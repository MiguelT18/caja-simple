---
// Campo de foto con vista previa antes de guardar: manda `image` (archivo) y `removeImage`.
// Lo usan el diálogo de sucursal (fachada, 16:9), Tu cuenta (perfil, redonda) y Configuración (logo, cuadrado).
import { ImagePlus, Store, UserRound } from "@lucide/astro";

interface Props {
  /** id del formulario que lo contiene (para los ids del campo y su error). */
  form: string;
  label: string;
  /** URL de la foto actual, si tiene. */
  image?: string;
  round?: boolean;
  /** Logo: cuadrado chico y la imagen entera (contain), sin recortar. */
  square?: boolean;
  /** Con `square`: portada grande (10rem) con los botones debajo, como en Configuración. */
  cover?: boolean;
}

const { form, label, image, round = false, square = false, cover = false } = Astro.props;
const Placeholder = round ? UserRound : Store;
// Lado mayor al subirla: perfil y logo se ven chicos; la fachada, a lo ancho de una tarjeta (pantallas 2x).
const max = round || square ? 512 : 1280;
---

<div class:list={["field", { round, square, cover }]} data-photo-field data-form={form} data-max={max}>
  <span class="field-label" id={`${form}-image-label`}>{label}</span>
  <div class="photo-row">
    <div class="photo-preview">
      <img src={image} alt="" hidden={!image} decoding="async" data-photo-preview data-fallback />
      <Placeholder size={28} stroke-width={1.5} aria-hidden="true" />
    </div>
    <div class="photo-actions">
      <label class="btn btn-secondary photo-pick">
        <ImagePlus size={18} stroke-width={1.75} />
        {image ? "Cambiar foto" : "Elegir foto"}
        <input
          class="sr-only"
          id={`${form}-image`}
          type="file"
          name="image"
          accept="image/jpeg,image/png,image/webp"
          aria-labelledby={`${form}-image-label`}
          aria-describedby={`${form}-image-hint ${form}-image-error`}
          data-photo-input
        />
      </label>
      {
        image && (
          <label class="photo-remove">
            <input type="checkbox" name="removeImage" value="true" data-photo-remove />
            Quitar foto
          </label>
        )
      }
    </div>
  </div>
  <p class="field-hint" id={`${form}-image-hint`}>Opcional · JPG, PNG o WebP. La achicamos al subirla</p>
  <p class="field-error" id={`${form}-image-error`}></p>
</div>

<script>
  import { setBusy } from "@/scripts/busy";
  import { shrinkInput } from "@/scripts/shrink-image";

  // Vista previa de la foto elegida antes de guardar. La foto se achica antes, así se sube y se ve la liviana.
  for (const field of document.querySelectorAll<HTMLElement>("[data-photo-field]")) {
    const input = field.querySelector<HTMLInputElement>("[data-photo-input]")!;
    const preview = field.querySelector<HTMLImageElement>("[data-photo-preview]")!;
    const remove = field.querySelector<HTMLInputElement>("[data-photo-remove]");
    const original = preview.getAttribute("src");
    let objectUrl: string | undefined;

    const show = (src: string | null) => {
      if (src) preview.src = src;
      preview.hidden = !src;
    };

    const submit = document.getElementById(field.dataset.form!)?.querySelector<HTMLButtonElement>("button[type=submit]");

    input.addEventListener("change", async () => {
      // Mientras se achica, no se puede guardar: se enviaría el original.
      setBusy(submit, true, "Preparando foto…");
      const file = await shrinkInput(input, Number(field.dataset.max));
      setBusy(submit, false);
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = file ? URL.createObjectURL(file) : undefined;
      if (remove && file) remove.checked = false;
      show(objectUrl ?? original);
    });

    remove?.addEventListener("change", () => {
      if (remove.checked) input.value = "";
      show(remove.checked ? null : original);
    });
  }
</script>

<style>
  .photo-row {
    display: grid;
    gap: 0.75rem;
  }

  .photo-preview {
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--color-border-strong);
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
    color: var(--color-text-subtle);
  }

  .photo-preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Foto de perfil y logo: chicos, al lado de los botones. */
  .round .photo-row,
  .square .photo-row {
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .round .photo-preview {
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .square .photo-preview {
    width: 5rem;
    aspect-ratio: 1;
    border-radius: 0.75rem;
  }

  .square .photo-preview img {
    object-fit: contain;
  }

  /* Portada: el logo grande como arte de álbum, los botones debajo. */
  .cover .photo-row {
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
  }

  .cover .photo-preview {
    width: 100%;
    max-width: 10rem;
    border-radius: 0.375rem;
  }

  .cover .photo-preview:has(img:not([hidden])) {
    border-color: transparent;
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.45);
  }

  .photo-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .photo-pick:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .photo-remove {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .photo-remove input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-primary);
  }
</style>
