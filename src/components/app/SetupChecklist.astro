---
// Primeros pasos de la dueña nueva: catálogo → inventario → turno → primera venta. Se oculta al completarlos.
import { ChevronRight, CircleCheck, Circle } from "@lucide/astro";
import { branchHref, businessHref } from "@/data/queries";
import type { Branch, Business } from "@/data/types";

interface Props {
  business: Business;
  branch?: Branch;
  hasProducts: boolean;
  hasStock: boolean;
  opened: boolean;
  sold: boolean;
}

const { business, branch, hasProducts, hasStock, opened, sold } = Astro.props;
const at = (section: string) => (branch ? branchHref(business, branch, section) : `${businessHref(business)}/sucursales`);
const steps = [
  { done: hasProducts, title: "Agrega tus productos", note: "Arma el catálogo del negocio, uno por uno o con un CSV.", href: `${businessHref(business)}/catalogo` },
  { done: hasStock, title: "Ponles precio y stock", note: "En el inventario de la sucursal, lo que vas a vender ahí.", href: at("inventario") },
  { done: opened, title: "Abre el primer turno", note: "Con el efectivo con el que empieza la caja.", href: at("turnos") },
  { done: sold, title: "Registra la primera venta", note: "Desde Vender, en el celular o la computadora.", href: at("registrar-venta") },
];
const done = steps.filter((s) => s.done).length;
---

{
  done < steps.length && (
    <section class="card setup" aria-labelledby="setup-title">
      <div class="setup-head">
        <h2 id="setup-title" class="card-title">Primeros pasos</h2>
        <p class="setup-count">
          {done} de {steps.length} listos
        </p>
      </div>
      <ol class="setup-steps" role="list">
        {steps.map((s) => (
          <li>
            <a href={s.href} class:list={["setup-step", { "is-done": s.done }]}>
              {s.done ? <CircleCheck size={22} stroke-width={1.75} class="setup-icon" /> : <Circle size={22} stroke-width={1.75} class="setup-icon" />}
              <span class="setup-text">
                <span class="setup-title">{s.title}</span>
                <span class="setup-note">
                  <span class="sr-only">{s.done ? "Listo. " : "Pendiente. "}</span>
                  {s.note}
                </span>
              </span>
              <span class="setup-state" aria-hidden="true">{s.done ? "Listo" : "Pendiente"}</span>
              <ChevronRight size={18} stroke-width={1.75} class="setup-go" />
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .setup {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .setup-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .setup-count {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .setup-steps {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .setup-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.5rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .setup-step:hover {
    background: var(--color-surface-hover);
  }

  .setup-icon {
    color: var(--color-text-muted);
  }

  .is-done .setup-icon {
    color: var(--color-income);
  }

  .setup-text {
    display: grid;
    gap: 0.125rem;
  }

  .setup-title {
    font-weight: var(--font-semibold);
  }

  .is-done .setup-title {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .setup-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .setup-state {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }

  .is-done .setup-state {
    color: var(--color-income);
  }

  .setup-go {
    color: var(--color-text-muted);
  }

  @media (max-width: 30rem) {
    .setup-state {
      display: none;
    }
  }
</style>
