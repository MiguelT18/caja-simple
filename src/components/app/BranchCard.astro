---
// Tarjeta de una sucursal en «Sucursales»: foto de la fachada (o el color de la sucursal), estado de la caja,
// turnos y cifras de hoy. El lápiz y «Agregar foto» abren el diálogo `branch-<id>` de la página.
import { ArrowRight, CircleCheck, Clock, ImagePlus, MapPin, Pencil, Store, TriangleAlert, Users } from "@lucide/astro";
import ShiftChip from "@/components/ShiftChip.astro";
import type { businessContext } from "@/data/queries";
import { formatBs } from "@/lib/format";

type BranchStats = NonNullable<Awaited<ReturnType<typeof businessContext>>>["branchSummary"][number];

interface Props {
  stats: Pick<BranchStats, "branch" | "image" | "href" | "employees" | "shifts" | "sales" | "expenses" | "cash">;
  /** Posición en la lista: elige el color de la sucursal. */
  index: number;
}

const { stats, index } = Astro.props;
const { branch } = stats;
const balance = stats.sales - stats.expenses;
---

<!-- Con foto, la fachada lleva el mismo view-transition-name que el fondo del encabezado de la sucursal: pasa a él al entrar. -->
<article
  class="card branch"
  style={`--branch: var(--color-branch-${(index % 6) + 1})`}
  aria-labelledby={`branch-title-${branch.id}`}
  data-morph={stats.image ? "" : undefined}
>
  <div class="branch-media">
    {stats.image ? (
      <img class="skeleton" src={stats.image} alt="" loading="lazy" decoding="async" data-fallback style={`view-transition-name: branch-${branch.id}`} />
    ) : (
      <div class="branch-placeholder">
        <Store size={36} stroke-width={1.5} aria-hidden="true" />
        <button type="button" class="photo-add" data-open-dialog={`branch-${branch.id}`}>
          <ImagePlus size={16} stroke-width={1.75} />
          Agregar foto<span class="sr-only"> de {branch.name}</span>
        </button>
      </div>
    )}
    <a href={stats.href} class="play-btn enter" aria-label={`Entrar a ${branch.name}`} title="Entrar">
      <ArrowRight size={22} stroke-width={1.75} />
    </a>
    <button type="button" class="icon-btn media-edit" data-open-dialog={`branch-${branch.id}`} aria-label={`Editar ${branch.name}`}>
      <Pencil size={16} stroke-width={1.75} />
    </button>
    <span class="media-status">
      {stats.cash === "cuadra" && (
        <span class="chip chip-income">
          <CircleCheck size={14} stroke-width={2} />
          La caja cuadró
        </span>
      )}
      {stats.cash === "descuadre" && (
        <span class="chip chip-warning">
          <TriangleAlert size={14} stroke-width={2} />
          Caja descuadrada
        </span>
      )}
      {stats.cash === "en-curso" && (
        <span class="chip chip-live">
          <span class="live-dot" aria-hidden="true" />
          Turno en curso
        </span>
      )}
      {stats.cash === "sin-abrir" && (
        <span class="chip chip-neutral">
          <Clock size={14} stroke-width={2} />
          Sin turnos abiertos hoy
        </span>
      )}
    </span>
  </div>

  <div class="branch-body">
    <header class="branch-head">
      <h2 class="card-title" id={`branch-title-${branch.id}`}>
        <span class="branch-dot" aria-hidden="true" />
        <span class="branch-name" title={branch.name}>{branch.name}</span>
      </h2>
      {branch.address && (
        <p class="meta" title={branch.address}>
          <MapPin size={16} stroke-width={1.75} />
          <span>{branch.address}</span>
        </p>
      )}
      <p class="meta">
        <Users size={16} stroke-width={1.75} />
        <span>
          {stats.employees} {stats.employees === 1 ? "empleado" : "empleados"}
        </span>
      </p>
    </header>

    <div class="shifts">
      <ul class="shift-list" role="list" aria-label={`Turnos de ${branch.name}`}>
        {stats.shifts.map((shift) => (
          <li>
            <ShiftChip shift={shift} withTime />
          </li>
        ))}
      </ul>
      <a class="shifts-link" href={`${stats.href}/turnos`}>
        <Clock size={14} stroke-width={2} />
        Editar turnos<span class="sr-only"> de {branch.name}</span>
      </a>
    </div>

    <dl class="figures" aria-label="Hoy">
      <div>
        <dt>Ventas</dt>
        <dd class="num amount-income">{formatBs(stats.sales, "+")}</dd>
      </div>
      <div>
        <dt>Gastos</dt>
        <dd class="num amount-expense">{formatBs(stats.expenses, "−")}</dd>
      </div>
      <div class="balance">
        <dt>Saldo</dt>
        <dd class="num">{formatBs(balance)}</dd>
      </div>
    </dl>

  </div>
</article>

<style>
  /* Tarjeta tipo álbum: portada con margen, sin borde; se aclara al pasar el mouse. */
  .branch {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    transition: background-color 200ms;
  }

  .branch:hover,
  .branch:focus-within {
    background: var(--color-surface-hover);
  }

  /* Foto de la fachada, o el color de la sucursal si todavía no tiene. */
  .branch-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.375rem;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--branch) 45%, var(--color-surface)),
      color-mix(in oklab, var(--branch) 15%, var(--color-surface))
    );
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.4);
  }

  .branch-media img {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  .branch-placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: 100%;
    color: var(--color-text);
  }

  .photo-add {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    white-space: nowrap;
    cursor: pointer;
  }

  .photo-add:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .media-edit {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .media-status {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    max-width: calc(100% - 5rem);
  }

  .media-status .chip {
    box-shadow: var(--shadow-sm);
  }

  .branch-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0.25rem 0.25rem;
    container-type: inline-size;
  }

  .branch-head {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    margin-bottom: 0.125rem;
  }

  .branch-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .branch-dot {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--branch);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .meta :global(svg) {
    flex-shrink: 0;
  }

  .meta span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shifts {
    display: grid;
    gap: 0.5rem;
  }

  .shifts-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    justify-self: start;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .shifts-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .shift-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shift-list .num {
    font-weight: var(--font-medium);
    opacity: 0.85;
  }

  /* Cifras de hoy: tres columnas; si la tarjeta es angosta, una debajo de otra. */
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .figures div {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .figures dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
  }

  .figures dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .figures .balance dd {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
  }

  @container (max-width: 19rem) {
    .figures {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.375rem;
    }

    .figures div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  /* «Entrar»: botón redondo sobre la portada; aparece al pasar el mouse y queda fijo en táctil. */
  .enter {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 200ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .branch:hover .enter,
  .branch:focus-within .enter {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .enter {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enter {
      transition: none;
    }
  }

</style>
