---
// Barra del turno, abajo en toda página de sucursal: el turno abierto con su horario, la cuenta de la caja
// (apertura + ventas − gastos = esperado) y el botón para registrar una venta. Del reproductor de música toma
// solo la forma (barra fija abajo, arte cuadrado, botón redondo), nunca sus metáforas de audio.
// Sin turno abierto, invita a abrir uno. Los datos salen de shiftBarData() (src/data/branch.ts).
import { Clock, Hourglass, LockOpen, Moon, Plus, RotateCcw, Sun, Sunset, TriangleAlert } from "@lucide/astro";
import FormInput from "@/components/app/FormInput.astro";
import type { ShiftBarData } from "@/data/queries";
import { shiftProgress } from "@/lib/dates";
import { formatBs, overnight } from "@/lib/format";

interface Props {
  data: ShiftBarData;
}

const { data } = Astro.props;
const shift = data.shift;
// Más de 24 h abierto (un turno olvidado): el aviso no se va solo, hay que cerrarlo con el arqueo.
const stale = !!data.stale;
const late = stale || (shift && data.openedOn ? shiftProgress(shift, data.openedOn).late : false);
const Icon = shift ? { morning: Sun, afternoon: Sunset, night: Moon }[shift.tone] : Clock;
const expected = data.expected ?? 0;
// Si el botón llevaría a la página actual («Registrar venta» o «Turnos»), no se muestra: la página ya tiene esa acción.
const here = Astro.url.pathname.replace(/\/$/, "");
---

<aside id="shift-bar" class="shift-bar" aria-label={shift ? "Turno en curso" : "Turno"} data-shift-bar data-region="shift-bar">
  <div class="now">
    <span class:list={["art", shift && `art-${shift.tone}`]} aria-hidden="true">
      <Icon size={22} stroke-width={1.75} />
      {/* La foto tapa el ícono; si no carga (data-fallback), queda el ícono. Con turno, su ícono va de insignia. */}
      {data.image && <img class="art-img" src={data.image} alt="" decoding="async" data-fallback />}
      {data.image && shift && (
        <span class:list={["art-badge", `art-${shift.tone}`]}>
          <Icon size={12} stroke-width={2} />
        </span>
      )}
    </span>
    <div class="now-text">
      <p class="now-title">{shift ? `Turno ${shift.name.toLowerCase()}` : "Sin turno abierto"}</p>
      {
        shift ? (
          <div class="status" data-status data-start={shift.start} data-end={shift.end} data-opened={data.openedOn} data-stale={stale ? "" : undefined}>
            <p class="now-sub" data-on-time hidden={late}>
              <span class="live">
                <span class="live-dot" aria-hidden="true" />
                En curso
              </span>
              <span class="num hours">
                {shift.start}–{shift.end}
                {overnight(shift) && <span title="Termina al día siguiente"> (+1)</span>}
              </span>
              <span class="branch">{data.branchName}</span>
            </p>
            <p class="now-sub late" data-late hidden={!late}>
              <TriangleAlert size={14} stroke-width={1.75} />
              {stale ? (
                <span class="late-text">
                  Lleva más de 24 h abierto<span class="late-long">. Ciérralo con el arqueo</span>
                </span>
              ) : (
                <span class="late-text">
                  Pasó <span class="late-long">la hora de cierre</span><span class="late-short">el cierre</span> (<span class="num">{shift.end}</span>)
                </span>
              )}
            </p>
          </div>
        ) : (
          <p class="now-sub">
            <span class="branch">{data.branchName}</span>
          </p>
        )
      }
    </div>
  </div>

  {
    shift ? (
      <>
        {/* La cuenta del turno, como se hace en el mostrador: los signos de cada monto son la operación. */}
        <dl class="ledger" aria-label="Caja del turno">
          <div class="term term-opening">
            <dt>Apertura</dt>
            <dd class="num">{formatBs(data.opening ?? 0)}</dd>
          </div>
          <div class="term term-flow">
            {/* Solo el efectivo entra al cajón: QR y transferencias no van en el arqueo. */}
            <dt>Ventas en efectivo</dt>
            <dd class="num amount-income">{formatBs(data.cash ?? 0, "+")}</dd>
          </div>
          <div class="term term-flow">
            <dt>Gastos</dt>
            <dd class="num amount-expense">{formatBs(data.expenses ?? 0, "−")}</dd>
          </div>
          <div class="term term-total">
            <dt>Esperado en caja</dt>
            <dd class:list={["num", expected < 0 && "amount-expense"]}>{formatBs(expected)}</dd>
          </div>
        </dl>

        <div class="cash">
          {here !== data.saleHref && (
            <a class="sale" href={data.saleHref} title="Registrar venta">
              <span class="play-btn">
                <Plus size={24} stroke-width={1.75} />
              </span>
              <span class="sale-label">Registrar venta</span>
            </a>
          )}
        </div>
      </>
    ) : data.reopen ? (
      // Su turno ya se cerró hoy: se pide a la dueña que lo reabra (requestReopen); ella acepta o rechaza en sus avisos.
      data.reopen.pending ? (
        <p class="reopen-wait">
          <Hourglass size={16} stroke-width={1.75} aria-hidden="true" />
          <span>Pediste reabrir el turno {data.reopen.shiftName.toLowerCase()}. Esperando respuesta.</span>
        </p>
      ) : (
        <button type="button" class="btn btn-primary open" data-open-dialog="bar-reopen-shift">
          <RotateCcw size={18} stroke-width={1.75} />
          {data.reopen.direct ? "Reabrir turno" : "Pedir reabrir"}
        </button>
      )
    ) : data.wait ? (
      // Fuera del horario de todo turno: se dice desde cuándo se abre el próximo (la base no lo dejaría antes).
      <p class="reopen-wait">
        <Clock size={16} stroke-width={1.75} aria-hidden="true" />
        <span>El turno {data.wait.shiftName.toLowerCase()} se abre a partir de las <span class="num">{data.wait.from}</span>.</span>
      </p>
    ) : (
      here !== data.shiftsHref &&
      (data.open ? (
        // Se abre aquí mismo, sin ir a Turnos. Sin data-form-notice: los errores salen en un toast (scripts/action-forms.ts).
        <button type="button" class="btn btn-primary open" data-open-dialog="bar-open-shift">
          <LockOpen size={18} stroke-width={1.75} />
          Abrir turno
        </button>
      ) : (
        <a class="btn btn-primary open" href={data.shiftsHref}>
          <LockOpen size={18} stroke-width={1.75} />
          Abrir turno
        </a>
      ))
    )
  }
</aside>

{
  !shift && data.reopen && !data.reopen.pending && (
    <dialog id="bar-reopen-shift" class="modal" aria-labelledby="bar-reopen-shift-title">
      {
        data.reopen.direct ? (
          // La dueña reabre directo: el mismo turno de hoy, con lo vendido y sin lo contado (public.reopen_shift).
          <form id="bar-reopen-shift-form" class="modal-form" method="dialog" data-action="reopenShift" data-reload data-success={`Turno ${data.reopen.shiftName.toLowerCase()} reabierto.`} novalidate>
            <header class="modal-head">
              <h2 id="bar-reopen-shift-title">¿Reabrir el turno {data.reopen.shiftName.toLowerCase()}?</h2>
              <p>Ya se cerró hoy. Al reabrirlo se borra lo contado y se sigue vendiendo en el mismo turno hasta volver a cerrarlo con el arqueo.</p>
            </header>
            <input type="hidden" name="closeId" value={data.reopen.closeId} />
            <p class="notice notice-error" role="alert" data-form-notice></p>
            <div class="modal-actions">
              <button type="button" class="btn btn-secondary" data-close-dialog>Cancelar</button>
              <button type="submit" class="btn btn-primary">Reabrir turno</button>
            </div>
          </form>
        ) : (
          <form
            id="bar-reopen-shift-form"
            class="modal-form"
            method="dialog"
            data-action="requestReopen"
            data-reload
            data-success="Listo: le avisamos a quien administra el negocio."
            novalidate
          >
            <header class="modal-head">
              <h2 id="bar-reopen-shift-title">¿Pedir reabrir el turno {data.reopen.shiftName.toLowerCase()}?</h2>
              <p>
                Ya se cerró hoy. Para volver a abrirlo, quien administra el negocio tiene que estar de acuerdo: le llega un
                aviso y decide. El pedido también queda en tus avisos; si acepta, sigues vendiendo en el mismo turno.
              </p>
            </header>
            <input type="hidden" name="closeId" value={data.reopen.closeId} />
            <FormInput form="bar-reopen-shift-form" name="reason" label="Motivo (opcional)" hint="Por ejemplo: lo cerré antes de tiempo, faltaba registrar una venta." maxlength={200} />
            <p class="notice notice-error" role="alert" data-form-notice></p>
            <div class="modal-actions">
              <button type="button" class="btn btn-secondary" data-close-dialog>Cancelar</button>
              <button type="submit" class="btn btn-primary">Confirmar y avisar</button>
            </div>
          </form>
        )
      }
    </dialog>
  )
}

{
  !shift && data.open && (
    <dialog id="bar-open-shift" class="modal" aria-labelledby="bar-open-shift-title">
      <form id="bar-open-shift-form" class="modal-form" method="dialog" data-action="openShift" data-reload data-success="Turno abierto." novalidate>
        <header class="modal-head">
          <h2 id="bar-open-shift-title">Abrir turno</h2>
          <p>En {data.branchName}. Las ventas y los gastos que registres cuentan en este turno.</p>
        </header>
        <input type="hidden" name="branchId" value={data.open.branchId} />
        {data.open.shifts.length === 1 ? (
          <input type="hidden" name="shiftId" value={data.open.shifts[0].id} />
        ) : (
          <FormInput
            form="bar-open-shift-form"
            name="shiftId"
            label="Turno"
            options={data.open.shifts.map((s) => ({ value: s.id, label: `${s.name} (${s.start}–${s.end})`, selected: s.selected }))}
            required
          />
        )}
        <FormInput
          form="bar-open-shift-form"
          name="opening"
          type="number"
          inputmode="decimal"
          step="0.01"
          min="0"
          label={data.open.shifts.length === 1 ? `Dinero en caja al abrir el turno ${data.open.shifts[0].name.toLowerCase()} (Bs)` : "Dinero en caja al abrir (Bs)"}
          value={data.open.opening === undefined ? undefined : String(data.open.opening)}
          hint={data.open.opening === undefined ? undefined : "Lo contado al cerrar el último turno. Cámbialo si no es lo que hay."}
          required
        />
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" data-close-dialog>Cancelar</button>
          <button type="submit" class="btn btn-primary">Abrir turno</button>
        </div>
      </form>
    </dialog>
  )
}

<script>
  import { shiftProgress } from "@/lib/dates";

  // Pasada la hora de cierre, la línea de estado cambia a un aviso. Se revisa cada minuto en hora de Bolivia.
  // Busca la barra en cada vuelta: tras una venta o un gasto se cambia por una nueva (scripts/refresh.ts).
  setInterval(() => {
    const box = document.querySelector<HTMLElement>("[data-shift-bar] [data-status]");
    if (!box || "stale" in box.dataset) return;
    const { start = "", end = "", opened = "" } = box.dataset;
    const isLate = shiftProgress({ start, end }, opened).late;
    box.querySelector<HTMLElement>("[data-late]")!.hidden = !isLate;
    box.querySelector<HTMLElement>("[data-on-time]")!.hidden = isLate;
  }, 60_000);
</script>

<style>
  .shift-bar {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto minmax(10rem, 1fr);
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
    padding: 0.625rem 1rem 0.625rem 0.625rem;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .now {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }

  /* Portada del turno: el ícono del tono sobre su color. */
  .art {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.375rem;
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
  }

  .art-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  /* Insignia del turno sobre la foto: el borde del color de la barra la separa de la imagen. */
  .art-badge {
    position: absolute;
    right: -0.25rem;
    bottom: -0.25rem;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
  }

  .art-morning {
    background: var(--color-shift-morning-soft);
    color: var(--color-shift-morning);
  }

  .art-afternoon {
    background: var(--color-shift-afternoon-soft);
    color: var(--color-shift-afternoon);
  }

  .art-night {
    background: var(--color-shift-night-soft);
    color: var(--color-shift-night);
  }

  .now-text {
    display: grid;
    min-width: 0;
  }

  /* Sin esto la línea de estado no se encoge y el nombre de la sucursal pisa la cuenta. */
  .status {
    min-width: 0;
  }

  .now-title,
  .now-sub {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .now-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
  }

  .now-sub {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .now-sub[hidden] {
    display: none;
  }

  /* Separador fino entre las partes de la línea de estado. */
  .now-sub:not(.late) > * + *::before {
    content: "·" / "";
    margin-right: 0.5rem;
  }

  .live {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary);
    font-weight: var(--font-bold);
  }

  .hours {
    flex-shrink: 0;
  }

  .branch {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .late {
    color: var(--color-warning);
    font-weight: var(--font-bold);
  }

  .late :global(svg) {
    flex-shrink: 0;
  }

  .late-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .late-short {
    display: none;
  }

  /* La cuenta del turno: cuatro cifras en fila; el esperado, separado por «=», es el resultado. */
  .ledger {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin: 0;
  }

  .term {
    display: grid;
    gap: 0.125rem;
  }

  .term dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .term dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    white-space: nowrap;
  }

  .term-total {
    position: relative;
    padding-left: 1.5rem;
  }

  .term-total::before {
    content: "=" / "";
    position: absolute;
    bottom: 0;
    left: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  .term-total dd {
    font-size: var(--text-base);
    font-weight: var(--font-extrabold);
  }

  .cash {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  .sale {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .sale:hover .play-btn {
    transform: scale(1.04);
    background: var(--color-primary-hover);
  }

  .open,
  .reopen-wait {
    grid-column: 3;
    justify-self: end;
  }

  /* Pedido de reapertura enviado: texto con ícono (no solo color), sin botón. */
  .reopen-wait {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Escritorio angosto: sin la apertura la suma ya no cierra, así que se va también el «=»;
     el texto del botón queda en title y en el nombre del enlace. */
  @media (max-width: 1180px) {
    .term-opening {
      display: none;
    }

    .term-total {
      padding-left: 0;
    }

    .term-total::before {
      content: none;
    }

    .sale-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Hasta 960px, de la cuenta queda solo el esperado. */
  @media (max-width: 960px) {
    .term-flow {
      display: none;
    }
  }

  @media (max-width: 960px) and (min-width: 769px) {
    .shift-bar {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 1rem;
    }
  }

  /* Móvil: mini-reproductor sobre el borde inferior con el turno, el esperado y el botón. */
  @media (max-width: 768px) {
    .shift-bar {
      position: fixed;
      right: 0.5rem;
      bottom: calc(0.5rem + env(safe-area-inset-bottom));
      left: 0.5rem;
      z-index: 50;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 0.75rem;
      min-height: 0;
      padding: 0.5rem;
      overflow: hidden;
      border-radius: var(--radius-panel);
      background: var(--color-surface-hover);
      box-shadow: var(--shadow-md);
    }

    .art {
      width: 2.75rem;
      height: 2.75rem;
    }

    .now-title {
      font-size: var(--text-sm);
    }

    .now-sub {
      font-size: var(--text-xs);
    }

    /* En el celular la línea de estado no tiene lugar para el horario y el aviso se acorta. */
    .hours,
    .late-long {
      display: none;
    }

    .late-short {
      display: inline;
    }

    .term {
      text-align: right;
    }

    .term-total dd {
      font-size: var(--text-sm);
    }

    .play-btn {
      width: 2.75rem;
      height: 2.75rem;
    }

    .open,
    .reopen-wait {
      grid-column: 2 / -1;
    }
  }
</style>
