---
// Barra del turno, abajo en toda página de sucursal: el turno abierto con su horario, la cuenta de la caja
// (apertura + ventas − gastos = esperado) y el botón para registrar una venta. Del reproductor de música toma
// solo la forma (barra fija abajo, arte cuadrado, botón redondo), nunca sus metáforas de audio.
// Sin turno abierto, invita a abrir uno. Los datos salen de shiftBarData() (src/data/branch.ts).
import { Clock, LockOpen, Moon, Plus, Sun, Sunset, TriangleAlert } from "@lucide/astro";
import type { ShiftBarData } from "@/data/queries";
import { shiftProgress } from "@/lib/dates";
import { formatBs, overnight } from "@/lib/format";

interface Props {
  data: ShiftBarData;
}

const { data } = Astro.props;
const shift = data.shift;
const late = shift && data.openedOn ? shiftProgress(shift, data.openedOn).late : false;
const Icon = shift ? { morning: Sun, afternoon: Sunset, night: Moon }[shift.tone] : Clock;
const expected = data.expected ?? 0;
// Si el botón llevaría a la página actual («Registrar venta» o «Turnos»), no se muestra: la página ya tiene esa acción.
const here = Astro.url.pathname.replace(/\/$/, "");
---

<aside class="shift-bar" aria-label={shift ? "Turno en curso" : "Turno"} data-shift-bar>
  <div class="now">
    <span class:list={["art", shift && `art-${shift.tone}`]} aria-hidden="true">
      <Icon size={22} stroke-width={1.75} />
    </span>
    <div class="now-text">
      <p class="now-title">{shift ? `Turno ${shift.name.toLowerCase()}` : "Sin turno abierto"}</p>
      {
        shift ? (
          <div class="status" data-status data-start={shift.start} data-end={shift.end} data-opened={data.openedOn}>
            <p class="now-sub" data-on-time hidden={late}>
              <span class="live">
                <span class="live-dot" aria-hidden="true" />
                En curso
              </span>
              <span class="num hours">
                {shift.start}–{shift.end}
                {overnight(shift) && <span title="Termina al día siguiente"> (+1)</span>}
              </span>
              <span class="branch">{data.branchName}</span>
            </p>
            <p class="now-sub late" data-late hidden={!late}>
              <TriangleAlert size={14} stroke-width={1.75} />
              <span class="late-text">
                Pasó <span class="late-long">la hora de cierre</span><span class="late-short">el cierre</span> (<span class="num">{shift.end}</span>)
              </span>
            </p>
          </div>
        ) : (
          <p class="now-sub">
            <span class="branch">{data.branchName}</span>
          </p>
        )
      }
    </div>
  </div>

  {
    shift ? (
      <>
        {/* La cuenta del turno, como se hace en el mostrador: los signos de cada monto son la operación. */}
        <dl class="ledger" aria-label="Caja del turno">
          <div class="term term-opening">
            <dt>Apertura</dt>
            <dd class="num">{formatBs(data.opening ?? 0)}</dd>
          </div>
          <div class="term term-flow">
            <dt>Ventas</dt>
            <dd class="num amount-income">{formatBs(data.sales ?? 0, "+")}</dd>
          </div>
          <div class="term term-flow">
            <dt>Gastos</dt>
            <dd class="num amount-expense">{formatBs(data.expenses ?? 0, "−")}</dd>
          </div>
          <div class="term term-total">
            <dt>Esperado en caja</dt>
            <dd class:list={["num", expected < 0 && "amount-expense"]}>{formatBs(expected)}</dd>
          </div>
        </dl>

        <div class="cash">
          {here !== data.saleHref && (
            <a class="sale" href={data.saleHref} title="Registrar venta">
              <span class="play-btn">
                <Plus size={24} stroke-width={1.75} />
              </span>
              <span class="sale-label">Registrar venta</span>
            </a>
          )}
        </div>
      </>
    ) : (
      here !== data.shiftsHref && (
        <a class="btn btn-primary open" href={data.shiftsHref}>
          <LockOpen size={18} stroke-width={1.75} />
          Abrir turno
        </a>
      )
    )
  }
</aside>

<script>
  import { shiftProgress } from "@/lib/dates";

  // Pasada la hora de cierre, la línea de estado cambia a un aviso. Se revisa cada minuto en hora de Bolivia.
  const box = document.querySelector<HTMLElement>("[data-shift-bar] [data-status]");
  if (box) {
    const { start = "", end = "", opened = "" } = box.dataset;
    const onTime = box.querySelector<HTMLElement>("[data-on-time]")!;
    const late = box.querySelector<HTMLElement>("[data-late]")!;
    setInterval(() => {
      const isLate = shiftProgress({ start, end }, opened).late;
      late.hidden = !isLate;
      onTime.hidden = isLate;
    }, 60_000);
  }
</script>

<style>
  .shift-bar {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto minmax(10rem, 1fr);
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
    padding: 0.625rem 1rem 0.625rem 0.625rem;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .now {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }

  /* Portada del turno: el ícono del tono sobre su color. */
  .art {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.375rem;
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
  }

  .art-morning {
    background: var(--color-shift-morning-soft);
    color: var(--color-shift-morning);
  }

  .art-afternoon {
    background: var(--color-shift-afternoon-soft);
    color: var(--color-shift-afternoon);
  }

  .art-night {
    background: var(--color-shift-night-soft);
    color: var(--color-shift-night);
  }

  .now-text {
    display: grid;
    min-width: 0;
  }

  /* Sin esto la línea de estado no se encoge y el nombre de la sucursal pisa la cuenta. */
  .status {
    min-width: 0;
  }

  .now-title,
  .now-sub {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .now-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
  }

  .now-sub {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .now-sub[hidden] {
    display: none;
  }

  /* Separador fino entre las partes de la línea de estado. */
  .now-sub:not(.late) > * + *::before {
    content: "·" / "";
    margin-right: 0.5rem;
  }

  .live {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary);
    font-weight: var(--font-bold);
  }

  .hours {
    flex-shrink: 0;
  }

  .branch {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .late {
    color: var(--color-warning);
    font-weight: var(--font-bold);
  }

  .late :global(svg) {
    flex-shrink: 0;
  }

  .late-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .late-short {
    display: none;
  }

  /* La cuenta del turno: cuatro cifras en fila; el esperado, separado por «=», es el resultado. */
  .ledger {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin: 0;
  }

  .term {
    display: grid;
    gap: 0.125rem;
  }

  .term dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .term dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    white-space: nowrap;
  }

  .term-total {
    position: relative;
    padding-left: 1.5rem;
  }

  .term-total::before {
    content: "=" / "";
    position: absolute;
    bottom: 0;
    left: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  .term-total dd {
    font-size: var(--text-base);
    font-weight: var(--font-extrabold);
  }

  .cash {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  .sale {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .sale:hover .play-btn {
    transform: scale(1.04);
    background: var(--color-primary-hover);
  }

  .open {
    grid-column: 3;
    justify-self: end;
  }

  /* Escritorio angosto: sin la apertura la suma ya no cierra, así que se va también el «=»;
     el texto del botón queda en title y en el nombre del enlace. */
  @media (max-width: 1180px) {
    .term-opening {
      display: none;
    }

    .term-total {
      padding-left: 0;
    }

    .term-total::before {
      content: none;
    }

    .sale-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Hasta 960px, de la cuenta queda solo el esperado. */
  @media (max-width: 960px) {
    .term-flow {
      display: none;
    }
  }

  @media (max-width: 960px) and (min-width: 769px) {
    .shift-bar {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 1rem;
    }
  }

  /* Móvil: mini-reproductor sobre el borde inferior con el turno, el esperado y el botón. */
  @media (max-width: 768px) {
    .shift-bar {
      position: fixed;
      right: 0.5rem;
      bottom: calc(0.5rem + env(safe-area-inset-bottom));
      left: 0.5rem;
      z-index: 50;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 0.75rem;
      min-height: 0;
      padding: 0.5rem;
      overflow: hidden;
      border-radius: var(--radius-panel);
      background: var(--color-surface-hover);
      box-shadow: var(--shadow-md);
    }

    .art {
      width: 2.75rem;
      height: 2.75rem;
    }

    .now-title {
      font-size: var(--text-sm);
    }

    .now-sub {
      font-size: var(--text-xs);
    }

    /* En el celular la línea de estado no tiene lugar para el horario y el aviso se acorta. */
    .hours,
    .late-long {
      display: none;
    }

    .late-short {
      display: inline;
    }

    .term {
      text-align: right;
    }

    .term-total dd {
      font-size: var(--text-sm);
    }

    .play-btn {
      width: 2.75rem;
      height: 2.75rem;
    }

    .open {
      grid-column: 2 / -1;
    }
  }
</style>
