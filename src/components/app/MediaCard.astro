---
// Tarjeta tipo álbum: arte cuadrado (o redondo, para personas), título y subtítulo. Toda la tarjeta es un enlace;
// al pasar el mouse se aclara y aparece el botón redondo ámbar (en pantallas táctiles se ve siempre).
import { ArrowRight } from "@lucide/astro";

interface Props {
  /** Sin enlace: la vista previa de «Abre tu negocio», que no lleva a ningún lado. */
  href?: string;
  title: string;
  subtitle?: string;
  /** Texto del arte cuando no hay imagen: iniciales o una palabra corta. */
  monogram?: string;
  image?: string;
  /** Color del arte (una var(--color-…)). */
  color?: string;
  round?: boolean;
  /** Para lectores de pantalla: qué hace el enlace («Entrar a Almacén López»). */
  label?: string;
  /** view-transition-name del arte: el encabezado de la página destino usa el mismo para recibir la imagen. */
  transition?: string;
}

const { href, title, subtitle, monogram, image, color = "var(--color-primary)", round = false, label, transition } = Astro.props;
---

<article class="media-card" style={`--art: ${color}`} data-morph={transition ? "" : undefined}>
  <div class:list={["art", { round }]} style={transition && `view-transition-name: ${transition}`}>
    {image ? <img src={image} alt="" loading="lazy" decoding="async" data-fallback /> : <span class="monogram" aria-hidden="true">{monogram}</span>}
    <span class="play-btn" aria-hidden="true">
      <ArrowRight size={22} stroke-width={1.75} />
    </span>
  </div>
  <h3 class="title">
    {href ? <a href={href} aria-label={label}>{title}</a> : title}
  </h3>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <slot />
</article>

<style>
  .media-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.75rem;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
    transition: background-color 200ms;
  }

  .media-card:hover,
  .media-card:focus-within {
    background: var(--color-surface-hover);
  }

  .art {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border-radius: 0.375rem;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--art) 70%, var(--color-surface)),
      color-mix(in oklab, var(--art) 25%, var(--color-surface))
    );
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.4);
  }

  .art.round {
    border-radius: 50%;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .monogram {
    position: absolute;
    left: 0.875rem;
    bottom: 0.625rem;
    color: var(--color-text);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    font-weight: var(--font-extrabold);
    letter-spacing: -0.04em;
  }

  /* Aparece desde abajo al pasar el mouse; quieto y visible con táctil o movimiento reducido. */
  .play-btn {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 200ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .media-card:hover .play-btn,
  .media-card:focus-within .play-btn {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .play-btn {
      opacity: 1;
      transform: none;
    }
  }

  .title {
    margin: 0;
    overflow: hidden;
    font-size: var(--text-base);
    line-height: var(--text-base-lh);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  /* Toda la tarjeta responde al clic; el foco se dibuja en la tarjeta entera. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .title a:focus-visible {
    outline: none;
  }

  .media-card:has(.title a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .subtitle {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .play-btn {
      transition: none;
    }
  }
</style>
