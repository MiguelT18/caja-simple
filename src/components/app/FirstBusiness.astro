---
// «Tus negocios» sin ninguno: crear el primero con todo lo que necesita (logo, rubro, descripción, sucursal con foto y
// turnos). A la derecha, cómo se va a ver y lo que viene después. El diálogo de «Crear negocio» queda corto a propósito.
import { Shirt, Store, UtensilsCrossed } from "@lucide/astro";
import BusinessProfileFields from "./BusinessProfileFields.astro";
import FormInput from "./FormInput.astro";
import PhotoField from "./PhotoField.astro";
import ShiftsEditor from "./ShiftsEditor.astro";
import { businessKinds } from "@/data/kinds";
import { defaultShifts } from "@/data/queries";

interface Props {
  firstName?: string;
}

const { firstName } = Astro.props;
const form = "onboarding";
const kindIcons = { tienda: Store, ropa: Shirt, restaurante: UtensilsCrossed };
const next = [
  { title: "Agrega tus productos", note: "Con precio y stock por sucursal, uno por uno o desde una planilla." },
  { title: "Invita a tu equipo", note: "Cada persona entra con su cuenta a la sucursal donde trabaja." },
  { title: "Abre el primer turno", note: "Con el efectivo con el que empieza la caja, y a vender." },
];
---

<section class="first" aria-labelledby="first-title">
  <header class="intro">
    {firstName && <p class="eyebrow">Hola, {firstName}</p>}
    <h1 id="first-title">Abre tu negocio</h1>
    <p>Son dos partes: tu negocio y la sucursal donde está la caja. Todo se puede cambiar después en Configuración.</p>
  </header>

  <div class="layout">
    <form id={form} class="steps" data-action="createBusiness" data-redirect="/app/{slug}" enctype="multipart/form-data" novalidate>
      <section class="step" aria-labelledby="step-business">
        <header class="step-head">
          <span class="step-n" aria-hidden="true">1</span>
          <div>
            <h2 id="step-business">Tu negocio</h2>
            <p>Cómo lo reconocen tus clientes y tu equipo.</p>
          </div>
        </header>
        <div class="step-body">
          <div class="identity">
            <PhotoField form={form} label="Logo" square cover />
            <div class="identity-fields">
              <FormInput form={form} name="name" label="Nombre del negocio" placeholder="Ej.: Almacén López" required maxlength={80} />
              <fieldset class="kinds">
                <legend class="field-label">Rubro</legend>
                <p class="field-hint" id={`${form}-kind-hint`}>Cambia cómo se llaman algunas secciones. Lo puedes cambiar después.</p>
                <div class="kind-options">
                  {
                    businessKinds.map((k, i) => {
                      const Icon = kindIcons[k.value];
                      return (
                        <label class="kind">
                          <input type="radio" name="kind" value={k.value} checked={i === 0} aria-describedby={`${form}-kind-hint`} data-kind-label={k.label} />
                          <Icon size={20} stroke-width={1.75} />
                          <span class="kind-label">{k.label}</span>
                          <span class="kind-hint">{k.hint}</span>
                        </label>
                      );
                    })
                  }
                </div>
                <p class="field-error" id={`${form}-kind-error`}></p>
              </fieldset>
            </div>
          </div>
          <BusinessProfileFields form={form} />
        </div>
      </section>

      <section class="step" aria-labelledby="step-branch">
        <header class="step-head">
          <span class="step-n" aria-hidden="true">2</span>
          <div>
            <h2 id="step-branch">Primera sucursal</h2>
            <p>Donde está la caja. Si tienes más locales, los agregas después.</p>
          </div>
        </header>
        <div class="step-body">
          <div class="field-row-2">
            <FormInput form={form} name="branchName" label="Nombre de la sucursal" value="Principal" hint="La zona o la calle; por ejemplo: Centro o Mercado Rodríguez." required maxlength={80} />
            <FormInput form={form} name="branchAddress" label="Dirección" hint="Opcional. La ve tu equipo en el menú." maxlength={160} />
          </div>
          <PhotoField form={form} name="branchImage" label="Foto de la fachada" />
          <ShiftsEditor form={form} presets={[{ label: "Los de siempre", shifts: defaultShifts }]} />
        </div>
      </section>

      <div class="submit">
        <p class="notice notice-error" role="alert" data-form-notice></p>
        <button type="submit" class="btn btn-primary">Crear negocio</button>
      </div>
    </form>

    <aside class="aside" aria-label="Vista previa y siguientes pasos">
      <div class="preview" aria-hidden="true">
        <p class="aside-label">Así se verá</p>
        <div class="preview-art">
          <img alt="" hidden data-preview-logo />
          <span class="preview-monogram" data-preview-monogram>TN</span>
        </div>
        <p class="preview-name" data-preview-name>Tu negocio</p>
        <p class="preview-meta"><span data-preview-kind>{businessKinds[0].label}</span> · <span data-preview-branch>Principal</span></p>
      </div>
      <div class="next">
        <h2 class="aside-label">Después de crearlo</h2>
        <ol role="list">
          {next.map((s) => (
            <li>
              <span class="next-title">{s.title}</span>
              <span class="next-note">{s.note}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="invite">Si te invitaron a trabajar en un negocio, aparecerá aquí cuando entres con el correo de la invitación.</p>
    </aside>
  </div>
</section>

<script>
  // Vista previa: nombre, monograma, rubro, sucursal y el logo ya achicado que muestra PhotoField.
  const form = document.getElementById("onboarding") as HTMLFormElement | null;
  if (form) {
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const name = $("[data-preview-name]");
    const monogram = $("[data-preview-monogram]");
    const kind = $("[data-preview-kind]");
    const branch = $("[data-preview-branch]");
    const logo = $<HTMLImageElement>("[data-preview-logo]");
    const source = form.querySelector<HTMLImageElement>('[data-photo-field]:has([name="image"]) [data-photo-preview]');

    const paint = () => {
      const data = new FormData(form);
      const n = String(data.get("name") ?? "").trim();
      name.textContent = n || "Tu negocio";
      monogram.textContent = (n || "Tu negocio").split(/\s+/).slice(0, 2).map((w) => w[0] ?? "").join("").toUpperCase();
      kind.textContent = form.querySelector<HTMLInputElement>('[name="kind"]:checked')?.dataset.kindLabel ?? "";
      branch.textContent = String(data.get("branchName") ?? "").trim() || "Sucursal";
    };
    form.addEventListener("input", paint);
    form.addEventListener("change", paint);
    paint();

    if (source) {
      const sync = () => {
        logo.hidden = source.hidden || !source.getAttribute("src");
        if (!logo.hidden) logo.src = source.src;
        monogram.hidden = !logo.hidden;
      };
      new MutationObserver(sync).observe(source, { attributes: true, attributeFilter: ["src", "hidden"] });
    }
  }
</script>

<style>
  .first {
    max-width: 68rem;
    margin: 0 auto;
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  .intro {
    max-width: 40rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    color: var(--color-text-muted);
    font-weight: var(--font-semibold);
  }

  .intro h1 {
    margin: 0 0 0.5rem;
    font-size: var(--text-display);
    line-height: var(--text-display-lh, 1.05);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.035em;
  }

  .intro p:last-child {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .steps {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  .step {
    display: grid;
    gap: 1rem;
  }

  .step-head {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .step-head h2 {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.02em;
  }

  .step-head p {
    margin: 0.125rem 0 0;
    color: var(--color-text-muted);
  }

  .step-n {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.125rem;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-surface);
    font-weight: var(--font-extrabold);
  }

  .step-body {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
  }

  /* Dentro de la superficie elevada, los campos bajan un tono para no perderse. */
  .step-body :global(.input) {
    background: var(--color-surface);
  }

  /* La fachada en 16:9 a todo el ancho se come la pantalla: con el ancho de una tarjeta alcanza. */
  .step-body :global([data-photo-field]:not(.square) .photo-preview) {
    max-width: 22rem;
  }

  .identity {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .identity-fields {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .kinds {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .kinds legend {
    padding: 0;
    margin-bottom: 0.25rem;
  }

  .kinds .field-hint {
    margin: 0;
  }

  .kind-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }

  .kind {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }

  .kind:hover {
    border-color: var(--color-text-muted);
  }

  .kind input {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--color-primary);
  }

  .kind :global(svg) {
    color: var(--color-text-muted);
  }

  .kind-label {
    font-weight: var(--font-bold);
  }

  .kind-hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .kind:has(input:checked) {
    border-color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  .kind:has(input:checked) :global(svg) {
    color: var(--color-primary);
  }

  .kind:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .submit {
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }

  .submit .notice:empty {
    display: none;
  }

  .submit .btn {
    min-width: 12rem;
  }

  .aside {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .aside-label {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .preview {
    padding: 0.75rem 0.75rem 1rem;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
  }

  .preview-art {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: 0.375rem;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-primary) 70%, var(--color-surface)),
      color-mix(in oklab, var(--color-primary) 25%, var(--color-surface))
    );
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.4);
  }

  .preview-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-surface);
  }

  .preview-monogram {
    position: absolute;
    left: 0.875rem;
    bottom: 0.625rem;
    color: var(--color-text);
    font-size: 3rem;
    line-height: 1;
    font-weight: var(--font-extrabold);
    letter-spacing: -0.04em;
  }

  .preview-name {
    margin: 0;
    overflow-wrap: anywhere;
    font-weight: var(--font-bold);
  }

  .preview-meta {
    margin: 0.125rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .next ol {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: next;
  }

  .next li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: 0.625rem;
    counter-increment: next;
  }

  .next li::before {
    content: counter(next);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
  }

  .next-title {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  .next-note,
  .invite {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .invite {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    /* En una columna la vista previa sobra: queda lo que viene después, al final. */
    .aside {
      position: static;
    }

    .preview {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .identity {
      grid-template-columns: minmax(0, 1fr);
    }

    .submit .btn {
      width: 100%;
    }

    .kind-options {
      grid-template-columns: minmax(0, 1fr);
    }

    /* El logo chico junto a su botón, como en Tu cuenta. */
    .identity :global(.cover .photo-row) {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
    }

    .identity :global(.cover .photo-preview) {
      width: 5rem;
    }
  }
</style>
