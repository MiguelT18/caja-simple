---
/*
 * El script que actualiza la página con los avisos del negocio (src/scripts/live.ts) y el anuncio para lectores de
 * pantalla. Sin indicador visible: un «En vivo» hacía pensar que la sucursal estaba abierta.
 * Los montos marcados con data-live="<clave>" data-amount data-sign cuentan hasta el valor nuevo y se resaltan;
 * los <time data-ago> se reescriben cada 30 s. Con `branch`, solo cuentan los avisos de esa sucursal.
 */

interface Props {
  /** «negocio:<id>». */
  topic: string;
  /** id de sucursal → nombre, para el anuncio. */
  names: Record<string, string>;
  /** Regiones (data-region) que se actualizan. */
  regions: string[];
  branch?: string;
}

const { topic, names, regions, branch } = Astro.props;
---

<div data-live-topic={topic} data-branch-names={JSON.stringify(names)} data-live-regions={regions.join(",")} data-live-branch={branch}>
  <p class="sr-only" aria-live="polite" data-live-announce></p>
</div>

<script>
  import { ago } from "@/scripts/live-core";
  import { watchLive } from "@/scripts/live";
  import { formatBs } from "@/lib/format";

  const bar = document.querySelector<HTMLElement>("[data-live-topic]");
  if (bar) {
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const announce = bar.querySelector<HTMLElement>("[data-live-announce]")!;
    // Los «hace X min» de la página se reescriben solos.
    const paint = () => {
      for (const el of document.querySelectorAll<HTMLElement>("[data-ago]")) el.textContent = ago(Date.now() - Number(el.dataset.ago));
    };
    setInterval(paint, 30_000);

    // Montos antes de actualizar: lo que cambió cuenta hasta el valor nuevo y se resalta un momento.
    let before = new Map<string, number>();
    const amounts = () => new Map([...document.querySelectorAll<HTMLElement>("[data-live]")].map((el) => [el.dataset.live!, Number(el.dataset.amount)]));
    const tween = (el: HTMLElement, from: number, to: number) => {
      const sign = el.dataset.sign as "+" | "−" | undefined;
      const start = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - start) / 400);
        el.textContent = formatBs(from + (to - from) * (1 - (1 - k) ** 3), sign);
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    watchLive({
      topic: bar.dataset.liveTopic!,
      regions: bar.dataset.liveRegions!.split(","),
      names: JSON.parse(bar.dataset.branchNames ?? "{}"),
      branch: bar.dataset.liveBranch,
      onStatus: paint,
      onAnnounce: (message) => {
        // Vaciar y volver a poner: el lector repite el aviso aunque sea igual al anterior.
        announce.textContent = "";
        setTimeout(() => (announce.textContent = message), 50);
      },
      beforeRefresh: () => (before = amounts()),
      afterRefresh: () => {
        for (const el of document.querySelectorAll<HTMLElement>("[data-live]")) {
          const from = before.get(el.dataset.live!);
          const to = Number(el.dataset.amount);
          if (from === undefined || from === to) continue;
          el.classList.add("is-changed");
          setTimeout(() => el.classList.remove("is-changed"), 1500);
          if (!reduceMotion) tween(el, from, to);
        }
      },
    });
  }
</script>

<style>
  /* Lo que acaba de cambiar: un fondo suave que se va solo. Los montos están en la página, no aquí. */
  :global([data-live]) {
    border-radius: 0.25rem;
    transition: background-color 600ms;
  }

  :global([data-live].is-changed) {
    background: var(--color-primary-soft);
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-live]) {
      transition: none;
    }
  }
</style>
