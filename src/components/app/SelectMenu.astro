---
// Selector con menú desplegable propio y buscador: un botón con aspecto de campo y, pegada a él, una lista que se
// filtra al escribir. Para cuando un <select> se queda corto (opciones con foto o datos, listas largas).
//
//   <SelectMenu form="f" name="productId" label="Producto" options={opciones} required>
//     {(option) => <MiFila {...option} />}   ← cómo se ve cada opción (y lo elegido, en el campo)
//   </SelectMenu>
//
// Sin contenido, cada opción muestra su `label`. Manda el valor en un campo oculto `name`; los ids del botón y del
// error siguen a FormInput (`<form>-<name>`, ver scripts/action-forms.ts). Búsqueda: sin mayúsculas ni tildes, cada
// palabra al comienzo de una palabra de `label` + `keywords` (si no hay nada, en cualquier parte), y primero lo que
// empieza con lo escrito. Mismo patrón de lista que PeopleSuggest: popover fijo, debajo del campo o arriba si no cabe.
import { ChevronDown, Search } from "@lucide/astro";

export interface SelectMenuOption {
  value: string;
  label: string;
  /** Texto extra que también se busca (categoría, código…). */
  keywords?: string;
  [key: string]: unknown;
}

interface Props {
  form: string;
  name: string;
  label: string;
  options: SelectMenuOption[];
  value?: string;
  placeholder?: string;
  searchPlaceholder?: string;
  /** Qué se elige, en plural y minúscula: «productos». Para el buscador y los anuncios. */
  noun?: string;
  required?: boolean;
  /** Aviso si se manda vacío (con `required`). */
  requiredMessage?: string;
}

const {
  form,
  name,
  label,
  options,
  value = "",
  placeholder = "Elige una opción",
  searchPlaceholder = "Buscar",
  noun = "opciones",
  required = false,
  requiredMessage = "Elige una opción.",
} = Astro.props;

const id = `${form}-${name}`;
const fold = (text: string) => text.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const custom = Astro.slots.has("default");
const rows = await Promise.all(
  options.map(async (o, i) => ({
    ...o,
    optionId: `${id}-option-${i}`,
    html: custom ? await Astro.slots.render("default", [o]) : null,
  })),
);
const chosen = rows.find((o) => o.value === value);
---

<div class="field select-menu" data-select-menu data-required-message={required ? requiredMessage : undefined} data-noun={noun}>
  <span class="field-label" id={`${id}-label`}>{label}</span>
  <input type="hidden" name={name} value={chosen?.value ?? ""} data-select-value />
  <button
    type="button"
    class="input select-trigger"
    id={id}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-panel`}
    aria-labelledby={`${id}-label ${id}`}
    aria-describedby={`${id}-error`}
    data-select-trigger
  >
    <span class="select-value" data-select-shown>
      {chosen ? chosen.html ? <Fragment set:html={chosen.html} /> : chosen.label : <span class="select-placeholder">{placeholder}</span>}
    </span>
    <template data-select-placeholder><span class="select-placeholder">{placeholder}</span></template>
    <ChevronDown size={18} stroke-width={1.75} aria-hidden="true" />
  </button>
  <div class="select-panel" id={`${id}-panel`} popover="manual" data-select-panel>
    <div class="select-search">
      <Search size={16} stroke-width={1.75} aria-hidden="true" />
      <input
        type="search"
        class="input"
        placeholder={searchPlaceholder}
        aria-label={`Buscar ${noun}`}
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls={`${id}-list`}
        aria-describedby={`${id}-keys`}
        autocomplete="off"
        data-select-search
      />
    </div>
    <ul class="select-list" id={`${id}-list`} role="listbox" aria-label={label}>
      {
        rows.map((o) => (
          <li class="select-option" role="option" id={o.optionId} aria-selected="false" data-value={o.value} data-name={fold(o.label)} data-search={fold([o.label, o.keywords].filter(Boolean).join(" "))}>
            <span class="select-option-body">{o.html ? <Fragment set:html={o.html} /> : o.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="select-empty" hidden data-select-empty></p>
    <p class="sr-only" aria-live="polite" data-select-status></p>
    <p class="sr-only" id={`${id}-keys`}>Con las flechas arriba y abajo eliges y con Enter confirmas.</p>
  </div>
  <p class="field-error" id={`${id}-error`}></p>
</div>

<script>
  // Todo va delegado en document: los formularios entran y salen con las regiones y el ClientRouter.
  const fold = (text: string) => text.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  const parts = (root: Element) => {
    const menu = root.closest<HTMLElement>("[data-select-menu]")!;
    return {
      menu,
      value: menu.querySelector<HTMLInputElement>("[data-select-value]")!,
      trigger: menu.querySelector<HTMLButtonElement>("[data-select-trigger]")!,
      shown: menu.querySelector<HTMLElement>("[data-select-shown]")!,
      panel: menu.querySelector<HTMLElement>("[data-select-panel]")!,
      search: menu.querySelector<HTMLInputElement>("[data-select-search]")!,
      list: menu.querySelector<HTMLElement>('[role="listbox"]')!,
      empty: menu.querySelector<HTMLElement>("[data-select-empty]")!,
      status: menu.querySelector<HTMLElement>("[data-select-status]")!,
      error: menu.querySelector<HTMLElement>(".field-error")!,
    };
  };
  type Parts = ReturnType<typeof parts>;
  const isOpen = (p: Parts) => p.panel.matches(":popover-open");
  const visible = (p: Parts) => [...p.list.querySelectorAll<HTMLElement>('[role="option"]:not([hidden])')];
  let opened: Parts | null = null;

  function highlight(p: Parts, option: HTMLElement | undefined) {
    p.list.querySelectorAll('[aria-selected="true"]').forEach((el) => el.setAttribute("aria-selected", "false"));
    if (!option) return p.search.removeAttribute("aria-activedescendant");
    option.setAttribute("aria-selected", "true");
    p.search.setAttribute("aria-activedescendant", option.id);
    option.scrollIntoView({ block: "nearest" });
  }

  function filter(p: Parts) {
    const typed = p.search.value.trim();
    const q = fold(typed);
    const words = q.split(/\s+/).filter(Boolean);
    const options = [...p.list.querySelectorAll<HTMLElement>('[role="option"]')];
    const by = (test: (hay: string, w: string) => boolean) => options.filter((o) => words.every((w) => test(" " + o.dataset.search!, w)));
    let matches = by((hay, w) => hay.includes(" " + w));
    if (!matches.length) matches = by((hay, w) => hay.includes(w));
    const rank = (o: HTMLElement) => (o.dataset.name!.startsWith(q) ? 0 : (" " + o.dataset.name).includes(" " + words[0]) ? 1 : 2);
    const byName = (a: HTMLElement, b: HTMLElement) => a.dataset.name!.localeCompare(b.dataset.name!);
    options.forEach((o) => (o.hidden = !matches.includes(o)));
    p.list.append(...(words.length ? matches.sort((a, b) => rank(a) - rank(b) || byName(a, b)) : options.sort(byName)));
    p.empty.hidden = matches.length > 0;
    p.empty.textContent = `Nada coincide con «${typed}».`;
    p.status.textContent = words.length ? `${matches.length} ${matches.length === 1 ? "resultado" : "resultados"}` : "";
    const current = p.list.querySelector<HTMLElement>(`[role="option"][data-value="${CSS.escape(p.value.value)}"]`);
    highlight(p, words.length ? matches[0] : (current ?? matches[0]));
  }

  // Debajo del campo; si no cabe, arriba. Se vuelve a calcular al desplazar: la lista es fija y el campo se mueve.
  function place(p: Parts) {
    const rect = p.trigger.getBoundingClientRect();
    // Si el campo salió de la vista (desplazado fuera del diálogo o de la página), la lista se cierra.
    const box = (p.trigger.closest("dialog") ?? document.documentElement).getBoundingClientRect();
    if (rect.bottom < Math.max(box.top, 0) || rect.top > Math.min(box.bottom, innerHeight)) return close(p);
    p.panel.style.left = `${Math.max(8, Math.min(rect.left, innerWidth - rect.width - 8))}px`;
    p.panel.style.width = `${Math.min(rect.width, innerWidth - 16)}px`;
    const height = p.panel.offsetHeight;
    const below = rect.bottom + 4 + height <= innerHeight || rect.top - 4 - height < 0;
    p.panel.style.top = `${below ? rect.bottom + 4 : rect.top - 4 - height}px`;
  }

  function open(p: Parts) {
    if (isOpen(p)) return;
    if (opened && opened.menu !== p.menu) close(opened);
    p.search.value = "";
    p.panel.showPopover();
    filter(p);
    place(p);
    p.trigger.setAttribute("aria-expanded", "true");
    p.search.focus();
    opened = p;
  }

  function close(p: Parts, focusTrigger = false) {
    if (isOpen(p)) p.panel.hidePopover();
    p.trigger.setAttribute("aria-expanded", "false");
    p.search.removeAttribute("aria-activedescendant");
    if (focusTrigger) p.trigger.focus();
    if (opened?.menu === p.menu) opened = null;
  }

  function choose(p: Parts, option: HTMLElement) {
    p.value.value = option.dataset.value!;
    p.shown.replaceChildren(option.querySelector(".select-option-body")!.cloneNode(true));
    p.trigger.removeAttribute("aria-invalid");
    p.error.textContent = "";
    p.value.dispatchEvent(new Event("change", { bubbles: true }));
    close(p, true);
  }

  function clear(p: Parts) {
    p.value.value = "";
    p.shown.replaceChildren(p.menu.querySelector<HTMLTemplateElement>("[data-select-placeholder]")!.content.cloneNode(true));
    close(p);
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const trigger = target.closest("[data-select-trigger]");
    if (trigger) {
      const p = parts(trigger);
      return isOpen(p) ? close(p) : open(p);
    }
    const option = target.closest<HTMLElement>('[data-select-menu] [role="option"]');
    if (option) choose(parts(option), option);
  });
  // El clic en una opción no le quita el foco al buscador (si no, el blur cerraría la lista antes del clic).
  document.addEventListener("mousedown", (event) => {
    if ((event.target as Element).closest('[data-select-menu] [role="option"]')) event.preventDefault();
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target as Element;
    if (target.matches("[data-select-trigger]") && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
      event.preventDefault();
      return open(parts(target));
    }
    if (!target.matches("[data-select-search]")) return;
    const p = parts(target);
    const list = visible(p);
    const at = list.findIndex((o) => o.getAttribute("aria-selected") === "true");
    const go = (i: number) => (event.preventDefault(), highlight(p, list[i]));
    if (event.key === "ArrowDown" && list.length) go((at + 1) % list.length);
    else if (event.key === "ArrowUp" && list.length) go((at - 1 + list.length) % list.length);
    else if (event.key === "PageDown" && list.length) go(Math.min(at + 5, list.length - 1));
    else if (event.key === "PageUp" && list.length) go(Math.max(at - 5, 0));
    else if (event.key === "Enter") {
      event.preventDefault();
      if (at >= 0) choose(p, list[at]);
    } else if (event.key === "Escape") {
      // Cierra solo la lista, no el diálogo.
      event.preventDefault();
      event.stopPropagation();
      close(p, true);
    } else if (event.key === "Tab") close(p);
  });

  document.addEventListener("input", (event) => {
    const target = event.target as Element;
    if (target.matches("[data-select-search]")) filter(parts(target));
  });

  document.addEventListener("focusout", (event) => {
    const target = event.target as Element;
    if (!target.matches("[data-select-search]")) return;
    const p = parts(target);
    setTimeout(() => !p.panel.contains(document.activeElement) && close(p));
  });

  // Se desplaza el diálogo o la página: la lista sigue al campo (no la lista misma, que también se desplaza).
  let frame = 0;
  const follow = (event: Event) => {
    if (!opened || opened.panel.contains(event.target as Node)) return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => opened && place(opened));
  };
  document.addEventListener("scroll", follow, { capture: true, passive: true });
  addEventListener("resize", follow);

  // Obligatorio y vacío: no se manda, el aviso queda junto al campo.
  addEventListener(
    "submit",
    (event) => {
      const form = event.target as HTMLFormElement;
      const missing = [...form.querySelectorAll<HTMLElement>("[data-select-menu][data-required-message]")].map(parts).find((p) => !p.value.value);
      if (!missing) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      missing.trigger.setAttribute("aria-invalid", "true");
      missing.error.textContent = missing.menu.dataset.requiredMessage!;
      missing.trigger.focus();
    },
    true,
  );
  // reset no toca los campos ocultos: lo elegido se borra a mano. Al cerrar el diálogo, la lista también se cierra.
  document.addEventListener("reset", (event) => (event.target as Element).querySelectorAll?.("[data-select-menu]").forEach((el) => clear(parts(el))));
  document.addEventListener("close", (event) => (event.target as Element).querySelectorAll?.("[data-select-menu]").forEach((el) => close(parts(el))), true);
</script>

<style>
  .select-trigger {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    text-align: start;
    cursor: pointer;
  }

  .select-trigger > :global(svg) {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 150ms var(--ease-out);
  }

  .select-trigger[aria-expanded="true"] > :global(svg) {
    transform: rotate(180deg);
  }

  .select-value {
    flex: 1;
    min-width: 0;
  }

  .select-placeholder {
    color: var(--color-text-muted);
  }

  .select-panel {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  .select-search {
    position: relative;
    padding: 0.25rem 0.25rem 0.5rem;
  }

  .select-search > :global(svg) {
    position: absolute;
    top: 50%;
    left: 0.875rem;
    color: var(--color-text-muted);
    transform: translateY(calc(-50% - 0.125rem));
    pointer-events: none;
  }

  .select-search .input {
    padding-left: 2.25rem;
  }

  .select-list {
    max-height: min(20rem, 50vh);
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  .select-option {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .select-option:hover,
  .select-option[aria-selected="true"] {
    background: var(--color-surface-muted);
  }

  /* La opción activa con el teclado: además del fondo, una barra (no solo color). */
  .select-option[aria-selected="true"] {
    box-shadow: inset 3px 0 0 var(--color-primary);
  }

  .select-menu :global(.select-option-body) {
    display: block;
    flex: 1;
    min-width: 0;
  }

  .select-empty {
    margin: 0;
    padding: 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
