---
// Precio de un plan como pide docs/planes-de-suscripcion.md: «US$ 5,50 + impuestos · hoy Bs 79».
import { priceOf, type Period, type PlanName, type Quote } from "@/data/plans";

interface Props {
  plan: PlanName;
  period: Period;
  quote: Quote | null;
}

const { plan, period, quote } = Astro.props;
const price = priceOf(plan, period, quote);
---

<p class="plan-price" data-region={`price-${plan}`}>
  <span class="usd num">{price.usd}</span>
  <span class="detail">{price.detail}</span>
  {price.today && <span class="today num">{price.today}</span>}
</p>

<style>
  .plan-price {
    display: grid;
    gap: 0.125rem;
    margin: 1rem 0 0;
  }

  .usd {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .detail {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .today {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
</style>
