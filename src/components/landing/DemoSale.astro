---
// Turno mañana (ejemplo): registrar una venta como en «Registrar venta». Pasos en data-at / data-tap; ver demo-play.ts.
// Leche ×2 explica el «quedan 3» de la tarde.
import { CircleCheck } from "@lucide/astro";
import MiniDemo from "./MiniDemo.astro";
import { formatBs } from "@/lib/format";

const total = 31.5;
const totalKeys = "7@1,14@2,26.5@3,31.5@4";
//              idle, leche, leche, mantequilla, galletas, cómo paga, efectivo, cobrar, registrada
const steps = [500, 650, 650, 650, 650, 600, 600, 600, 900];
---

<MiniDemo
  title="Registrar venta"
  label="Ejemplo de venta registrada"
  summary={`Ejemplo: venta de Leche 1 L ×2, Mantequilla 200 g ×1 y Galletas ×1 por ${formatBs(total, "+")}, cobrada en efectivo. Venta registrada.`}
  steps={steps}
>
  <ul class="picks" role="list">
    <li class="pick" data-tap="1 2"><span>Leche 1 L</span><span class="num">Bs 7,00</span></li>
    <li class="pick" data-tap="3"><span>Mantequilla 200 g</span><span class="num">Bs 12,50</span></li>
    <li class="pick" data-tap="4"><span>Galletas</span><span class="num">Bs 5,00</span></li>
  </ul>

  <p class="cart-title">Venta actual</p>
  <ul class="lines" role="list">
    <li data-at="1">
      <span>Leche 1 L <span class="stack qty num"><span data-at="1" data-until="2">×1</span><span data-at="2">×2</span></span></span>
      <span class="num" data-demo-count="14@2" data-from="7">Bs 14,00</span>
    </li>
    <li data-at="3"><span>Mantequilla 200 g <span class="qty num">×1</span></span><span class="num">Bs 12,50</span></li>
    <li data-at="4"><span>Galletas <span class="qty num">×1</span></span><span class="num">Bs 5,00</span></li>
  </ul>

  <div class="pay" data-at="5">
    <span class="fake-label">Cómo paga</span>
    <span class="options">
      <span class="option is-checked" data-tap="6"><span class="radio"></span>Efectivo</span>
      <span class="option"><span class="radio"></span>QR</span>
    </span>
  </div>

  <p class="lines-total"><span>Total</span><span class="num amount-income" data-demo-count={totalKeys} data-sign="+">{formatBs(total, "+")}</span></p>

  <div class="stack foot">
    <span class="btn btn-primary btn-block fake-btn" data-at="0" data-until="8" data-tap="7">
      <span>Cobrar <span class="num" data-demo-count={totalKeys}>{formatBs(total)}</span></span>
    </span>
    <p class="status-ok" data-at="8"><CircleCheck size={18} stroke-width={2} />Venta registrada · Efectivo</p>
  </div>
</MiniDemo>

<style>
  .picks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .pick {
    position: relative;
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-medium);
  }

  .pick .num {
    color: var(--color-text-muted);
  }

  .cart-title {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
    font-weight: var(--font-semibold);
  }

  .lines {
    min-height: calc(3 * var(--text-sm-lh) + 1rem);
  }

  .pay {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .pay .fake-label {
    margin: 0;
  }

  .options {
    display: flex;
    gap: 0.5rem;
  }

  .option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
  }

  .option.is-checked {
    border-color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  /* La opción elegida se ve en el punto relleno, no solo en el color del borde. */
  .radio {
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
  }

  .is-checked .radio {
    border: 3.5px solid var(--color-primary);
  }

  .qty.stack {
    display: inline-grid;
  }

  .foot {
    margin-top: 1rem;
  }
</style>
