---
/*
 * Tarjeta de un turno en «Un día en el local»: una mini pantalla de la app que se opera sola (src/scripts/demo-play.ts).
 * El contenido es decorativo (aria-hidden); `summary` dice a los lectores de pantalla cómo termina.
 * Sin JS o con movimiento reducido se ve el estado final, que es lo que trae el HTML.
 */
import { RotateCcw } from "@lucide/astro";

interface Props {
  title: string;
  label: string;
  summary: string;
  /** Duración de cada paso, en ms. */
  steps: number[];
}

const { title, label, summary, steps } = Astro.props;
---

<figure class="demo mini" aria-label={label} data-demo data-steps={steps.join(",")}>
  <figcaption class="demo-head">
    <span class="demo-title">{title}</span>
    <span class="mini-tools">
      <button type="button" class="replay" data-replay hidden>
        <RotateCcw size={14} stroke-width={1.75} aria-hidden="true" /><span class="replay-text">Ver de nuevo</span>
      </button>
      <span class="sample">Ejemplo</span>
    </span>
  </figcaption>
  <p class="sr-only">{summary}</p>
  <div class="mini-body" aria-hidden="true">
    <slot />
  </div>
</figure>

<style>
  /* Alto reservado para «Ver de nuevo»: la cabecera no crece cuando aparece. */
  .mini-tools {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.75rem;
  }

  .demo-title {
    min-width: 0;
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 1.75rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-medium);
    cursor: pointer;
  }

  .replay:hover {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .replay[hidden] {
    display: none;
  }

  /* En el celular queda solo el ícono, con el texto para lectores de pantalla: así el título no se parte. */
  @media (max-width: 480px) {
    .replay {
      justify-content: center;
      min-width: 1.75rem;
      padding: 0;
    }
    .replay-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Las hojas (cobrar, gasto, cierre) se abren encima del contenido: la tarjeta no cambia de alto. */
  .mini-body {
    position: relative;
  }
</style>

<style is:global>
  /*
   * Piezas compartidas por las tres tarjetas (Demo*.astro): líneas, total, avisos y la mecánica de la animación.
   * Van globales porque el contenido llega por <slot> desde cada tarjeta.
   */
  .mini .lines {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mini .lines > li,
  .mini .lines > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mini .lines dt {
    color: var(--color-text-muted);
  }

  .mini .lines dd {
    margin: 0;
  }

  .mini .qty {
    color: var(--color-text-muted);
  }

  .mini .lines-total {
    display: flex;
    justify-content: space-between;
    margin: 1rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-semibold);
  }

  .mini :is(.status-ok, .stock-alert) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    font-weight: var(--font-semibold);
  }

  .mini .status-ok {
    background: var(--color-income-soft);
    color: var(--color-income);
  }

  .mini .stock-alert {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }

  /* Botones de mentira: la forma de .btn sin ser interactivos. */
  .mini .fake-btn {
    position: relative;
    pointer-events: none;
    font-size: var(--text-sm);
    min-height: 2.5rem;
  }

  /* Campo de mentira, como .input de la app. */
  .mini .fake-label {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-medium);
  }

  .mini .fake-input {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }

  /* Cursor de texto tras lo que se está tipeando. */
  .mini .is-typing::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.15em;
    background: var(--color-text);
  }

  /* Hoja que sube desde abajo, como los modales de la app en el celular. */
  .mini .sheet {
    position: absolute;
    inset: auto -0.5rem -0.5rem;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .mini .sheet-title {
    margin: 0;
    font-weight: var(--font-semibold);
  }

  /* Dos piezas en la misma celda: una se va y la otra llega sin mover nada. */
  .mini .stack {
    display: grid;
  }

  .mini .stack > * {
    grid-area: 1 / 1;
  }

  /* Lo transitorio (hojas, el botón que se va) no se ve sin JS: el estado final no lo tiene. */
  .mini [data-until]:not(.is-on) {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mini.is-playable [data-at] {
      transition:
        opacity 350ms cubic-bezier(0.16, 1, 0.3, 1),
        translate 350ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 350ms;
    }

    .mini.is-playable .is-off {
      opacity: 0;
      translate: 0 0.375rem;
    }

    .mini.is-playable .sheet:not(.is-on) {
      translate: 0 1.5rem;
    }

    /* El toque: un círculo suave que se encoge sobre lo tocado (se vende desde el celular, no con mouse). */
    .mini .is-tap {
      animation: press 450ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mini .is-tap::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 2.75rem;
      height: 2.75rem;
      margin: -1.375rem 0 0 -1.375rem;
      border: 2px solid var(--shift, var(--color-primary));
      border-radius: 50%;
      background: var(--shift-soft, var(--color-primary-soft));
      pointer-events: none;
      animation: touch 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }

  @keyframes press {
    40% {
      scale: 0.96;
    }
  }

  @keyframes touch {
    from {
      opacity: 0.9;
      scale: 1.3;
    }
    50% {
      opacity: 0.8;
      scale: 0.8;
    }
    to {
      opacity: 0;
      scale: 0.9;
    }
  }
</style>
