---
import { Bell, PackageMinus, TriangleAlert, UserCheck, UserPlus, UserX } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import { inbox } from "@/data/queries";
import type { Notification } from "@/data/types";
import { formatBs } from "@/lib/format";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
const { notifications, unread } = inbox(Astro.locals);

const when = (iso: string) =>
  new Intl.DateTimeFormat("es-BO", { timeZone: "America/La_Paz", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(
    new Date(iso),
  );

function describe(n: Notification) {
  switch (n.kind) {
    case "invitation": {
      const { owner, business, jobTitle, branch, shift } = n.data;
      return {
        icon: UserPlus,
        title: `${owner} te invitó a ${business}`,
        detail: [jobTitle, branch, shift && `turno ${shift}`].filter(Boolean).join(" · "),
      };
    }
    case "invitation_answer":
      return n.data.accepted
        ? { icon: UserCheck, title: `${n.data.person} aceptó tu invitación`, detail: `Ya está en ${n.data.business}` }
        : { icon: UserX, title: `${n.data.person} rechazó tu invitación`, detail: n.data.business };
    case "cash_mismatch":
      return {
        icon: TriangleAlert,
        title: `Caja descuadrada en ${n.data.branch}`,
        detail: `Turno ${n.data.shift}: ${formatBs(n.data.difference)} de diferencia`,
        tone: "warning",
      };
    case "low_stock":
      return {
        icon: PackageMinus,
        title: `Stock bajo: ${n.data.product}`,
        detail: `Quedan ${n.data.stock} en ${n.data.branch} (mínimo ${n.data.minStock})`,
        tone: "warning",
      };
  }
}

const label = unread === 0 ? "Notificaciones" : `Notificaciones, ${unread} sin leer`;
---

<div class:list={["bell", className]} data-bell {...rest}>
  <button type="button" class="icon-btn bell-trigger" popovertarget="notifications" aria-expanded="false" aria-label={label} title={label}>
    <Bell size={18} stroke-width={1.75} />
    {unread > 0 && <span class="bell-count" aria-hidden="true">{unread > 9 ? "9+" : unread}</span>}
  </button>

  <div id="notifications" class="bell-panel" popover>
    <header class="bell-head">
      <h2>Notificaciones</h2>
      {
        unread > 0 && (
          <form data-action="markNotificationsRead">
            <button type="submit" class="bell-link">
              Marcar todo como leído
            </button>
          </form>
        )
      }
    </header>

    {
      notifications.length === 0 ? (
        <p class="bell-empty">
          No tienes avisos. Aquí te llegan las invitaciones a un negocio y, si eres dueña, los descuadres de caja y el stock bajo.
        </p>
      ) : (
        <ul class="bell-list" role="list">
          {notifications.map((n) => {
            const { icon: Icon, title, detail, tone } = describe(n);
            return (
              <li class:list={["bell-item", { unread: !n.read }]}>
                <span class:list={["bell-icon", tone]} aria-hidden="true">
                  <Icon size={16} stroke-width={1.75} />
                </span>
                <div class="bell-body">
                  <p class="bell-title">
                    {!n.read && <span class="sr-only">Sin leer: </span>}
                    {title}
                  </p>
                  {detail && <p class="bell-detail">{detail}</p>}
                  <p class="bell-time">{when(n.createdAt)}</p>
                  {n.kind === "invitation" &&
                    (n.pending ? (
                      <div class="bell-actions">
                        <form data-action="respondInvitation" data-redirect="/app">
                          <input type="hidden" name="employeeId" value={n.employeeId} />
                          <input type="hidden" name="accept" value="true" />
                          <button type="submit" class="btn btn-primary">
                            Aceptar
                          </button>
                        </form>
                        <form data-action="respondInvitation" data-confirm={`¿Rechazar la invitación a ${n.data.business}?`}>
                          <input type="hidden" name="employeeId" value={n.employeeId} />
                          <input type="hidden" name="accept" value="false" />
                          <button type="submit" class="btn btn-secondary">
                            Rechazar
                          </button>
                        </form>
                      </div>
                    ) : (
                      <p class="bell-detail">Aceptaste esta invitación.</p>
                    ))}
                </div>
                {!n.read && <span class="bell-dot" aria-hidden="true" />}
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-bell]").forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>(".bell-trigger")!;
    const panel = root.querySelector<HTMLElement>(".bell-panel")!;

    // Abre bajo la campana sin salirse de la pantalla; en móvil ocupa el ancho con 16px de margen.
    function position() {
      const rect = trigger.getBoundingClientRect();
      const width = Math.min(352, window.innerWidth - 32);
      panel.style.width = `${width}px`;
      panel.style.top = `${rect.bottom + 8}px`;
      panel.style.left = `${Math.max(16, Math.min(rect.left, window.innerWidth - width - 16))}px`;
    }

    panel.addEventListener("beforetoggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      trigger.setAttribute("aria-expanded", String(open));
      if (open) position();
    });

    window.addEventListener("resize", () => panel.hidePopover());
  });
</script>

<style>
  .bell {
    display: contents;
  }

  .bell-trigger {
    position: relative;
  }

  /* El número dice cuántos hay; el color solo lo refuerza. */
  .bell-count {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0 0.25rem;
    border: 2px solid var(--color-surface);
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-bold);
    line-height: 0.875rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .bell-panel {
    position: fixed;
    inset: auto;
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 0;
    padding: 0;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(-0.375rem) scale(0.97);
    transform-origin: top left;
    transition:
      opacity 150ms ease-in,
      transform 150ms ease-in,
      overlay 150ms ease-in allow-discrete,
      display 150ms ease-in allow-discrete;
  }

  .bell-panel:popover-open {
    opacity: 1;
    transform: none;
    transition-duration: 200ms;
    transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @starting-style {
    .bell-panel:popover-open {
      opacity: 0;
      transform: translateY(-0.375rem) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bell-panel {
      transition: none;
    }
  }

  .bell-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .bell-head h2 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
  }

  .bell-link {
    padding: 0;
    border: none;
    background: none;
    color: var(--color-primary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    cursor: pointer;
  }

  .bell-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .bell-empty {
    margin: 0;
    padding: 1.25rem 1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .bell-list {
    margin: 0;
    padding: 0.25rem 0;
  }

  .bell-item {
    position: relative;
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem 2rem 0.75rem 1rem;
  }

  .bell-item + .bell-item {
    border-top: 1px solid var(--color-border);
  }

  .bell-item.unread {
    background: color-mix(in srgb, var(--color-primary-soft) 55%, transparent);
  }

  .bell-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
  }

  .bell-icon.warning {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }

  .bell-body {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .bell-body p {
    margin: 0;
  }

  .bell-title {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-medium);
  }

  .unread .bell-title {
    font-weight: var(--font-semibold);
  }

  .bell-detail,
  .bell-time {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .bell-time {
    font-size: var(--text-xs);
  }

  .bell-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .bell-actions .btn {
    min-height: 2.25rem;
    padding-inline: 0.875rem;
    font-size: var(--text-sm);
  }

  .bell-dot {
    position: absolute;
    top: 1.125rem;
    right: 1rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
