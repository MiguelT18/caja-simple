---
interface Props {
  class?: string;
}

// `rest` lleva el atributo de scope de Astro para que los estilos del padre lleguen al SVG.
const { class: className, ...rest } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" {...rest}>
  <rect width="32" height="32" rx="8" fill="currentColor"></rect>
  <path
    d="M8 13h16v11H8zm2-4h12v4H10zm6 8v4"
    fill="none"
    stroke="var(--color-surface)"
    stroke-width="2"
    stroke-linejoin="round"></path>
</svg>
