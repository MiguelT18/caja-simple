---
// Calculadora del precio según la cantidad de locales: stepper y, debajo, la cuenta a la vista (base + extras = total),
// en US$ y, con tipo de cambio, «hoy Bs …». La usan /planes y /app/[negocio]/plan.
// La cuenta es la misma del cobro (usdFor y bsTotal, src/data/plans.ts).
import { Minus, Plus, RotateCcw } from "@lucide/astro";
import type { Period, Quote } from "../data/plans";
import { shortDate, today } from "../lib/dates";

interface Props {
  // Locales con los que arranca (en la app, las sucursales que ya tiene el negocio).
  branches?: number;
  /** En la app: las sucursales que tiene hoy el negocio. Si se cambia el número, ofrece volver a él. */
  current?: number;
  /** En la app: no se paga por menos locales de los que ya tiene el negocio. */
  min?: number;
  /** Para que el número de locales vaya en un formulario (el del cobro). */
  name?: string;
  form?: string;
  /** Precio fundador (0,5 = 50%): el total va con descuento y se muestra el de antes. */
  discount?: number;
  /** Meses de fundador que le quedan: en el anual, el descuento cubre solo esos (de 12). */
  founderMonths?: number;
  /** Nombre del descuento: «Precio fundador» o, en el primer cobro de un negocio referido, «Descuento por recomendación». */
  discountName?: string;
  period: Period;
  quote: Quote | null;
}

const MAX = 20;
const { period, quote, current, name, form, discount = 0, founderMonths = 12, discountName = "Precio fundador" } = Astro.props;
const min = Math.min(MAX, Math.max(1, Astro.props.min ?? 1));
const branches = Math.min(MAX, Math.max(min, Astro.props.branches ?? 1));
const per = period === "mensual" ? "al mes" : "al año";
// El total en Bs sale de este tipo de cambio (el del BCB de hoy o, si aún no llegó, el último).
const rateText = quote
  ? `Tipo de cambio ${quote.rateDate === today() ? "de hoy" : `del ${shortDate(quote.rateDate)}`}: Bs ${quote.rate.toLocaleString("es-BO", { minimumFractionDigits: 2, maximumFractionDigits: 4 })} por US$ 1 (BCB).`
  : "Todavía no tenemos el tipo de cambio de hoy: el total en bolivianos aparece apenas llegue.";
---

<section class="calc" aria-labelledby="calc-title" data-branches={branches} data-current={current} data-min={min} data-discount={discount} data-founder-months={founderMonths} data-discount-name={discountName} data-max={MAX} data-period={period} data-quote={quote ? JSON.stringify(quote) : ""}>
  <div class="calc-input">
    <div class="calc-head">
      <h2 id="calc-title" class="calc-title"><label for="calc-branches">¿Cuántos locales tienes?</label></h2>
      <p class="calc-hint">El primero va en el plan Negocio; cada local más se suma como sucursal extra.</p>
    </div>
    <div class="stepper">
      <button type="button" class="stepper-btn" data-step="-1" aria-label="Un local menos" aria-controls="calc-branches">
        <Minus size={20} stroke-width={1.75} />
      </button>
      <input
        id="calc-branches"
        class="stepper-value num"
        type="number"
        inputmode="numeric"
        min={min}
        max={MAX}
        name={name}
        form={form}
        step="1"
        value={branches}
        aria-describedby="calc-range"
      />
      <button type="button" class="stepper-btn" data-step="1" aria-label="Un local más" aria-controls="calc-branches">
        <Plus size={20} stroke-width={1.75} />
      </button>
    </div>
    <p class="calc-range" id="calc-range">{min > 1 ? `Desde ${min} (los que ya tienes) hasta ${MAX} locales` : `De 1 a ${MAX} locales`}</p>
    {
      current !== undefined && (
        <p class="calc-current" data-current-note hidden>
          Tu negocio tiene {current} {current === 1 ? "local" : "locales"}.
          <button type="button" class="calc-reset" data-reset>
            <RotateCcw size={14} stroke-width={1.75} />
            Volver a {current}
          </button>
        </p>
      )
    }
  </div>

  <div class="calc-bill">
    <dl class="bill">
      <div class="bill-row">
        <dt>Plan Negocio · 1 local</dt>
        <dd class="num" data-base></dd>
      </div>
      <div class="bill-row" data-extra-row>
        <dt data-extra-label></dt>
        <dd class="num" data-extra></dd>
      </div>
      {
        discount > 0 && (
          <div class="bill-row">
            <dt data-discount-label>{discountName} · −{Math.round(discount * 100)}%</dt>
            <dd class="num" data-discount-amount></dd>
          </div>
        )
      }
      <div class="bill-total">
        <dt data-per>Total {per}</dt>
        <dd aria-live="polite" aria-atomic="true">
          <span class="calc-price num"><span data-usd></span>{quote?.tax ? <small> + impuestos</small> : null}</span>
          <span class="calc-bs num"></span>
        </dd>
      </div>
    </dl>
    <p class="calc-rate">{rateText}</p>
    <p class="calc-detail"></p>
  </div>
</section>

<script>
  import { bsTotal, discounted, planUsd, usdFor, usdLabel, type Period, type Quote } from "../data/plans";

  for (const calc of document.querySelectorAll<HTMLElement>(".calc")) {
    const max = Number(calc.dataset.max);
    const min = Number(calc.dataset.min ?? 1);
    const discount = Number(calc.dataset.discount ?? 0);
    const discountAmount = calc.querySelector("[data-discount-amount]");
    const discountLabel = calc.querySelector("[data-discount-label]");
    const founderMonths = Number(calc.dataset.founderMonths ?? 12);
    const discountName = calc.dataset.discountName ?? "Precio fundador";
    let period = calc.dataset.period as Period;
    const quote: Quote | null = calc.dataset.quote ? JSON.parse(calc.dataset.quote) : null;
    const current = calc.dataset.current ? Number(calc.dataset.current) : undefined;
    const input = calc.querySelector<HTMLInputElement>("input")!;
    const price = calc.querySelector<HTMLElement>(".calc-price")!;
    const bs = calc.querySelector<HTMLElement>(".calc-bs")!;
    const usdText = price.querySelector("[data-usd]")!;
    const detail = calc.querySelector(".calc-detail")!;
    const base = calc.querySelector("[data-base]")!;
    const extraRow = calc.querySelector<HTMLElement>("[data-extra-row]")!;
    const extraLabel = calc.querySelector("[data-extra-label]")!;
    const extraAmount = calc.querySelector("[data-extra]")!;
    const currentNote = calc.querySelector<HTMLElement>("[data-current-note]");
    const [less, more] = calc.querySelectorAll<HTMLButtonElement>("[data-step]");
    const clamp = (n: number) => Math.min(max, Math.max(min, Math.round(n)));
    let branches = Number(calc.dataset.branches);

    const render = () => {
      input.value = String(branches);
      // aria-disabled y no disabled: en el tope el botón conserva el foco (el clic ya no cambia nada).
      less.setAttribute("aria-disabled", String(branches === min));
      more.setAttribute("aria-disabled", String(branches === max));
      // Un local: Negocio (o Gratis). Más: Sucursales, con cada local extra aparte.
      const extra = branches - 1;
      const full = usdFor(extra === 0 ? "Negocio" : "Sucursales", period, extra);
      // Anual: el precio fundador cubre solo los meses que le quedan.
      const months = period === "anual" ? founderMonths : 12;
      const usd = discounted(full, discount, months);
      if (discountLabel)
        discountLabel.textContent = `${discountName} · −${Math.round(discount * 100)}%${months < 12 ? ` en ${months} de 12 meses` : ""}`;
      if (discountAmount) discountAmount.textContent = `− ${usdLabel(Math.round((full - usd) * 100) / 100)}`;
      base.textContent = usdLabel(planUsd.base[period]);
      extraRow.hidden = extra === 0;
      extraLabel.textContent = `${extra} ${extra === 1 ? "sucursal extra" : "sucursales extra"} × ${usdLabel(planUsd.extraBranch[period])}`;
      extraAmount.textContent = usdLabel(Math.round(extra * planUsd.extraBranch[period] * 100) / 100);
      // Dólares y bolivianos al tipo de cambio de hoy (la misma cuenta del cobro); «con impuestos» solo si los hay.
      usdText.textContent = usdLabel(usd);
      bs.hidden = !quote;
      bs.textContent = quote ? `Bs ${bsTotal(usd, quote.rate, quote.tax).toLocaleString("es-BO")}${quote.tax ? " con impuestos" : ""}` : "";
      detail.textContent =
        (extra === 0 ? "Plan Negocio (o Gratis, sin pagar)." : `Plan Sucursales: ${branches} locales en total.`) +
        (discount > 0 ? ` Sin el descuento serían ${usdLabel(full)}.` : "");
      if (currentNote) currentNote.hidden = current === undefined || branches === current;
    };

    const set = (next: number) => {
      const value = clamp(next);
      if (value === branches) return render();
      branches = value;
      render();
      // Reinicia la animación del precio en cada cambio.
      price.classList.remove("tick");
      void price.offsetWidth;
      price.classList.add("tick");
    };

    // Mantener presionado − o + repite: tras una pausa, un paso cada 90 ms.
    for (const button of [less, more]) {
      const step = Number(button.dataset.step);
      let timer: ReturnType<typeof setTimeout> | undefined;
      const stop = () => clearTimeout(timer);
      const repeat = (delay: number) => {
        timer = setTimeout(() => {
          set(branches + step);
          repeat(90);
        }, delay);
      };
      button.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        set(branches + step);
        repeat(400);
      });
      for (const type of ["pointerup", "pointerleave", "pointercancel"]) button.addEventListener(type, stop);
      // Teclado (Enter o Espacio): un paso por pulsación. Los clics del puntero ya se contaron en pointerdown.
      button.addEventListener("click", (event) => {
        if (event.detail === 0) set(branches + step);
      });
    }

    // Escribir el número: se acota a min–20 al salir del campo; lo que no es número vuelve al valor de antes.
    input.addEventListener("input", () => {
      const typed = Number(input.value);
      if (input.value !== "" && Number.isFinite(typed) && typed >= min && typed <= max) set(typed);
    });
    input.addEventListener("change", () => set(input.value === "" || !Number.isFinite(Number(input.value)) ? branches : Number(input.value)));
    input.addEventListener("keydown", (event) => {
      if (event.key === "PageUp" || event.key === "PageDown") {
        event.preventDefault();
        set(branches + (event.key === "PageUp" ? 5 : -5));
      }
    });

    // Mensual/anual sin recargar (PeriodSwitch): mismos locales, precios del período nuevo.
    document.addEventListener("period:change", (event) => {
      period = (event as CustomEvent<Period>).detail;
      calc.querySelector("[data-per]")!.textContent = `Total ${period === "mensual" ? "al mes" : "al año"}`;
      render();
    });

    calc.querySelector("[data-reset]")?.addEventListener("click", () => {
      if (current !== undefined) set(current);
      input.focus();
    });
    render();
  }
</script>

<style>
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 1.5rem 2.5rem;
    align-items: start;
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
  }

  .calc-input {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .calc-head {
    display: grid;
    gap: 0.25rem;
  }

  .calc-title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    font-weight: var(--font-semibold);
  }

  .calc-hint,
  .calc-range {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  /* Un solo bloque: − | número | +. El borde marca el foco del campo. */
  .stepper {
    display: inline-grid;
    grid-template-columns: 3rem 4.5rem 3rem;
    align-items: stretch;
    height: 3rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
    overflow: hidden;
  }

  .stepper:focus-within {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .stepper-btn {
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    transition: background-color 150ms;
  }

  .stepper-btn:hover:not([aria-disabled="true"]) {
    background: var(--color-surface);
  }

  .stepper-btn:active:not([aria-disabled="true"]) {
    background: var(--color-primary-soft);
  }

  /* El anillo global queda recortado por el overflow del bloque: aquí va hacia adentro. */
  .stepper-btn:focus-visible {
    outline-offset: -3px;
  }

  .stepper-btn[aria-disabled="true"] {
    color: var(--color-text-subtle);
    cursor: not-allowed;
  }

  .stepper-value {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: none;
    border-inline: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .stepper-value::-webkit-inner-spin-button,
  .stepper-value::-webkit-outer-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .stepper-value:focus {
    outline: none;
  }

  .calc-current {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .calc-current[hidden] {
    display: none;
  }

  .calc-reset {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 1.5rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-primary);
    font: inherit;
    font-weight: var(--font-semibold);
    cursor: pointer;
  }

  .calc-reset:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* La cuenta: conceptos a la izquierda, importes alineados a la derecha. */
  .calc-bill {
    display: grid;
    gap: 0.5rem;
  }

  .bill {
    display: grid;
    margin: 0;
  }

  .bill-row,
  .bill-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .bill-row {
    padding: 0.375rem 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .bill-row[hidden] {
    display: none;
  }

  .bill-row dd {
    margin: 0;
    color: var(--color-text);
    font-weight: var(--font-medium);
  }

  .bill-total {
    margin-top: 0.375rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .bill-total dt {
    font-weight: var(--font-semibold);
  }

  .bill-total dd {
    display: grid;
    justify-items: end;
    margin: 0;
    text-align: right;
  }

  .calc-price {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--font-bold);
  }

  .calc-price small {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .calc-bs {
    color: var(--color-text);
    font-size: var(--text-xl);
    line-height: var(--text-xl-lh);
    font-weight: var(--font-bold);
  }

  .calc-bs[hidden] {
    display: none;
  }

  .calc-rate,
  .calc-detail {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  @media (prefers-reduced-motion: no-preference) {
    .calc-price.tick {
      animation: tick 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes tick {
    from {
      opacity: 0.35;
      translate: 0 0.25rem;
    }
  }

  @media (max-width: 720px) {
    .calc {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.25rem;
    }

    .calc-input {
      justify-items: stretch;
    }

    /* En el celular el stepper ocupa el ancho: botones grandes en las puntas. */
    .stepper {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem;
    }
  }
</style>
