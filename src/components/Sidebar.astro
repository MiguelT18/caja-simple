---
import { BriefcaseBusiness, GripVertical, Store } from "@lucide/astro";
import type { Branch, User } from "../data/types";
import { NAV_ORDER_COOKIE, appNav, applyNavOrder } from "../data/navigation";
import { branchColor, branchHref, branchImages, branchSections, businessHref, entryHref, founderPromo, myAffiliate, myBusinesses, type Membership } from "../data/queries";
import PromoBar from "./PromoBar.astro";
import ContextSwitcher from "./ContextSwitcher.astro";
import Logo from "./Logo.astro";
import NotificationBell from "./NotificationBell.astro";
import ThemeToggle from "./ThemeToggle.astro";
import UserCard from "./UserCard.astro";
import { plural } from "../lib/format";

interface Props {
  user: User;
  /** Negocio (y sucursal) de la página; sin él, la persona está en «Tus negocios». */
  context?: { membership: Membership; branch?: Branch };
}

const { user, context } = Astro.props;
const m = context?.membership;
const branch = context?.branch;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// Precio fundador: solo a quien tiene un negocio propio en Gratis, y no en su página de plan (ahí va el detalle).
// En Gratis o en la prueba de 30 días: los dos todavía no pagaron.
const freeOwned = myBusinesses(Astro.locals).find((other) => other.role === "dueño" && (other.business.plan === "Gratis" || other.business.trial))?.business;
const promo = freeOwned && !currentPath.endsWith("/plan") && !currentPath.includes("/cobro/") ? await founderPromo(Astro.locals.supabase).catch(() => null) : null;
const navSections = applyNavOrder(appNav(m, branch, !!myAffiliate(Astro.locals)), Astro.cookies.get(NAV_ORDER_COOKIE)?.value);

const businessOptions = myBusinesses(Astro.locals).map((other) => ({
  label: other.business.name,
  detail:
    other.role === "dueño"
      ? `Tu negocio · ${plural(other.branches.length, "sucursal", "sucursales")}`
      : ["Trabajas aquí", other.employee?.jobTitle].filter(Boolean).join(" · "),
  href: entryHref(other),
  current: other.business.id === m?.business.id,
}));

// Biblioteca de sucursales: al cambiar se queda en la misma sección (de Turnos a Turnos), si el rol la puede ver.
const section = m && branch ? currentPath.slice(branchHref(m.business, branch).length).replace(/^\//, "") : undefined;
const fallback = m?.role === "dueño" ? "" : "registrar-venta";
// Solo el dueño ve la página de sucursales: el título de la biblioteca lleva a ella.
const branchesHref = m?.role === "dueño" ? `${businessHref(m.business)}/sucursales` : undefined;
const images = m ? await branchImages(Astro.locals, m) : new Map<string, string>();
const branchLinks = m
  ? m.branches.map((other) => ({
      name: other.name,
      detail: other.address || (m.role === "dueño" ? "Sucursal" : (m.employee?.jobTitle ?? "Sucursal")),
      color: branchColor(m, other.id),
      image: images.get(other.id),
      href: branchHref(m.business, other, section !== undefined && branchSections(m.role).includes(section) ? section : fallback),
      current: other.id === branch?.id,
    }))
  : [];
---

<div class="sidebar" style="view-transition-name: sidebar">
  <header class="sidebar-header">
    <a href={m ? entryHref(m) : "/app"} class="brand">
      <Logo class="logo" />
      <span class="brand-text">
        <span class="brand-name">Caja Simple</span>
        <span class="brand-tagline">Tu negocio, bajo control</span>
      </span>
    </a>

    <div class="header-actions">
      <NotificationBell />
      <ThemeToggle class="sidebar-theme" />

      <button
        type="button"
        class="icon-btn menu-toggle"
        aria-controls="sidebar-panel"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="menu-icon" aria-hidden="true">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </span>
      </button>
    </div>
  </header>

  <div class="sidebar-panel" id="sidebar-panel">
    {
      m && (
        <ContextSwitcher
          id="business-menu"
          label="Negocio"
          icon={BriefcaseBusiness}
          options={businessOptions}
          footer={{ label: "Tus negocios", href: "/app" }}
        />
      )
    }
    <nav class="sidebar-nav" aria-label="Navegación principal">
      {
        navSections.map(({ key, title, items }, index) => (
          <div class="nav-section">
            <p class="nav-section-title" id={`nav-section-${index}`}>
              {title}
            </p>
            <ul aria-labelledby={`nav-section-${index}`} class="nav-sortable" data-nav-section={key}>
              {items.map(({ id, label, href, icon: Icon }, i) => (
                <li data-nav-id={id}>
                  <a
                    href={href}
                    class="nav-link"
                    data-astro-prefetch
                    aria-current={currentPath === href ? "page" : undefined}
                    aria-describedby={i === 0 ? "nav-reorder-hint" : undefined}
                  >
                    <Icon size={18} stroke-width={1.75} />
                    {label}
                    <GripVertical class="nav-grip" size={16} stroke-width={1.75} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {
        branchLinks.length > 0 && (
          <div class="nav-section">
            <div class="library-head">
              <p class="nav-section-title" id="nav-section-branches">
                Sucursales
              </p>
              {branchesHref && (
                <a href={branchesHref} class="library-all" data-astro-prefetch aria-current={currentPath === branchesHref ? "page" : undefined}>
                  Ver todas<span class="sr-only"> las sucursales</span>
                </a>
              )}
            </div>
            <ul aria-labelledby="nav-section-branches" class="library">
              {branchLinks.map((link) => (
                <li>
                  <a href={link.href} class="library-link" data-astro-prefetch aria-current={link.current ? "true" : undefined}>
                    <span class="library-art" style={`--branch: ${link.color}`} aria-hidden="true">
                      {link.image && <img src={link.image} alt="" loading="lazy" decoding="async" data-fallback />}
                      <Store size={18} stroke-width={1.75} />
                    </span>
                    <span class="library-text">
                      <span class="library-name">{link.name}</span>
                      <span class="library-detail">{link.detail}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p id="nav-reorder-hint" class="sr-only">Arrastra para reordenar, o usa Alt con las flechas arriba y abajo.</p>
      <p class="sr-only" aria-live="polite" data-nav-announce></p>
    </nav>

    <footer class="sidebar-footer">
      {promo && freeOwned && <PromoBar variant="card" promo={promo} href={`${businessHref(freeOwned)}/plan`} label="Usar descuento" />}
      <UserCard user={user} />
    </footer>
  </div>
</div>

<script>
  import Sortable from "sortablejs";

  // Orden del menú elegido por la persona: se guarda en una cookie para que el servidor ya lo pinte ordenado.
  const lists = document.querySelectorAll<HTMLUListElement>(".nav-sortable");
  const announce = document.querySelector<HTMLElement>("[data-nav-announce]")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function saveOrder() {
    let order: Record<string, string[]> = {};
    try {
      order = JSON.parse(decodeURIComponent(document.cookie.match(/(?:^|; )nav-order=([^;]*)/)?.[1] ?? "{}"));
    } catch {}
    for (const list of lists) order[list.dataset.navSection!] = [...list.children].map((li) => (li as HTMLElement).dataset.navId!);
    document.cookie = `nav-order=${encodeURIComponent(JSON.stringify(order))}; path=/; max-age=31536000; samesite=lax`;
  }

  for (const list of lists) {
    Sortable.create(list, {
      animation: reducedMotion ? 0 : 150,
      // En pantallas táctiles hay que mantener presionado: así tocar y desplazar siguen funcionando.
      delay: 250,
      delayOnTouchOnly: true,
      ghostClass: "nav-ghost",
      chosenClass: "nav-chosen",
      onEnd: (event) => {
        if (event.oldIndex !== event.newIndex) saveOrder();
      },
    });

    // Teclado: Alt + ↑/↓ mueve el enlace con foco dentro de su sección.
    list.addEventListener("keydown", (event) => {
      if (!event.altKey || (event.key !== "ArrowUp" && event.key !== "ArrowDown")) return;
      const li = (event.target as HTMLElement).closest("li");
      if (!li) return;
      event.preventDefault();
      const sibling = event.key === "ArrowUp" ? li.previousElementSibling : li.nextElementSibling;
      if (!sibling) return;
      if (event.key === "ArrowUp") sibling.before(li);
      else sibling.after(li);
      li.querySelector("a")!.focus();
      saveOrder();
      announce.textContent = `${li.textContent!.trim()}: posición ${[...list.children].indexOf(li) + 1} de ${list.children.length}`;
    });
  }

  const sidebar = document.querySelector<HTMLElement>(".sidebar")!;
  const toggle = sidebar.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const panel = sidebar.querySelector<HTMLElement>(".sidebar-panel")!;
  const mobileQuery = window.matchMedia("(max-width: 768px)");

  function setOpen(open: boolean) {
    sidebar.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.classList.toggle("menu-open", open);
    // Mientras el menú está abierto, el contenido de fondo no recibe foco ni clics.
    for (const el of document.querySelectorAll("main, .shift-bar")) el.toggleAttribute("inert", open);
  }

  toggle.addEventListener("click", () => {
    const open = sidebar.dataset.open !== "true";
    setOpen(open);
    if (open) panel.querySelector<HTMLElement>("button, a")?.focus();
  });

  panel.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    // Si hay un popover abierto (p. ej. el selector de sucursal), Esc solo cierra ese popover.
    if (event.key !== "Escape" || sidebar.dataset.open !== "true") return;
    if (sidebar.querySelector(":popover-open")) return;
    setOpen(false);
    toggle.focus();
  });

  mobileQuery.addEventListener("change", () => setOpen(false));
</script>

<style>
  /* Dos paneles apilados sobre el suelo: arriba la marca y las acciones; abajo la biblioteca (negocio, secciones y sucursales). */
  .sidebar {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .sidebar-header,
  .sidebar-panel {
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    padding: 0.875rem 0.75rem 0.875rem 1rem;
  }

  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .logo {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-primary);
  }

  .brand-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .brand-name {
    font-size: var(--text-base);
    line-height: 1.25;
    font-weight: var(--font-extrabold);
    letter-spacing: -0.02em;
  }

  .brand-name,
  .brand-tagline {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* En el panel de escritorio no entra entero junto a la campana y el tema: solo se muestra en la barra móvil. */
  @media (min-width: 769px) {
    .brand-tagline {
      display: none;
    }
  }

  .brand-tagline {
    font-size: var(--text-xs);
    line-height: var(--text-sm-lh);
    color: var(--color-text-muted);
  }

  .sidebar-panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
    padding: 0.75rem 0.5rem 0.5rem;
  }

  .menu-toggle {
    display: none;
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .header-actions .sidebar-theme,
  .header-actions :global(.bell-trigger) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .sidebar-nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 0;
    margin: 0 -0.25rem;
    padding: 0.25rem;
    overflow-y: auto;
    scrollbar-width: thin;
    /* Tenue pero siempre visible: así se nota que la lista sigue hacia abajo. */
    scrollbar-color: var(--color-border) transparent;
    transition: scrollbar-color 150ms;
  }

  /* La barra de scroll se marca al pasar por la biblioteca. */
  .sidebar-nav:hover,
  .sidebar-nav:focus-within {
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }

  .library-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }

  .library-head .nav-section-title {
    margin-bottom: 0;
  }

  .library-all {
    flex-shrink: 0;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .library-all:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .library-all[aria-current="page"] {
    background: var(--color-primary-soft);
    color: var(--color-text);
  }

  .nav-section-title {
    margin: 0 0 0.375rem;
    padding: 0 0.625rem;
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-extrabold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .nav-link svg {
    flex-shrink: 0;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  /* Ítem activo: texto pleno sobre un tinte del color del negocio y el ícono en ese color. */
  .nav-link[aria-current="page"] {
    background: var(--color-primary-soft);
    color: var(--color-text);
    font-weight: var(--font-bold);
  }

  .nav-link[aria-current="page"] svg {
    color: var(--color-primary);
  }

  /* Agarradera de arrastre: aparece al pasar el mouse; en táctil se arrastra manteniendo presionado. */
  .nav-link .nav-grip {
    margin-left: auto;
    color: var(--color-text-muted);
    opacity: 0;
    cursor: grab;
    transition: opacity 150ms;
  }

  .nav-link:hover .nav-grip,
  .nav-link:focus-visible .nav-grip {
    opacity: 1;
  }

  .nav-link[aria-current="page"] .nav-grip {
    color: var(--color-text-muted);
  }

  @media (hover: none) {
    .nav-link .nav-grip {
      display: none;
    }
  }

  /* Hueco donde caerá el ítem y el ítem levantado. */
  .nav-sortable :global(.nav-ghost) {
    opacity: 0.4;
  }

  .nav-sortable :global(.nav-chosen) .nav-link {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  /* Sucursales como filas de biblioteca: portada cuadrada con su color, nombre y detalle. */
  .library-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem;
    border-radius: 0.375rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .library-link:hover {
    background: var(--color-surface-muted);
  }

  .library-link[aria-current] {
    background: var(--color-surface-hover);
  }

  .library-art {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--branch) 22%, var(--color-surface));
    color: var(--branch);
  }

  /* Foto de la fachada recortada al cuadrado; sin foto, o si no carga, queda el color de la sucursal con el ícono. */
  .library-art:has(> img:not([hidden])) > :global(svg) {
    display: none;
  }

  .library-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .library-text {
    display: grid;
    min-width: 0;
  }

  .library-name,
  .library-detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-name {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  .library-link[aria-current] .library-name {
    color: var(--color-primary);
  }

  .library-detail {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .sidebar-footer {
    margin-top: auto;
  }

  @media (max-width: 768px) {
    /* En móvil: barra superior a todo el ancho y el menú a pantalla completa. */
    .sidebar {
      --topbar-height: 4rem;

      position: sticky;
      top: 0;
      z-index: 100;
      gap: 0;
    }

    /* La barra superior queda por encima del panel para que el botón siga visible al abrirlo. */
    .sidebar-header {
      position: relative;
      z-index: 1;
      height: var(--topbar-height);
      padding: 0 0.5rem 0 1rem;
      border-radius: 0;
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(12px);
    }

    .header-actions .sidebar-theme,
    .header-actions :global(.bell-trigger) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .menu-toggle {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      color: var(--color-text);
    }

    .menu-icon {
      position: relative;
      width: 1.375rem;
      height: 1rem;
    }

    .menu-bar {
      position: absolute;
      top: calc(50% - 1px);
      left: 0;
      width: 100%;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 300ms cubic-bezier(0.65, 0, 0.35, 1),
        opacity 200ms ease;
    }

    .menu-bar:nth-child(1) {
      transform: translateY(-7px);
    }

    .menu-bar:nth-child(3) {
      transform: translateY(7px);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(1) {
      transform: rotate(45deg);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(3) {
      transform: rotate(-45deg);
    }

    .sidebar-panel {
      position: fixed;
      inset: 0;
      gap: 1rem;
      padding: calc(var(--topbar-height) + 1rem) 1rem calc(1rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      border-radius: 0;
      opacity: 0;
      transform: translateY(-0.75rem);
      visibility: hidden;
      transition:
        opacity 250ms ease,
        transform 250ms var(--ease-out),
        visibility 0s linear 250ms;
    }

    .sidebar[data-open="true"] .sidebar-panel {
      opacity: 1;
      transform: none;
      visibility: visible;
      transition:
        opacity 250ms ease,
        transform 250ms var(--ease-out);
    }

    /* El panel completo ya hace scroll; la lista no necesita su propio scroll. */
    .sidebar-nav {
      flex: none;
      overflow: visible;
    }

    .nav-link {
      padding: 0.75rem 0.875rem;
      font-size: var(--text-base);
      line-height: var(--text-base-lh);
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-bar,
    .sidebar-panel {
      transition: none !important;
    }
  }
</style>
