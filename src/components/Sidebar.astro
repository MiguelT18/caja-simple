---
import { BriefcaseBusiness, CirclePlus, Store } from "@lucide/astro";
import type { Branch, User } from "../data/mock";
import { appNav } from "../data/navigation";
import { branchHref, branchSections, entryHref, myBusinesses, type Membership } from "../data/queries";
import ContextSwitcher from "./ContextSwitcher.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import UserCard from "./UserCard.astro";

interface Props {
  user: User;
  /** Negocio (y sucursal) de la página; sin él, la persona está en «Tus negocios». */
  context?: { membership: Membership; branch?: Branch };
}

const { user, context } = Astro.props;
const m = context?.membership;
const branch = context?.branch;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navSections = appNav(m, branch);
const saleHref = m && branch ? branchHref(m.business, branch, "registrar-venta") : undefined;

const businessOptions = myBusinesses().map((other) => ({
  label: other.business.name,
  detail:
    other.role === "dueño"
      ? `Dueña · ${other.branches.length} ${other.branches.length === 1 ? "sucursal" : "sucursales"}`
      : `Empleada · ${other.employee?.jobTitle ?? ""}`,
  href: entryHref(other),
  current: other.business.id === m?.business.id,
}));

// Al cambiar de sucursal se queda en la misma sección (de Turnos a Turnos), si el rol la puede ver.
const section = m && branch ? currentPath.slice(branchHref(m.business, branch).length).replace(/^\//, "") : "";
const branchOptions =
  m && branch
    ? m.branches.map((other) => ({
        label: other.name,
        detail: other.address,
        href: branchHref(m.business, other, branchSections(m.role).includes(section) ? section : "registrar-venta"),
        current: other.id === branch.id,
      }))
    : [];
---

<aside class="sidebar">
  <header class="sidebar-header">
    <a href={m ? entryHref(m) : "/app"} class="brand">
      <Logo class="logo" />
      <span class="brand-text">
        <span class="brand-name">Caja Simple</span>
        <span class="brand-tagline">Tu negocio, bajo control</span>
      </span>
    </a>

    <div class="header-actions">
      <ThemeToggle class="sidebar-theme" />

      <button
        type="button"
        class="icon-btn menu-toggle"
        aria-controls="sidebar-panel"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="menu-icon" aria-hidden="true">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </span>
      </button>
    </div>
  </header>

  <div class="sidebar-panel" id="sidebar-panel">
    {
      m && (
        <ContextSwitcher
          id="business-menu"
          label="Negocio"
          icon={BriefcaseBusiness}
          options={businessOptions}
          footer={{ label: "Tus negocios", href: "/app" }}
        />
      )
    }
    {branchOptions.length > 1 && <ContextSwitcher id="branch-menu" label="Sucursal" icon={Store} options={branchOptions} />}

    {
      saleHref && (
        <a
          href={saleHref}
          class="btn btn-primary btn-block sale-cta"
          aria-current={currentPath === saleHref ? "page" : undefined}
        >
          <CirclePlus size={18} stroke-width={2} />
          Registrar venta
        </a>
      )
    }

    <nav class="sidebar-nav" aria-label="Navegación principal">
      {
        navSections.map(({ title, items }, index) => (
          <div class="nav-section">
            <p class="nav-section-title" id={`nav-section-${index}`}>
              {title}
            </p>
            <ul aria-labelledby={`nav-section-${index}`}>
              {items.map(({ label, href, icon: Icon }) => (
                <li>
                  <a
                    href={href}
                    class="nav-link"
                    aria-current={currentPath === href ? "page" : undefined}
                  >
                    <Icon size={18} stroke-width={1.75} />
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <footer class="sidebar-footer">
      <UserCard user={user} />
    </footer>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>(".sidebar")!;
  const toggle = sidebar.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const panel = sidebar.querySelector<HTMLElement>(".sidebar-panel")!;
  const mobileQuery = window.matchMedia("(max-width: 768px)");

  function setOpen(open: boolean) {
    sidebar.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.classList.toggle("menu-open", open);
    // Mientras el menú está abierto, el contenido de fondo no recibe foco ni clics.
    document.querySelector("main")?.toggleAttribute("inert", open);
  }

  toggle.addEventListener("click", () => {
    const open = sidebar.dataset.open !== "true";
    setOpen(open);
    if (open) panel.querySelector<HTMLElement>("button, a")?.focus();
  });

  panel.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    // Si hay un popover abierto (p. ej. el selector de sucursal), Esc solo cierra ese popover.
    if (event.key !== "Escape" || sidebar.dataset.open !== "true") return;
    if (sidebar.querySelector(":popover-open")) return;
    setOpen(false);
    toggle.focus();
  });

  mobileQuery.addEventListener("change", () => setOpen(false));
</script>

<style>
  /* Panel flotante: separado del borde, redondeado y con sombra. */
  .sidebar {
    position: sticky;
    top: 0.75rem;
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 1rem;
    width: 17rem;
    height: calc(100dvh - 1.5rem);
    margin: 0.75rem;
    padding: 1rem 0.75rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    padding-left: 0.25rem;
  }

  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .logo {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-primary);
  }

  .brand-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .brand-name {
    font-size: var(--text-base);
    line-height: 1.25;
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .brand-name,
  .brand-tagline {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand-tagline {
    font-size: var(--text-xs);
    line-height: var(--text-sm-lh);
    color: var(--color-text-muted);
  }

  .sidebar-panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
  }

  .menu-toggle {
    display: none;
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .header-actions .sidebar-theme {
    width: 2rem;
    height: 2rem;
  }

  /* Acción principal */
  .sale-cta {
    min-height: 2.5rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .sale-cta[aria-current="page"] {
    box-shadow:
      0 0 0 2px var(--color-surface),
      0 0 0 4px var(--color-focus);
  }

  /* Secciones */
  .sidebar-nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    min-height: 0;
    margin: 0 -0.25rem;
    padding: 0.5rem 0.25rem;
    overflow-y: auto;
    scrollbar-width: thin;
    transition: scrollbar-color 150ms;
  }

  /* Barra fina que se resalta al pasar por el menú. */
  .sidebar-nav:hover,
  .sidebar-nav:focus-within {
    scrollbar-color: var(--scrollbar-thumb-hover) var(--scrollbar-track);
  }

  @supports not (scrollbar-color: auto) {
    .sidebar-nav::-webkit-scrollbar,
    .sidebar-panel::-webkit-scrollbar {
      width: 8px;
    }

    .sidebar-nav::-webkit-scrollbar-thumb,
    .sidebar-panel::-webkit-scrollbar-thumb {
      border-width: 2px;
    }
  }

  .nav-section-title {
    margin: 0 0 0.25rem;
    padding: 0 0.625rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sidebar-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-medium);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms,
      color 150ms;
  }

  /* Barra de acento del ítem activo */
  .nav-link::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--color-primary);
    transform: scaleY(0);
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nav-link svg {
    flex-shrink: 0;
  }

  .nav-link:hover {
    background: var(--color-surface-muted);
  }

  .nav-link[aria-current="page"] {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .nav-link[aria-current="page"]::before {
    transform: scaleY(1);
  }

  .sidebar-footer {
    margin-top: auto;
  }

  @media (max-width: 768px) {
    /* En móvil el panel deja de flotar: barra superior a todo el ancho. */
    .sidebar {
      --topbar-height: 4rem;

      top: 0;
      z-index: 100;
      width: 100%;
      height: auto;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }

    /* La barra superior queda por encima del panel para que el botón siga visible al abrirlo. */
    .sidebar-header {
      position: relative;
      z-index: 1;
      height: var(--topbar-height);
      padding: 0 0.5rem 0 1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface);
    }

    .header-actions .sidebar-theme {
      width: 2.75rem;
      height: 2.75rem;
    }

    .menu-toggle {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      color: var(--color-text);
    }

    .menu-icon {
      position: relative;
      width: 1.375rem;
      height: 1rem;
    }

    .menu-bar {
      position: absolute;
      top: calc(50% - 1px);
      left: 0;
      width: 100%;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 300ms cubic-bezier(0.65, 0, 0.35, 1),
        opacity 200ms ease;
    }

    .menu-bar:nth-child(1) {
      transform: translateY(-7px);
    }

    .menu-bar:nth-child(3) {
      transform: translateY(7px);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(1) {
      transform: rotate(45deg);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(3) {
      transform: rotate(-45deg);
    }

    .sidebar-panel {
      position: fixed;
      inset: 0;
      gap: 1rem;
      padding: calc(var(--topbar-height) + 1rem) 1rem
        calc(1rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      background: var(--color-surface);
      opacity: 0;
      transform: translateY(-0.75rem);
      visibility: hidden;
      transition:
        opacity 250ms ease,
        transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1),
        visibility 0s linear 250ms;
    }

    .sidebar[data-open="true"] .sidebar-panel {
      opacity: 1;
      transform: none;
      visibility: visible;
      transition:
        opacity 250ms ease,
        transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* El panel completo ya hace scroll; la lista no necesita su propio scroll. */
    .sidebar-nav {
      flex: none;
      overflow: visible;
    }

    .sale-cta {
      min-height: 2.75rem;
      font-size: var(--text-base);
      line-height: var(--text-base-lh);
    }

    .nav-link {
      padding: 0.75rem 0.875rem;
      font-size: var(--text-base);
      line-height: var(--text-base-lh);
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-bar,
    .sidebar-panel,
    .nav-link::before {
      transition: none !important;
    }
  }
</style>
