---
import {
  CirclePlus,
  LayoutDashboard,
  LogOut,
  Moon,
  Package,
  Sun,
  Wallet,
} from "@lucide/astro";
import Logo from "./Logo.astro";

export interface SidebarUser {
  firstName: string;
  lastName: string;
  email: string;
  avatarUrl?: string;
}

interface Props {
  user: SidebarUser;
}

const { user } = Astro.props;

const fullName = `${user.firstName} ${user.lastName}`;
const initials = `${user.firstName[0] ?? ""}${user.lastName[0] ?? ""}`.toUpperCase();

const navItems = [
  {
    label: "Resumen",
    href: "/",
    icon: LayoutDashboard,
  },
  {
    label: "Productos",
    href: "/productos",
    icon: Package,
  },
  {
    label: "Registrar venta",
    href: "/registrar-venta",
    icon: CirclePlus,
  },
  { label: "Gastos", href: "/gastos", icon: Wallet },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<aside class="sidebar">
  <header class="sidebar-header">
    <a href="/" class="brand">
      <Logo class="logo" />
      <span class="brand-text">
        <span class="brand-name">Caja Simple</span>
        <span class="brand-tagline">Tu negocio, bajo control</span>
      </span>
    </a>

    <div class="header-actions">
      <button
        type="button"
        class="theme-toggle"
        aria-pressed="false"
        aria-label="Modo oscuro"
        title="Cambiar tema"
      >
        <Moon class="theme-icon icon-moon" size={20} stroke-width={1.75} />
        <Sun class="theme-icon icon-sun" size={20} stroke-width={1.75} />
      </button>

      <button
        type="button"
        class="menu-toggle"
        aria-controls="sidebar-panel"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="menu-icon" aria-hidden="true">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </span>
      </button>
    </div>
  </header>

  <div class="sidebar-panel" id="sidebar-panel">
    <nav class="sidebar-nav" aria-label="Navegación principal">
      <ul>
        {
          navItems.map(({ label, href, icon: Icon }) => (
            <li>
              <a
                href={href}
                class="nav-link"
                aria-current={currentPath === href ? "page" : undefined}
              >
                <Icon size={20} stroke-width={1.75} />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <footer class="sidebar-footer">
      {
        user.avatarUrl ? (
          <img
            class="avatar"
            src={user.avatarUrl}
            alt=""
            width="40"
            height="40"
          />
        ) : (
          <span class="avatar avatar-initials" aria-hidden="true">
            {initials}
          </span>
        )
      }
      <div class="user-info">
        <span class="user-name" title={fullName}>{fullName}</span>
        <span class="user-email" title={user.email}>{user.email}</span>
      </div>
      <form method="post" action="/logout">
        <button
          type="submit"
          class="logout"
          aria-label="Cerrar sesión"
          title="Cerrar sesión"
        >
          <LogOut size={20} stroke-width={1.75} />
        </button>
      </form>
    </footer>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>(".sidebar")!;
  const toggle = sidebar.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const mobileQuery = window.matchMedia("(max-width: 768px)");

  function setOpen(open: boolean) {
    sidebar.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.classList.toggle("menu-open", open);
    // Mientras el menú está abierto, el contenido de fondo no recibe foco ni clics.
    document.querySelector("main")?.toggleAttribute("inert", open);
  }

  toggle.addEventListener("click", () => {
    const open = sidebar.dataset.open !== "true";
    setOpen(open);
    if (open) sidebar.querySelector<HTMLElement>(".nav-link")?.focus();
  });

  sidebar.querySelectorAll(".nav-link").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && sidebar.dataset.open === "true") {
      setOpen(false);
      toggle.focus();
    }
  });

  mobileQuery.addEventListener("change", () => setOpen(false));

  // Tema: la preferencia guardada manda; si no hay, se sigue la del sistema.
  const THEME_KEY = "caja-simple-theme";
  const themeToggle = sidebar.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  function isDark() {
    const theme = document.documentElement.dataset.theme;
    return theme ? theme === "dark" : darkQuery.matches;
  }

  function syncThemeToggle() {
    themeToggle.setAttribute("aria-pressed", String(isDark()));
  }

  themeToggle.addEventListener("click", () => {
    const theme = isDark() ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {}
    syncThemeToggle();
  });

  darkQuery.addEventListener("change", syncThemeToggle);
  syncThemeToggle();
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 17.5rem;
    height: 100dvh;
    padding: 1.25rem 0.875rem;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    padding: 0 0 1.25rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .logo {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-primary);
  }

  .brand-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .brand-name {
    font-size: var(--text-lg);
    line-height: 1.25;
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .brand-name,
  .brand-tagline {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand-tagline {
    font-size: var(--text-xs);
    line-height: var(--text-sm-lh);
    color: var(--color-text-muted);
  }

  .sidebar-panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 0;
  }

  .menu-toggle {
    display: none;
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 0.5rem;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .theme-toggle:hover {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .theme-icon {
    position: absolute;
    transition:
      transform 400ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 250ms ease;
  }

  /* Luna en tema claro, sol en tema oscuro (el oscuro puede venir del sistema o de data-theme). */
  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  :global(:root[data-theme="dark"]) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :global(:root[data-theme="dark"]) .icon-sun {
    opacity: 1;
    transform: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.5);
    }

    :global(:root:not([data-theme="light"])) .icon-sun {
      opacity: 1;
      transform: none;
    }
  }

  .sidebar-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    font-size: var(--text-base);
    line-height: var(--text-base-lh);
    font-weight: var(--font-medium);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .nav-link svg {
    flex-shrink: 0;
  }

  .nav-link:hover {
    background: var(--color-surface-muted);
  }

  .nav-link[aria-current="page"] {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .nav-link:focus-visible,
  .logout:focus-visible,
  .menu-toggle:focus-visible,
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding: 1rem 0.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .avatar {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-initials {
    display: grid;
    place-items: center;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .user-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .user-name,
  .user-email {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-name {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
  }

  .user-email {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--color-text-muted);
  }

  .logout {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 0.5rem;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .logout:hover {
    background: var(--color-expense-soft);
    color: var(--color-expense);
  }

  @media (max-width: 768px) {
    .sidebar {
      --topbar-height: 4rem;

      z-index: 100;
      width: 100%;
      height: auto;
      padding: 0;
      border-right: none;
    }

    /* La barra superior queda por encima del panel para que el botón siga visible al abrirlo. */
    .sidebar-header {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--topbar-height);
      padding: 0 0.5rem 0 1rem;
      background: var(--color-surface);
    }

    .logo {
      width: 2.25rem;
      height: 2.25rem;
    }

    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }

    .menu-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: none;
      border-radius: 0.5rem;
      background: none;
      color: var(--color-text);
      cursor: pointer;
    }

    .menu-toggle:hover {
      background: var(--color-surface-muted);
    }

    .menu-icon {
      position: relative;
      width: 1.375rem;
      height: 1rem;
    }

    .menu-bar {
      position: absolute;
      top: calc(50% - 1px);
      left: 0;
      width: 100%;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 300ms cubic-bezier(0.65, 0, 0.35, 1),
        opacity 200ms ease;
    }

    .menu-bar:nth-child(1) {
      transform: translateY(-7px);
    }

    .menu-bar:nth-child(3) {
      transform: translateY(7px);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(1) {
      transform: rotate(45deg);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .sidebar[data-open="true"] .menu-bar:nth-child(3) {
      transform: rotate(-45deg);
    }

    .sidebar-panel {
      position: fixed;
      inset: 0;
      padding: calc(var(--topbar-height) + 1rem) 1rem
        calc(1.25rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--color-surface);
      opacity: 0;
      transform: translateY(-0.75rem);
      visibility: hidden;
      transition:
        opacity 250ms ease,
        transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1),
        visibility 0s linear 250ms;
    }

    .sidebar[data-open="true"] .sidebar-panel {
      opacity: 1;
      transform: none;
      visibility: visible;
      transition:
        opacity 250ms ease,
        transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .nav-link {
      padding: 0.875rem 1rem;
      font-size: var(--text-lg);
      line-height: var(--text-lg-lh);
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-bar,
    .sidebar-panel,
    .theme-icon {
      transition: none !important;
    }
  }
</style>
