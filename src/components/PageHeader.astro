---
// Encabezado de página de /app: un degradado del color de la entidad (sucursal o negocio) que se funde con el panel,
// el título grande y, debajo, las acciones. Con el slot `cover`, se arma como la portada de un álbum a la izquierda.
interface Props {
  title: string;
  description?: string;
  /** Línea chica sobre el título: la fecha del día (longDate) y, si aplica, el turno. */
  eyebrow?: string;
  /** Encabezado bajo para las páginas de trabajo rápido («Vender»): deja ver el contenido en el primer pantallazo. */
  compact?: boolean;
  /** Color del degradado: el de la sucursal (branchColor) o, por defecto, el ámbar del negocio. */
  tint?: string;
}

const { title, description, eyebrow, compact, tint = "var(--color-primary)" } = Astro.props;
const hasCover = Astro.slots.has("cover");
const hasActions = Astro.slots.has("default");
---

<header class:list={["page-head", { "has-cover": hasCover, compact }]} style={`--tint: ${tint}`}>
  {
    hasCover && (
      <div class="page-cover">
        <slot name="cover" />
      </div>
    )
  }
  <div class="page-head-text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  {
    hasActions && (
      <div class="page-actions">
        <slot />
      </div>
    )
  }
</header>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: 1.25rem 1.5rem;
    margin: 0 calc(-1 * var(--main-pad)) 1.75rem;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--main-pad) 1.5rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--tint) 40%, var(--color-surface)) 0%,
      color-mix(in oklab, var(--tint) 16%, var(--color-surface)) 65%,
      var(--color-surface) 100%
    );
  }

  .page-head.has-cover {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .page-cover {
    width: clamp(6rem, 14vw, 12rem);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.375rem;
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.45);
  }

  .page-head-text {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    line-height: var(--text-display-lh);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.035em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  /* Sobre el degradado, el texto secundario va en el color pleno: el atenuado no llega a AA sobre el tinte. */
  .page-head-text p.eyebrow {
    margin: 0 0 0.375rem;
    font-weight: var(--font-semibold);
  }

  .page-head-text p {
    max-width: 65ch;
    margin: 0.75rem 0 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .page-head.compact {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .compact h1 {
    font-size: var(--text-3xl);
    line-height: var(--text-3xl-lh);
    letter-spacing: -0.02em;
  }

  .compact .page-head-text p:not(.eyebrow) {
    margin-top: 0.375rem;
  }

  .page-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 480px) {
    .page-head.has-cover {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
