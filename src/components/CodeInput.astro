---
// Código de la verificación en dos pasos: seis casillas con un «-» al medio (123-456), como en Authenticator.
// Es un solo <input> real, transparente sobre las casillas: pegar, autocompletar del celular, lector de pantalla y la
// validación de auth-form.ts / action-forms.ts (error en #<id>-error) funcionan como con cualquier campo.
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "id" | "name"> {
  id: string;
  name?: string;
  label: string;
  /** Al completar los 6 dígitos, envía el formulario (por omisión, sí). */
  autosubmit?: boolean;
}

const { id, name = "code", label, autosubmit = true, ...rest } = Astro.props;
---

<div class="field">
  <label class="field-label" for={id}>{label}</label>
  <div class="code-field">
    <input
      class="code-input"
      id={id}
      name={name}
      type="text"
      inputmode="numeric"
      autocomplete="one-time-code"
      pattern="\d{6}"
      minlength={6}
      maxlength={6}
      spellcheck="false"
      aria-describedby={`${id}-error`}
      data-code-input
      data-autosubmit={autosubmit || undefined}
      {...rest}
    />
    <div class="code-slots num" aria-hidden="true">
      {[0, 1, 2].map(() => <span class="slot"></span>)}
      <span class="sep">-</span>
      {[3, 4, 5].map(() => <span class="slot"></span>)}
    </div>
  </div>
  <p class="field-error" id={`${id}-error`}></p>
</div>

<script>
  for (const input of document.querySelectorAll<HTMLInputElement>("[data-code-input]")) {
    const slots = [...input.parentElement!.querySelectorAll<HTMLElement>(".slot")];
    const paint = () => {
      const digits = input.value.replace(/\D/g, "").slice(0, 6);
      if (digits !== input.value) input.value = digits;
      const focused = document.activeElement === input;
      slots.forEach((slot, i) => {
        slot.textContent = digits[i] ?? "";
        slot.classList.toggle("is-active", focused && i === Math.min(digits.length, 5));
      });
    };
    input.addEventListener("input", () => {
      paint();
      if (input.value.length === 6 && "autosubmit" in input.dataset) input.form?.requestSubmit();
    });
    // Con los 6 ya puestos (p. ej., un código que no pasó), escribir o pegar empieza uno nuevo: no hay que borrar antes.
    input.addEventListener("beforeinput", (e) => {
      if (input.value.length === 6 && (e.inputType === "insertText" || e.inputType === "insertFromPaste")) input.value = "";
    });
    // El cursor siempre al final: las casillas no muestran una posición en medio.
    const toEnd = () => input.setSelectionRange(input.value.length, input.value.length);
    input.addEventListener("focus", () => (toEnd(), paint()));
    input.addEventListener("click", toEnd);
    input.addEventListener("blur", paint);
    // Un formulario que se vacía (form.reset() al cerrar un diálogo) también vacía las casillas.
    input.form?.addEventListener("reset", () => setTimeout(paint));
    paint();
  }
</script>

<style>
  .code-field {
    position: relative;
    justify-self: start;
    max-width: 100%;
  }

  /* El campo real cubre las casillas y recibe el teclado, el pegado y los toques; no se ve. */
  .code-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    caret-color: transparent;
    font-size: 16px;
    letter-spacing: 2.5rem;
    outline: none;
    cursor: text;
    -webkit-text-fill-color: transparent;
  }

  .code-input::selection {
    background: transparent;
  }

  .code-slots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 3.25rem;
    border: 1px solid var(--color-input-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    transition:
      border-color 150ms,
      box-shadow 150ms;
  }

  .sep {
    color: var(--color-text-muted);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
  }

  /* El anillo de foco va en la casilla que toca escribir. */
  .slot.is-active {
    outline: 2px solid var(--color-focus);
    outline-offset: -1px;
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .code-input[aria-invalid="true"] + .code-slots .slot {
    border-color: var(--color-expense);
  }

  .code-input[aria-invalid="true"] + .code-slots .slot.is-active {
    outline-color: var(--color-expense);
    box-shadow: 0 0 0 3px var(--color-expense-soft);
  }

  @media (max-width: 420px) {
    .code-slots {
      gap: 0.375rem;
    }

    .slot {
      width: 2.5rem;
      height: 3rem;
    }
  }
</style>
