---
import { LifeBuoy, LogOut } from "@lucide/astro";
import type { User } from "../data/types";
import Avatar from "./Avatar.astro";

interface Props {
  user: User;
}

const { user } = Astro.props;

const fullName = `${user.firstName} ${user.lastName}`;
// Ayuda guarda desde qué página se escribe, para entender el contexto del mensaje.
const helpHref = `/app/ayuda?desde=${encodeURIComponent(Astro.url.pathname)}`;
---

<div class="user-card">
  <a href="/app/cuenta" class="user-link" title="Tu cuenta">
  <Avatar src={user.avatarUrl} seed={user.id} size={2.25} />
  <div class="user-info">
    <span class="user-name">{fullName}</span>
    <span class="user-email">{user.email}</span>
  </div>
  <span class="sr-only">Tu cuenta</span>
  </a>
  <a href={helpHref} class="icon-btn user-action" aria-label="Ayuda y comentarios" title="Ayuda y comentarios">
    <LifeBuoy size={18} stroke-width={1.75} />
  </a>
  <form method="post" action="/api/auth/logout" data-logout>
    <button type="submit" class="icon-btn user-action" aria-label="Cerrar sesión" title="Cerrar sesión">
      <LogOut size={18} stroke-width={1.75} />
    </button>
  </form>
</div>

<script>
  import { clearAllDrafts } from "../scripts/drafts";
  // Al salir se borran los borradores: en un equipo compartido, la próxima persona no ve lo que escribió esta.
  document.addEventListener("submit", (event) => {
    if ((event.target as HTMLElement).matches("form[data-logout]")) clearAllDrafts();
  });
</script>

<style>
  .user-card {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
  }

  /* Foto y nombre llevan a Tu cuenta; cerrar sesión queda aparte. */
  .user-link {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    margin: -0.25rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .user-link:hover {
    background: var(--color-surface);
  }

  .user-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .user-name,
  .user-email {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-name {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
  }

  .user-email {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--color-text-muted);
  }

  .user-action {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
  }

  @media (pointer: coarse) {
    .user-action {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .logout:hover {
    background: var(--color-expense-soft);
    color: var(--color-expense);
  }
</style>
