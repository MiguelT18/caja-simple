---
import { LifeBuoy, LogOut } from "@lucide/astro";
import type { User } from "../data/types";

interface Props {
  user: User;
}

const { user } = Astro.props;

const fullName = `${user.firstName} ${user.lastName}`;
// Ayuda guarda desde qué página se escribe, para entender el contexto del mensaje.
const helpHref = `/app/ayuda?desde=${encodeURIComponent(Astro.url.pathname)}`;
const initials = `${user.firstName[0] ?? ""}${user.lastName[0] ?? user.email[0] ?? ""}`.toUpperCase();
---

<div class="user-card">
  <a href="/app/cuenta" class="user-link" title="Tu cuenta">
  {
    user.avatarUrl ? (
      <img class="avatar skeleton" src={user.avatarUrl} alt="" width="36" height="36" decoding="async" data-fallback />
    ) : (
      <span class="avatar avatar-initials" aria-hidden="true">
        {initials}
      </span>
    )
  }
  <div class="user-info">
    <span class="user-name">{fullName}</span>
    <span class="user-email">{user.email}</span>
  </div>
  <span class="sr-only">Tu cuenta</span>
  </a>
  <a href={helpHref} class="icon-btn user-action" aria-label="Ayuda y comentarios" title="Ayuda y comentarios">
    <LifeBuoy size={18} stroke-width={1.75} />
  </a>
  <form method="post" action="/api/auth/logout">
    <button type="submit" class="icon-btn user-action" aria-label="Cerrar sesión" title="Cerrar sesión">
      <LogOut size={18} stroke-width={1.75} />
    </button>
  </form>
</div>

<style>
  .user-card {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
  }

  .avatar {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-initials {
    display: grid;
    place-items: center;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }

  /* Foto y nombre llevan a Tu cuenta; cerrar sesión queda aparte. */
  .user-link {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    margin: -0.25rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .user-link:hover {
    background: var(--color-surface);
  }

  .user-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .user-name,
  .user-email {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-name {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
  }

  .user-email {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--color-text-muted);
  }

  .user-action {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
  }

  @media (pointer: coarse) {
    .user-action {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .logout:hover {
    background: var(--color-expense-soft);
    color: var(--color-expense);
  }
</style>
