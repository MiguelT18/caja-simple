---
import { ArrowLeft, ArrowRight, Hourglass, MapPin, Search, SearchX, Store } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import Layout from "@/layouts/Layout.astro";
import { businessKinds } from "@/data/kinds";
import { DIRECTORY_PAGE_SIZE, myBusinesses, searchBusinesses, type DirectoryBusiness } from "@/data/queries";
import type { BusinessKind } from "@/data/types";
import { plural } from "@/lib/format";

const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim().slice(0, 80);
const kindParam = params.get("rubro");
const kind = businessKinds.some((k) => k.value === kindParam) ? (kindParam as BusinessKind) : null;
const page = Math.min(Math.max(Number.parseInt(params.get("pagina") ?? "1", 10) || 1, 1), 1000);

const { businesses, total } = await searchBusinesses(Astro.locals, { q, kind, page });
const pages = Math.max(Math.ceil(total / DIRECTORY_PAGE_SIZE), 1);
const kindLabel = (k: BusinessKind) => businessKinds.find((b) => b.value === k)?.label ?? k;
const filtered = q !== "" || kind !== null;

// Para «Entrar» en los negocios donde ya está la persona.
const mine = new Map(myBusinesses(Astro.locals).map((m) => [m.business.id, m.business.slug]));
const pageHref = (n: number) => {
  const next = new URLSearchParams();
  if (q) next.set("q", q);
  if (kind) next.set("rubro", kind);
  if (n > 1) next.set("pagina", String(n));
  const s = next.toString();
  return s ? `/app/buscar?${s}` : "/app/buscar";
};
const monogram = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? "")
    .join("")
    .toUpperCase();
const joinId = (b: DirectoryBusiness) => `join-${b.id}`;
---

<Layout title="Buscar negocios">
  <PageHeader title="Buscar negocios" description="Encuentra negocios que usan Caja Simple y pide unirte a su equipo. Solo aparecen los que eligieron mostrarse." />

  <form class="filters card" method="get" action="/app/buscar" role="search" aria-label="Buscar negocios">
    <div class="field grow">
      <label class="field-label" for="search-q">Nombre, rubro o zona</label>
      <div class="search-input">
        <Search size={18} stroke-width={1.75} aria-hidden="true" />
        <input class="input" id="search-q" name="q" type="search" value={q} maxlength={80} placeholder="Ej.: almacén, Centro, pollos" autocomplete="off" />
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="search-kind">Rubro</label>
      <select class="input" id="search-kind" name="rubro">
        <option value="">Todos los rubros</option>
        {businessKinds.map((k) => <option value={k.value} selected={k.value === kind}>{k.label}</option>)}
      </select>
    </div>
    <div class="filter-actions">
      <button type="submit" class="btn btn-primary">Buscar</button>
      {filtered && <a class="btn btn-secondary" href="/app/buscar">Limpiar</a>}
    </div>
  </form>

  <section data-region="results" aria-labelledby="results-title">
    <h2 id="results-title" class="results-title">
      {total === 0 ? "Sin resultados" : filtered ? `${plural(total, "negocio encontrado", "negocios encontrados")}` : `${plural(total, "negocio", "negocios")} en Buscar`}
    </h2>

    {
      businesses.length === 0 ? (
        <div class="empty card">
          <span class="empty-icon" aria-hidden="true">
            {filtered ? <SearchX size={24} stroke-width={1.75} /> : <Store size={24} stroke-width={1.75} />}
          </span>
          <p class="empty-title">{filtered ? "Ningún negocio coincide con tu búsqueda" : "Todavía no hay negocios en Buscar"}</p>
          <p>{filtered ? "Prueba con otra palabra o con todos los rubros." : "Cuando un negocio elija mostrarse, aparecerá aquí."}</p>
        </div>
      ) : (
        <ul class="results" role="list">
          {businesses.map((b) => (
            <li class="result card">
              <div class="result-head">
                <span class="logo" aria-hidden="true">
                  {b.logo ? <img src={b.logo} alt="" loading="lazy" decoding="async" data-fallback /> : null}
                  <span class="logo-initials">{monogram(b.name)}</span>
                </span>
                <div class="result-name">
                  <h3>{b.name}</h3>
                  <p class="kind">{kindLabel(b.kind)}</p>
                </div>
              </div>
              <p class="description">{b.description}</p>
              <div class="branches">
                <p class="branches-title">{plural(b.branches.length, "sucursal", "sucursales")}</p>
                <ul role="list">
                  {b.branches.map((br) => (
                    <li>
                      <MapPin size={14} stroke-width={1.75} aria-hidden="true" />
                      <span>
                        <span class="branch-name">{br.name}</span>
                        {br.address && <span class="branch-address"> · {br.address}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="result-action">
                {b.relation === null && (
                  <button type="button" class="btn btn-primary" data-open-dialog={joinId(b)} aria-label={`Pedir unirme a ${b.name}`}>
                    Pedir unirme
                  </button>
                )}
                {b.relation === "pendiente" && (
                  <p class="status">
                    <Hourglass size={16} stroke-width={1.75} aria-hidden="true" />
                    Pedido enviado · esperando respuesta
                  </p>
                )}
                {b.relation === "invitado" && <p class="status">Te invitaron: revisa tus avisos.</p>}
                {(b.relation === "dueño" || b.relation === "equipo") && (
                  <>
                    <p class="status">{b.relation === "dueño" ? "Es tu negocio" : "Ya trabajas aquí"}</p>
                    {mine.has(b.id) && (
                      <a class="btn btn-secondary" href={`/app/${mine.get(b.id)}`} aria-label={`Entrar a ${b.name}`}>
                        Entrar
                      </a>
                    )}
                  </>
                )}
              </div>
              {b.relation === null && (
                <Modal
                  id={joinId(b)}
                  title={`Pedir unirme a ${b.name}`}
                  description="Le llega un aviso a quien lo administra. Si acepta, elige tu sucursal, tu turno y tu puesto, y entras al equipo."
                  action="requestJoin"
                  submitLabel="Enviar pedido"
                  success="Pedido enviado. Te avisamos cuando respondan."
                  hidden={{ businessId: b.id }}
                >
                  {b.branches.length > 1 && (
                    <FormInput
                      form={`${joinId(b)}-form`}
                      name="branchId"
                      label="Sucursal"
                      hint="Opcional. Quien administra decide al aceptar."
                      options={[{ value: "", label: "La que necesiten" }, ...b.branches.map((br) => ({ value: br.id, label: br.name }))]}
                    />
                  )}
                  <FormInput
                    form={`${joinId(b)}-form`}
                    name="message"
                    label="Mensaje"
                    rows={3}
                    maxlength={300}
                    placeholder="Ej.: Hola, trabajo de cajera hace 2 años y puedo en el turno de la tarde."
                    hint="Opcional. Cuéntales quién eres y en qué puedes ayudar."
                  />
                </Modal>
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      pages > 1 && (
        <nav class="pager" aria-label="Páginas de resultados">
          {page > 1 ? (
            <a class="btn btn-secondary" href={pageHref(page - 1)} rel="prev">
              <ArrowLeft size={16} stroke-width={1.75} aria-hidden="true" />
              Anterior
            </a>
          ) : (
            <span />
          )}
          <span class="num">Página {page} de {pages}</span>
          {page < pages ? (
            <a class="btn btn-secondary" href={pageHref(page + 1)} rel="next">
              Siguiente
              <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </section>
</Layout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
  }

  .filters .field {
    flex: 1 1 12rem;
  }

  .filters .grow {
    flex: 1 1 16rem;
  }

  .search-input {
    position: relative;
  }

  .search-input :global(svg) {
    position: absolute;
    top: 50%;
    left: 0.75rem;
    translate: 0 -50%;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input .input {
    width: 100%;
    padding-left: 2.5rem;
  }

  .filter-actions {
    display: flex;
    gap: 0.5rem;
  }

  .results-title {
    margin: 0 0 1rem;
    font-size: var(--text-lg);
  }

  .results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
    padding: 1.25rem;
  }

  .result-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .logo {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: var(--font-bold);
  }

  .logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .result-name {
    min-width: 0;
  }

  .result-name h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    overflow-wrap: anywhere;
  }

  .kind {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .description {
    margin: 0;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .branches-title {
    margin: 0 0 0.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }

  .branches ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .branches li {
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
    overflow-wrap: anywhere;
  }

  .branches li :global(svg) {
    flex-shrink: 0;
    translate: 0 2px;
    color: var(--color-text-muted);
  }

  .branch-name {
    font-weight: var(--font-medium);
  }

  .branch-address {
    color: var(--color-text-muted);
  }

  .result-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .empty p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .empty .empty-title {
    color: var(--color-text);
    font-weight: var(--font-semibold);
  }

  .empty-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
