---
import { ArrowLeft, ArrowRight, BadgeCheck, Crown, Hourglass, LayoutGrid, Mail, MapPin, Search, SearchX, Shirt, Store, UserPlus, UtensilsCrossed } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import SelectMenu from "@/components/app/SelectMenu.astro";
import Layout from "@/layouts/Layout.astro";
import { businessKinds } from "@/data/kinds";
import { DIRECTORY_PAGE_SIZE, myBusinesses, searchBusinesses, type DirectoryBusiness } from "@/data/queries";
import type { BusinessKind } from "@/data/types";
import { plural } from "@/lib/format";

const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim().slice(0, 80);
const kindParam = params.get("rubro");
const kind = businessKinds.some((k) => k.value === kindParam) ? (kindParam as BusinessKind) : null;
const page = Math.min(Math.max(Number.parseInt(params.get("pagina") ?? "1", 10) || 1, 1), 1000);

const { businesses, total } = await searchBusinesses(Astro.locals, { q, kind, page });
const pages = Math.max(Math.ceil(total / DIRECTORY_PAGE_SIZE), 1);
const kindLabel = (k: BusinessKind) => businessKinds.find((b) => b.value === k)?.label ?? k;
const kindIcons = { "": LayoutGrid, tienda: Store, ropa: Shirt, restaurante: UtensilsCrossed };
const kindChoices = [{ value: "", label: "Todos los rubros", hint: "Tiendas, ropa y restaurantes." }, ...businessKinds].map((k) => ({ ...k, keywords: k.hint }));
const filtered = q !== "" || kind !== null;
const resultsTitle = total === 0 ? "Sin resultados" : filtered ? plural(total, "negocio encontrado", "negocios encontrados") : `${plural(total, "negocio", "negocios")} en Buscar`;
// Las primeras sucursales bastan para ubicar el negocio; el resto, contado.
const SHOWN_BRANCHES = 3;

// Para «Entrar» en los negocios donde ya está la persona.
const mine = new Map(myBusinesses(Astro.locals).map((m) => [m.business.id, m.business.slug]));
const pageHref = (n: number) => {
  const next = new URLSearchParams();
  if (q) next.set("q", q);
  if (kind) next.set("rubro", kind);
  if (n > 1) next.set("pagina", String(n));
  const s = next.toString();
  return s ? `/app/buscar?${s}` : "/app/buscar";
};
const monogram = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? "")
    .join("")
    .toUpperCase();
const joinId = (b: DirectoryBusiness) => `join-${b.id}`;
---

<Layout title="Buscar negocios">
  <PageHeader title="Buscar negocios" description="Encuentra negocios que usan Caja Simple y pide unirte a su equipo. Solo aparecen los que eligieron mostrarse." />

  <form class="filters card" method="get" action="/app/buscar" role="search" aria-label="Buscar negocios" data-directory-search>
    <div class="field grow">
      <label class="field-label" for="search-q">Nombre, rubro o zona</label>
      <div class="search-input">
        <Search size={18} stroke-width={1.75} aria-hidden="true" />
        <input class="input" id="search-q" name="q" type="search" value={q} maxlength={80} placeholder="Ej.: almacén, Centro, pollos" autocomplete="off" aria-describedby="search-hint" />
      </div>
      <p class="sr-only" id="search-hint">Los resultados cambian mientras escribes.</p>
    </div>
    <div class="kind-field">
      <SelectMenu form="search" name="rubro" label="Rubro" options={kindChoices} value={kind ?? ""} searchPlaceholder="Buscar rubro" noun="rubros">
        {(o: (typeof kindChoices)[number]) => {
          const Icon = kindIcons[o.value as keyof typeof kindIcons];
          return (
            <span class="kind-option">
              <Icon size={18} stroke-width={1.75} aria-hidden="true" />
              <span class="kind-text">
                <span class="kind-name">{o.label}</span>
                <span class="kind-hint">{o.hint}</span>
              </span>
            </span>
          );
        }}
      </SelectMenu>
    </div>
    {/* Sin botón: sin JS, Enter en el buscador manda el formulario; con JS, se busca al escribir. */}
    <p class="sr-only" aria-live="polite" data-search-status></p>
  </form>

  <section data-region="results" aria-labelledby="results-title">
    <div class="results-head">
      <h2 id="results-title" class="results-title" data-results-title>{resultsTitle}</h2>
      {filtered && <a class="clear-link" href="/app/buscar">Limpiar la búsqueda</a>}
    </div>

    {
      businesses.length === 0 ? (
        <div class="empty card">
          <span class="empty-icon" aria-hidden="true">
            {filtered ? <SearchX size={24} stroke-width={1.75} /> : <Store size={24} stroke-width={1.75} />}
          </span>
          <p class="empty-title">{filtered ? "Ningún negocio coincide con tu búsqueda" : "Todavía no hay negocios en Buscar"}</p>
          <p>{filtered ? "Prueba con otra palabra o con todos los rubros." : "Cuando un negocio elija mostrarse, aparecerá aquí."}</p>
        </div>
      ) : (
        <ul class="results" role="list">
          {businesses.map((b) => {
            const KindIcon = kindIcons[b.kind];
            const rest = b.branches.length - SHOWN_BRANCHES;
            return (
              <li class="result card">
                <div class="result-head">
                  <span class="logo" aria-hidden="true">
                    {b.logo ? <img src={b.logo} alt="" loading="lazy" decoding="async" data-fallback /> : null}
                    <span class="logo-initials">{monogram(b.name)}</span>
                  </span>
                  <div class="result-name">
                    <h3>{b.name}</h3>
                    <span class="kind-chip">
                      <KindIcon size={14} stroke-width={1.75} aria-hidden="true" />
                      {kindLabel(b.kind)}
                    </span>
                  </div>
                </div>
                <p class="description">{b.description}</p>
                {b.branches.length > 0 && (
                  <div class="branches">
                    <p class="branches-title">
                      <MapPin size={14} stroke-width={1.75} aria-hidden="true" />
                      {plural(b.branches.length, "sucursal", "sucursales")}
                    </p>
                    <ul role="list">
                      {b.branches.slice(0, SHOWN_BRANCHES).map((br) => (
                        <li title={br.address ? `${br.name} · ${br.address}` : br.name}>
                          <span class="branch-name">{br.name}</span>
                          {br.address && <span class="branch-address">{br.address}</span>}
                        </li>
                      ))}
                    </ul>
                    {rest > 0 && <p class="branches-more">y {plural(rest, "sucursal más", "sucursales más")}</p>}
                  </div>
                )}
                <div class="result-action">
                  {b.relation === null && (
                    <button type="button" class="btn btn-primary" data-open-dialog={joinId(b)} aria-label={`Pedir unirme a ${b.name}`}>
                      <UserPlus size={18} stroke-width={1.75} aria-hidden="true" />
                      Pedir unirme
                    </button>
                  )}
                  {b.relation === "pendiente" && (
                    <p class="status">
                      <Hourglass size={16} stroke-width={1.75} aria-hidden="true" />
                      Pedido enviado · esperando respuesta
                    </p>
                  )}
                  {b.relation === "invitado" && (
                    <p class="status">
                      <Mail size={16} stroke-width={1.75} aria-hidden="true" />
                      Te invitaron: revisa tus avisos.
                    </p>
                  )}
                  {(b.relation === "dueño" || b.relation === "equipo") && (
                    <>
                      <p class="status">
                        {b.relation === "dueño" ? <Crown size={16} stroke-width={1.75} aria-hidden="true" /> : <BadgeCheck size={16} stroke-width={1.75} aria-hidden="true" />}
                        {b.relation === "dueño" ? "Es tu negocio" : "Ya trabajas aquí"}
                      </p>
                      {mine.has(b.id) && (
                        <a class="btn btn-secondary" href={`/app/${mine.get(b.id)}`} aria-label={`Entrar a ${b.name}`}>
                          Entrar
                          <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
                        </a>
                      )}
                    </>
                  )}
                </div>
                {b.relation === null && (
                  <Modal
                    id={joinId(b)}
                    title={`Pedir unirme a ${b.name}`}
                    description="Le llega un aviso a quien lo administra. Si acepta, elige tu sucursal, tu turno y tu puesto, y entras al equipo."
                    action="requestJoin"
                    submitLabel="Enviar pedido"
                    success="Pedido enviado. Te avisamos cuando respondan."
                    hidden={{ businessId: b.id }}
                  >
                    {b.branches.length > 1 && (
                      <FormInput
                        form={`${joinId(b)}-form`}
                        name="branchId"
                        label="Sucursal"
                        hint="Opcional. Quien administra decide al aceptar."
                        options={[{ value: "", label: "La que necesiten" }, ...b.branches.map((br) => ({ value: br.id, label: br.name }))]}
                      />
                    )}
                    <FormInput
                      form={`${joinId(b)}-form`}
                      name="message"
                      label="Mensaje"
                      rows={3}
                      maxlength={300}
                      placeholder="Ej.: Hola, trabajo de cajera hace 2 años y puedo en el turno de la tarde."
                      hint="Opcional. Cuéntales quién eres y en qué puedes ayudar."
                    />
                  </Modal>
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    {
      pages > 1 && (
        <nav class="pager" aria-label="Páginas de resultados">
          {page > 1 ? (
            <a class="btn btn-secondary" href={pageHref(page - 1)} rel="prev">
              <ArrowLeft size={16} stroke-width={1.75} aria-hidden="true" />
              Anterior
            </a>
          ) : (
            <span />
          )}
          <span class="num">Página {page} de {pages}</span>
          {page < pages ? (
            <a class="btn btn-secondary" href={pageHref(page + 1)} rel="next">
              Siguiente
              <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </section>
</Layout>

<script>
  import { onPage, refreshRegions } from "@/scripts/refresh";

  // Busca mientras se escribe: cambia la dirección (sin sumar al historial) y solo la región de resultados, así el
  // foco y el cursor se quedan en el buscador. Una respuesta vieja se descarta sola: refreshRegions la ignora si la
  // dirección ya cambió.
  onPage((signal) => {
    const form = document.querySelector<HTMLFormElement>("[data-directory-search]");
    if (!form) return;
    const status = form.querySelector<HTMLElement>("[data-search-status]")!;
    let timer = 0;

    const search = async () => {
      clearTimeout(timer);
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form)) if (typeof value === "string" && value.trim()) params.set(key, value.trim());
      const url = params.size ? `${form.action}?${params}` : form.action;
      if (url === location.href) return;
      history.replaceState(history.state, "", url);
      await refreshRegions(["results"], url);
      if (location.href === new URL(url, location.href).href) status.textContent = document.querySelector("[data-results-title]")?.textContent ?? "";
    };

    form.addEventListener("input", (event) => {
      if (!(event.target as Element).matches('input[name="q"]')) return;
      clearTimeout(timer);
      timer = window.setTimeout(search, 250);
    }, { signal });
    // El rubro (campo oculto de SelectMenu) avisa con «change».
    form.addEventListener("change", (event) => (event.target as Element).matches('input[name="rubro"]') && search(), { signal });
    form.addEventListener("submit", (event) => (event.preventDefault(), search()), { signal });
    signal.addEventListener("abort", () => clearTimeout(timer));
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
  }

  .filters .grow {
    flex: 2 1 16rem;
  }

  .kind-field {
    flex: 1 1 14rem;
    min-width: 0;
  }

  .search-input {
    position: relative;
  }

  .search-input :global(svg) {
    position: absolute;
    top: 50%;
    left: 0.75rem;
    translate: 0 -50%;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input .input {
    width: 100%;
    padding-left: 2.5rem;
  }

  /* El campo del rubro mide lo mismo que el buscador (SelectMenu trae 3.5rem para opciones con dos líneas). */
  .kind-field :global(.select-trigger) {
    min-height: 2.75rem;
  }

  @media (min-width: 769px) and (pointer: fine) {
    .kind-field :global(.select-trigger) {
      min-height: 2.5rem;
    }
  }

  .kind-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .kind-option :global(svg) {
    flex: none;
    color: var(--color-text-muted);
  }

  .kind-text {
    display: grid;
    min-width: 0;
  }

  .kind-hint {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--color-text-muted);
  }

  /* En el campo basta el nombre: la descripción se lee en la lista. */
  :global(.select-trigger) .kind-hint {
    display: none;
  }

  .results-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 1rem;
  }

  .results-title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .clear-link {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1.25rem;
  }

  .result-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }

  /* Arte cuadrado de la tarjeta: la foto del negocio o su monograma. */
  .logo {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 4rem;
    height: 4rem;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: var(--text-lg);
    font-weight: var(--font-extrabold);
    box-shadow: var(--shadow-md);
  }

  .logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .result-name {
    display: grid;
    justify-items: start;
    gap: 0.375rem;
    min-width: 0;
  }

  .result-name h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.25;
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .kind-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .kind-chip :global(svg) {
    color: var(--color-text-muted);
  }

  /* Tres líneas como mucho: las tarjetas quedan parejas. */
  .description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .branches {
    display: grid;
    gap: 0.375rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
  }

  .branches-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-bold);
  }

  .branches-title :global(svg) {
    color: var(--color-text-muted);
  }

  .branches ul {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  /* Una línea por sucursal: el nombre se ve entero y la dirección se corta con «…» (completa en el title). */
  .branches li {
    display: flex;
    gap: 0.3em;
    min-width: 0;
    white-space: nowrap;
  }

  .branch-name {
    flex-shrink: 0;
    max-width: 60%;
    overflow: hidden;
    font-weight: var(--font-semibold);
    text-overflow: ellipsis;
  }

  .branch-address {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-muted);
    text-overflow: ellipsis;
  }

  .branch-address::before {
    content: "· ";
  }

  .branches-more {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
  }

  .result-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .result-action .btn-primary {
    flex: 1;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .status :global(svg) {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .empty p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .empty .empty-title {
    color: var(--color-text);
    font-weight: var(--font-semibold);
  }

  .empty-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
