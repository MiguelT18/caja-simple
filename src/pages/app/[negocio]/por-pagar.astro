---
import PageHeader from "@/components/PageHeader.astro";
import PayablesCard from "@/components/app/PayablesCard";
import Layout from "@/layouts/Layout.astro";
import { CircleAlert, CircleCheck } from "@lucide/astro";
import { headerBackdrop, membership, paidSince, payables } from "@/data/queries";
import { branchHref } from "@/data/routes";
import { today as todayOf } from "@/lib/dates";
import { formatBs, plural } from "@/lib/format";
import { dueState } from "@/lib/payables";

// Lo que falta pagar en cada sucursal y, para la dueña, sus gastos fijos. La empleada ve la suya (m.branches y RLS):
// lo que le toca saldar, lo que paga la dueña y sus reembolsos.
const m = membership(Astro.locals, Astro.params.negocio!);
if (!m) return Astro.rewrite("/404");
const isOwner = m.role === "dueño";
const today = todayOf();
const branchIds = m.branches.map((b) => b.id);
const [owed, paidThisMonth, backdrop] = await Promise.all([
  payables(Astro.locals.supabase, branchIds, today),
  paidSince(Astro.locals.supabase, branchIds, `${today.slice(0, 8)}01`),
  headerBackdrop(Astro.locals, m),
]);
const total = owed.pending.reduce((s, p) => s + p.balance, 0);
const lateItems = owed.pending.filter((p) => dueState(p.dueOn, today).tone === "late");
const late = lateItems.reduce((s, p) => s + p.balance, 0);
const many = m.branches.length > 1;
---

<Layout title={`Por pagar · ${m.business.name}`} context={{ membership: m }}>
  <PageHeader {...backdrop} title="Por pagar" live description={isOwner ? "Gastos fijos y pendientes de todas tus sucursales. Al pagarlos, quedan con el día que tocaba." : `Lo que falta pagar en ${m.branches[0]?.name ?? "tu sucursal"}. Lo que pagues de tu bolsillo queda como reembolso que te paga la dueña.`} />

  <section class="kpis" aria-label="Totales de todas las sucursales" data-region="payables-totals">
    <div class="kpi">
      <p class="kpi-label">Por pagar</p>
      <p class="kpi-value num">{formatBs(total)}</p>
      <p class="kpi-note">{owed.pending.length === 0 ? "Nada pendiente" : plural(owed.pending.length, "pago", "pagos")}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Vencido</p>
      <p class:list={["kpi-value num", late > 0 && "amount-expense"]}>{formatBs(late)}</p>
      <p class:list={["kpi-note late-note", late > 0 && "is-late"]}>
        {late > 0 ? <CircleAlert size={16} stroke-width={1.75} /> : <CircleCheck size={16} stroke-width={1.75} />}
        {late > 0 ? plural(lateItems.length, "pago vencido", "pagos vencidos") : "Nada vencido"}
      </p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Pagado este mes</p>
      <p class="kpi-value num">{formatBs(paidThisMonth)}</p>
      <p class="kpi-note">Desde el día 1</p>
    </div>
  </section>

  <div class="branches" data-region="payables">
    {
      m.branches.map((b) => (
        <section aria-label={many ? b.name : undefined}>
          {many && (
            <div class="shelf-head">
              <h2>{b.name}</h2>
              <a href={branchHref(m.business, b, "gastos")} class="shelf-link">Ver gastos</a>
            </div>
          )}
          <PayablesCard
            client:load
            branchId={b.id}
            pending={owed.pending.filter((p) => p.branchId === b.id)}
            fixed={owed.fixed.filter((f) => f.branchId === b.id)}
            today={today}
            userId={Astro.locals.userId!}
            isOwner={isOwner}
            canAdd
            cashShift={null}
            myEmployeeId={m.employee?.branchId === b.id ? m.employee.id : null}
          />
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .kpis {
    margin: 0 0 2.5rem;
  }

  .late-note {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .late-note.is-late {
    color: var(--color-expense);
    font-weight: var(--font-semibold);
  }

  .branches {
    display: grid;
    gap: 1.5rem;
  }

  .branches .shelf-head {
    margin-top: 1rem;
  }
</style>
