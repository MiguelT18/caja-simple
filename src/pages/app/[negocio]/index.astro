---
import { CircleCheck, Clock, Store, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import BarCompareChart from "@/components/app/charts/BarCompareChart";
import Layout from "@/layouts/Layout.astro";
import { businessContext, businessHref } from "@/data/queries";
import { formatBs } from "@/lib/format";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, branchSummary, salesTotal, expensesTotal } = ctx;
const balance = salesTotal - expensesTotal;
const rows = branchSummary.map((b) => ({ label: b.branch.name, sales: b.sales, expenses: b.expenses }));
---

<Layout title={`Resumen · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader
    title="Resumen del negocio"
    description={`${business.name} · ${branchSummary.length === 1 ? "hoy" : `hoy en sus ${branchSummary.length} sucursales`}`}
  />

  <section class="kpis" aria-label="Totales de hoy en todas las sucursales">
    <div class="kpi">
      <p class="kpi-label">Ventas</p>
      <p class="kpi-value num amount-income">{formatBs(salesTotal, "+")}</p>
      <p class="kpi-note">{branchSummary.reduce((n, b) => n + b.salesCount, 0)} ventas</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Gastos</p>
      <p class="kpi-value num amount-expense">{formatBs(expensesTotal, "−")}</p>
      <p class="kpi-note">Entre todas las sucursales</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Saldo del día</p>
      <p class:list={["kpi-value num", { "amount-expense": balance < 0 }]}>{formatBs(balance)}</p>
      <p class="kpi-note">Ventas menos gastos</p>
    </div>
  </section>

  <section class="card chart-card" aria-labelledby="compare-title">
    <h2 id="compare-title" class="card-title">Ventas y gastos por sucursal</h2>
    <BarCompareChart client:visible rows={rows} />
  </section>

  <div class="shelf-head">
    <h2>Cada sucursal hoy</h2>
    <a href={`${businessHref(business)}/sucursales`} class="shelf-link">Mostrar todo</a>
  </div>
  <ul class="branch-list" role="list">
    {
      branchSummary.map((b, i) => (
        <li class="branch-row" style={`--branch: var(--color-branch-${(i % 6) + 1})`}>
          <a href={b.href} class="branch-link">
            <span class="branch-art" aria-hidden="true">
              <Store size={20} stroke-width={1.75} />
            </span>
            <span class="branch-name">{b.branch.name}</span>
          </a>
          <span class="num amount-income">{formatBs(b.sales, "+")}</span>
          <span class="num amount-expense">{formatBs(b.expenses, "−")}</span>
          <span class="status">
            {b.cash === "cuadra" && (
              <span class="chip chip-income">
                <CircleCheck size={14} stroke-width={2} />
                La caja cuadró
              </span>
            )}
            {b.cash === "descuadre" && (
              <span class="chip chip-warning">
                <TriangleAlert size={14} stroke-width={2} />
                Caja descuadrada
              </span>
            )}
            {b.cash === "en-curso" && (
              <span class="chip chip-live">
                <span class="live-dot" aria-hidden="true" />
                Turno en curso
              </span>
            )}
            {b.cash === "sin-abrir" && (
              <span class="chip chip-neutral">
                <Clock size={14} stroke-width={2} />
                Sin turnos abiertos hoy
              </span>
            )}
            {b.lowStock > 0 && (
              <span class="chip chip-warning">
                <TriangleAlert size={14} stroke-width={2} />
                {b.lowStock} {b.lowStock === 1 ? "producto" : "productos"} con stock bajo
              </span>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .chart-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
  }

  /* Sucursales como filas de una lista: sin tarjeta, con hover redondeado. */
  .branch-list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .branch-row {
    display: grid;
    grid-template-columns: minmax(10rem, 1.2fr) repeat(2, minmax(7rem, auto)) minmax(0, 2fr);
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border-radius: 0.375rem;
    transition: background-color 150ms;
  }

  .branch-row:hover {
    background: var(--color-surface-hover);
  }

  .branch-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    color: var(--color-text);
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .branch-link:hover .branch-name {
    text-decoration: underline;
  }

  .branch-art {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--branch) 22%, var(--color-surface));
    color: var(--branch);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  @media (max-width: 960px) {
    .branch-row {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem 1.5rem;
    }

    .branch-link,
    .status {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
</style>
