---
import { ArrowRight, ChartColumnIncreasing, CircleCheck, Clock, Lightbulb, PackageX, Store, TrendingDown, TrendingUp, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import SetupChecklist from "@/components/app/SetupChecklist.astro";
import BarCompareChart from "@/components/app/charts/BarCompareChart";
import Layout from "@/layouts/Layout.astro";
import {
  branchColor,
  branchHref,
  businessContext,
  businessHref,
  businessStats,
  daysSince,
  firstSteps,
  hourSpan,
  marketingIdeas,
  peakHour,
  statsPeriods,
  statsRange,
  trend,
  weekdayName,
  weekdayRange,
} from "@/data/queries";
import { planLimits } from "@/data/plans";
import { formatBs, plural } from "@/lib/format";
import { longDate, today } from "@/lib/dates";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, branchSummary, salesTotal, expensesTotal } = ctx;
const balance = salesTotal - expensesTotal;
const salesCount = branchSummary.reduce((n, b) => n + b.salesCount, 0);
const rows = branchSummary.map((b) => ({ label: b.branch.name, sales: b.sales, expenses: b.expenses }));
const steps = await firstSteps(Astro.locals, branchSummary.map((b) => b.branch.id));

// Estadísticas del período elegido (?periodo=). Más vendidos y sucursales para todos; lo demás desde el plan Negocio.
const limits = planLimits[business.plan];
const insightsAllowed = limits.reports;
const periods = statsPeriods(limits.historyDays);
const range = statsRange(Astro.url.searchParams.get("periodo"), today(), limits.historyDays);
// Si la consulta falla, el resto del Resumen se sigue viendo.
const loaded = await businessStats(Astro.locals.supabase, business.id, range).catch((e) => {
  console.error(JSON.stringify({ level: "error", source: "business-stats", message: String(e) }));
  return null;
});
const stats = loaded?.stats;
const statsTotal = stats ? stats.branches.reduce((n, b) => n + b.revenue, 0) : 0;
const statsSales = stats ? stats.branches.reduce((n, b) => n + b.sales, 0) : 0;
const topProducts = stats?.products.slice(0, 5) ?? [];
const topRevenue = topProducts[0]?.revenue || 1;
const branchRank = branchSummary
  .map(({ branch }) => {
    const b = stats?.branches.find((x) => x.id === branch.id);
    return { branch, revenue: b?.revenue ?? 0, sales: b?.sales ?? 0 };
  })
  .sort((a, b) => b.revenue - a.revenue);
const change = trend(statsTotal, loaded?.previous ?? null);
const peak = stats && peakHour(stats.hours);
const week = stats && weekdayRange(stats.weekdays);
const ideas = stats
  ? marketingIdeas({
      stats,
      previous: loaded!.previous,
      days: range.days,
      today: today(),
      branches: branchSummary.map(({ branch }) => ({ id: branch.id, name: branch.name, inventoryHref: branchHref(business, branch, "inventario") })),
      soldIn: new Map(ctx.catalog.map((p) => [p.id, new Set(p.soldIn.map((s) => s.branchId))])),
      catalogHref: `${businessHref(business)}/catalogo`,
    })
  : [];
const periodLabel = periods.find((p) => p.value === range.period)!.label;
const ticket = (revenue: number, sales: number) => (sales ? revenue / sales : 0);
const firstBranch = branchSummary[0]?.branch;
// Con menos ventas que esto, un «más vendido» o una hora pico no dicen nada: se pide más datos en vez de mostrar cifras.
const MIN_SALES = 5;
const longerPeriod = periods.find((p) => p.value === "todo") ?? periods[periods.length - 1];
---

<Layout title={`Resumen · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader
    eyebrow={longDate(today())}
    title={business.name}
    {...ctx.backdrop}
    description={branchSummary.length === 1 ? "Cómo va la caja hoy." : `Cómo va la caja hoy en tus ${branchSummary.length} sucursales.`}
  />

  <SetupChecklist
    business={business}
    branch={branchSummary[0]?.branch}
    hasProducts={ctx.catalog.length > 0}
    hasStock={ctx.catalog.some((p) => p.soldIn.length > 0)}
    {...steps}
  />

  <section class="kpis" aria-label="Totales de hoy en todas las sucursales">
    <div class="kpi">
      <p class="kpi-label">Ventas</p>
      <p class="kpi-value num amount-income">{formatBs(salesTotal, "+")}</p>
      <p class="kpi-note">{plural(salesCount, "venta", "ventas")}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Gastos</p>
      <p class="kpi-value num amount-expense">{formatBs(expensesTotal, "−")}</p>
      <p class="kpi-note">{branchSummary.length === 1 ? "Salidas de la caja" : "Entre todas las sucursales"}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Saldo del día</p>
      <p class:list={["kpi-value num", { "amount-expense": balance < 0 }]}>{formatBs(balance)}</p>
      <p class="kpi-note">Ventas menos gastos</p>
    </div>
  </section>

  {/* Con una sola sucursal el gráfico repetiría las cifras de arriba. */}
  {
    rows.length > 1 && (
      <section class="card chart-card" aria-labelledby="compare-title">
        <h2 id="compare-title" class="card-title">Ventas y gastos por sucursal</h2>
        <BarCompareChart client:visible rows={rows} />
      </section>
    )
  }

  <div class="shelf-head">
    <h2>{branchSummary.length === 1 ? "Tu sucursal hoy" : "Sucursales hoy"}</h2>
    <a href={`${businessHref(business)}/sucursales`} class="shelf-link">Ver sucursales</a>
  </div>
  <ul class="branch-list" role="list">
    {
      branchSummary.map((b, i) => (
        <li class="branch-row" style={`--branch: var(--color-branch-${(i % 6) + 1})`}>
          <a href={b.href} class="branch-link">
            <span class="branch-art" aria-hidden="true">
              <Store size={20} stroke-width={1.75} />
            </span>
            <span class="branch-name">{b.branch.name}</span>
          </a>
          <span class="num amount-income"><span class="sr-only">Ventas: </span>{formatBs(b.sales, "+")}</span>
          <span class="num amount-expense"><span class="sr-only">Gastos: </span>{formatBs(b.expenses, "−")}</span>
          <span class="status">
            {b.cash === "cuadra" && (
              <span class="chip chip-income">
                <CircleCheck size={14} stroke-width={2} />
                La caja cuadró
              </span>
            )}
            {b.cash === "descuadre" && (
              <span class="chip chip-warning">
                <TriangleAlert size={14} stroke-width={2} />
                Caja descuadrada
              </span>
            )}
            {b.cash === "en-curso" && (
              <span class="chip chip-live">
                <span class="live-dot" aria-hidden="true" />
                Turno en curso
              </span>
            )}
            {b.cash === "sin-abrir" && (
              <span class="chip chip-neutral">
                <Clock size={14} stroke-width={2} />
                Sin abrir hoy
              </span>
            )}
            {b.lowStock > 0 && (
              <span class="chip chip-warning">
                <TriangleAlert size={14} stroke-width={2} />
                {plural(b.lowStock, "producto", "productos")} con stock bajo
              </span>
            )}
          </span>
        </li>
      ))
    }
  </ul>

  <section class="stats" aria-labelledby="stats-title" data-region="stats">
    <div class="shelf-head stats-head">
      <h2 id="stats-title">Cómo va tu negocio</h2>
      <nav aria-label="Período de las estadísticas">
        <ul class="periods" role="list">
          {
            periods.map((p) => (
              <li>
                <a href={`?periodo=${p.value}`} class="period" data-stats-period aria-current={p.value === range.period ? "page" : undefined}>
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {
      !stats ? (
        <p class="notice notice-error">No pudimos cargar las estadísticas. Vuelve a intentarlo en un rato.</p>
      ) : statsSales < MIN_SALES ? (
        <div class="stats-empty">
          <span class="empty-art" aria-hidden="true">
            <ChartColumnIncreasing size={28} stroke-width={1.75} />
          </span>
          <h3 class="stats-empty-title">Aún faltan ventas para tus estadísticas</h3>
          <p class="stats-empty-text">
            {statsSales === 0
              ? `No hay ventas en ${range.period === "todo" ? "tu negocio" : `los últimos ${periodLabel}`}.`
              : `Llevas ${plural(statsSales, "venta", "ventas")} en ${range.period === "todo" ? "total" : `los últimos ${periodLabel}`}.`}{" "}
            Con {MIN_SALES} te mostramos lo que más se vende, tus sucursales y tu ritmo.
          </p>
          <div class="empty-progress">
            <span class="num">{Math.min(statsSales, MIN_SALES)} de {MIN_SALES} ventas</span>
            <span class="bar" style={`--fill: ${(Math.min(statsSales, MIN_SALES) / MIN_SALES) * 100}%`} aria-hidden="true" />
          </div>
          <div class="stats-empty-actions">
            {firstBranch && (
              <a href={branchHref(business, firstBranch, "registrar-venta")} class="btn btn-primary">
                Ir a Vender
                <ArrowRight size={18} stroke-width={2} />
              </a>
            )}
            {range.period !== longerPeriod.value && (
              <a href={`?periodo=${longerPeriod.value}`} class="btn btn-secondary" data-stats-period>
                Ver {longerPeriod.value === "todo" ? "todo el historial" : `los últimos ${longerPeriod.label}`}
              </a>
            )}
          </div>
        </div>
      ) : (
        <>
          <div class="stats-grid">
            <section class="card stat-card" aria-labelledby="top-title">
              <h3 id="top-title" class="card-title">Lo que más se vende</h3>
              <ol class="rank" role="list">
                {topProducts.map((p, i) => (
                  <li class="rank-row">
                    <span class="rank-pos num" aria-hidden="true">{i + 1}</span>
                    <span class="rank-text">
                      <span class="rank-name">
                        <span class="sr-only">{i + 1}. </span>
                        {p.name}
                      </span>
                      <span class="rank-meta">{plural(p.qty, "vendido", "vendidos")}</span>
                      <span class="bar" style={`--fill: ${(p.revenue / topRevenue) * 100}%`} aria-hidden="true" />
                    </span>
                    <span class="num rank-value">{formatBs(p.revenue)}</span>
                  </li>
                ))}
              </ol>
            </section>

            {
              branchSummary.length > 1 ? (
                <section class="card stat-card" aria-labelledby="branches-rank-title">
                  <h3 id="branches-rank-title" class="card-title">Sucursales que más venden</h3>
                  <ol class="rank" role="list">
                    {branchRank.map((b, i) => (
                      <li class="rank-row" style={`--branch: ${branchColor(ctx.membership, b.branch.id)}`}>
                        <span class="branch-art branch-art-sm" aria-hidden="true">
                          <Store size={16} stroke-width={1.75} />
                        </span>
                        <span class="rank-text">
                          <span class="rank-name">
                            <span class="sr-only">{i + 1}. </span>
                            {b.branch.name}
                          </span>
                          <span class="rank-meta">
                            {statsTotal ? Math.round((b.revenue / statsTotal) * 100) : 0} % del total · {plural(b.sales, "venta", "ventas")} · {formatBs(ticket(b.revenue, b.sales))} por venta
                          </span>
                          <span class="bar" style={`--fill: ${statsTotal ? (b.revenue / (branchRank[0].revenue || 1)) * 100 : 0}%`} aria-hidden="true" />
                        </span>
                        <span class="num rank-value">{formatBs(b.revenue)}</span>
                      </li>
                    ))}
                  </ol>
                </section>
              ) : (
                <section class="card stat-card" aria-labelledby="ticket-title">
                  <h3 id="ticket-title" class="card-title">Por venta</h3>
                  <p class="big num">{formatBs(ticket(statsTotal, statsSales))}</p>
                  <p class="stat-note">
                    Promedio de {plural(statsSales, "venta", "ventas")} por {formatBs(statsTotal)} en {range.period === "todo" ? "total" : `los últimos ${periodLabel}`}.
                  </p>
                </section>
              )
            }
          </div>

          {
            !insightsAllowed ? (
              <p class="notice stats-upsell">
                La tendencia, tu hora pico, los productos que no se mueven e ideas para vender más son del plan Negocio.{" "}
                <a href={`${businessHref(business)}/plan`}>Ver los planes</a>
              </p>
            ) : (
              <>
                <div class="stats-grid">
                  <section class="card stat-card" aria-labelledby="trend-title">
                    <h3 id="trend-title" class="card-title">Ventas {range.period === "todo" ? "desde el inicio" : `de los últimos ${periodLabel}`}</h3>
                    <p class="big num amount-income">{formatBs(statsTotal, "+")}</p>
                    {change !== null ? (
                      <p class:list={["trend", change < 0 ? "trend-down" : "trend-up"]}>
                        {change < 0 ? <TrendingDown size={18} stroke-width={1.75} /> : <TrendingUp size={18} stroke-width={1.75} />}
                        {change === 0 ? "Igual" : `${Math.abs(change)} % ${change < 0 ? "menos" : "más"}`} que en los {range.days} días anteriores
                      </p>
                    ) : (
                      <p class="stat-note">{range.period === "todo" ? "Todo lo vendido desde tu primera venta." : "Sin ventas en el período anterior para comparar."}</p>
                    )}
                  </section>
                  <section class="card stat-card" aria-labelledby="rhythm-title">
                    <h3 id="rhythm-title" class="card-title">Tu ritmo</h3>
                    <dl class="rhythm">
                      <div>
                        <dt>Hora pico</dt>
                        <dd>{peak ? hourSpan(peak.hour) : "—"}</dd>
                      </div>
                      <div>
                        <dt>Mejor día</dt>
                        <dd>{week ? weekdayName(week.best.dow) : "—"}</dd>
                      </div>
                      <div>
                        <dt>Día más flojo</dt>
                        <dd>{week ? weekdayName(week.worst.dow) : "—"}</dd>
                      </div>
                    </dl>
                  </section>
                </div>

                {stats.quiet.length > 0 && (
                  <section class="card stat-card" aria-labelledby="quiet-title">
                    <h3 id="quiet-title" class="card-title">Productos que no se mueven</h3>
                    <p class="stat-note">Tienen stock y no se venden hace más de 30 días.</p>
                    <ul class="quiet" role="list">
                      {stats.quiet.map((q) => (
                        <li>
                          <PackageX size={18} stroke-width={1.75} aria-hidden="true" />
                          <span class="rank-name">{q.name}</span>
                          <span class="rank-meta">
                            {q.lastSale ? `Sin ventas hace ${daysSince(q.lastSale, today())} días` : "Nunca se vendió"} · {q.stock} en stock
                          </span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                <section aria-labelledby="ideas-title" class="ideas-block">
                  <h3 id="ideas-title" class="ideas-title">Ideas para vender más</h3>
                  {ideas.length === 0 ? (
                    <p class="stat-note">Todavía no hay suficientes ventas para sugerirte ideas. Aparecen a medida que vendes.</p>
                  ) : (
                  <>
                    <p class="stat-note">Sugerencias a partir de tus ventas.</p>
                    <ul class="ideas" role="list">
                      {ideas.map((idea) => (
                        <li class="card idea">
                          <Lightbulb size={20} stroke-width={1.75} aria-hidden="true" />
                          <p>{idea.text}</p>
                          {idea.href && (
                            <a href={idea.href} class="shelf-link idea-link">
                              {idea.linkLabel}
                              <ArrowRight size={14} stroke-width={2} />
                            </a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </>
                  )}
                </section>
              </>
            )
          }
        </>
      )
    }
  </section>
</Layout>

<script>
  import { onRegions, refreshRegions } from "@/scripts/refresh";

  // El período cambia solo la sección de estadísticas: sin navegar, así el panel no salta ni se vuelve esqueleto.
  onRegions((root) => {
    for (const link of root.querySelectorAll<HTMLAnchorElement>("[data-stats-period]")) {
      link.addEventListener("click", async (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const section = link.closest<HTMLElement>("[data-region=stats]");
        section?.setAttribute("aria-busy", "true");
        history.replaceState(history.state, "", link.href);
        await refreshRegions(["stats"], link.href);
        // El foco queda en la píldora del período elegido (el enlace pulsado ya no existe).
        document.querySelector<HTMLElement>('[data-region=stats] .period[aria-current]')?.focus({ preventScroll: true });
      });
    }
  });
</script>

<style>
  .chart-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
  }

  /* Sucursales como filas de una lista: sin tarjeta, con hover redondeado. */
  .branch-list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .branch-row {
    display: grid;
    grid-template-columns: minmax(10rem, 1.2fr) repeat(2, minmax(7rem, auto)) minmax(0, 2fr);
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border-radius: 0.375rem;
    transition: background-color 150ms;
  }

  .branch-row:hover {
    background: var(--color-surface-hover);
  }

  .branch-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    color: var(--color-text);
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .branch-link:hover .branch-name {
    text-decoration: underline;
  }

  .branch-art {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--branch) 22%, var(--color-surface));
    color: var(--branch);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  @media (max-width: 960px) {
    .branch-row {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem 1.5rem;
    }

    .branch-link,
    .status {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
  /* --- Cómo va tu negocio --- */
  .stats {
    display: grid;
    gap: 1rem;
  }

  .stats-head {
    flex-wrap: wrap;
    align-items: center;
  }

  .periods {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .period {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    background: var(--color-surface-muted);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: background-color 150ms;
  }

  .period:hover {
    background: var(--color-surface-hover);
  }

  /* Píldora activa invertida, como los filtros de Vender. */
  .period[aria-current] {
    background: var(--color-text);
    color: var(--color-surface);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .stat-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.25rem;
  }

  /* Sin datos suficientes: una tarjeta centrada que dice cuánto falta y qué hacer. */
  .stats-empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: clamp(1.75rem, 5vw, 2.75rem) 1.25rem;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
    text-align: center;
  }

  .empty-art {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.25rem;
    border-radius: 50%;
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
  }

  .stats-empty-title {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--text-xl-lh);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.01em;
  }

  .stats-empty-text {
    max-width: 30rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .empty-progress {
    display: grid;
    gap: 0.375rem;
    width: min(14rem, 100%);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .stats-empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  /* Mientras llega el período nuevo: la sección queda a la vista, atenuada. */
  .stats[aria-busy="true"] {
    opacity: 0.55;
    transition: opacity 150ms;
  }

  .stat-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .big {
    margin: 0;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.02em;
  }

  .rank {
    display: grid;
    gap: 0.25rem;
    margin: 0 -0.5rem;
    padding: 0;
    list-style: none;
  }

  .rank-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 0.375rem;
  }

  .rank-row:hover {
    background: var(--color-surface-hover);
  }

  .rank-pos {
    width: 1.5rem;
    color: var(--color-text-muted);
    font-weight: var(--font-bold);
    text-align: center;
  }

  .rank-text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .rank-name {
    font-weight: var(--font-semibold);
    overflow-wrap: anywhere;
  }

  .rank-meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .rank-value {
    font-weight: var(--font-bold);
    white-space: nowrap;
  }

  /* La barra solo acompaña a la cifra escrita. */
  .bar {
    height: 0.25rem;
    margin-top: 0.25rem;
    border-radius: 999px;
    background: linear-gradient(var(--color-income), var(--color-income)) 0 0 / var(--fill) 100% no-repeat, var(--color-border);
  }

  .branch-art-sm {
    width: 2.25rem;
    height: 2.25rem;
