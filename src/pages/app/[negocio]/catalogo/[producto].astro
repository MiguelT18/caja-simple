---
// Crear (/catalogo/nuevo, ?tipo=combo&con=a,b para armar un combo) y editar (/catalogo/[id]) un producto del catálogo.
// La página se adapta a cómo se vende y a lo que el negocio eligió mostrar (businesses.product_form).
import { ArrowLeft } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ProductEditor from "@/components/app/products/ProductEditor";
import Layout from "@/layouts/Layout.astro";
import { catalogLabel } from "@/data/kinds";
import { businessContext, businessHref } from "@/data/queries";
import { planLimits } from "@/data/plans";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, catalog, categories } = ctx;
const creating = Astro.params.producto === "nuevo";
const product = creating ? undefined : catalog.find((p) => p.id === Astro.params.producto);
if (!creating && !product) return Astro.rewrite("/404");

const limits = planLimits[business.plan];
const combo = creating ? Astro.url.searchParams.get("tipo") === "combo" && limits.bulk : Boolean(product?.components);
const seed = (Astro.url.searchParams.get("con") ?? "").split(",").filter(Boolean).slice(0, 20);
const catalogHref = `${businessHref(business)}/catalogo`;
const label = catalogLabel(business.kind);
const title = product ? product.name : combo ? "Armar combo" : business.kind === "restaurante" ? "Nuevo plato" : "Nuevo producto";
const description = product
  ? "Cambia cómo se ve y se vende. El stock de cada sucursal se cambia en su inventario."
  : combo
    ? "Junta productos de tu catálogo y véndelos a un precio propio."
    : "Elige cómo se vende y completa solo lo que te sirve. Lo que escribes se guarda como borrador hasta que guardes.";
---

<Layout title={`${title} · ${label} · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader {...ctx.backdrop} title={title} description={description}>
    <a slot="back" class="back" href={catalogHref}><ArrowLeft size={16} stroke-width={1.75} />{label}</a>
  </PageHeader>

  <div data-region="product-editor">
    <ProductEditor
      client:load
      businessId={business.id}
      kind={business.kind}
      config={business.productForm}
      categories={categories}
      catalog={catalog}
      branches={ctx.membership.branches.map((b) => ({ id: b.id, name: b.name }))}
      product={product}
      combo={combo}
      comboSeed={seed}
      limits={limits}
      catalogHref={catalogHref}
      planHref={`${businessHref(business)}/plan`}
    />
  </div>
</Layout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
  }
</style>
