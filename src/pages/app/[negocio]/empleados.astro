---
import { ChevronLeft, ChevronRight, User, UserPlus } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import EmployeesTable from "@/components/app/EmployeesTable";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import Layout from "@/layouts/Layout.astro";
import { businessContext, fullName, joinRequests } from "@/data/queries";
import { stamp } from "@/lib/dates";
import { plural } from "@/lib/format";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, branchById, employees, shiftById, shifts, branches } = ctx;
const requests = await joinRequests(Astro.locals, business.id);
const shiftOptions = [
  { value: "", label: "Elige un turno" },
  ...shifts.map((s) => ({ value: s.id, label: branches.length > 1 ? `${branchById(s.branchId)?.name} · ${s.name}` : s.name })),
];

const rows = employees.map((e) => {
  const shift = shiftById(e.shiftId);
  return {
    id: e.id,
    avatarSeed: e.personId ?? e.id,
    name: fullName(e),
    email: e.email,
    role: e.jobTitle,
    branchId: e.branchId,
    branch: branchById(e.branchId)?.name ?? "—",
    shiftId: e.shiftId ?? undefined,
    shift: shift && { name: shift.name, tone: shift.tone },
    active: e.status === "activo",
  };
});
---

<Layout title={`Empleados · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader {...ctx.backdrop} title="Empleados" live description={`${plural(employees.length, "persona", "personas")} en las sucursales de ${business.name}. Entran gratis, siempre.`}>
    <button type="button" class="btn btn-primary" data-open-dialog="invite"><UserPlus size={18} stroke-width={2} />Invitar empleado</button>
  </PageHeader>

  <Modal
    id="invite"
    title="Invitar empleado"
    description="Le llega la invitación a sus avisos y entra al negocio cuando la acepta."
    action="inviteEmployee"
    submitLabel="Invitar"
    hidden={{ businessId: business.id }}
  >
    <FormInput
      form="invite-form"
      name="person"
      label="Nombre o correo"
      placeholder="Ej.: Ana Pérez o ana@gmail.com"
      hint="Busca a la persona por su nombre o su correo. Si todavía no tiene cuenta, escribe su correo completo y le llega una invitación para crearla."
      required
      autocapitalize="none"
      spellcheck="false"
      autocomplete="off"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="people-suggest-list"
      aria-expanded="false"
      data-people-search={business.id}
    />
    <!-- La cuenta elegida entre las sugerencias encontradas por nombre: se invita por ella, sin conocer su correo. -->
    <input type="hidden" name="personId" form="invite-form" data-person-id />
    <!-- Dentro del diálogo: lo de afuera queda inerte mientras está abierto. -->
    <div id="people-suggest" class="suggest" popover="manual">
      <ul class="suggest-skeleton" aria-hidden="true">
        {[0, 1, 2].map(() => (
          <li>
            <span class="sk sk-avatar" />
            <span class="sk-lines">
              <span class="sk sk-name" />
              <span class="sk sk-email" />
            </span>
          </li>
        ))}
      </ul>
      <ul class="suggest-list" id="people-suggest-list" role="listbox" aria-label="Cuentas registradas"></ul>
      <p class="suggest-empty"></p>
      <div class="suggest-pager">
        <button type="button" class="pager-btn" data-step="-1" tabindex="-1" aria-label="Página anterior">
          <ChevronLeft size={16} stroke-width={2} />
        </button>
        <span class="pager-info"></span>
        <button type="button" class="pager-btn" data-step="1" tabindex="-1" aria-label="Página siguiente">
          <ChevronRight size={16} stroke-width={2} />
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-status></p>
      <p class="sr-only" id="people-keys">Con las flechas arriba y abajo eliges una cuenta; con RePág y AvPág cambias de página.</p>
    </div>
    <FormInput form="invite-form" name="jobTitle" label="Puesto" placeholder="Ej.: Cajera" required maxlength={60} />
    <div class="field-row-2">
      <FormInput form="invite-form" name="branchId" label="Sucursal" required options={branches.map((b) => ({ value: b.id, label: b.name }))} />
      <FormInput
        form="invite-form"
        name="shiftId"
        label="Turno"
        required
        options={[
          { value: "", label: "Elige un turno" },
          ...shifts.map((s) => ({ value: s.id, label: branches.length > 1 ? `${branchById(s.branchId)?.name} · ${s.name}` : s.name })),
        ]}
      />
    </div>
  </Modal>

  <section id="pedidos" class="requests" data-region="join-requests" aria-labelledby="requests-title" hidden={requests.length === 0}>
    <h2 id="requests-title">Pedidos para unirse</h2>
    <p class="requests-hint">Personas que encontraron {business.name} en Buscar. Al aceptar, eliges su sucursal, su turno y su puesto.</p>
    <ul class="request-list" role="list">
      {requests.map((r) => (
        <li class="request card">
          <div class="request-body">
            <p class="request-name">{r.personName}</p>
            <p class="request-meta">{[r.personEmail, r.branchId && `Prefiere ${branchById(r.branchId)?.name}`, stamp(r.createdAt)].filter(Boolean).join(" · ")}</p>
            {r.message && <p class="request-message">«{r.message}»</p>}
          </div>
          <div class="request-actions">
            <button type="button" class="btn btn-primary" data-open-dialog={`join-${r.id}`} aria-label={`Aceptar a ${r.personName}`}>Aceptar</button>
            <form
              data-action="answerJoin"
              data-refresh="join-requests"
              data-success="Pedido rechazado."
              data-confirm={`¿Rechazar el pedido de ${r.personName}? Le avisamos que no lo aceptaste.`}
              data-confirm-label="Rechazar"
              data-danger
            >
              <input type="hidden" name="requestId" value={r.id} />
              <input type="hidden" name="accept" value="false" />
              <button type="submit" class="btn btn-secondary" aria-label={`Rechazar a ${r.personName}`}>Rechazar</button>
            </form>
          </div>
          <Modal
            id={`join-${r.id}`}
            title={`Aceptar a ${r.personName}`}
            description="Entra al equipo en la sucursal y el turno que elijas. Le llega un aviso."
            action="answerJoin"
            submitLabel="Aceptar en el equipo"
            success={`${r.personName} ya está en tu equipo.`}
            hidden={{ requestId: r.id, accept: "true" }}
          >
            <FormInput form={`join-${r.id}-form`} name="jobTitle" label="Puesto" placeholder="Ej.: Cajera" required maxlength={60} />
            <div class="field-row-2">
              <FormInput
                form={`join-${r.id}-form`}
                name="branchId"
                label="Sucursal"
                required
                options={branches.map((b) => ({ value: b.id, label: b.name, selected: b.id === r.branchId }))}
              />
              <FormInput form={`join-${r.id}-form`} name="shiftId" label="Turno" required options={shiftOptions} />
            </div>
          </Modal>
        </li>
      ))}
    </ul>
  </section>

  <div data-region="team">
  <EmployeesTable
    client:visible
    rows={rows}
    business={business.name}
    branches={branches.map((b) => ({ id: b.id, name: b.name }))}
    shifts={shifts.map((s) => ({ id: s.id, branchId: s.branchId, name: s.name, start: s.start, end: s.end, tone: s.tone }))}
  />
  </div>
</Layout>

<!-- Ícono de los avatares de las sugerencias (el script los arma en el navegador). -->
<template id="avatar-icon"><User stroke-width={1.75} /></template>

<script>
  import { actions } from "astro:actions";
  import { avatarColor } from "@/lib/format";

  // byEmail: se encontró por su correo y se ve completo; si no, por su nombre, con el correo enmascarado.
  type Person = { id: string; email: string; byEmail: boolean; name: string; avatarUrl?: string };
  type Result = { people: Person[]; total: number; page: number };

  const PAGE_SIZE = 5;
  const input = document.querySelector<HTMLInputElement>("[data-people-search]");
  const popover = document.getElementById("people-suggest");
  if (input && popover) {
    const list = popover.querySelector<HTMLElement>(".suggest-list")!;
    const skeleton = popover.querySelector<HTMLElement>(".suggest-skeleton")!;
    const empty = popover.querySelector<HTMLElement>(".suggest-empty")!;
    const pager = popover.querySelector<HTMLElement>(".suggest-pager")!;
    const pagerInfo = popover.querySelector<HTMLElement>(".pager-info")!;
    const [prev, next] = popover.querySelectorAll<HTMLButtonElement>(".pager-btn");
    const status = popover.querySelector<HTMLElement>("[data-status]")!;
    const businessId = input.dataset.peopleSearch!;
    const personId = document.querySelector<HTMLInputElement>("[data-person-id]")!;
    // Las teclas de la lista se anuncian aparte: en pantalla la pista queda corta.
    input.setAttribute("aria-describedby", `${input.getAttribute("aria-describedby") ?? ""} people-keys`.trim());

    // Búsquedas ya hechas: volver atrás o cambiar de página no espera a la red.
    const cache = new Map<string, Result>();
    let result: Result | null = null;
    let query = "";
    let active = -1;
    let timer: ReturnType<typeof setTimeout>;
    let request = 0;

    const pages = () => Math.max(1, Math.ceil((result?.total ?? 0) / PAGE_SIZE));

    const open = () => {
      const rect = input.getBoundingClientRect();
      popover.style.top = `${rect.bottom + 4}px`;
      popover.style.left = `${rect.left}px`;
      popover.style.width = `${rect.width}px`;
      if (!popover.matches(":popover-open")) popover.showPopover();
      input.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      clearTimeout(timer);
      request++;
      if (popover.matches(":popover-open")) popover.hidePopover();
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      active = -1;
    };

    const show = (state: "loading" | "results") => {
      const loading = state === "loading";
      popover.setAttribute("aria-busy", String(loading));
      skeleton.hidden = !loading;
      list.hidden = loading || !result?.people.length;
      empty.hidden = loading || !!result?.people.length;
      pager.hidden = loading || pages() < 2;
    };

    const highlight = (index: number) => {
      active = index;
      list.querySelectorAll("[role=option]").forEach((el, i) => el.setAttribute("aria-selected", String(i === index)));
      if (index >= 0) input.setAttribute("aria-activedescendant", `person-${index}`);
      else input.removeAttribute("aria-activedescendant");
    };

    const choose = (index: number) => {
      const person = result?.people[index];
      if (!person) return;
      // Por correo, el campo queda con el correo y se invita con él. Por nombre, con el nombre y el correo
      // enmascarado a la vista, y se invita por la cuenta.
      input.value = person.byEmail ? person.email : `${person.name || person.email} · ${person.email}`;
      personId.value = person.byEmail ? "" : person.id;
      close();
    };

    const option = (p: Person, i: number) => {
      const li = document.createElement("li");
      li.id = `person-${i}`;
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", "false");
      li.className = "suggest-option";
      // Como Avatar.astro: el ícono sobre el color de la persona y la foto encima; si no carga, queda el ícono.
      const avatar = Object.assign(document.createElement("span"), { className: "avatar-default" });
      avatar.setAttribute("aria-hidden", "true");
      avatar.style.setProperty("--avatar", avatarColor(p.id));
      avatar.append(document.querySelector<HTMLTemplateElement>("#avatar-icon")!.content.cloneNode(true));
      if (p.avatarUrl) {
        const img = Object.assign(document.createElement("img"), { src: p.avatarUrl, alt: "", referrerPolicy: "no-referrer" });
        img.addEventListener("error", () => (img.hidden = true));
        avatar.append(img);
      }
      const text = Object.assign(document.createElement("span"), { className: "suggest-text" });
      text.append(Object.assign(document.createElement("span"), { className: "suggest-name", textContent: p.name || p.email }));
      if (p.name) text.append(Object.assign(document.createElement("span"), { className: "suggest-email", textContent: p.email }));
      li.append(avatar, text);
      // mousedown: elige antes de que el campo pierda el foco.
      li.addEventListener("mousedown", (e) => {
        e.preventDefault();
        choose(i);
      });
      return li;
    };

    const render = () => {
      if (!result) return;
      list.replaceChildren(...result.people.map(option));
      const from = (result.page - 1) * PAGE_SIZE + 1;
      const to = from + result.people.length - 1;
      pagerInfo.textContent = `${from}–${to} de ${result.total}`;
      prev.disabled = result.page <= 1;
      next.disabled = result.page >= pages();
      empty.textContent = `Ninguna cuenta registrada coincide con «${query}».`;
      status.textContent = result.total
        ? `${result.total} ${result.total === 1 ? "cuenta" : "cuentas"}. Página ${result.page} de ${pages()}.`
        : empty.textContent;
      highlight(-1);
      show("results");
      open();
    };

    const load = async (q: string, page: number) => {
      const key = `${q.toLowerCase()}|${page}`;
      const mine = ++request;
      const cached = cache.get(key);
      if (cached) {
        result = cached;
        return render();
      }
      show("loading");
      status.textContent = "Buscando cuentas…";
      open();
      const { data, error } = await actions.searchPeople({ businessId, query: q, page }).catch(() => ({ data: undefined, error: new Error("offline") }));
      // Solo cuenta la última búsqueda: las respuestas pueden llegar desordenadas.
      if (mine !== request) return;
      if (error || !data) {
        result = { people: [], total: 0, page };
        empty.textContent = "No se pudo buscar. Escribe su correo completo.";
        status.textContent = empty.textContent;
        return show("results");
      }
      cache.set(key, data);
      result = data;
      render();
    };

    input.addEventListener("input", () => {
      // Lo escrito ya no es la persona elegida.
      personId.value = "";
      clearTimeout(timer);
      query = input.value.trim();
      if (query.length < 3) return close();
      // El esqueleto aparece al instante; la consulta espera a que se deje de teclear un momento.
      if (!cache.has(`${query.toLowerCase()}|1`)) {
        show("loading");
        open();
      }
      timer = setTimeout(() => load(query, 1), 200);
    });

    const turn = (step: number) => {
      if (!result) return;
      const page = result.page + step;
      if (page < 1 || page > pages()) return;
      load(query, page);
    };

    for (const button of [prev, next]) {
      // mousedown: el foco se queda en el campo.
      button.addEventListener("mousedown", (e) => e.preventDefault());
      button.addEventListener("click", () => turn(Number(button.dataset.step)));
    }

    input.addEventListener("keydown", (e) => {
      if (!popover.matches(":popover-open")) return;
      const count = result?.people.length ?? 0;
      if ((e.key === "ArrowDown" || e.key === "ArrowUp") && count) {
        e.preventDefault();
        highlight((active + (e.key === "ArrowDown" ? 1 : -1) + count) % count);
      } else if (e.key === "PageDown" || e.key === "PageUp") {
        e.preventDefault();
        turn(e.key === "PageDown" ? 1 : -1);
      } else if (e.key === "Enter" && active >= 0) {
        e.preventDefault();
        choose(active);
      } else if (e.key === "Escape") {
        // Cierra solo la lista, no el diálogo.
        e.preventDefault();
        e.stopPropagation();
        close();
      }
    });

    input.addEventListener("blur", close);
    input.closest("dialog")?.addEventListener("close", () => {
      close();
      personId.value = "";
    });
    window.addEventListener("resize", close);
  }
</script>

<style>
  .requests {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .requests h2 {
    margin: 0;
  }

  .requests-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .request-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .request {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
  }

  .request-body {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    flex: 1 1 16rem;
  }

  .request-body p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .request-name {
    font-weight: var(--font-semibold);
  }

  .request-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .request-actions {
    display: flex;
    gap: 0.5rem;
  }

  .suggest {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  .suggest-list,
  .suggest-skeleton {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .suggest :global(.suggest-option),
  .suggest-skeleton li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
  }

  .suggest :global(.suggest-option) {
    cursor: pointer;
  }

  .suggest :global(.suggest-option:hover),
  .suggest :global(.suggest-option[aria-selected="true"]) {
    background: var(--color-surface-muted);
  }

  .suggest :global(.suggest-text),
  .sk-lines {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }

  .suggest :global(.suggest-text) {
    gap: 0;
  }

  .suggest :global(.suggest-name),
  .suggest :global(.suggest-email) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggest :global(.suggest-name) {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .suggest :global(.suggest-email) {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Esqueleto: la forma de una fila (foto, nombre, correo) mientras llega la respuesta. */
  .sk {
    display: block;
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .sk-avatar {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
  }

  .sk-name {
    width: 45%;
    height: 0.75rem;
  }

  .sk-email {
    width: 70%;
    height: 0.625rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sk {
      animation: sk-pulse 1.2s ease-in-out infinite;
    }

    .suggest-skeleton li:nth-child(2) .sk {
      animation-delay: 150ms;
    }

    .suggest-skeleton li:nth-child(3) .sk {
      animation-delay: 300ms;
    }
  }

  @keyframes sk-pulse {
    50% {
      opacity: 0.45;
    }
  }

  .suggest-empty {
    margin: 0;
    padding: 0.625rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .suggest-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding: 0.25rem 0.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .pager-info {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .pager-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 0.5rem;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .pager-btn:hover:not(:disabled) {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .pager-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

</style>
