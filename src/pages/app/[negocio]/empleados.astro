---
import { BadgeCheck, UserPlus } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import EmployeesTable from "@/components/app/EmployeesTable";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import PeopleSuggest from "@/components/app/PeopleSuggest.astro";
import SelectMenu from "@/components/app/SelectMenu.astro";
import Layout from "@/layouts/Layout.astro";
import { businessContext, fullName, joinRequests } from "@/data/queries";
import { stamp } from "@/lib/dates";
import { plural } from "@/lib/format";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, branchById, employees, shiftById, shifts, branches } = ctx;
const requests = await joinRequests(Astro.locals, business.id);
const branchOptions = branches.map((b) => ({ value: b.id, label: b.name }));
// Los turnos van agrupados por sucursal (con más de una); elegir uno elige también su sucursal (script de abajo).
const shiftOptions = shifts.map((s) => ({
  value: s.id,
  label: s.name,
  keywords: `${s.start} ${s.end}`,
  group: branches.length > 1 ? branchById(s.branchId)?.name : undefined,
  branchId: s.branchId,
  hours: `${s.start}–${s.end}`,
}));

const rows = employees.map((e) => {
  const mine = e.shiftIds.map(shiftById).filter((s) => s !== undefined);
  return {
    id: e.id,
    avatarSeed: e.personId ?? e.id,
    name: fullName(e),
    email: e.email,
    role: e.jobTitle,
    branchId: e.branchId,
    branch: branchById(e.branchId)?.name ?? "—",
    shiftIds: e.shiftIds,
    shifts: mine.map((s) => ({ name: s.name, tone: s.tone })),
    openEarlyMin: e.openEarlyMin,
    openLateMin: e.openLateMin,
    active: e.status === "activo",
  };
});
---

<Layout title={`Empleados · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader {...ctx.backdrop} title="Empleados" live description={`${plural(employees.length, "persona", "personas")} en las sucursales de ${business.name}. Entran gratis, siempre.`}>
    {/* La dueña no vende ni abre turnos como dueña: para hacerlo, se agrega a una sucursal (entra activa, sin invitación). */}
    {!ctx.membership.employee && (
      <button type="button" class="btn btn-secondary" data-open-dialog="work-here"><BadgeCheck size={18} stroke-width={2} />Trabajar tú</button>
    )}
    <button type="button" class="btn btn-primary" data-open-dialog="invite"><UserPlus size={18} stroke-width={2} />Invitar empleado</button>
  </PageHeader>

  {
    !ctx.membership.employee && (
      <Modal
        id="work-here"
        title="Trabajar tú en una sucursal"
        description="Como dueña ves todo, pero las ventas, los gastos y los turnos los registra quien trabaja en la sucursal. Agrégate y abres tu turno, vendes y cierras la caja como cualquier empleada."
        action="inviteEmployee"
        reload
        submitLabel="Agregarme"
        success="Listo: ya trabajas en esa sucursal."
        hidden={{ businessId: business.id, personId: Astro.locals.userId ?? undefined, person: "Tú" }}
      >
        <FormInput form="work-here-form" name="jobTitle" label="Puesto" placeholder="Ej.: Encargada" required maxlength={60} />
        <div class="field-row-2">
          <SelectMenu form="work-here-form" name="branchId" label="Sucursal" options={branchOptions} placeholder="Elige una sucursal" searchPlaceholder="Buscar sucursal" noun="sucursales" required requiredMessage="Elige una sucursal." />
          <SelectMenu form="work-here-form" name="shiftId" label="Turno" options={shiftOptions} placeholder="Elige un turno" searchPlaceholder="Nombre u hora" noun="turnos" required requiredMessage="Elige un turno.">
            {(o: (typeof shiftOptions)[number]) => (
              <span class="shift-option" data-branch={o.branchId}>
                <span>{o.label}</span>
                <span class="shift-hours num">{o.hours}</span>
              </span>
            )}
          </SelectMenu>
        </div>
      </Modal>
    )
  }

  <Modal
    id="invite"
    title="Invitar empleado"
    description="Le llega la invitación a sus avisos y entra al negocio cuando la acepta."
    action="inviteEmployee"
    draft
    submitLabel="Invitar"
    hidden={{ businessId: business.id }}
  >
    <FormInput
      form="invite-form"
      name="person"
      label="Nombre o correo"
      placeholder="Ej.: Ana Pérez o ana@gmail.com"
      hint="Busca a la persona por su nombre o su correo. Si todavía no tiene cuenta, escribe su correo completo y le llega una invitación para crearla."
      required
      autocapitalize="none"
      spellcheck="false"
      autocomplete="off"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="people-suggest-list"
      aria-expanded="false"
      data-people-search={business.id}
    />
    <!-- La cuenta elegida entre las sugerencias encontradas por nombre: se invita por ella, sin conocer su correo. -->
    <input type="hidden" name="personId" form="invite-form" data-person-id />
    <!-- Dentro del diálogo: lo de afuera queda inerte mientras está abierto. -->
    <PeopleSuggest />
    <FormInput form="invite-form" name="jobTitle" label="Puesto" placeholder="Ej.: Cajera" required maxlength={60} />
    <div class="field-row-2">
          <SelectMenu form="invite-form" name="branchId" label="Sucursal" options={branchOptions} placeholder="Elige una sucursal" searchPlaceholder="Buscar sucursal" noun="sucursales" required requiredMessage="Elige una sucursal." />
          <SelectMenu form="invite-form" name="shiftId" label="Turno" options={shiftOptions} placeholder="Elige un turno" searchPlaceholder="Nombre u hora" noun="turnos" required requiredMessage="Elige un turno.">
            {(o: (typeof shiftOptions)[number]) => (
              <span class="shift-option" data-branch={o.branchId}>
                <span>{o.label}</span>
                <span class="shift-hours num">{o.hours}</span>
              </span>
            )}
          </SelectMenu>
        </div>
  </Modal>

  <section id="pedidos" class="requests" data-region="join-requests" aria-labelledby="requests-title" hidden={requests.length === 0}>
    <h2 id="requests-title">Pedidos para unirse</h2>
    <p class="requests-hint">Personas que encontraron {business.name} en Buscar. Al aceptar, eliges su sucursal, su turno y su puesto.</p>
    <ul class="request-list" role="list">
      {requests.map((r) => (
        <li class="request card">
          <div class="request-body">
            <p class="request-name">{r.personName}</p>
            <p class="request-meta">{[r.personEmail, r.branchId && `Prefiere ${branchById(r.branchId)?.name}`, stamp(r.createdAt)].filter(Boolean).join(" · ")}</p>
            {r.message && <p class="request-message">«{r.message}»</p>}
          </div>
          <div class="request-actions">
            <button type="button" class="btn btn-primary" data-open-dialog={`join-${r.id}`} aria-label={`Aceptar a ${r.personName}`}>Aceptar</button>
            <form
              data-action="answerJoin"
              data-refresh="join-requests"
              data-success="Pedido rechazado."
              data-confirm={`¿Rechazar el pedido de ${r.personName}? Le avisamos que no lo aceptaste.`}
              data-confirm-label="Rechazar"
              data-danger
            >
              <input type="hidden" name="requestId" value={r.id} />
              <input type="hidden" name="accept" value="false" />
              <button type="submit" class="btn btn-secondary" aria-label={`Rechazar a ${r.personName}`}>Rechazar</button>
            </form>
          </div>
          <Modal
            id={`join-${r.id}`}
            title={`Aceptar a ${r.personName}`}
            description="Entra al equipo en la sucursal y el turno que elijas. Le llega un aviso."
            action="answerJoin"
            submitLabel="Aceptar en el equipo"
            success={`${r.personName} ya está en tu equipo.`}
            hidden={{ requestId: r.id, accept: "true" }}
          >
            <FormInput form={`join-${r.id}-form`} name="jobTitle" label="Puesto" placeholder="Ej.: Cajera" required maxlength={60} />
            <div class="field-row-2">
          <SelectMenu form={`join-${r.id}-form`} name="branchId" label="Sucursal" options={branchOptions} value={r.branchId ?? undefined} placeholder="Elige una sucursal" searchPlaceholder="Buscar sucursal" noun="sucursales" required requiredMessage="Elige una sucursal." />
          <SelectMenu form={`join-${r.id}-form`} name="shiftId" label="Turno" options={shiftOptions} placeholder="Elige un turno" searchPlaceholder="Nombre u hora" noun="turnos" required requiredMessage="Elige un turno.">
            {(o: (typeof shiftOptions)[number]) => (
              <span class="shift-option" data-branch={o.branchId}>
                <span>{o.label}</span>
                <span class="shift-hours num">{o.hours}</span>
              </span>
            )}
          </SelectMenu>
        </div>
          </Modal>
        </li>
      ))}
    </ul>
  </section>

  <div data-region="team">
  <EmployeesTable
    client:visible
    rows={rows}
    business={business.name}
    branches={branches.map((b) => ({ id: b.id, name: b.name }))}
    shifts={shifts.map((s) => ({ id: s.id, branchId: s.branchId, name: s.name, start: s.start, end: s.end, tone: s.tone }))}
  />
  </div>
</Layout>

<!-- Ícono de los avatares de las sugerencias (el script los arma en el navegador). -->

<script>
  import { peopleSearch } from "@/scripts/people-search";
  import { onPage } from "@/scripts/refresh";

  onPage(() => {
    const input = document.querySelector<HTMLInputElement>("[data-people-search]");
    const personId = document.querySelector<HTMLInputElement>("[data-person-id]");
    if (input && personId) peopleSearch(input, personId, input.dataset.peopleSearch);
  });

  // Sucursal y Turno van juntos: el turno elegido fija su sucursal; otra sucursal borra un turno que no es de ella.
  // Delegado en document (una vez por sesión): los formularios entran y salen con las regiones.
  const branchOfShift = (form: Element, shiftId: string) =>
    form.querySelector<HTMLElement>(`[name="shiftId"] ~ .select-panel [role="option"][data-value="${CSS.escape(shiftId)}"] [data-branch]`)?.dataset.branch;
  document.addEventListener("change", (event) => {
    const input = event.target as HTMLInputElement;
    if (!input.matches?.("[data-select-value]") || (input.name !== "shiftId" && input.name !== "branchId")) return;
    const form = input.closest("dialog") ?? input.form ?? input.closest("form");
    if (!form) return;
    const branch = form.querySelector<HTMLInputElement>('[data-select-value][name="branchId"]');
    const shift = form.querySelector<HTMLInputElement>('[data-select-value][name="shiftId"]');
    if (!branch || !shift) return;
    if (input === shift && shift.value) {
      const owner = branchOfShift(form, shift.value);
      if (owner && owner !== branch.value) branch.dispatchEvent(new CustomEvent("select:set", { detail: owner, bubbles: true }));
    } else if (input === branch && shift.value && branchOfShift(form, shift.value) !== branch.value) {
      shift.dispatchEvent(new CustomEvent("select:set", { detail: "", bubbles: true }));
    }
  });
</script>

<style>
  /* Turno en el menú: nombre y, a la derecha, su horario. */
  .shift-option {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .shift-hours {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .requests {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .requests h2 {
    margin: 0;
  }

  .requests-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .request-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .request {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
  }

  .request-body {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    flex: 1 1 16rem;
  }

  .request-body p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .request-name {
    font-weight: var(--font-semibold);
  }

  .request-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .request-actions {
    display: flex;
    gap: 0.5rem;
  }

</style>
