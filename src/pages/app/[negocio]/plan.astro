---
import { ArrowLeft, Check, ChevronDown, ExternalLink, MessageCircle, Sparkles, Store, X } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import PlanCalculator from "@/components/PlanCalculator.astro";
import PeriodSwitch from "@/components/plans/PeriodSwitch.astro";
import PlanPrice from "@/components/plans/PlanPrice.astro";
import Layout from "@/layouts/Layout.astro";
import { businessContext, businessHref, currentQuote, founderPromo, myBusinesses, planCharges } from "@/data/queries";
import { plans, upgradeUrl, usdLabel, type Period } from "@/data/plans";
import { longDate, shortDate, stamp } from "@/lib/dates";
import { plural } from "@/lib/format";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business } = ctx;
const sb = Astro.locals.supabase;
const period: Period = Astro.url.searchParams.get("periodo") === "anual" ? "anual" : "mensual";
const [quote, charges, promo] = await Promise.all([
  currentQuote(sb),
  planCharges(sb, business.id),
  founderPromo(sb, business.id).catch(() => null),
]);
// Lo que pagaría hoy: con su precio fundador vigente o, si aún no lo es, mientras queden cupos.
const discount = promo ? promo.discount : 0;
const pct = (d: number) => `${Math.round(d * 100)}%`;
const branches = ctx.membership.branches.length;
// Cada negocio paga su plan: desde aquí se puede pasar al de otro negocio propio.
const ownedOthers = myBusinesses(Astro.locals).filter((other) => other.role === "dueño" && other.business.id !== business.id);
const chargeHref = (id: string) => `${businessHref(business)}/cobro/${id}`;

// Se cobra solo por QR; los otros nombres quedan para los cobros viejos del historial.
const methodLabel: Record<string, string> = { qr: "QR bancario", transferencia: "Transferencia bancaria", tarjeta: "Tarjeta de crédito" };

// El cobro por pagar más reciente: con su monto fijo en Bs e instrucciones. Los demás van al historial.
const pending = charges.find((c) => c.status === "pendiente");
const history = charges.filter((c) => c !== pending);
const code = (id: string) => id.slice(0, 8).toUpperCase();
// En WhatsApp, el aviso de pago va con el mensaje ya escrito.
const proofUrl =
  upgradeUrl && pending && /wa\.me|whatsapp/.test(upgradeUrl)
    ? `${upgradeUrl}${upgradeUrl.includes("?") ? "&" : "?"}text=${encodeURIComponent(
        `Hola, pagué el plan de ${business.name}: Bs ${pending.amountBs.toLocaleString("es-BO")}, código ${code(pending.id)}. Te envío el comprobante.`,
      )}`
    : upgradeUrl;
const statusLabel = { pendiente: "Por pagar", vencido: "Vencido", pagado: "Pagado" } as const;
const chargeName = (c: (typeof charges)[number]) =>
  `${c.plan}${c.extraBranches ? ` + ${plural(c.extraBranches, "sucursal extra", "sucursales extra")}` : ""} · ${c.period}${c.discount > 0 ? ` · precio fundador −${pct(c.discount)}` : ""}`;
const rateText = (c: (typeof charges)[number]) =>
  `${usdLabel(c.usd)} × Bs ${c.rate.toLocaleString("es-BO", { maximumFractionDigits: 4 })} (BCB, ${shortDate(c.rateDate)}) + ${Math.round(c.taxRate * 100)}% de IVA e IT`;
---

<Layout title={`Plan · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader {...ctx.backdrop} title="Planes" description={`${business.name} está en el plan ${business.plan}${business.planUntil ? `, pagado hasta el ${longDate(business.planUntil).replace(/^\S+ /, "")}` : ""}. Tus empleados entran siempre gratis; pagas por negocio y por sucursal.`} >
    <a slot="back" class="back" href={`${businessHref(business)}/configuracion`}><ArrowLeft size={16} stroke-width={1.75} />Configuración</a>
  </PageHeader>

  <PeriodSwitch period={period} quote={quote} />

  <div class="plan-grid">
    {
      plans.map((plan) => {
        const current = plan.name === business.plan;
        return (
          <article class:list={["card", "plan", { current }]} aria-labelledby={`plan-${plan.name}`}>
            <header>
              <h2 id={`plan-${plan.name}`}>{plan.name}</h2>
              {current && <span class="chip chip-income">Tu plan</span>}
            </header>
            <p class="audience">{plan.audience}</p>
            <PlanPrice plan={plan.name} period={period} quote={quote} />
            <ul role="list">
              {plan.features.map((feature) => (
                <li>
                  <Check size={16} stroke-width={1.75} />
                  {typeof feature === "string" ? (
                      feature
                    ) : (
                      <span>
                        {feature.text} <span class="chip chip-neutral">Próximamente</span>
                      </span>
                    )}
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <section class="card pay" aria-labelledby="pay-title">
    <h2 class="card-title" id="pay-title">Pagar tu plan</h2>
    <p class="pay-intro">
      Elige cuántos locales pagas y el período arriba (mensual o anual): el total cambia al instante. Pagas por QR desde cualquier banco y
      activamos tu plan apenas vemos el comprobante. No pierdes nada de lo que ya registraste.
    </p>
    {
      quote ? (
        <form id="pay" class="pay-form" data-action="createPlanCharge" data-redirect={`${businessHref(business)}/cobro/{id}`} novalidate>
          <input type="hidden" name="businessId" value={business.id} />
          <input type="hidden" name="period" id="pay-period" value={period} />
          <div class="for-business">
            <p>
              <Store size={18} stroke-width={1.75} aria-hidden="true" />
              <span>Pagas el plan de <strong>{business.name}</strong></span>
            </p>
            {ownedOthers.length > 0 && (
              <details class="switch">
                <summary>
                  Cambiar de negocio
                  <ChevronDown size={16} stroke-width={1.75} aria-hidden="true" />
                </summary>
                <ul role="list">
                  {ownedOthers.map((other) => (
                    <li>
                      <a href={`${businessHref(other.business)}/plan${period === "anual" ? "?periodo=anual" : ""}`}>
                        <strong>{other.business.name}</strong>
                        <span>Plan {other.business.plan} · {plural(other.branches.length, "sucursal", "sucursales")}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
          {promo && (
            <p class="founder">
              <Sparkles size={16} stroke-width={1.75} aria-hidden="true" />
              <span>
                <strong>Precio fundador: −{pct(promo.discount)}</strong>{" "}
                {promo.until
                  ? `en todos tus cobros hasta el ${longDate(promo.until).replace(/^\S+ /, "")}.`
                  : `${promo.months === 12 ? "el primer año" : `por ${promo.months} meses`} desde tu primer pago. ${promo.left === 1 ? "Queda 1 cupo" : `Quedan ${promo.left} cupos`}: el tuyo se reserva al confirmar el pago.`}
              </span>
            </p>
          )}
          <PlanCalculator branches={pending ? pending.extraBranches + 1 : branches} current={branches} min={Math.max(branches, 1)} name="branches" form="pay" discount={discount} period={period} quote={quote} />

          {pending && (
            <div class="pending" role="group" aria-labelledby="pending-title">
              {/* Dentro del formulario #pay: la X envía el de eliminar, que está afuera (los formularios no se anidan). */}
              <button type="submit" form={`delete-charge-${pending.id}`} class="icon-btn charge-delete pending-delete" aria-label={`Eliminar el cobro ${code(pending.id)}`} title="Eliminar cobro">
                <X size={18} stroke-width={1.75} aria-hidden="true" />
              </button>
              <p class="pending-head">
                <span class="chip chip-warning">{statusLabel.pendiente}</span>
                <strong id="pending-title">
                  Tienes un cobro de <span class="num">Bs {pending.amountBs.toLocaleString("es-BO")}</span> · {chargeName(pending)}
                </strong>
              </p>
              <p class="charge-meta">
                Código <strong class="num">{code(pending.id)}</strong> · el monto vale hasta el {stamp(pending.expiresAt)}. {rateText(pending)}.
              </p>
              <div class="pending-actions">
                <a href={chargeHref(pending.id)} class="btn btn-primary" target="_blank" rel="noopener">
                  <ExternalLink size={16} stroke-width={1.75} />Ver QR y cómo pagar<span class="sr-only"> (se abre en otra pestaña)</span>
                </a>
                {proofUrl && (
                  <a href={proofUrl} class="btn btn-secondary" target="_blank" rel="noopener">
                    <MessageCircle size={16} stroke-width={1.75} />Ya pagué: enviar comprobante<span class="sr-only"> por WhatsApp (se abre en otra pestaña)</span>
                  </a>
                )}
              </div>
              <p class="charge-meta">Si cambias los locales o el período, genera un cobro nuevo con ese monto.</p>
            </div>
          )}

          <p class="notice notice-error" role="alert" data-form-notice />
          <button type="submit" class:list={["btn", pending ? "btn-secondary" : "btn-primary"]}>
            {pending ? "Generar cobro nuevo" : "Generar cobro y ver QR"}
          </button>
        </form>
      ) : (
        <p class="notice" role="status">
          Todavía no tenemos el tipo de cambio del BCB de hoy, así que no podemos calcular el monto en bolivianos. Intenta en unos minutos
          {upgradeUrl && (
            <>
              {" "}o <a href={upgradeUrl} target="_blank" rel="noopener">escríbenos<span class="sr-only"> (se abre en otra pestaña)</span></a>
            </>
          )}
          .
        </p>
      )
    }
  </section>

  {/* Eliminar un cobro sin pagar (fuera de #pay: los formularios no se anidan; el botón apunta aquí con form=). */}
  {charges.filter((c) => c.status !== "pagado").map((c) => (
    <form
      id={`delete-charge-${c.id}`}
      hidden
      data-action="deletePlanCharge"
      data-reload
      data-confirm={`¿Eliminar el cobro ${code(c.id)} de Bs ${c.amountBs.toLocaleString("es-BO")}? Si ya lo pagaste, no lo elimines: lo usamos para activar tu plan.`}
      data-confirm-label="Eliminar"
      data-danger
      data-success="Cobro eliminado."
    >
      <input type="hidden" name="id" value={c.id} />
    </form>
  ))}

  {
    history.length > 0 && (
      <section class="history" aria-labelledby="history-title">
        <h2 class="section-title" id="history-title">Cobros anteriores</h2>
        <ul role="list">
          {history.map((c) => (
            <li class="card">
              <div>
                <p class="history-name"><a href={chargeHref(c.id)}>{chargeName(c)}</a></p>
                <p class="history-meta">
                  {stamp(c.createdAt)} · {methodLabel[c.method]} · código {code(c.id)}
                </p>
              </div>
              <p class="history-amount num">Bs {c.amountBs.toLocaleString("es-BO")}</p>
              <span class:list={["chip", c.status === "pagado" ? "chip-income" : "chip-neutral"]}>
                {statusLabel[c.status]}
                {c.paidAt && ` el ${shortDate(c.paidAt.slice(0, 10))}`}
              </span>
              {c.status !== "pagado" && (
                <button type="submit" form={`delete-charge-${c.id}`} class="icon-btn charge-delete" aria-label={`Eliminar el cobro ${code(c.id)}`} title="Eliminar cobro">
                  <X size={18} stroke-width={1.75} aria-hidden="true" />
                </button>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<script>
  // El selector «Período» del cobro sigue al de arriba (mensual/anual sin recargar, PeriodSwitch).
  document.addEventListener("period:change", (event) => {
    const field = document.querySelector<HTMLInputElement>("#pay-period");
    if (field) field.value = (event as CustomEvent<string>).detail;
  });
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
    /* Sobre el degradado: el atenuado no llega a AA (como el texto del PageHeader). */
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
  }

  .back:hover {
    color: var(--color-text);
  }

  .plan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .plan {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .plan.current {
    border-color: var(--color-primary);
  }

  .plan header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plan h2 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
  }

  .audience {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .plan ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .plan li {
    display: flex;
    gap: 0.5rem;
  }

  .plan li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: var(--color-income);
  }

  .pay {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
  }

  /* La calculadora va dentro de la tarjeta: sin su propio marco. */
  .pay :global(.calc) {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
  }

  .founder {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-panel);
    background: var(--color-primary-soft);
    font-size: var(--text-sm);
  }

  .founder :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-primary);
  }

  /* El cobro por pagar: borde y chip (no solo color). */
  .pending {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1rem 3.25rem 1rem 1rem;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-panel);
  }

  .charge-delete {
    width: 2.75rem;
    height: 2.75rem;
  }

  .pending-delete {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
  }

  .pending-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .pending-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .charge-meta,
  .pay-intro,
  .history-meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .charge-code {
    margin: 0;
  }

  .for-business {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
  }

  .for-business > p {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
  }

  .for-business :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .switch summary {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    list-style: none;
  }

  .switch summary::-webkit-details-marker {
    display: none;
  }

  .switch[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .switch ul {
    display: grid;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .switch li + li {
    border-top: 1px solid var(--color-border);
  }

  .switch a {
    display: grid;
    padding: 0.625rem 0.25rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .switch a span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .switch a:hover strong {
    text-decoration: underline;
  }


  .pay-form .btn {
    justify-self: start;
  }

  .pay-form {
    display: grid;
    gap: 1rem;
  }

  .history {
    margin-top: 2rem;
  }

  .history ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .history li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.875rem 1.25rem;
  }

  .history li > div {
    flex: 1 1 14rem;
  }

  .history-name,
  .history-amount {
    margin: 0;
    font-weight: var(--font-semibold);
  }
</style>
