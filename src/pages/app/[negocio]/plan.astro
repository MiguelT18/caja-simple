---
import { ArrowLeft, Check, CreditCard, Landmark, QrCode } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import PlanCalculator from "@/components/PlanCalculator.astro";
import Layout from "@/layouts/Layout.astro";
import { businessContext, businessHref } from "@/data/queries";
import { plans, upgradeUrl } from "@/data/plans";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business } = ctx;
const payments = [
  { icon: QrCode, label: "QR bancario", detail: "Desde la app de tu banco, el mes o el año." },
  { icon: Landmark, label: "Transferencia bancaria", detail: "A la cuenta que te pasamos al pedir el cambio." },
  { icon: CreditCard, label: "Tarjeta de crédito", detail: "Con un enlace de pago que te mandamos." },
];
---

<Layout title={`Plan · ${business.name}`} context={{ membership: ctx.membership }}>
  <a class="back" href={`${businessHref(business)}/configuracion`}><ArrowLeft size={16} stroke-width={1.75} />Configuración</a>
  <PageHeader title="Planes" description={`${business.name} está en el plan ${business.plan}. Tus empleados entran siempre gratis; pagas por negocio y por sucursal.`} />

  <div class="plan-grid">
    {
      plans.map((plan) => {
        const current = plan.name === business.plan;
        return (
          <article class:list={["card", "plan", { current }]} aria-labelledby={`plan-${plan.name}`}>
            <header>
              <h3 id={`plan-${plan.name}`}>{plan.name}</h3>
              {current && <span class="chip chip-income">Tu plan</span>}
            </header>
            <p class="audience">{plan.audience}</p>
            <p class="price">
              <span class="num">{plan.price}</span>
              {plan.period && <span class="period">{plan.period}</span>}
            </p>
            <ul role="list">
              {plan.features.map((feature) => (
                <li>
                  <Check size={16} stroke-width={1.75} />
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <PlanCalculator branches={ctx.membership.branches.length} />

  <section class="payments" aria-labelledby="payments-title">
    <h2 class="section-title" id="payments-title">Métodos de pago</h2>
    <ul role="list">
      {
        payments.map(({ icon: Icon, label, detail }) => (
          <li class="card">
            <Icon size={22} stroke-width={1.75} />
            <div>
              <p class="payment-label">{label}</p>
              <p class="payment-detail">{detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card upgrade" aria-labelledby="upgrade-title">
    <h2 class="card-title" id="upgrade-title">Mejorar plan</h2>
    <ol>
      <li>Escríbenos con el nombre de tu negocio y el plan que quieres.</li>
      <li>Pagas el mes o el año con el método que prefieras (el anual trae 2 meses gratis).</li>
      <li>Activamos tu plan apenas vemos el pago. No pierdes nada de lo que ya registraste.</li>
    </ol>
    {upgradeUrl && (
      <a href={upgradeUrl} class="btn btn-primary" target="_blank" rel="noopener">
        Mejorar plan
      </a>
    )}
  </section>
</Layout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back:hover {
    color: var(--color-text);
  }

  .upgrade {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .payments {
    margin-block: 2.5rem;
  }

  .payments ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .payments li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .payments li :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .payment-label,
  .payment-detail {
    margin: 0;
  }

  .payment-label {
    font-weight: var(--font-semibold);
  }

  .payment-detail {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .plan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .plan {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .plan.current {
    border-color: var(--color-primary);
  }

  .plan header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plan h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
  }

  .audience,
  .period {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin: 0.25rem 0;
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
  }

  .plan ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .plan li {
    display: flex;
    gap: 0.5rem;
  }

  .plan li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: var(--color-income);
  }

  .upgrade ol {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .upgrade .btn {
    justify-self: start;
  }
</style>
