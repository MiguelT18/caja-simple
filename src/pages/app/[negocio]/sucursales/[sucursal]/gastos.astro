---
import { Plus } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import DonutChart from "@/components/app/charts/DonutChart";
import ExpensesTable from "@/components/app/ExpensesTable";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import RangeFilter from "@/components/app/RangeFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { branchContext, shiftBarData, branchHref, expensesByCategory, fullName, sum } from "@/data/queries";
import { formatBs } from "@/lib/format";
import { addDays, longDate, parseRange, shortDate, today as todayOf } from "@/lib/dates";

const { negocio, sucursal } = Astro.params;
const range = parseRange(Astro.url.searchParams, todayOf());
const ctx = await branchContext(Astro.locals, negocio!, sucursal!, range);
if (!ctx) return Astro.rewrite("/404");
const rangeText = range.days === 7 && range.to === ctx.today ? "los últimos 7 días" : `del ${shortDate(range.from)} al ${shortDate(range.to)}`;
const { branch, business, canCorrect, currentShift, expenseHistory, expenses, shiftById, shifts, today } = ctx;
// Nuevo en cada carga (la página recarga al guardar): un doble envío del mismo formulario no duplica el gasto.
const expenseId = crypto.randomUUID();
// Categorías ya usadas, como sugerencias del campo.
const usedCategories = [...new Set(expenseHistory.map((g) => g.category))].sort();

const weekTotal = sum(expenseHistory.map((g) => g.amount));
const todayTotal = sum(expenses.map((g) => g.amount));
const byShift = shifts.map((shift) => ({
  shift,
  total: sum(expenseHistory.filter((g) => g.shiftId === shift.id).map((g) => g.amount)),
}));

const rows = expenseHistory.map((g) => {
  const shift = shiftById(g.shiftId);
  return {
    id: g.id,
    date: g.date,
    time: g.time,
    concept: g.concept,
    category: g.category,
    shift: { name: shift.name, tone: shift.tone },
    by: fullName(g.recordedBy),
    amount: g.voided ?? g.amount,
    voided: g.voided !== null,
    canEdit: canCorrect(g),
  };
});
---

<Layout title={`Gastos · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...ctx.backdrop} eyebrow={longDate(today)} title="Gastos" description={`Lo que salió de la caja ${rangeText} en ${branch.name}.`}>
    {
      currentShift ? (
        <button type="button" class="btn btn-primary" data-open-dialog="expense">
          <Plus size={18} stroke-width={2} />
          Registrar gasto
        </button>
      ) : (
        <a class="btn btn-secondary" href={branchHref(business, branch, "turnos")}>
          Abre un turno<span class="label-rest"> para registrar gastos</span>
        </a>
      )
    }
  </PageHeader>

  {/* Región: tras guardar trae un expenseId nuevo, así el siguiente gasto no se toma por repetido. */}
  <div data-region="expense-form">
  {
    currentShift && (
      <Modal
        id="expense"
        title="Registrar gasto"
        description={`Sale de la caja del turno ${currentShift.name.toLowerCase()}.`}
        action="createExpense"
        submitLabel="Guardar gasto"
        hidden={{ expenseId, branchId: branch.id, shiftId: currentShift.id }}
      >
        <FormInput form="expense-form" name="concept" label="Concepto" placeholder="Ej.: Pago al proveedor de leche" required maxlength={120} />
        <div class="field-row-2">
          <FormInput form="expense-form" name="category" label="Categoría" placeholder="Ej.: Proveedores" list="expense-categories" required maxlength={40} />
          <FormInput form="expense-form" name="amount" type="number" inputmode="decimal" step="0.01" min="0.01" label="Monto (Bs)" required />
        </div>
        <datalist id="expense-categories">
          {["Proveedores", "Servicios", "Transporte", "Insumos", ...usedCategories]
            .filter((c, i, all) => all.indexOf(c) === i)
            .map((c) => <option value={c} />)}
        </datalist>
      </Modal>
    )
  }
  </div>

  <div class="top" data-region="totals">
    <dl class="card totals">
      <div class="totals-main">
        <dt>{rangeText[0].toUpperCase() + rangeText.slice(1)}</dt>
        <dd class="num amount-expense">{formatBs(weekTotal, "−")}</dd>
      </div>
      <div>
        <dt>Hoy</dt>
        <dd class="num amount-expense">{formatBs(todayTotal, "−")}</dd>
      </div>
      {
        byShift.map(({ shift, total }) => (
          <div>
            <dt>
              <ShiftChip shift={shift} />
            </dt>
            <dd class="num amount-expense">{formatBs(total, "−")}</dd>
          </div>
        ))
      }
    </dl>

    <section class="card chart-card" aria-labelledby="by-category">
      <h2 id="by-category" class="card-title">Por categoría</h2>
      <DonutChart client:visible items={expensesByCategory(expenseHistory)} totalLabel={range.days === 7 && range.to === today ? "en 7 días" : `en ${range.days} días`} />
    </section>
  </div>

  <h2 class="section-title">Historial</h2>
  <RangeFilter from={range.from} to={range.to} max={today} historyStart={business.plan === "Gratis" ? addDays(today, -60) : undefined} />
  <div data-region="history">
    <ExpensesTable client:visible rows={rows} categories={usedCategories} />
  </div>
</Layout>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1rem;
    align-items: stretch;
  }

  .totals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-content: start;
    margin: 0;
    padding: 1.25rem;
  }

  .totals div {
    display: grid;
    gap: 0.375rem;
  }

  .totals dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .totals dd {
    margin: 0;
    font-weight: var(--font-semibold);
  }

  .totals-main {
    grid-column: 1 / -1;
  }

  .totals-main dd {
    font-size: var(--text-3xl);
    line-height: var(--text-3xl-lh);
    font-weight: var(--font-bold);
  }

  .chart-card {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  @media (max-width: 1100px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Celular: el enlace sin turno se acorta para no salirse del ancho (el resto queda para lectores de pantalla). */
  @media (max-width: 480px) {
    .label-rest {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .totals,
    .chart-card {
      padding: 1rem;
    }
  }
</style>
