---
import { ArrowDown, Clock, HandCoins, Plus } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import ExpensesTable, { type ExpenseRow } from "@/components/app/ExpensesTable";
import PayablesCard from "@/components/app/PayablesCard";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import RangeFilter from "@/components/app/RangeFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { branchContext, shiftBarData, branchHref, expensesByCategory, fullName, payables, sum } from "@/data/queries";
import { formatBs } from "@/lib/format";
import { addDays, longDate, parseRange, shortDate, today as todayOf } from "@/lib/dates";

const { negocio, sucursal } = Astro.params;
const range = parseRange(Astro.url.searchParams, todayOf());
const ctx = await branchContext(Astro.locals, negocio!, sucursal!, range);
if (!ctx) return Astro.rewrite("/404");
const rangeText = range.days === 7 && range.to === ctx.today ? "los últimos 7 días" : `del ${shortDate(range.from)} al ${shortDate(range.to)}`;
const { branch, business, canCorrect, currentShift, expenseHistory, expenses, shiftById, shifts, today, withdrawalHistory } = ctx;
const isOwner = ctx.membership.role === "dueño";
const owed = await payables(Astro.locals.supabase, [branch.id], today, range);
// Nuevos en cada carga: un doble envío del mismo formulario no duplica el gasto ni el retiro.
const expenseId = crypto.randomUUID();
const withdrawalId = crypto.randomUUID();
// La dueña retira aunque no tenga ficha aquí; quien trabaja aquí, también (la dueña recibe un aviso).
const canWithdraw = !!currentShift && (isOwner || ctx.works);
const myEmployeeId = ctx.membership.employee?.branchId === branch.id ? ctx.membership.employee.id : null;
const staff = ctx.employees.filter((e) => e.status === "activo").map((e) => ({ id: e.id, name: fullName(e) }));
// Categorías ya usadas, como sugerencias del campo.
const usedCategories = [...new Set(expenseHistory.map((g) => g.category))].sort();

const weekTotal = sum(expenseHistory.map((g) => g.amount));
const todayTotal = sum(expenses.map((g) => g.amount));
const byShift = shifts.map((shift) => ({
  shift,
  total: sum(expenseHistory.filter((g) => g.shiftId === shift.id).map((g) => g.amount)),
}));
// Para la dueña: lo ya pagado (de la caja y fuera de ella) y cuánto sería con lo que falta pagar.
const paidOutside = sum(owed.outside.map((x) => x.amount));
const spent = weekTotal + paidOutside;
const pendingTotal = sum(owed.pending.map((p) => p.balance));
const withPending = spent + pendingTotal;
const withdrawn = sum(withdrawalHistory.map((w) => w.amount));
const categories = expensesByCategory(expenseHistory);
const categoriesTotal = sum(categories.map((c) => c.value));

const rows: ExpenseRow[] = [
  ...expenseHistory.map((g) => {
  const shift = shiftById(g.shiftId);
  return {
    id: g.id,
    // Salda un pendiente: se muestra el día que tocaba; el del pago va debajo.
    date: g.owedOn ?? g.date,
    paidOn: g.owedOn ? g.date : undefined,
    time: g.time,
    concept: g.concept,
    category: g.category,
    shift: { name: shift.name, tone: shift.tone },
    by: fullName(g.recordedBy),
    amount: g.voided ?? g.amount,
    voided: g.voided !== null,
    canEdit: canCorrect(g),
  };
  }),
  // Pagos fuera de la caja: no son de ningún turno y no suman en lo que salió de la caja.
  ...owed.outside.map((x) => ({
    id: x.id,
    date: x.owedOn,
    paidOn: x.paidOn,
    time: x.time,
    concept: x.concept,
    category: x.category,
    by: fullName(x.paidBy),
    amount: x.amount,
    outside: true,
    canEdit: isOwner || x.paidById === Astro.locals.userId,
  })),
  // Retiros de la dueña: salen de la caja del turno, pero no son gastos.
  ...withdrawalHistory.map((w) => {
    const shift = shiftById(w.shiftId);
    return {
      id: w.id,
      date: w.date,
      time: w.time,
      concept: w.note ? `Retiro: ${w.note}` : "Retiro de la dueña",
      category: "Retiro",
      shift: { name: shift.name, tone: shift.tone },
      by: fullName(w.recordedBy),
      amount: w.voided ?? w.amount,
      voided: w.voided !== null,
      withdrawal: true,
      canEdit: w.voided === null && canCorrect(w),
    };
  }),
].sort((a: ExpenseRow, b: ExpenseRow) => (b.paidOn ?? b.date).localeCompare(a.paidOn ?? a.date) || b.time.localeCompare(a.time));
---

<Layout title={`Gastos · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...ctx.backdrop} eyebrow={longDate(today)} title="Gastos" description={`Lo que salió de la caja ${rangeText} en ${branch.name}.`}>
    {
      canWithdraw && (
        <button type="button" class="btn btn-secondary" data-open-dialog="withdrawal">
          <HandCoins size={18} stroke-width={1.75} />
          Registrar retiro
        </button>
      )
    }
    {
      // Registra quien trabaja en la sucursal; la dueña sin ficha aquí solo mira.
      !ctx.works ? null : currentShift ? (
        <button type="button" class="btn btn-primary" data-open-dialog="expense">
          <Plus size={18} stroke-width={2} />
          Registrar gasto
        </button>
      ) : (
        <a class="btn btn-secondary" href={branchHref(business, branch, "turnos")}>
          Abre un turno<span class="label-rest"> para registrar gastos</span>
        </a>
      )
    }
  </PageHeader>

  {/* Región: tras guardar trae un expenseId nuevo, así el siguiente gasto no se toma por repetido. */}
  <div data-region="expense-form">
  {
    ctx.works && currentShift && (
      <Modal
        id="expense"
        title="Registrar gasto"
        description={`Sale de la caja del turno ${currentShift.name.toLowerCase()}.${isOwner ? "" : " La dueña recibe un aviso."}`}
        action="createExpense"
        draft
        submitLabel="Guardar gasto"
        hidden={{ expenseId, branchId: branch.id, shiftId: currentShift.id }}
      >
        <FormInput form="expense-form" name="concept" label="Concepto" placeholder="Ej.: Pago al proveedor de leche" required maxlength={120} />
        <div class="field-row-2">
          <FormInput form="expense-form" name="category" label="Categoría" placeholder="Ej.: Proveedores" list="expense-categories" required maxlength={40} />
          <FormInput form="expense-form" name="amount" type="number" inputmode="decimal" step="0.01" min="0.01" label="Monto (Bs)" required />
        </div>
        <datalist id="expense-categories">
          {["Proveedores", "Servicios", "Transporte", "Insumos", ...usedCategories]
            .filter((c, i, all) => all.indexOf(c) === i)
            .map((c) => <option value={c} />)}
        </datalist>
      </Modal>
    )
  }
  {
    canWithdraw && (
      <Modal
        id="withdrawal"
        title="Registrar retiro"
        description={`Efectivo que se lleva la dueña de la caja del turno ${currentShift!.name.toLowerCase()}. Baja lo esperado en caja, pero no es un gasto.${isOwner ? "" : " La dueña recibe un aviso."}`}
        action="createWithdrawal"
        submitLabel="Guardar retiro"
        hidden={{ withdrawalId, branchId: branch.id, shiftId: currentShift!.id }}
      >
        <FormInput form="withdrawal-form" name="amount" type="number" inputmode="decimal" step="0.01" min="0.01" label="Monto (Bs)" required />
        <FormInput form="withdrawal-form" name="note" label="Nota (opcional)" placeholder="Ej.: Ganancias de la semana" maxlength={120} />
      </Modal>
    )
  }
  </div>

  {/* Quien trabaja aquí ve los pendientes y el historial, no los totales. */}
  {isOwner && (
  <div class="top" data-region="totals">
    <section class="card summary" aria-labelledby="spent-title">
      <div class="hero">
        <h2 id="spent-title" class="kpi-label">Gastado {rangeText}</h2>
        <p class="num kpi-value amount-expense">{formatBs(spent, "−")}</p>
        <p class="kpi-note">Hoy <span class="num">{formatBs(todayTotal, "−")}</span></p>
      </div>

      {
        pendingTotal > 0 && (
          <div class="pending">
            <Clock size={18} stroke-width={1.75} aria-hidden="true" />
            <p>
              <strong>Por pagar <span class="num">{formatBs(pendingTotal)}</span></strong>
              <span class="muted">
                Con lo pendiente: <span class="num">{formatBs(withPending, "−")}</span>
              </span>
            </p>
            <a href={`#payables-${branch.id}`}>
              Ver<span class="label-rest"> lo que falta pagar</span>
              <ArrowDown size={16} stroke-width={1.75} aria-hidden="true" />
            </a>
          </div>
        )
      }

      <div class="breakdown">
        <h3 class="sub-title">De dónde salió</h3>
        <ul class="rows">
          <li>
            <div class="row strong">
              <span>De la caja</span>
              <span class="num amount-expense">{formatBs(weekTotal, "−")}</span>
            </div>
            <ul class="rows nested" aria-label="De la caja, por turno">
              {
                byShift.map(({ shift, total }) => (
                  <li class="row">
                    <ShiftChip shift={shift} />
                    <span class="num">{formatBs(total, "−")}</span>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="row strong">
            <span>Pagado aparte</span>
            <span class="num amount-expense">{formatBs(paidOutside, "−")}</span>
          </li>
        </ul>
      </div>

      <div class="withdrawals">
        <HandCoins size={18} stroke-width={1.75} aria-hidden="true" />
        <p>
          <strong>Retiros</strong>
          <span class="muted">No son gastos: es efectivo que se llevó la dueña.</span>
        </p>
        <span class="num">{formatBs(withdrawn)}</span>
      </div>
    </section>

    <section class="card categories" aria-labelledby="by-category">
      <h2 id="by-category" class="card-title">Por categoría</h2>
      {
        categoriesTotal > 0 ? (
          <ul class="cat-list">
            {categories.map((c) => {
              const share = Math.round((c.value / categoriesTotal) * 100);
              return (
                <li>
                  <span class="cat-name">{c.name}</span>
                  <span class="num muted">{share}%</span>
                  <span class="num cat-amount">{formatBs(c.value)}</span>
                  <span class="bar" aria-hidden="true">
                    <span style={`width: ${Math.max(share, 2)}%`} />
                  </span>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty-state">Todavía no hay gastos en estas fechas.</p>
        )
      }
    </section>
  </div>
  )}

  <div class="payables" data-region="payables">
    <PayablesCard
      client:load
      branchId={branch.id}
      pending={owed.pending}
      fixed={owed.fixed}
      today={today}
      userId={Astro.locals.userId!}
      isOwner={isOwner}
      canAdd={isOwner}
      cashShift={ctx.works && currentShift ? { id: currentShift.id, name: currentShift.name } : null}
      categories={usedCategories}
      settled={owed.settled}
      staff={staff}
      myEmployeeId={myEmployeeId}
    />
  </div>

  <h2 class="section-title">Historial</h2>
  <RangeFilter from={range.from} to={range.to} max={today} historyStart={business.plan === "Gratis" ? addDays(today, -60) : undefined} />
  <div data-region="history">
    <ExpensesTable client:visible rows={rows} categories={usedCategories} />
  </div>
</Layout>

<style>
  /* Cada card mide lo que su contenido: la de categorías no se estira a la altura del resumen. */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .top h2,
  .top h3,
  .top p {
    margin: 0;
  }

  .summary {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .hero {
    display: grid;
    gap: 0.25rem;
  }

  /* Es h2 por la estructura, pero se ve como etiqueta de cifra: el tamaño de h2 global no aplica. */
  .hero .kpi-label {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
    letter-spacing: 0;
  }

  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .withdrawals {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }

  /* El enlace baja a otra línea si no cabe al lado del monto. */
  .pending {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--color-warning-soft);
  }

  .pending > :global(svg) {
    color: var(--color-warning);
  }

  .pending p {
    display: grid;
    flex: 1 1 12rem;
  }

  .withdrawals p {
    display: grid;
  }

  .pending .num {
    white-space: nowrap;
  }

  .pending a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .sub-title {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .rows {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .row.strong {
    font-weight: var(--font-semibold);
  }

  .nested {
    margin-top: 0.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .withdrawals {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .withdrawals > :global(svg) {
    color: var(--color-text-muted);
  }

  .withdrawals > .num {
    font-weight: var(--font-semibold);
  }

  .categories {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .categories .empty-state {
    padding: 1rem 0;
  }

  .cat-list {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .cat-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.375rem 0.75rem;
    align-items: baseline;
  }

  .cat-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat-amount {
    min-width: 6.5rem;
    text-align: right;
    font-weight: var(--font-semibold);
  }

  .bar {
    grid-column: 1 / -1;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-expense);
  }

  /* Misma separación que entre secciones (.section-title): no queda pegada a los totales. */
  .payables {
    margin-top: 2.5rem;
  }

  @media (max-width: 760px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Celular: el enlace sin turno se acorta para no salirse del ancho (el resto queda para lectores de pantalla). */
  @media (max-width: 480px) {
    .label-rest {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .summary,
    .categories {
      padding: 1rem;
    }
  }
</style>
