---
import { ChevronUp, Clock, LockOpen, Minus, Plus, Search, ShoppingCart, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import Layout from "@/layouts/Layout.astro";
import { branchColor, branchContext, shiftBarData, branchHref, isLowStock } from "@/data/queries";
import { longDate } from "@/lib/dates";
import { formatBs } from "@/lib/format";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, business, products, currentShift: shift, today } = ctx;
---

<Layout title={`Registrar venta · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader
    compact
    tint={branchColor(ctx.membership, branch.id)}
    eyebrow={[longDate(today), shift && `Turno ${shift.name.toLowerCase()}`].filter(Boolean).join(" · ")}
    title="Registrar venta"
    description={`${branch.name} · elige los productos y el total se suma solo.`}
  />

  {
    !shift && (
      <div class="closed">
        <Clock size={20} stroke-width={1.75} />
        <p>No hay un turno abierto. Ábrelo para empezar a vender.</p>
        <a class="btn btn-primary" href={branchHref(business, branch, "turnos")}>
          <LockOpen size={18} stroke-width={1.75} />
          Abrir turno
        </a>
      </div>
    )
  }

  <div class="sale">
    <section class="catalog" aria-label="Productos">
      <label class="search">
        <Search size={18} stroke-width={1.75} />
        <span class="sr-only">Buscar producto</span>
        <input type="search" class="input" placeholder="Buscar producto" data-search autocomplete="off" />
      </label>

      {
        products.length === 0 && (
          <p class="card empty-state">
            Esta sucursal todavía no vende productos.
            {ctx.role === "dueño" && (
              <>
                {" "}
                <a href={branchHref(business, branch, "inventario")}>Agrégalos en Inventario</a>.
              </>
            )}
          </p>
        )
      }
      <ul class="product-grid" role="list">
        {
          products.map((p) => (
            <li data-name={p.name.toLowerCase()}>
              <button type="button" class="product" data-id={p.id} data-name={p.name} data-price={p.price ?? ""} data-stock={p.stock ?? ""} disabled={p.stock === 0 || !shift}>
                <span class="product-name">{p.name}</span>
                <span class="product-price num">{p.price === null ? "Precio al vender" : formatBs(p.price)}</span>
                {p.stock !== null && (
                  <span class:list={["product-stock num", { low: isLowStock(p) }]}>
                    {isLowStock(p) && p.stock > 0 && <TriangleAlert size={14} stroke-width={2} />}
                    {p.stock === 0 ? "Sin stock" : isLowStock(p) ? `Quedan ${p.stock}` : `${p.stock} en stock`}
                  </span>
                )}
                <span class="in-cart num" data-in-cart hidden />

                <span class="add play-btn" aria-hidden="true">
                  <Plus size={20} stroke-width={1.75} />
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="empty" data-empty hidden>Ningún producto coincide con tu búsqueda.</p>
    </section>

    <!-- En pantallas angostas la venta es una hoja pegada abajo: la barra muestra total y «Confirmar», y se despliega para ver las líneas. -->
    <aside class:list={["card cart", !shift && "cart-off"]} aria-labelledby="cart-title" data-cart>
      <header class="cart-head">
        <h2 id="cart-title" class="card-title">Venta actual</h2>
        {shift && <ShiftChip shift={shift} />}
      </header>

      <button type="button" class="cart-toggle" aria-expanded="false" aria-controls="cart-body" data-cart-toggle data-idle={shift ? `Turno ${shift.name.toLowerCase()}` : "Toca un producto para agregarlo"}>
        <span class="cart-art" aria-hidden="true">
          <ShoppingCart size={20} stroke-width={1.75} />
        </span>
        <span class="cart-toggle-text">
          <span class="cart-toggle-total num" data-total-mini>{formatBs(0)}</span>
          <span class="cart-toggle-sub" data-count>{shift ? `Turno ${shift.name.toLowerCase()}` : "Toca un producto para agregarlo"}</span>
        </span>
        <ChevronUp class="cart-chevron" size={20} stroke-width={1.75} />
      </button>

      <div class="cart-body" id="cart-body">
        <p class="cart-empty" data-cart-empty>
          <ShoppingCart size={20} stroke-width={1.75} />
          Todavía no agregaste productos.
        </p>
        <ul class="cart-lines" role="list" data-cart-lines></ul>

        <p class="cart-total">
          <span>Total</span>
          <span class="num" data-total aria-live="polite">{formatBs(0)}</span>
        </p>

        <button type="button" class="btn btn-secondary btn-block cart-clear" data-clear disabled>Vaciar</button>
      </div>

      <p class="notice cart-notice" data-notice role="status"></p>
      <button type="button" class="btn btn-primary btn-block cart-confirm" data-confirm data-branch={branch.id} data-shift={shift?.id} disabled>
        <span>Confirmar<span class="confirm-rest"> venta</span></span>
      </button>
    </aside>

    <template data-icons>
      <Minus size={18} stroke-width={1.75} data-icon="minus" />
      <Plus size={18} stroke-width={1.75} data-icon="plus" />
    </template>
  </div>
</Layout>

<script>
  import { actions } from "astro:actions";
  import { formatBs } from "@/lib/format";
  import { toast } from "@/scripts/dialogs";

  // Una línea por producto; con precio al vender, una línea por prenda (cada una con su precio).
  // price null: falta escribirlo. stock Infinity: sin control de stock.
  type Line = { productId: string; name: string; price: number | null; open: boolean; stock: number; qty: number };
  const cart = new Map<string, Line>();
  let openLines = 0;
  const lines = document.querySelector<HTMLUListElement>("[data-cart-lines]")!;
  const emptyCart = document.querySelector<HTMLElement>("[data-cart-empty]")!;
  const total = document.querySelector<HTMLElement>("[data-total]")!;
  const notice = document.querySelector<HTMLElement>("[data-notice]")!;
  const confirm = document.querySelector<HTMLButtonElement>("[data-confirm]")!;
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]")!;

  const icons = document.querySelector<HTMLTemplateElement>("[data-icons]")!.content;
  const cartBox = document.querySelector<HTMLElement>("[data-cart]")!;
  const toggle = document.querySelector<HTMLButtonElement>("[data-cart-toggle]")!;
  const totalMini = document.querySelector<HTMLElement>("[data-total-mini]")!;
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const products = document.querySelectorAll<HTMLButtonElement>(".product");

  /** Despliega o pliega la hoja de la venta (solo se ve como hoja en pantallas angostas). */
  function setOpen(open: boolean) {
    cartBox.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
  }
  toggle.addEventListener("click", () => setOpen(!cartBox.hasAttribute("data-open")));
  cartBox.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && cartBox.hasAttribute("data-open")) {
      setOpen(false);
      toggle.focus();
    }
  });

  function qtyButton(label: string, icon: "minus" | "plus", onClick: () => void) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "icon-btn qty-btn";
    button.append(icons.querySelector(`[data-icon="${icon}"]`)!.cloneNode(true));
    button.setAttribute("aria-label", label);
    button.addEventListener("click", onClick);
    return button;
  }

  /** Campo de precio de una prenda: actualiza el total al escribir sin redibujar la línea (no pierde el foco). */
  function priceInput(item: Line) {
    const input = document.createElement("input");
    Object.assign(input, { type: "number", inputMode: "decimal", step: "0.01", min: "0", placeholder: "Precio", className: "input line-price num" });
    input.setAttribute("aria-label", `Precio de ${item.name}`);
    if (item.price !== null) input.value = String(item.price);
    input.addEventListener("input", () => {
      item.price = Number(input.value) > 0 ? Number(input.value) : null;
      showTotal();
    });
    return input;
  }

  function showTotal() {
    const sum = formatBs([...cart.values()].reduce((a, l) => a + (l.price ?? 0) * l.qty, 0));
    total.textContent = totalMini.textContent = sum;
  }

  /** Resumen de la barra plegada y cuántos de cada producto ya están en la venta (en el mosaico, con texto). */
  function showCounts() {
    const byProduct = new Map<string, number>();
    for (const l of cart.values()) byProduct.set(l.productId, (byProduct.get(l.productId) ?? 0) + l.qty);
    const units = [...byProduct.values()].reduce((a, n) => a + n, 0);
    count.textContent = units === 0 ? toggle.dataset.idle! : `${units} ${units === 1 ? "producto" : "productos"}`;
    for (const button of products) {
      const badge = button.querySelector<HTMLElement>("[data-in-cart]")!;
      const n = byProduct.get(button.dataset.id!) ?? 0;
      badge.hidden = n === 0;
      badge.textContent = `${n} en la venta`;
    }
  }

  function render() {
    lines.replaceChildren();
    for (const [id, item] of cart) {
      const li = document.createElement("li");
      const name = document.createElement("span");
      name.className = "line-name";
      name.textContent = item.name;
      const qty = document.createElement("span");
      qty.className = "qty num";
      qty.textContent = String(item.qty);
      const amount = item.open ? priceInput(item) : document.createElement("span");
      if (!item.open) {
        amount.className = "line-amount num";
        amount.textContent = formatBs(item.price! * item.qty);
      }
      const step = (delta: number) => () => {
        if (delta > 0 && item.qty >= item.stock) {
          notice.textContent = `Solo quedan ${item.stock} de ${item.name}.`;
          return;
        }
        item.qty += delta;
        if (item.qty <= 0) cart.delete(id);
        render();
      };
      li.append(
        name,
        qtyButton(`Quitar un ${item.name}`, "minus", step(-1)),
        qty,
        qtyButton(`Agregar un ${item.name}`, "plus", step(1)),
        amount,
      );
      lines.append(li);
    }
    emptyCart.hidden = cart.size > 0;
    showTotal();
    showCounts();
    confirm.disabled = clear.disabled = cart.size === 0;
    if (cart.size === 0) setOpen(false);
  }

  for (const button of products) {
    button.addEventListener("click", () => {
      const { id, name, price, stock } = button.dataset;
      const open = price === "";
      const key = open ? `${id}#${++openLines}` : id!;
      const item = cart.get(key) ?? { productId: id!, name: name!, price: open ? null : Number(price), open, stock: stock === "" ? Infinity : Number(stock), qty: 0 };
      if (item.qty >= item.stock) {
        notice.textContent = `Solo quedan ${item.stock} de ${item.name}.`;
        return;
      }
      item.qty += 1;
      cart.set(key, item);
      notice.textContent = "";
      render();
      // La prenda recién agregada pide su precio enseguida (en pantallas angostas, despliega la hoja para escribirlo).
      if (open) {
        setOpen(true);
        lines.querySelector<HTMLInputElement>("li:last-child .line-price")?.focus();
      }
    });
  }

  clear.addEventListener("click", () => {
    cart.clear();
    render();
  });

  confirm.addEventListener("click", async () => {
    const missing = [...cart.values()].find((l) => l.price === null);
    if (missing) {
      notice.textContent = `Escribe el precio de «${missing.name}».`;
      setOpen(true);
      return;
    }
    confirm.disabled = clear.disabled = true;
    notice.textContent = "Guardando venta…";
    const { error } = await actions.registerSale({
      branchId: confirm.dataset.branch!,
      shiftId: confirm.dataset.shift!,
      items: [...cart.values()].map((l) => ({ productId: l.productId, qty: l.qty, ...(l.open && { price: l.price! }) })),
    });
    if (error) {
      notice.textContent = error.message;
      confirm.disabled = clear.disabled = false;
      return;
    }
    // Recarga para mostrar el stock actualizado; el aviso queda para la siguiente vista.
    try {
      sessionStorage.setItem("sale-notice", `Venta de ${total.textContent} registrada.`);
    } catch {}
    window.location.reload();
  });

  try {
    const saved = sessionStorage.getItem("sale-notice");
    if (saved) {
      toast(saved, "success");
      sessionStorage.removeItem("sale-notice");
    }
  } catch {}

  const search = document.querySelector<HTMLInputElement>("[data-search]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  search.addEventListener("input", () => {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    for (const li of document.querySelectorAll<HTMLLIElement>(".product-grid li")) {
      li.hidden = !li.dataset.name!.includes(query);
      if (!li.hidden) visible++;
    }
    empty.hidden = visible > 0;
  });
</script>

<style>
  .sale {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: 1.5rem;
    align-items: start;
  }

  .search {
    position: relative;
    display: block;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }

  .search :global(svg) {
    position: absolute;
    top: 50%;
    left: 0.875rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .search .input {
    padding-left: 2.75rem;
  }


  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mosaico de producto: superficie elevada; al pasar el mouse se aclara y asoma el botón redondo de agregar. */
  .product {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    width: 100%;
    height: 100%;
    padding: 1rem;
    border: none;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms;
  }

  .product:hover:not(:disabled) {
    background: var(--color-surface-hover);
  }

  .add {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0;
    transform: translateY(0.375rem);
    transition:
      opacity 200ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .product:is(:hover, :focus-visible):not(:disabled) .add {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .add {
      transition: none;
    }
  }

  .product:active {
    scale: 0.98;
  }

  .product:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .product-name {
    font-weight: var(--font-bold);
  }

  .product-price {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
  }

  .product-stock {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .product-stock.low {
    color: var(--color-warning);
    font-weight: var(--font-semibold);
  }

  /* Sin turno abierto: el aviso va arriba, antes de los productos, con la salida a mano. */
  .closed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .closed p {
    flex: 1 1 16rem;
    margin: 0;
    font-weight: var(--font-semibold);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .cart {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cart-empty {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    padding: 1.5rem 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cart-empty[hidden] {
    display: none;
  }

  .cart-lines {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .cart-lines:empty {
    display: none;
  }

  .cart-lines :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.75rem auto 5.5rem;
    align-items: center;
    gap: 0.25rem;
  }

  .cart-lines :global(.qty-btn) {
    width: 2rem;
    height: 2rem;
    font-size: var(--text-lg);
  }

  .cart-lines :global(.qty) {
    text-align: center;
    font-weight: var(--font-semibold);
  }

  .cart-lines :global(.line-amount) {
    text-align: right;
  }

  .cart-lines :global(.line-price) {
    min-height: 2.25rem;
    padding-block: 0.25rem;
    text-align: right;
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-semibold);
  }

  .cart-total .num {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--font-bold);
  }

  /* Cuántos de este producto ya van en la venta: con texto, porque en pantallas angostas la venta está plegada. */
  .in-cart {
    justify-self: start;
    margin-top: 0.25rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--color-primary-soft);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
  }

  .in-cart[hidden] {
    display: none;
  }

  /* En escritorio la venta es la tarjeta de siempre: la barra plegable no existe y «Vaciar» va al final. */
  .cart-toggle {
    display: none;
  }

  .cart-body {
    display: contents;
  }

  .cart-clear {
    order: 2;
  }

  .cart-notice,
  .cart-confirm {
    order: 1;
  }

  /* Con pantalla táctil, el botón de agregar se ve siempre y los botones de cantidad llegan a 44px. */
  @media (hover: none) {
    .add {
      opacity: 1;
      transform: none;
    }

    /* El botón fijo ocupa la esquina: el stock no pasa por debajo. */
    .product-stock {
      padding-right: 2.75rem;
    }
  }

  @media (pointer: coarse) {
    .cart-lines :global(.qty-btn) {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* Pantallas angostas: el catálogo ocupa todo el ancho y la venta es una hoja pegada abajo, como el mini-reproductor.
     Plegada muestra el total, cuántos productos lleva y «Confirmar»; desplegada suma las líneas encima. */
  @media (max-width: 960px) {
    .sale {
      grid-template-columns: minmax(0, 1fr);
    }

    .cart:not(.cart-off) {
      position: sticky;
      top: auto;
      bottom: calc(0.5rem + env(safe-area-inset-bottom));
      z-index: 40;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding: 0.5rem;
      background: var(--color-surface-hover);
      box-shadow: var(--shadow-md);
    }

    .cart:not(.cart-off) .cart-head,
    .cart:not(.cart-off) .cart-total {
      display: none;
    }

    .cart[data-open]:not(.cart-off) .cart-head {
      grid-column: 1 / -1;
      grid-row: 1;
      display: flex;
      padding: 0.5rem 0.5rem 0;
    }

    .cart:not(.cart-off) .cart-toggle {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      min-height: 2.75rem;
      padding: 0;
      border: none;
      border-radius: 0.375rem;
      background: none;
      color: var(--color-text);
      text-align: left;
      cursor: pointer;
    }

    .cart-art {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 0.375rem;
      background: var(--color-primary-soft);
      color: var(--color-text);
    }

    .cart-toggle-text {
      display: grid;
      min-width: 0;
    }

    .cart-toggle-total {
      font-size: var(--text-lg);
      font-weight: var(--font-extrabold);
      letter-spacing: -0.02em;
    }

    .cart-toggle-sub {
      overflow: hidden;
      color: var(--color-text-muted);
      font-size: var(--text-xs);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cart-toggle :global(.cart-chevron) {
      flex-shrink: 0;
      color: var(--color-text-muted);
      transition: rotate 200ms var(--ease-out);
    }

    .cart[data-open] .cart-toggle :global(.cart-chevron) {
      rotate: 180deg;
    }

    .cart:not(.cart-off) .cart-confirm {
      grid-column: 2;
      grid-row: 4;
      width: auto;
    }

    .cart:not(.cart-off) .cart-toggle {
      grid-column: 1;
      grid-row: 4;
    }

    .cart:not(.cart-off) .cart-notice {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    /* Desplegada: las líneas crecen hacia arriba, con su propio scroll si son muchas. */
    .cart:not(.cart-off) .cart-body {
      display: none;
    }

    .cart[data-open]:not(.cart-off) .cart-body {
      grid-column: 1 / -1;
      grid-row: 2;
      display: grid;
      gap: 0.75rem;
      max-height: min(55dvh, 28rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.5rem 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      animation: sheet-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .cart-off {
      position: static;
    }

    /* Una línea por fila en dos renglones: el nombre arriba, cantidad y monto debajo. */
    .cart-lines :global(li) {
      grid-template-columns: auto 1.75rem auto minmax(0, 1fr);
      row-gap: 0.125rem;
    }

    .cart-lines :global(.line-name) {
      grid-column: 1 / -1;
