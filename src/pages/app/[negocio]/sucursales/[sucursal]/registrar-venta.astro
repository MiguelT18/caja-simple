---
import { Plus, Search, ShoppingCart } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import Layout from "@/layouts/Layout.astro";
import { branchColor, branchContext, shiftBarData, branchHref } from "@/data/queries";
import { formatBs } from "@/lib/format";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, business, products, currentShift: shift } = ctx;
---

<Layout title={`Registrar venta · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader tint={branchColor(ctx.membership, branch.id)} title="Registrar venta" description={`${branch.name} · toca los productos para agregarlos a la venta`} />

  <div class="sale">
    <section class="catalog" aria-label="Productos">
      <label class="search">
        <Search size={18} stroke-width={1.75} />
        <span class="sr-only">Buscar producto</span>
        <input type="search" class="input" placeholder="Buscar producto" data-search autocomplete="off" />
      </label>

      {
        products.length === 0 && (
          <p class="card empty-state">
            Esta sucursal todavía no vende productos.
            {ctx.role === "dueño" && (
              <>
                {" "}
                <a href={branchHref(business, branch, "inventario")}>Agrégalos en Inventario</a>.
              </>
            )}
          </p>
        )
      }
      <ul class="product-grid" role="list">
        {
          products.map((p) => (
            <li data-name={p.name.toLowerCase()}>
              <button type="button" class="product" data-id={p.id} data-name={p.name} data-price={p.price ?? ""} data-stock={p.stock ?? ""} disabled={p.stock === 0 || !shift}>
                <span class="product-name">{p.name}</span>
                <span class="product-price num">{p.price === null ? "Precio al vender" : formatBs(p.price)}</span>
                <span class="product-stock num">
                  {p.stock === null ? "Sin control de stock" : p.stock === 0 ? "Sin stock" : `${p.stock} en stock`}
                </span>
                <span class="add play-btn" aria-hidden="true">
                  <Plus size={20} stroke-width={1.75} />
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="empty" data-empty hidden>Ningún producto coincide con tu búsqueda.</p>
    </section>

    <aside class="card cart" aria-labelledby="cart-title">
      <header class="cart-head">
        <h2 id="cart-title" class="card-title">Venta actual</h2>
        {shift && <ShiftChip shift={shift} />}
      </header>

      {
        !shift && (
          <p class="notice">
            No hay un turno abierto. <a href={branchHref(business, branch, "turnos")}>Abre uno en Turnos</a> para registrar ventas.
          </p>
        )
      }

      <p class="cart-empty" data-cart-empty>
        <ShoppingCart size={20} stroke-width={1.75} />
        Todavía no agregaste productos.
      </p>
      <ul class="cart-lines" role="list" data-cart-lines></ul>

      <p class="cart-total">
        <span>Total</span>
        <span class="num" data-total aria-live="polite">{formatBs(0)}</span>
      </p>

      <p class="notice" data-notice role="status"></p>
      <button type="button" class="btn btn-primary btn-block" data-confirm data-branch={branch.id} data-shift={shift?.id} disabled>
        Confirmar venta
      </button>
      <button type="button" class="btn btn-secondary btn-block" data-clear disabled>Vaciar</button>
    </aside>
  </div>
</Layout>

<script>
  import { actions } from "astro:actions";
  import { formatBs } from "@/lib/format";

  // Una línea por producto; con precio al vender, una línea por prenda (cada una con su precio).
  // price null: falta escribirlo. stock Infinity: sin control de stock.
  type Line = { productId: string; name: string; price: number | null; open: boolean; stock: number; qty: number };
  const cart = new Map<string, Line>();
  let openLines = 0;
  const lines = document.querySelector<HTMLUListElement>("[data-cart-lines]")!;
  const emptyCart = document.querySelector<HTMLElement>("[data-cart-empty]")!;
  const total = document.querySelector<HTMLElement>("[data-total]")!;
  const notice = document.querySelector<HTMLElement>("[data-notice]")!;
  const confirm = document.querySelector<HTMLButtonElement>("[data-confirm]")!;
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]")!;

  function qtyButton(label: string, text: string, onClick: () => void) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "icon-btn qty-btn";
    button.textContent = text;
    button.setAttribute("aria-label", label);
    button.addEventListener("click", onClick);
    return button;
  }

  /** Campo de precio de una prenda: actualiza el total al escribir sin redibujar la línea (no pierde el foco). */
  function priceInput(item: Line) {
    const input = document.createElement("input");
    Object.assign(input, { type: "number", inputMode: "decimal", step: "0.01", min: "0", placeholder: "Precio", className: "input line-price num" });
    input.setAttribute("aria-label", `Precio de ${item.name}`);
    if (item.price !== null) input.value = String(item.price);
    input.addEventListener("input", () => {
      item.price = Number(input.value) > 0 ? Number(input.value) : null;
      total.textContent = formatBs([...cart.values()].reduce((a, l) => a + (l.price ?? 0) * l.qty, 0));
    });
    return input;
  }

  function render() {
    lines.replaceChildren();
    let sum = 0;
    for (const [id, item] of cart) {
      sum += (item.price ?? 0) * item.qty;
      const li = document.createElement("li");
      const name = document.createElement("span");
      name.className = "line-name";
      name.textContent = item.name;
      const qty = document.createElement("span");
      qty.className = "qty num";
      qty.textContent = String(item.qty);
      const amount = item.open ? priceInput(item) : document.createElement("span");
      if (!item.open) {
        amount.className = "line-amount num";
        amount.textContent = formatBs(item.price! * item.qty);
      }
      const step = (delta: number) => () => {
        if (delta > 0 && item.qty >= item.stock) {
          notice.textContent = `Solo quedan ${item.stock} de ${item.name}.`;
          return;
        }
        item.qty += delta;
        if (item.qty <= 0) cart.delete(id);
        render();
      };
      li.append(
        name,
        qtyButton(`Quitar un ${item.name}`, "−", step(-1)),
        qty,
        qtyButton(`Agregar un ${item.name}`, "+", step(1)),
        amount,
      );
      lines.append(li);
    }
    emptyCart.hidden = cart.size > 0;
    total.textContent = formatBs(sum);
    confirm.disabled = clear.disabled = cart.size === 0;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".product")) {
    button.addEventListener("click", () => {
      const { id, name, price, stock } = button.dataset;
      const open = price === "";
      const key = open ? `${id}#${++openLines}` : id!;
      const item = cart.get(key) ?? { productId: id!, name: name!, price: open ? null : Number(price), open, stock: stock === "" ? Infinity : Number(stock), qty: 0 };
      if (item.qty >= item.stock) {
        notice.textContent = `Solo quedan ${item.stock} de ${item.name}.`;
        return;
      }
      item.qty += 1;
      cart.set(key, item);
      notice.textContent = "";
      render();
      // La prenda recién agregada pide su precio enseguida.
      if (open) lines.querySelector<HTMLInputElement>("li:last-child .line-price")?.focus();
    });
  }

  clear.addEventListener("click", () => {
    cart.clear();
    render();
  });

  confirm.addEventListener("click", async () => {
    const missing = [...cart.values()].find((l) => l.price === null);
    if (missing) {
      notice.textContent = `Escribe el precio de «${missing.name}».`;
      return;
    }
    confirm.disabled = clear.disabled = true;
    notice.textContent = "Guardando venta…";
    const { error } = await actions.registerSale({
      branchId: confirm.dataset.branch!,
      shiftId: confirm.dataset.shift!,
      items: [...cart.values()].map((l) => ({ productId: l.productId, qty: l.qty, ...(l.open && { price: l.price! }) })),
    });
    if (error) {
      notice.textContent = error.message;
      confirm.disabled = clear.disabled = false;
      return;
    }
    // Recarga para mostrar el stock actualizado; el aviso queda para la siguiente vista.
    sessionStorage.setItem("sale-notice", "Venta registrada.");
    window.location.reload();
  });

  try {
    const saved = sessionStorage.getItem("sale-notice");
    if (saved) {
      notice.textContent = saved;
      sessionStorage.removeItem("sale-notice");
    }
  } catch {}

  const search = document.querySelector<HTMLInputElement>("[data-search]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  search.addEventListener("input", () => {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    for (const li of document.querySelectorAll<HTMLLIElement>(".product-grid li")) {
      li.hidden = !li.dataset.name!.includes(query);
      if (!li.hidden) visible++;
    }
    empty.hidden = visible > 0;
  });
</script>

<style>
  .sale {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: 1.5rem;
    align-items: start;
  }

  .search {
    position: relative;
    display: block;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }

  .search :global(svg) {
    position: absolute;
    top: 50%;
    left: 0.875rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .search .input {
    padding-left: 2.75rem;
  }


  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mosaico de producto: superficie elevada; al pasar el mouse se aclara y asoma el botón redondo de agregar. */
  .product {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    width: 100%;
    height: 100%;
    padding: 1rem;
    border: none;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms;
  }

  .product:hover:not(:disabled) {
    background: var(--color-surface-hover);
  }

  .add {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0;
    transform: translateY(0.375rem);
    transition:
      opacity 200ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .product:is(:hover, :focus-visible):not(:disabled) .add {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .add {
      transition: none;
    }
  }

  .product:active {
    scale: 0.98;
  }

  .product:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .product-name {
    font-weight: var(--font-bold);
  }

  .product-price {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
  }

  .product-stock {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .cart {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cart-empty {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    padding: 1.5rem 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cart-empty[hidden] {
    display: none;
  }

  .cart-lines {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .cart-lines:empty {
    display: none;
  }

  .cart-lines :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.75rem auto 5.5rem;
    align-items: center;
    gap: 0.25rem;
  }

  .cart-lines :global(.qty-btn) {
    width: 2rem;
    height: 2rem;
    font-size: var(--text-lg);
  }

  .cart-lines :global(.qty) {
    text-align: center;
    font-weight: var(--font-semibold);
  }

  .cart-lines :global(.line-amount) {
    text-align: right;
  }

  .cart-lines :global(.line-price) {
    min-height: 2.25rem;
    padding-block: 0.25rem;
    text-align: right;
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-semibold);
  }

  .cart-total .num {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--font-bold);
  }

  @media (max-width: 960px) {
    .sale {
      grid-template-columns: minmax(0, 1fr);
    }

    .cart {
      position: static;
    }
  }
</style>
