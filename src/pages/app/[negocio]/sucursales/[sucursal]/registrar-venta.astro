      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.5rem 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      animation: sheet-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .cart-off {
      position: static;
    }
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  /* Móvil: en esta página la hoja de la venta ocupa el lugar del mini-reproductor del turno (el turno va en la barra de la venta y en su encabezado). */
  @media (max-width: 768px) {
    :global(body:has(> .shift-bar):has(.cart:not(.cart-off)) > .shift-bar) {
      display: none;
    }

    :global(body:has(> .shift-bar):has(.cart:not(.cart-off)) main) {
      padding-bottom: 1rem;
    }

    .cart:not(.cart-off) {
      margin-inline: -0.5rem;
    }
  }

  /* Celular: «Cobrar» a secas, para que la barra deje lugar al total (que ya se ve al lado); el total sigue en el nombre del botón. */
  @media (max-width: 480px) {
    .confirm-rest {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart[data-open] .cart-body {
      animation: none;
    }

    .cart-toggle :global(.cart-chevron) {
      transition: none;
    }
  }
</style>
