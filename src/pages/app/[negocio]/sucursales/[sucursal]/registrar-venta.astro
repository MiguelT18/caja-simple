---
import { ChevronUp, Clock, LockOpen, Minus, Package, Plus, Search, ShoppingCart, TriangleAlert, X } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import Layout from "@/layouts/Layout.astro";
import { branchColor, branchContext, shiftBarData, branchHref, colorAt, isLowStock } from "@/data/queries";
import { longDate } from "@/lib/dates";
import { formatBs } from "@/lib/format";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, business, categories, products, currentShift: shift, today } = ctx;

// Cada categoría con un color de la paleta (el arte de los productos sin foto); el filtro solo con 2 grupos o más.
const NONE = "none";
const groups = [
  ...categories.filter((c) => products.some((p) => p.categoryId === c.id)).map((c) => ({ id: c.id, name: c.name })),
  ...(products.some((p) => !p.categoryId) ? [{ id: NONE, name: "Sin categoría" }] : []),
];
const colorOf = (categoryId?: string) => {
  const i = categories.findIndex((c) => c.id === categoryId);
  return i < 0 ? "var(--color-text-muted)" : colorAt(i);
};
---

<Layout title={`Registrar venta · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader
    compact
    tint={branchColor(ctx.membership, branch.id)}
    eyebrow={[longDate(today), shift && `Turno ${shift.name.toLowerCase()}`].filter(Boolean).join(" · ")}
    title="Registrar venta"
    description={`${branch.name} · elige los productos y el total se suma solo.`}
  />

  {
    !shift && (
      <div class="closed">
        <Clock size={20} stroke-width={1.75} />
        <p>No hay un turno abierto. Ábrelo para empezar a vender.</p>
        <a class="btn btn-primary" href={branchHref(business, branch, "turnos")}>
          <LockOpen size={18} stroke-width={1.75} />
          Abrir turno
        </a>
      </div>
    )
  }

  <div class="sale">
    <section class="catalog" aria-label="Productos">
      <div class="toolbar" hidden={products.length === 0}>
        <label class="search">
          <Search size={18} stroke-width={1.75} />
          <span class="sr-only">Buscar producto</span>
          <input type="search" class="input" placeholder="Buscar producto" aria-keyshortcuts="/" data-search autocomplete="off" />
        </label>

        {
          groups.length > 1 && (
            <div class="filters" role="group" aria-label="Filtrar por categoría">
              <button type="button" class="pill" aria-pressed="true" data-filter="">
                Todo
              </button>
              {groups.map((g) => (
                <button type="button" class="pill" aria-pressed="false" data-filter={g.id}>
                  {g.name}
                </button>
              ))}
            </div>
          )
        }
      </div>

      {
        products.length === 0 && (
          <p class="card empty-state">
            Esta sucursal todavía no vende productos.
            {ctx.role === "dueño" ? (
              <>
                {" "}
                <a href={branchHref(business, branch, "inventario")}>Agrégalos en Inventario</a>.
              </>
            ) : (
              " Pide a quien administra el negocio que los agregue en Inventario."
            )}
          </p>
        )
      }

      <!-- Card tipo álbum: el botón invisible cubre toda la card (agrega uno); el stepper va encima del arte y aparece cuando el producto ya está en la venta. -->
      <ul class="product-grid" role="list">
        {
          products.map((p) => {
            const price = p.price === null ? "precio al vender" : formatBs(p.price);
            return (
              <li data-name={p.name.toLowerCase()} data-category={p.categoryId ?? NONE}>
                <div
                  class:list={["product", { "sold-out": p.stock === 0 }]}
                  data-product
                  data-id={p.id}
                  data-name={p.name}
                  data-price={p.price ?? ""}
                  data-stock={p.stock ?? ""}
                  data-min-stock={p.minStock ?? ""}
                  data-image={p.image ?? ""}
                  data-color={colorOf(p.categoryId)}
                >
                  <button type="button" class="product-add" aria-label={`Agregar ${p.name}, ${price}`} disabled={p.stock === 0 || !shift} data-add />

                  <span class="art" style={`--cat: ${colorOf(p.categoryId)}`}>
                    {p.image ? <img class="skeleton" src={p.image} alt="" loading="lazy" /> : <Package size={36} stroke-width={1.5} />}
                    <span class="out-chip">Sin stock</span>
                    <span class="add play-btn" aria-hidden="true">
                      <Plus size={20} stroke-width={1.75} />
                    </span>
                    {p.price !== null && (
                      <span class="stepper" role="group" aria-label={`${p.name} en la venta`}>
                        <button type="button" class="icon-btn" aria-label={`Quitar un ${p.name}`} data-step="-1">
                          <Minus size={16} stroke-width={2} />
                        </button>
                        <span class="num" data-qty>
                          0
                        </span>
                        <button type="button" class="icon-btn" aria-label={`Agregar un ${p.name}`} data-step="1">
                          <Plus size={16} stroke-width={2} />
                        </button>
                      </span>
                    )}
                  </span>

                  <span class="product-name">{p.name}</span>
                  <span class="product-price num">{p.price === null ? "Precio al vender" : formatBs(p.price)}</span>
                  {p.stock !== null && (
                    <span class:list={["product-stock num", { low: isLowStock(p), warn: isLowStock(p) && p.stock > 0 }]} data-stock-label>
                      <TriangleAlert size={14} stroke-width={2} />
                      <span data-stock-text>{p.stock === 0 ? "Sin stock" : isLowStock(p) ? `Quedan ${p.stock}` : `${p.stock} en stock`}</span>
                    </span>
                  )}
                  <span class="in-cart num" data-in-cart hidden />
                </div>
              </li>
            );
          })
        }
      </ul>
      <p class="empty" data-empty hidden>
        Ningún producto coincide.
        <button type="button" class="link-btn" data-clear-filters>Quitar filtros</button>
      </p>
    </section>

    <!-- En pantallas angostas la venta es una hoja pegada abajo: la barra muestra total y «Cobrar», y se despliega para ver las líneas. -->
    <aside class:list={["card cart", !shift && "cart-off"]} aria-labelledby="cart-title" data-cart>
      <header class="cart-head">
        <div class="cart-title">
          <h2 id="cart-title" class="card-title">Venta actual</h2>
          <span class="cart-units" data-units></span>
        </div>
        {shift && <ShiftChip shift={shift} />}
        <button type="button" class="link-btn cart-clear" data-clear hidden>Vaciar</button>
      </header>

      <button type="button" class="cart-toggle" aria-expanded="false" aria-controls="cart-body" data-cart-toggle data-idle={shift ? `Turno ${shift.name.toLowerCase()}` : "Elige productos para empezar"}>
        <span class="cart-art" aria-hidden="true">
          <ShoppingCart size={20} stroke-width={1.75} />
        </span>
        <span class="cart-toggle-text">
          <span class="cart-toggle-total num" data-total-mini>{formatBs(0)}</span>
          <span class="cart-toggle-sub" data-count>{shift ? `Turno ${shift.name.toLowerCase()}` : "Elige productos para empezar"}</span>
        </span>
        <ChevronUp class="cart-chevron" size={20} stroke-width={1.75} />
      </button>

      <div class="cart-body" id="cart-body">
        <p class="cart-empty" data-cart-empty>
          <ShoppingCart size={20} stroke-width={1.75} />
          Elige productos para empezar la venta.
        </p>
        <ul class="cart-lines" role="list" data-cart-lines></ul>

        <p class="cart-total">
          <span>Total</span>
          <span class="num" data-total aria-live="polite">{formatBs(0)}</span>
        </p>

        <!-- Solo para el efectivo del mostrador: no se guarda con la venta. -->
        <div class="change" data-change hidden>
          <label class="field-label" for="paid">Paga con (Bs)</label>
          <input id="paid" class="input num" type="number" inputmode="decimal" step="0.01" min="0" placeholder="0,00" autocomplete="off" data-paid />
          <p class="change-result num" aria-live="polite" data-change-result></p>
        </div>
      </div>

      <p class="notice cart-notice" data-notice role="status"></p>
      <button type="button" class="btn btn-primary btn-block cart-confirm" data-confirm data-branch={branch.id} data-shift={shift?.id} disabled>
        <span>Cobrar<span class="confirm-rest"> <span data-confirm-total>{formatBs(0)}</span></span></span>
      </button>
    </aside>

    <template data-icons>
      <Minus size={16} stroke-width={2} data-icon="minus" />
      <Plus size={16} stroke-width={2} data-icon="plus" />
      <X size={16} stroke-width={2} data-icon="remove" />
      <Package size={18} stroke-width={1.75} data-icon="package" />
      <TriangleAlert size={16} stroke-width={2} data-icon="alert" />
    </template>
  </div>
</Layout>

<script>
  import { actions } from "astro:actions";
  import { formatBs } from "@/lib/format";
  import { isBusy, setBusy } from "@/scripts/busy";
  import { announce, confirmDialog, flashToast } from "@/scripts/dialogs";

  // Una línea por producto; con precio al vender, una línea por prenda (cada una con su precio).
  // price null: falta escribirlo. stock Infinity: sin control de stock.
  type Line = { productId: string; name: string; price: number | null; open: boolean; stock: number; qty: number; image: string; color: string };
  const cart = new Map<string, Line>();
  let openLines = 0;
  let totalValue = 0;

  const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const lines = $<HTMLUListElement>("[data-cart-lines]");
  const emptyCart = $("[data-cart-empty]");
  const total = $("[data-total]");
  const notice = $("[data-notice]");
  const confirm = $<HTMLButtonElement>("[data-confirm]");
  const confirmTotal = $("[data-confirm-total]");
  const clear = $<HTMLButtonElement>("[data-clear]");
  const units = $("[data-units]");
  const change = $("[data-change]");
  const paid = $<HTMLInputElement>("[data-paid]");
  const changeResult = $("[data-change-result]");

  const icons = $<HTMLTemplateElement>("[data-icons]").content;
  const icon = (name: string) => icons.querySelector(`[data-icon="${name}"]`)!.cloneNode(true);
  const cartBox = $("[data-cart]");
  const toggle = $<HTMLButtonElement>("[data-cart-toggle]");
  const totalMini = $("[data-total-mini]");
  const count = $("[data-count]");
  const cards = document.querySelectorAll<HTMLElement>("[data-product]");
  const cardById = new Map([...cards].map((card) => [card.dataset.id!, card]));

  /** Despliega o pliega la hoja de la venta (solo se ve como hoja en pantallas angostas). */
  function setOpen(open: boolean) {
    cartBox.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
  }
  toggle.addEventListener("click", () => setOpen(!cartBox.hasAttribute("data-open")));
  cartBox.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && cartBox.hasAttribute("data-open")) {
      setOpen(false);
      toggle.focus();
    }
  });

  const plural = (n: number) => `${n} ${n === 1 ? "producto" : "productos"}`;

  /** Unidades de un producto en la venta (con precio al vender, suma todas sus líneas). */
  function inCart(productId: string) {
    let n = 0;
    for (const l of cart.values()) if (l.productId === productId) n += l.qty;
    return n;
  }

  /** Suma una unidad del producto (o una prenda nueva, si su precio se escribe al vender). */
  function add(productId: string) {
    const card = cardById.get(productId)!;
    const { name, price, stock, image = "", color = "" } = card.dataset;
    const open = price === "";
    const key = open ? `${productId}#${++openLines}` : productId;
    const item = cart.get(key) ?? { productId, name: name!, price: open ? null : Number(price), open, stock: stock === "" ? Infinity : Number(stock), qty: 0, image, color };
    if (inCart(productId) >= item.stock) {
      notice.textContent = `Solo quedan ${item.stock} de ${item.name}.`;
      return;
    }
    item.qty += 1;
    cart.set(key, item);
    notice.textContent = "";
    render();
    announceCart(`Agregado ${item.name}.`);
    // La prenda recién agregada pide su precio enseguida (en pantallas angostas, despliega la hoja para escribirlo).
    if (open) {
      setOpen(true);
      lines.querySelector<HTMLInputElement>("li:last-child .line-price")?.focus();
    }
  }

  /** Cambia la cantidad de una línea; el stepper de la card y el del carro usan esta misma función. */
  function step(key: string, delta: number) {
    const item = cart.get(key);
    if (!item) return delta > 0 && add(key);
    if (delta > 0 && inCart(item.productId) >= item.stock) {
      notice.textContent = `Solo quedan ${item.stock} de ${item.name}.`;
      return;
    }
    notice.textContent = "";
    item.qty += delta;
    if (item.qty <= 0) cart.delete(key);
    render();
    announceCart(item.qty <= 0 ? `Quitado ${item.name}.` : `${item.name}: ${item.qty}.`);
  }

  function remove(key: string) {
    const item = cart.get(key);
    cart.delete(key);
    notice.textContent = "";
    render();
    if (item) announceCart(`Quitado ${item.name}.`);
  }

  /** Cada cambio del carro se anuncia con el resumen: el total visible puede estar plegado en el celular. */
  function announceCart(what: string) {
    let n = 0;
    for (const l of cart.values()) n += l.qty;
    announce(n === 0 ? `${what} La venta quedó vacía.` : `${what} ${plural(n)}, total ${formatBs(totalValue)}.`);
  }

  /** Lo que da de cambio el efectivo recibido; si no alcanza, cuánto falta (con ícono, no solo color). */
  function showChange() {
    change.hidden = cart.size === 0;
    const value = paid.value === "" ? null : Number(paid.value);
    changeResult.replaceChildren();
    changeResult.classList.remove("short");
    if (value === null || cart.size === 0) return;
    if (value >= totalValue) {
      changeResult.textContent = `Cambio: ${formatBs(value - totalValue)}`;
    } else {
      changeResult.classList.add("short");
      changeResult.append(icon("alert"), `Faltan ${formatBs(totalValue - value)}`);
    }
  }
  paid.addEventListener("input", showChange);

  function showTotal() {
    totalValue = [...cart.values()].reduce((a, l) => a + (l.price ?? 0) * l.qty, 0);
    total.textContent = totalMini.textContent = confirmTotal.textContent = formatBs(totalValue);
    showChange();
  }

  /** Resumen de la barra plegada y, en cada card, cuántos van en la venta y el stock que queda descontándolos. */
  function showCounts() {
    const byProduct = new Map<string, number>();
    for (const l of cart.values()) byProduct.set(l.productId, (byProduct.get(l.productId) ?? 0) + l.qty);
    const n = [...byProduct.values()].reduce((a, x) => a + x, 0);
    count.textContent = n === 0 ? toggle.dataset.idle! : plural(n);
    units.textContent = n === 0 ? "" : plural(n);
    for (const card of cards) {
      const inSale = byProduct.get(card.dataset.id!) ?? 0;
      const open = card.dataset.price === "";
      const addButton = card.querySelector<HTMLButtonElement>("[data-add]")!;
      // Precio fijo: el stepper sobre el arte. Precio al vender: cada toque es otra prenda, así que solo se cuenta.
      card.classList.toggle("in-sale", inSale > 0 && !open);
      const qty = card.querySelector("[data-qty]");
      if (qty) qty.textContent = String(inSale);
      const badge = card.querySelector<HTMLElement>("[data-in-cart]")!;
      badge.hidden = !open || inSale === 0;
      badge.textContent = `${inSale} en la venta`;

      const label = card.querySelector<HTMLElement>("[data-stock-label]");
      if (!label) continue; // Sin control de stock.
      const left = Number(card.dataset.stock) - inSale;
      const min = card.dataset.minStock;
      const low = min !== "" && left <= Number(min);
      label.classList.toggle("low", low);
      label.classList.toggle("warn", low && left > 0);
      label.querySelector("[data-stock-text]")!.textContent = left <= 0 ? "Sin stock" : low ? `Quedan ${left}` : `${left} en stock`;
      // aria-disabled y no disabled: si el botón tiene el foco, lo conserva (step/add avisan que no queda).
      card.querySelector('[data-step="1"]')?.setAttribute("aria-disabled", String(left <= 0));
      // Agotado en la venta: la card se apaga; se reactiva al quitar unidades del carro.
      if (!confirm.dataset.shift) continue;
      addButton.setAttribute("aria-disabled", String(left <= 0));
      card.classList.toggle("sold-out", left <= 0 && inSale === 0);
    }
  }

  function iconButton(label: string, name: string, onClick: () => void, className = "") {
    const button = document.createElement("button");
    button.type = "button";
    button.dataset.role = name;
    button.className = `icon-btn ${className}`;
    button.append(icon(name));
    button.setAttribute("aria-label", label);
    button.addEventListener("click", onClick);
    return button;
  }

  /** Campo de precio de una prenda: actualiza el total al escribir sin redibujar la línea (no pierde el foco). */
  function priceInput(item: Line) {
    const input = document.createElement("input");
    Object.assign(input, { type: "number", inputMode: "decimal", step: "0.01", min: "0", placeholder: "Precio", className: "input line-price num" });
    input.setAttribute("aria-label", `Precio de ${item.name}`);
    if (item.price !== null) input.value = String(item.price);
    input.addEventListener("input", () => {
      item.price = Number(input.value) > 0 ? Number(input.value) : null;
      amountOf.get(item)!.textContent = item.price === null ? "—" : formatBs(item.price * item.qty);
      showTotal();
    });
    return input;
  }

  const amountOf = new WeakMap<Line, HTMLElement>();
  /** La cantidad sola es un número suelto para el lector de pantalla: se le agrega «unidades». */
  const withUnits = (qty: HTMLElement) => (qty.append(el("span", "sr-only", " unidades")), qty);
  const el = (tag: string, className: string, text = "") => Object.assign(document.createElement(tag), { className, textContent: text });

  /** Qué botón del carro tenía el foco antes de redibujar: la línea, el botón y su posición. */
  function focusedLine() {
    const button = document.activeElement instanceof HTMLButtonElement ? document.activeElement : null;
    const li = button?.closest<HTMLLIElement>("[data-cart-lines] > li");
    if (!button || !li) return null;
    return { key: li.dataset.key!, role: button.dataset.role!, index: [...lines.children].indexOf(li) };
  }

  /** Devuelve el foco al mismo botón; si la línea ya no está, a la vecina; si el carro quedó vacío, a la búsqueda. */
  function restoreFocus(previous: ReturnType<typeof focusedLine>) {
    if (!previous) return;
    const same = [...lines.children].find((li) => (li as HTMLElement).dataset.key === previous.key);
    const target =
      same?.querySelector<HTMLElement>(`[data-role="${previous.role}"]`) ??
      lines.children[Math.min(previous.index, lines.children.length - 1)]?.querySelector<HTMLElement>('[data-role="remove"]') ??
      search;
    target.focus();
  }

  function render() {
    const previous = focusedLine();
    lines.replaceChildren();
    for (const [key, item] of cart) {
      const li = document.createElement("li");
      li.dataset.key = key;

      const thumb = el("span", "line-thumb");
      thumb.setAttribute("aria-hidden", "true");
      thumb.style.setProperty("--cat", item.color);
      if (item.image) thumb.append(Object.assign(document.createElement("img"), { src: item.image, alt: "" }));
      else thumb.append(icon("package"));

      const info = el("span", "line-info");
      info.append(el("span", "line-name", item.name), item.open ? priceInput(item) : el("span", "line-unit num", `${formatBs(item.price!)} c/u`));

      const qty = el("span", "line-qty");
      qty.append(
        iconButton(`Quitar un ${item.name}`, "minus", () => step(key, -1), "qty-btn"),
        withUnits(el("span", "qty num", String(item.qty))),
        iconButton(`Agregar un ${item.name}`, "plus", () => step(key, 1), "qty-btn"),
      );

      const amount = el("span", "line-amount num", item.price === null ? "—" : formatBs(item.price * item.qty));
      amountOf.set(item, amount);

      li.append(thumb, info, iconButton(`Quitar ${item.name} de la venta`, "remove", () => remove(key), "line-remove"), qty, amount);
      lines.append(li);
    }
    emptyCart.hidden = cart.size > 0;
    clear.hidden = cart.size === 0;
    showTotal();
    showCounts();
    confirm.disabled = cart.size === 0;
    if (cart.size === 0) {
      paid.value = "";
      setOpen(false);
    }
    restoreFocus(previous);
    keepCardFocus();
  }

  // El stepper de la card se oculta al llegar a 0: si tenía el foco, pasa al botón de la card.
  function keepCardFocus() {
    const active = document.activeElement;
    if (!(active instanceof HTMLElement) || !active.closest(".stepper") || active.checkVisibility()) return;
    active.closest("[data-product]")?.querySelector<HTMLElement>("[data-add]")?.focus();
  }

  for (const card of cards) {
    const id = card.dataset.id!;
    const addButton = card.querySelector<HTMLButtonElement>("[data-add]")!;
    addButton.addEventListener("click", () => {
      if (addButton.getAttribute("aria-disabled") === "true") {
        notice.textContent = `No queda stock de ${card.dataset.name}.`;
        return;
      }
      add(id);
    });
    for (const button of card.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      button.addEventListener("click", () => step(id, Number(button.dataset.step)));
    }
  }

  clear.addEventListener("click", async () => {
    if (cart.size > 1 && !(await confirmDialog("Se quitan todos los productos de la venta.", { title: "¿Vaciar la venta?", confirmLabel: "Vaciar", danger: true }))) return;
    cart.clear();
    notice.textContent = "";
    render();
    announce("La venta quedó vacía.");
    search.focus();
  });

  confirm.addEventListener("click", async () => {
    if (isBusy(confirm)) return;
    const missingIndex = [...cart.values()].findIndex((l) => l.price === null);
    if (missingIndex >= 0) {
      const missing = [...cart.values()][missingIndex];
      notice.textContent = `Escribe el precio de «${missing.name}».`;
      setOpen(true);
      // Lleva al campo que falta, marcado como inválido.
      const input = lines.children[missingIndex]?.querySelector<HTMLInputElement>(".line-price");
      input?.setAttribute("aria-invalid", "true");
      input?.addEventListener("input", () => input.removeAttribute("aria-invalid"), { once: true });
      input?.focus();
      return;
    }
    // aria-disabled (no disabled): el foco se queda en «Cobrar» mientras guarda.
    setBusy(confirm, true, "Guardando venta…");
    clear.disabled = true;
    let error: { message: string } | undefined;
    try {
      ({ error } = await actions.registerSale({
        branchId: confirm.dataset.branch!,
        shiftId: confirm.dataset.shift!,
        items: [...cart.values()].map((l) => ({ productId: l.productId, qty: l.qty, ...(l.open && { price: l.price! }) })),
      }));
    } catch {
      error = { message: "No hay conexión. La venta no se guardó: intenta de nuevo." };
    }
    if (error) {
      notice.textContent = error.message;
      setBusy(confirm, false);
      clear.disabled = false;
      return;
    }
    // Recarga para mostrar el stock actualizado; el aviso queda para la siguiente vista.
    flashToast(`Venta de ${formatBs(totalValue)} registrada.`);
    window.location.reload();
  });

  // Búsqueda y filtro por categoría, combinados.
  const search = $<HTMLInputElement>("[data-search]");
  const empty = $("[data-empty]");
  const pills = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLLIElement>(".product-grid li");
  let category = "";

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    for (const li of items) {
      li.hidden = !li.dataset.name!.includes(query) || (category !== "" && li.dataset.category !== category);
      if (!li.hidden) visible++;
    }
    empty.hidden = visible > 0 || items.length === 0;
    announceResults(visible);
    return [...items].filter((li) => !li.hidden);
  }

  // Cuántos productos quedan al buscar o filtrar: se anuncia al dejar de escribir, no en cada tecla.
  let resultsTimer: ReturnType<typeof setTimeout> | undefined;
  function announceResults(visible: number) {
    clearTimeout(resultsTimer);
    resultsTimer = setTimeout(() => announce(visible === 0 ? "Ningún producto coincide." : plural(visible)), 500);
  }

  function setCategory(value: string) {
    category = value;
    for (const pill of pills) pill.setAttribute("aria-pressed", String(pill.dataset.filter === value));
    applyFilters();
  }

  for (const pill of pills) pill.addEventListener("click", () => setCategory(pill.dataset.filter!));
  search.addEventListener("input", applyFilters);
  $("[data-clear-filters]").addEventListener("click", () => {
    search.value = "";
    setCategory("");
  });

  // Atajos: «/» busca; Enter agrega el único resultado; Esc limpia la búsqueda.
  if (matchMedia("(pointer: fine)").matches) search.placeholder = "Buscar producto (/)";
  search.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      const visible = applyFilters();
      const button = visible.length === 1 ? visible[0].querySelector<HTMLButtonElement>("[data-add]") : null;
      if (!button || button.disabled || button.getAttribute("aria-disabled") === "true") return;
      button.click();
      search.value = "";
      applyFilters();
    } else if (event.key === "Escape") {
      if (search.value === "") return search.blur();
      event.preventDefault();
      search.value = "";
      applyFilters();
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey) return;
    const target = event.target as HTMLElement;
    if (target.closest("input, textarea, select, [contenteditable], dialog[open]")) return;
    event.preventDefault();
    search.focus();
  });
</script>

<style>
  .sale {
