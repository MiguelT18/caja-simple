---
import { Clock, PackagePlus, Package } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import ProductCatalog from "@/components/app/products/ProductCatalog";
import Layout from "@/layouts/Layout.astro";
import { plural } from "@/lib/format";
import { stamp } from "@/lib/dates";
import { branchContext, shiftBarData, businessHref, isLowStock, stockMoves, stockRequests } from "@/data/queries";
import { planLimits } from "@/data/plans";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, products, role, business, categories } = ctx;
const isOwner = role === "dueño";

// Productos del catálogo que esta sucursal todavía no vende (solo la dueña los agrega).
const { data: catalog } = isOwner
  ? await Astro.locals.supabase.from("products").select("id, name").eq("business_id", business.id).order("name")
  : { data: [] };
const addable = (catalog ?? []).filter((p) => !products.some((x) => x.id === p.id));

const lowCount = products.filter(isLowStock).length;

// Entradas, mermas y ajustes: solo de productos con control de stock, y solo en los planes pagos (en Gratis el stock
// queda congelado: la base no deja cambiarlo). La base exige el rol (record_stock_move).
const limits = planLimits[business.plan];
const planHref = `${businessHref(business)}/plan`;
const tracked = limits.stock ? products.filter((p) => p.stock !== null) : [];
const frozen = !limits.stock && products.some((p) => p.stock !== null);
const [moves, requests] = await Promise.all([
  stockMoves(Astro.locals.supabase, branch.id),
  limits.stock ? stockRequests(Astro.locals.supabase, branch.id, Astro.locals.userId!) : [],
]);
const kinds = [
  { value: "entrada", label: "Entrada de mercadería (suma)" },
  ...(isOwner
    ? [
        { value: "merma", label: "Merma: vencido, roto o perdido (resta)" },
        { value: "ajuste", label: "Ajuste por conteo (suma o resta)" },
      ]
    : []),
];
const kindLabel = { entrada: "Entrada", merma: "Merma", ajuste: "Ajuste" };
---

<Layout title={`Inventario · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...ctx.backdrop}
    title="Inventario"
    live
    description={[`${plural(products.length, "producto", "productos")} en ${branch.name}`, lowCount > 0 && `${lowCount} con stock bajo`].filter(Boolean).join(" · ")}
  >
    {
      tracked.length > 0 && (
        <button type="button" class="btn btn-primary" data-open-dialog="stock-move">
          <PackagePlus size={18} stroke-width={2} />
          {isOwner ? "Registrar movimiento" : "Pedir entrada de mercadería"}
        </button>
      )
    }
    {
      isOwner && (
        <a href={`${businessHref(business)}/catalogo`} class="btn btn-secondary">
          <Package size={18} stroke-width={2} />
          Editar catálogo
        </a>
      )
    }
  </PageHeader>

  <div data-region="catalog">
    <ProductCatalog client:load products={products} categories={categories} businessId={business.id} branchId={branch.id} canEdit={isOwner} addable={addable} limits={limits} planHref={planHref} />
  </div>

  {
    frozen && (
      <p class="notice frozen">
        El stock que ves está congelado: en el plan Gratis no cambia con las ventas ni se puede corregir.
        {isOwner ? (
          <>
            {" "}<a href={planHref}>El control de stock es del plan Negocio</a>.
          </>
        ) : (
          " El control de stock es de los planes pagos."
        )}
      </p>
    )
  }

  <!-- Entradas que pidieron las empleadas: la dueña las acepta (el stock sube) o las rechaza. -->
  <div data-region="stock-requests">
    {
      requests.length > 0 && (
        <section class="moves" aria-labelledby="requests-title">
          <h2 class="section-title" id="requests-title">{isOwner ? "Entradas por aprobar" : "Tus pedidos de entrada"}</h2>
          <ul class="requests card" role="list">
            {requests.map((r) => (
              <li>
                <span class="request-what">
                  <strong>
                    {isOwner ? `${r.by} pide sumar ` : "Sumar "}
                    <span class="num amount-income">+{r.qty}</span> de {r.product}
                  </strong>
                  <span class="muted">{[stamp(r.at), r.reason && `«${r.reason}»`].filter(Boolean).join(" · ")}</span>
                </span>
                {isOwner ? (
                  <span class="request-actions">
                    <form data-action="answerStockRequest" data-success={`Entrada de ${r.product} aceptada: el stock subió ${r.qty}.`}>
                      <input type="hidden" name="requestId" value={r.id} />
                      <input type="hidden" name="accept" value="true" />
                      <button type="submit" class="btn btn-primary" aria-label={`Aceptar: sumar ${r.qty} de ${r.product}, pedido por ${r.by}`}>
                        Aceptar
                      </button>
                    </form>
                    <form
                      data-action="answerStockRequest"
                      data-success="Pedido rechazado."
                      data-confirm={`¿Rechazar el pedido de ${r.by}? El stock de ${r.product} no cambia.`}
                      data-confirm-label="Rechazar"
                      data-danger
                    >
                      <input type="hidden" name="requestId" value={r.id} />
                      <input type="hidden" name="accept" value="false" />
                      <button type="submit" class="btn btn-secondary" aria-label={`Rechazar el pedido de ${r.by}: ${r.qty} de ${r.product}`}>
                        Rechazar
                      </button>
                    </form>
                  </span>
                ) : (
                  <span class="chip chip-warning">
                    <Clock size={14} stroke-width={2} />
                    Esperando respuesta
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <section class="moves" aria-labelledby="moves-title" data-region="moves">
    <h2 class="section-title" id="moves-title">Movimientos de stock</h2>
    {
      moves.length === 0 ? (
        <p class="card empty-state">
          {limits.stock ? "Todavía no hay entradas, mermas ni ajustes. Las ventas descuentan el stock solas." : "Las entradas, mermas y ajustes de stock son del plan Negocio."}
        </p>
      ) : (
        <div class="table-wrap card" role="region" aria-label="Tabla de movimientos" tabindex="0">
          <table class="moves-table">
            <caption class="sr-only">Últimos movimientos de stock</caption>
            <thead>
              <tr>
                <th scope="col">Cuándo</th>
                <th scope="col">Producto</th>
                <th scope="col">Tipo</th>
                <th scope="col" class="right">Cantidad</th>
                <th scope="col">Motivo</th>
                <th scope="col">Registró</th>
              </tr>
            </thead>
            <tbody>
              {moves.map((m) => (
                <tr>
                  <td class="muted num">{stamp(m.at)}</td>
                  <td>{m.product}</td>
                  <td>{kindLabel[m.kind]}</td>
                  <td class:list={["right num", m.qty > 0 ? "amount-income" : "amount-expense"]}>{m.qty > 0 ? `+${m.qty}` : `−${Math.abs(m.qty)}`}</td>
                  <td class="muted">{m.reason ?? "—"}</td>
                  <td class="muted">{m.approvedBy ? `${m.by} · aceptó ${m.approvedBy}` : m.by}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <div data-region="stock-move-form">
  {
    tracked.length > 0 && (
      <Modal
        id="stock-move"
        title={isOwner ? "Registrar movimiento de stock" : "Pedir entrada de mercadería"}
        description={isOwner ? "Cambia el stock de la sucursal y queda en el registro con tu nombre." : "Quien administra el negocio recibe tu pedido. El stock sube cuando lo acepte."}
        action={isOwner ? "recordStockMove" : "requestStockEntry"}
        draft
        submitLabel={isOwner ? "Guardar" : "Enviar pedido"}
        hidden={{ branchId: branch.id }}
        success={isOwner ? "Stock actualizado" : "Pedido enviado. El stock sube cuando quien administra el negocio lo acepte."}
      >
        <FormInput form="stock-move-form" name="productId" label="Producto" options={tracked.map((p) => ({ value: p.id, label: `${p.name} (hay ${p.stock})` }))} required />
        {isOwner && <FormInput form="stock-move-form" name="kind" label="Tipo" options={kinds} required />}
        <FormInput
          form="stock-move-form"
          name="qty"
          type="number"
          inputmode="numeric"
          step="1"
          label={isOwner ? "Cantidad" : "Cantidad que llegó"}
          hint={isOwner ? "En un ajuste, usa un número negativo para restar (ej. −2)." : undefined}
          required
        />
        <FormInput form="stock-move-form" name="reason" label={isOwner ? "Motivo" : "Motivo (opcional)"} hint={isOwner ? "Obligatorio en mermas y ajustes." : "Ej.: pedido del proveedor."} maxlength={120} />
      </Modal>
    )
  }
  </div>
</Layout>

<style>
  .frozen {
    margin-top: 1.25rem;
  }

  .frozen a {
    color: inherit;
    font-weight: var(--font-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .moves {
    margin-top: 2rem;
  }

  .requests {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .requests li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .requests li:last-child {
    border-bottom: 0;
  }

  .request-what {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
    font-size: var(--text-sm);
  }

  .request-actions {
    display: flex;
    gap: 0.5rem;
  }

  .moves-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .moves-table th,
  .moves-table td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }

  .moves-table th {
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
  }

  .moves-table tr:last-child td {
    border-bottom: 0;
  }

  .moves-table .right {
    text-align: right;
  }

  .muted {
    color: var(--color-text-muted);
  }
</style>
