---
import { CircleSlash, ClipboardCheck, Clock, PackageMinus, PackagePlus, Package, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import SelectMenu from "@/components/app/SelectMenu.astro";
import ProductCatalog from "@/components/app/products/ProductCatalog";
import Layout from "@/layouts/Layout.astro";
import { formatBs, plural } from "@/lib/format";
import { stamp } from "@/lib/dates";
import { branchContext, shiftBarData, businessHref, isLowStock, stockDeliveries, stockMoves, stockRequests } from "@/data/queries";
import { planLimits } from "@/data/plans";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, products, role, business, categories } = ctx;
const isOwner = role === "dueño";

// Productos del catálogo que esta sucursal todavía no vende (solo la dueña los agrega).
const { data: catalog } = isOwner
  ? await Astro.locals.supabase.from("products").select("id, name").eq("business_id", business.id).order("name")
  : { data: [] };
const addable = (catalog ?? []).filter((p) => !products.some((x) => x.id === p.id));

const lowCount = products.filter(isLowStock).length;

// Entradas, mermas y ajustes: solo de productos con control de stock, y solo en los planes pagos (en Gratis el stock
// queda congelado: la base no deja cambiarlo). La base exige el rol (record_stock_move).
const limits = planLimits[business.plan];
const planHref = `${businessHref(business)}/plan`;
// Los combos no tienen stock propio (sale de sus productos): la base no deja moverlo.
const tracked = limits.stock ? products.filter((p) => p.stock !== null && !p.components) : [];
const frozen = !limits.stock && products.some((p) => p.stock !== null);
const [moves, requests, deliveries] = await Promise.all([
  stockMoves(Astro.locals.supabase, branch.id),
  limits.stock ? stockRequests(Astro.locals.supabase, branch.id, Astro.locals.userId!) : [],
  limits.stock ? stockDeliveries(Astro.locals.supabase, branch.id) : [],
]);
// Lo que la dueña envía lo confirma quien trabaja en la sucursal (la dueña, solo si se agregó como empleada aquí).
const canReceive = ctx.works;
const kinds = [
  { value: "entrada", label: "Entrada", hint: "Llegó mercadería. Suma al stock.", Icon: PackagePlus },
  { value: "merma", label: "Merma", hint: "Vencido, roto o perdido. Resta.", Icon: PackageMinus },
  { value: "ajuste", label: "Ajuste", hint: "Corrige con lo que contaste. Suma o resta.", Icon: ClipboardCheck },
];
const kindLabel = { entrada: "Entrada", merma: "Merma", ajuste: "Ajuste" };
---

<Layout title={`Inventario · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...ctx.backdrop}
    title="Inventario"
    live
    description={[`${plural(products.length, "producto", "productos")} en ${branch.name}`, lowCount > 0 && `${lowCount} con stock bajo`].filter(Boolean).join(" · ")}
  >
    {
      tracked.length > 0 && (
        <button type="button" class="btn btn-primary" data-open-dialog="stock-move">
          <PackagePlus size={18} stroke-width={2} />
          {isOwner ? "Registrar movimiento" : "Pedir entrada de mercadería"}
        </button>
      )
    }
    {
      isOwner && (
        <a href={`${businessHref(business)}/catalogo`} class="btn btn-secondary">
          <Package size={18} stroke-width={2} />
          Editar catálogo
        </a>
      )
    }
  </PageHeader>

  <div data-region="catalog">
    <ProductCatalog client:load products={products} categories={categories} businessId={business.id} branchId={branch.id} canEdit={isOwner} addable={addable} limits={limits} planHref={planHref} fields={business.productForm.fields} />
  </div>

  {
    frozen && (
      <p class="notice frozen">
        El stock que ves está congelado: en el plan Gratis no cambia con las ventas ni se puede corregir.
        {isOwner ? (
          <>
            {" "}<a href={planHref}>El control de stock es del plan Negocio</a>.
          </>
        ) : (
          " El control de stock es de los planes pagos."
        )}
      </p>
    )
  }

  <!-- Entradas que pidieron las empleadas: la dueña las acepta (el stock sube) o las rechaza. -->
  <div data-region="stock-requests">
    {
      requests.length > 0 && (
        <section class="moves" aria-labelledby="requests-title">
          <h2 class="section-title" id="requests-title">{isOwner ? "Entradas por aprobar" : "Tus pedidos de entrada"}</h2>
          <ul class="requests card" role="list">
            {requests.map((r) => (
              <li>
                <span class="request-what">
                  <strong>
                    {isOwner ? `${r.by} pide sumar ` : "Sumar "}
                    <span class="num amount-income">+{r.qty}</span> de {r.product}
                  </strong>
                  <span class="muted">{[stamp(r.at), r.reason && `«${r.reason}»`].filter(Boolean).join(" · ")}</span>
                </span>
                {isOwner ? (
                  <span class="request-actions">
                    <form data-action="answerStockRequest" data-success={`Entrada de ${r.product} aceptada: el stock subió ${r.qty}.`}>
                      <input type="hidden" name="requestId" value={r.id} />
                      <input type="hidden" name="accept" value="true" />
                      <button type="submit" class="btn btn-primary" aria-label={`Aceptar: sumar ${r.qty} de ${r.product}, pedido por ${r.by}`}>
                        Aceptar
                      </button>
                    </form>
                    <form
                      data-action="answerStockRequest"
                      data-success="Pedido rechazado."
                      data-confirm={`¿Rechazar el pedido de ${r.by}? El stock de ${r.product} no cambia.`}
                      data-confirm-label="Rechazar"
                      data-danger
                    >
                      <input type="hidden" name="requestId" value={r.id} />
                      <input type="hidden" name="accept" value="false" />
                      <button type="submit" class="btn btn-secondary" aria-label={`Rechazar el pedido de ${r.by}: ${r.qty} de ${r.product}`}>
                        Rechazar
                      </button>
                    </form>
                  </span>
                ) : (
                  <span class="chip chip-warning">
                    <Clock size={14} stroke-width={2} />
                    Esperando respuesta
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <!-- Stock que la dueña envió: entra cuando alguien de la sucursal confirma cuánto llegó. -->
  <div data-region="stock-deliveries">
    {
      deliveries.length > 0 && (
        <section class="moves" aria-labelledby="deliveries-title">
          <h2 class="section-title" id="deliveries-title">Por recibir</h2>
          <p class="muted deliveries-help">
            {canReceive ? "Cuenta lo que llegó y confírmalo: recién ahí entra al stock." : "Entra al stock cuando alguien de la sucursal confirme cuánto le llegó."}
          </p>
          <ul class="requests card" role="list">
            {deliveries.map((d) => (
              <li>
                <span class="request-what">
                  <strong>
                    {d.by} envió <span class="num amount-income">+{d.qty}</span> de {d.product}
                  </strong>
                  <span class="muted">{[stamp(d.at), d.reason && `«${d.reason}»`].filter(Boolean).join(" · ")}</span>
                </span>
                {canReceive ? (
                  <span class="request-actions">
                    <form id={`receive-${d.id}`} class="receive" data-action="receiveStock" data-success={`Listo: el stock de ${d.product} subió lo que llegó.`} novalidate>
                      <input type="hidden" name="deliveryId" value={d.id} />
                      <label class="receive-field">
                        <span>Llegaron</span>
                        <input
                          class="input num"
                          name="qty"
                          type="number"
                          inputmode="numeric"
                          min="0"
                          max={d.qty}
                          step="1"
                          value={d.qty}
                          required
                          aria-describedby={`receive-${d.id}-qty-error`}
                        />
                      </label>
                      <button type="submit" class="btn btn-primary" aria-label={`Confirmar lo que llegó de ${d.product}`}>
                        Confirmar
                      </button>
                      <p class="field-error" id={`receive-${d.id}-qty-error`} aria-live="polite"></p>
                      <label class="receive-field receive-note">
                        <span>Nota</span>
                        <input class="input" name="note" type="text" maxlength="200" placeholder="Opcional: qué faltó o llegó dañado" aria-describedby={`receive-${d.id}-note-error`} />
                      </label>
                      <p class="field-error" id={`receive-${d.id}-note-error`} aria-live="polite"></p>
                    </form>
                    <form
                      data-action="receiveStock"
                      data-success="Avisamos que no llegó."
                      data-confirm={`¿No llegó nada de ${d.product}? El stock no cambia y ${d.by} recibe el aviso.`}
                      data-confirm-label="No llegó"
                      data-danger
                    >
                      <input type="hidden" name="deliveryId" value={d.id} />
                      <input type="hidden" name="qty" value="0" />
                      <button type="submit" class="btn btn-secondary" aria-label={`No llegó ${d.product}`}>
                        No llegó
                      </button>
                    </form>
                  </span>
                ) : (
                  <span class="chip chip-warning">
                    <Clock size={14} stroke-width={2} />
                    Esperando a la sucursal
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <section class="moves" aria-labelledby="moves-title" data-region="moves">
    <h2 class="section-title" id="moves-title">Movimientos de stock</h2>
    {
      moves.length === 0 ? (
        <p class="card empty-state">
          {limits.stock ? "Todavía no hay entradas, mermas ni ajustes. Las ventas descuentan el stock solas." : "Las entradas, mermas y ajustes de stock son del plan Negocio."}
        </p>
      ) : (
        <div class="table-wrap card" role="region" aria-label="Tabla de movimientos" tabindex="0">
          <table class="moves-table">
            <caption class="sr-only">Últimos movimientos de stock</caption>
            <thead>
              <tr>
                <th scope="col">Cuándo</th>
                <th scope="col">Producto</th>
                <th scope="col">Tipo</th>
                <th scope="col" class="right">Cantidad</th>
                <th scope="col">Motivo</th>
                <th scope="col">Registró</th>
              </tr>
            </thead>
            <tbody>
              {moves.map((m) => (
                <tr>
                  <td class="muted num">{stamp(m.at)}</td>
                  <td>{m.product}</td>
                  <td>{kindLabel[m.kind]}</td>
                  <td class:list={["right num", m.qty > 0 ? "amount-income" : "amount-expense"]}>{m.qty > 0 ? `+${m.qty}` : `−${Math.abs(m.qty)}`}</td>
                  <td class="muted">{[m.reason, m.note && `Nota: «${m.note}»`].filter(Boolean).join(" · ") || "—"}</td>
                  <td class="muted">{m.approvedBy ? `${m.by} · aceptó ${m.approvedBy}` : m.by}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <div data-region="stock-move-form">
  {
    tracked.length > 0 && (
      <Modal
        id="stock-move"
        title={isOwner ? "Registrar movimiento de stock" : "Pedir entrada de mercadería"}
        description={isOwner ? "Cambia el stock de la sucursal y queda en el registro con tu nombre. Si alguien más trabaja aquí, una entrada sube cuando confirma que le llegó." : "Quien administra el negocio recibe tu pedido. El stock sube cuando lo acepte."}
        action={isOwner ? "recordStockMove" : "requestStockEntry"}
        draft
        submitLabel={isOwner ? "Guardar" : "Enviar pedido"}
        hidden={{ branchId: branch.id }}
        success={isOwner ? "Stock actualizado" : "Pedido enviado. El stock sube cuando quien administra el negocio lo acepte."}
      >
        <SelectMenu
          form="stock-move-form"
          name="productId"
          label="Producto"
          placeholder="Elige un producto"
          searchPlaceholder="Nombre, categoría, código o descripción"
          noun="productos"
          required
          requiredMessage="Elige un producto."
          options={tracked.map((p) => ({ value: p.id, label: p.name, keywords: [p.category, p.barcode, p.description].filter(Boolean).join(" "), product: p }))}
        >
          {({ product: p }: { product: (typeof tracked)[number] }) => {
            // Como en la tabla de productos: el estado va escrito y con ícono, no solo con color.
            const tone = p.stock === 0 ? "expense" : isLowStock(p) ? "warning" : null;
            const ToneIcon = p.stock === 0 ? CircleSlash : TriangleAlert;
            return (
              <span class="product-row">
                {p.image ? <img src={p.image} alt="" width="40" height="40" loading="lazy" /> : <span class="product-thumb"><Package size={20} stroke-width={1.75} /></span>}
                <span class="product-text">
                  <span class="product-name">{p.name}</span>
                  <span class="product-meta">{[p.category, p.price !== null && formatBs(p.price)].filter(Boolean).join(" · ")}</span>
                </span>
                <span class="product-stock">
                  <span class="product-count num" style={tone ? `color: var(--color-${tone})` : undefined}>
                    {tone && <ToneIcon size={14} stroke-width={2.25} aria-hidden="true" />}
                    {tone && <span class="product-tone">{p.stock === 0 ? "Sin stock" : "Stock bajo"}</span>}
                    Hay {p.stock}
                  </span>
                  {p.minStock !== null && <span class="product-min num">mín. {p.minStock}</span>}
                </span>
              </span>
            );
          }}
        </SelectMenu>
        {
          isOwner && (
            <fieldset class="choice-field">
              <legend class="field-label">Tipo</legend>
              <div class="kind-options">
                {kinds.map(({ value, label, hint, Icon }, i) => (
                  <label class="kind">
                    <input type="radio" name="kind" value={value} checked={i === 0} required aria-describedby="stock-move-form-kind-error" />
                    <Icon size={20} stroke-width={1.75} />
                    <span class="kind-label">{label}</span>
                    <span class="kind-hint">{hint}</span>
                  </label>
                ))}
              </div>
              <p class="field-error" id="stock-move-form-kind-error"></p>
            </fieldset>
          )
        }
        <FormInput
          form="stock-move-form"
          name="qty"
          type="number"
          inputmode="numeric"
          step="1"
          label={isOwner ? "Cantidad" : "Cantidad que llegó"}
          hint={isOwner ? "En un ajuste, usa un número negativo para restar (ej. −2)." : undefined}
          required
        />
        <FormInput form="stock-move-form" name="reason" label={isOwner ? "Motivo" : "Motivo (opcional)"} hint={isOwner ? "Obligatorio en mermas y ajustes." : "Ej.: pedido del proveedor."} maxlength={120} />
      </Modal>
    )
  }
  </div>
</Layout>

<style>
  .choice-field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice-field legend {
    padding: 0;
    margin-bottom: 0.25rem;
  }

  .product-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }

  .product-row img,
  .product-thumb {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    object-fit: cover;
  }

  .product-thumb {
    display: grid;
    place-items: center;
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
  }

  .product-text,
  .product-stock {
    display: grid;
    min-width: 0;
  }

  .product-name {
    font-weight: var(--font-semibold);
    overflow-wrap: anywhere;
  }

  .product-meta,
  .product-min {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .product-stock {
    justify-items: end;
    text-align: end;
  }

  .product-count {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .product-tone {
    font-size: var(--text-xs);
  }

  .kind-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }

  .kind {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }

  .kind:hover {
    border-color: var(--color-text-muted);
  }

  .kind input {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--color-primary);
  }

  .kind :global(svg) {
    color: var(--color-text-muted);
  }

  .kind-label {
    font-weight: var(--font-bold);
  }

  .kind-hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .kind:has(input:checked) {
    border-color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-text);
  }

  .kind:has(input:checked) :global(svg) {
    color: var(--color-primary);
  }

  .frozen {
    margin-top: 1.25rem;
  }

  .frozen a {
    color: inherit;
    font-weight: var(--font-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .moves {
    margin-top: 2rem;
  }

  .requests {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .requests li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .requests li:last-child {
    border-bottom: 0;
  }

  .request-what {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
    font-size: var(--text-sm);
  }

  .request-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .deliveries-help {
    margin: -0.5rem 0 0.75rem;
    font-size: var(--text-sm);
  }

  .receive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .receive-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }

  .receive-field .input {
    width: 6rem;
  }

  .receive-note {
    flex-basis: 100%;
  }

  .receive-note .input {
    flex: 1;
    width: auto;
    min-width: 0;
  }

  .receive .field-error {
    flex-basis: 100%;
    margin: 0;
  }

  .receive .field-error:empty {
    display: none;
  }

  .moves-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .moves-table th,
  .moves-table td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }

  .moves-table th {
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
  }

  .moves-table tr:last-child td {
    border-bottom: 0;
  }

  .moves-table .right {
    text-align: right;
  }

  .muted {
    color: var(--color-text-muted);
  }
</style>
