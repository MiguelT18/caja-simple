---
import { Plus } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import MovementsTable from "@/components/app/MovementsTable";
import RangeFilter from "@/components/app/RangeFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { branchColor, branchContext, shiftBarData, branchHref, orderLabels, receiptUrls, saleLines, sum } from "@/data/queries";
import { addDays, inRange, longDate, parseRange, shortDate, today as todayOf } from "@/lib/dates";
import { formatBs, plural } from "@/lib/format";

const { negocio, sucursal } = Astro.params;
const range = parseRange(Astro.url.searchParams, todayOf());
const ctx = await branchContext(Astro.locals, negocio!, sucursal!, range);
if (!ctx) return Astro.rewrite("/404");
const [lines, orderNames] = await Promise.all([
  saleLines(Astro.locals.supabase, ctx.branch.id, range.from, range.to),
  orderLabels(Astro.locals.supabase, ctx.branch.id, range.from, range.to),
]);
const at = (day: string, time?: string) => `${shortDate(day)}${time ? `, ${time}` : ""}`;
const rangeText =
  range.days === 7 && range.to === ctx.today && !range.fromTime
    ? "los últimos 7 días"
    : `del ${at(range.from, range.fromTime)} al ${at(range.to, range.toTime)}`;
const { branch, business, canCorrect, currentShift, receiptOf, sales, shiftById, shifts, today } = ctx;
// La base trae días enteros; con hora se recortan las puntas aquí.
const salesHistory = ctx.salesHistory.filter((s) => inRange(range, s.date, s.time));
const receipts = await receiptUrls(Astro.locals.supabase, salesHistory);

const weekTotal = sum(salesHistory.map((s) => s.total));
const todayTotal = sum(sales.map((s) => s.total));
const byShift = shifts.map((shift) => ({
  shift,
  total: sum(salesHistory.filter((s) => s.shiftId === shift.id).map((s) => s.total)),
}));

// Las más recientes primero; el día va junto a la hora porque la lista abarca varios días.
const rows = [...salesHistory]
  .sort((a, b) => `${b.date} ${b.time}`.localeCompare(`${a.date} ${a.time}`))
  .map((s) => {
    const shift = shiftById(s.shiftId);
    return {
      id: s.id,
      time: `${s.date === today ? "Hoy" : shortDate(s.date)}, ${s.time}`,
      // Cobrada como pedido abierto: lleva su nombre (mesa, cliente).
      label: `${orderNames.has(s.id) ? `Pedido «${orderNames.get(s.id)}»` : "Venta"} · ${plural(s.items, "producto", "productos")}`,
      shift: { name: shift.name, tone: shift.tone },
      by: s.recordedBy.firstName,
      amount: s.voided ?? s.total,
      kind: "sale" as const,
      payment: s.payment,
      voided: s.voided !== null,
      canVoid: canCorrect(s),
      detail: lines.get(s.id),
      ...receiptOf(s, receipts),
    };
  });
---

<Layout title={`Ventas · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...ctx.backdrop}
    tint={branchColor(ctx.membership, branch.id)}
    eyebrow={longDate(today)}
    title="Ventas"
    description={`Lo que se vendió ${rangeText} en ${branch.name}.`}
  >
    {
      currentShift ? (
        <a class="btn btn-primary" href={branchHref(business, branch, "registrar-venta")}>
          <Plus size={18} stroke-width={2} />
          Registrar venta
        </a>
      ) : (
        <a class="btn btn-secondary" href={branchHref(business, branch, "turnos")}>
          Abre un turno<span class="label-rest"> para vender</span>
        </a>
      )
    }
  </PageHeader>

  <dl class="card totals" data-region="totals">
    <div class="totals-main">
      <dt>{rangeText[0].toUpperCase() + rangeText.slice(1)}</dt>
      <dd class="num amount-income">{formatBs(weekTotal, "+")}</dd>
      <dd class="totals-note">{plural(salesHistory.length, "venta", "ventas")}</dd>
    </div>
    <div>
      <dt>Hoy</dt>
      <dd class="num amount-income">{formatBs(todayTotal, "+")}</dd>
    </div>
    {
      byShift.map(({ shift, total }) => (
        <div>
          <dt>
            <ShiftChip shift={shift} />
          </dt>
          <dd class="num amount-income">{formatBs(total, "+")}</dd>
        </div>
      ))
    }
  </dl>

  <h2 class="section-title">Historial</h2>
  <RangeFilter
    from={range.from}
    to={range.to}
    max={today}
    historyStart={business.plan === "Gratis" ? addDays(today, -60) : undefined}
    withTime
    fromTime={range.fromTime}
    toTime={range.toTime}
  />
  <div data-region="history">
    <MovementsTable client:visible rows={rows} pageSize={10} timeLabel="Cuándo" empty={`No hay ventas ${rangeText}.`} />
  </div>
</Layout>

<style>
  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.25rem;
    margin: 0 0 0.5rem;
    padding: 1.25rem;
  }

  .totals div {
    display: grid;
    align-content: start;
    gap: 0.375rem;
  }

  .totals dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .totals dd {
    margin: 0;
    font-weight: var(--font-semibold);
  }

  .totals-main dd {
    font-size: var(--text-3xl);
    line-height: var(--text-3xl-lh);
    font-weight: var(--font-bold);
  }

  .totals dd.totals-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-regular);
  }

  @media (max-width: 480px) {
    .label-rest {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .totals {
      padding: 1rem;
    }
  }
</style>
