---
import { CalendarX2, CircleCheck, GripVertical, Hourglass, LockOpen, MessageSquareText, Pencil, Plus, RotateCcw, Trash, TriangleAlert } from "@lucide/astro";
import Avatar from "@/components/Avatar.astro";
import ClosuresCalendar from "@/components/app/ClosuresCalendar";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import RangeFilter from "@/components/app/RangeFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { branchContext, businessHref, closesBetween, shiftBarData, fullName } from "@/data/queries";
import { differenceLabel, formatBs, overnight, shiftHours } from "@/lib/format";
import { addDays, inShiftWindow, longDate, openFrom, parseRange, shortDate, stamp } from "@/lib/dates";
import { DAY_NAMES } from "@/lib/schedule";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, closedNow, closures, currentShift, employees, hours, lastCount, reopenPending, role, shiftById, shiftTotals, shifts, today } = ctx;
const isOwner = role === "dueño";
// El turno de quien trabaja aquí: solo ese puede abrir (la base lo exige, private.check_shift_schedule).
const myShiftId = ctx.membership.employee?.shiftId;
const range = parseRange(Astro.url.searchParams, today);
const history = await closesBetween(Astro.locals.supabase, branch.id, range.from, range.to);
// Solo el último cierre de cada turno, de hoy o de ayer, se puede reabrir (igual que public.reopen_shift).
const latestClose = new Map<string, string>();
for (const c of history) if (!latestClose.has(c.shiftId)) latestClose.set(c.shiftId, c.id);
const canReopen = (c: (typeof history)[number]) =>
  isOwner && latestClose.get(c.shiftId) === c.id && c.date >= addDays(today, -1) && !currentShift;
const canNote = (c: (typeof history)[number]) => isOwner || c.closedById === Astro.locals.userId;
const DAYS = DAY_NAMES.map((d, i) => ({ dow: i + 1, short: "LMXJVSD"[i], long: d.replace(/s$/, "") }));
/** «Lun a vie», «Lun, mié, vie» o null si son todos los días. */
const daysLabel = (weekdays: number[] | null) =>
  !weekdays ? null : weekdays.map((d) => DAY_NAMES[d - 1].slice(0, 3)).join(", ").replace(/^./, (c) => c.toUpperCase());
---

<Layout title={`Turnos · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...ctx.backdrop} eyebrow={longDate(today)} title="Turnos" description={`Horarios, quién está a cargo y el cuadre de caja de hoy en ${branch.name}.`}>
    {
      isOwner && (
        <button type="button" class="btn btn-primary" data-open-dialog="shift-new">
          <Plus size={18} stroke-width={2} />
          Agregar turno
        </button>
      )
    }
  </PageHeader>

  {/* Región: tarjetas, historial y modales dependen unos de otros (abrir un turno cambia los demás). */}
  <div data-region="shifts">
  {
    shifts.length === 0 && (
      <p class="card empty-state">
        Esta sucursal todavía no tiene turnos.
        {isOwner ? " Agrega el primero con «Agregar turno» para poder abrir la caja." : " Pide a quien administra el negocio que los configure."}
      </p>
    )
  }

  <section class="shift-list" data-shift-list={isOwner && shifts.length > 1 ? branch.id : undefined}>
    {
      shifts.map((shift) => {
        const t = shiftTotals(shift.id);
        const staff = employees.filter((e) => e.shiftId === shift.id);
        // Fuera de horario la empleada ve el formulario igual: la base lo rechaza (check_shift_schedule) y el error sale en un aviso flotante. La dueña lo abre confirmándolo.
        const onSchedule = inShiftWindow(shift);
        const schedule = `${openFrom(shift)} a ${shift.end}`;
        // Días hábiles (horario semanal, días del turno y cierres): la empleada no lo abre; la dueña lo confirma.
        const closed = closedNow(shift);
        return (
          <article class:list={["card shift", { live: t.close.status === "en-curso" }]} aria-labelledby={`shift-${shift.id}-title`} data-shift-id={shift.id}>
            <header class="shift-head">
              {isOwner && shifts.length > 1 && (
                <button type="button" class="drag" data-drag aria-label={`Mover turno ${shift.name}`} aria-describedby="shift-order-hint">
                  <GripVertical size={18} stroke-width={1.75} />
                </button>
              )}
              <h2 class="sr-only" id={`shift-${shift.id}-title`}>Turno {shift.name}</h2>
              <ShiftChip shift={shift} />
              <span class="hours num">
                {shiftHours(shift, true)}
                {daysLabel(shift.weekdays) && <span> · {daysLabel(shift.weekdays)}</span>}
              </span>
              {t.close.status === "en-curso" && (
                <span class="live-label">
                  <span class="live-dot" aria-hidden="true" />
                  {t.openedOn === today ? "En curso" : t.openedOn === addDays(today, -1) ? "En curso desde ayer" : `En curso desde el ${longDate(t.openedOn).replace(/^\S+ /, "")}`}
                </span>
              )}
              {t.close.status === "cerrado" && <span class="chip chip-neutral">Cerrado</span>}
              {t.close.status === "pendiente" && <span class="chip chip-neutral">{closed ? "Hoy no abre" : "Sin abrir hoy"}</span>}
              {isOwner && (
                <button type="button" class="icon-btn" data-open-dialog={`shift-${shift.id}`} aria-label={`Editar turno ${shift.name}`}>
                  <Pencil size={16} stroke-width={1.75} />
                </button>
              )}
            </header>

            <div class="shift-body">
              <div>
                <h3 class="label">A cargo</h3>
                {staff.length === 0 ? (
                  <p class="muted">
                    Nadie asignado.
                    {isOwner && (
                      <>
                        {" "}
                        <a href={`${businessHref(ctx.business)}/empleados`}>Asigna a alguien en Empleados</a>.
                      </>
                    )}
                  </p>
                ) : (
                  <ul class="staff" role="list">
                    {staff.map((e) => (
                      <li>
                        <Avatar seed={e.personId ?? e.id} />
                        <span>
                          {fullName(e)}
                          <span class="role">{e.status === "invitado" ? "Invitación pendiente" : e.jobTitle}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <dl class="cash">
                <div>
                  <dt>Apertura</dt>
                  <dd class="num">{t.close.status === "pendiente" ? "—" : formatBs(t.close.opening)}</dd>
                </div>
                <div>
                  <dt>Ventas en efectivo</dt>
                  <dd class="num amount-income">{formatBs(t.cash, "+")}</dd>
                </div>
                <div>
                  <dt>Gastos</dt>
                  <dd class="num amount-expense">{formatBs(t.expenses, "−")}</dd>
                </div>
                <div class="strong">
                  <dt>Esperado en caja</dt>
                  <dd class="num">{formatBs(t.expected)}</dd>
                </div>
                <div>
                  <dt>Contado</dt>
                  <dd class="num">
                    {t.close.difference === undefined ? "Por contar" : formatBs(t.expected + t.close.difference)}
                  </dd>
                </div>
                {t.sales !== t.cash && (
                  <div>
                    <dt>QR y transferencia (no van a la caja)</dt>
                    <dd class="num">{formatBs(t.sales - t.cash)}</dd>
                  </div>
                )}
              </dl>
            </div>

            {/* Cómo cerró la caja: un aviso de unos segundos al cerrar (closeShift) y, fijo, en el historial de cierres. */}
            {t.close.status === "pendiente" &&
              (currentShift ? (
                <p class="muted">Cierra el turno {currentShift.name.toLowerCase()} antes de abrir este.</p>
              ) : closed && !isOwner ? (
                <p class="status chip-neutral">
                  <CalendarX2 size={16} stroke-width={2} />
                  <span>{closed}. Hoy no se abre.</span>
                </p>
              ) : !isOwner && shift.id !== myShiftId ? (
                <p class="status chip-neutral">
                  <LockOpen size={16} stroke-width={2} />
                  <span>Lo abre quien trabaja en este turno o quien administra el negocio.</span>
                </p>
              ) : (
                <form
                  id={`open-${shift.id}`}
                  class="inline-form"
                  data-action="openShift"
                  data-confirm={
                    // La dueña abre cualquier turno, pero lo confirma: lo abre a su nombre, en lugar de quien está asignado.
                    isOwner
                      ? [
                          staff.length > 0
                            ? `Vas a abrir el turno ${shift.name.toLowerCase()} a tu nombre, en lugar de ${staff.map((e) => e.firstName).join(", ").replace(/, ([^,]*)$/, " y $1")}.`
                            : `Vas a abrir el turno ${shift.name.toLowerCase()} a tu nombre.`,
                          !onSchedule && `Estás fuera de su horario (se abre de ${schedule}).`,
                          closed && `Hoy no es día hábil (${closed.charAt(0).toLowerCase() + closed.slice(1)}).`,
                          "Las ventas y los gastos que se registren contarán en este turno. ¿Abrirlo?",
                        ]
                          .filter(Boolean)
                          .join(" ")
                      : undefined
                  }
                  data-confirm-label={onSchedule && !closed ? "Abrir turno" : "Abrir fuera de horario"}
                  novalidate
                >
                  <input type="hidden" name="branchId" value={branch.id} />
                  <input type="hidden" name="shiftId" value={shift.id} />
                  <FormInput
                    form={`open-${shift.id}`}
                    name="opening"
                    type="number"
                    inputmode="decimal"
                    step="0.01"
                    min="0"
                    label="Dinero en caja al abrir (Bs)"
                    value={lastCount ? String(lastCount.counted) : undefined}
                    hint={[
                      closed && `${closed}.`,
                      !onSchedule && !isOwner && `Se abre de ${schedule}.`,
                      lastCount && `Lo contado al cerrar ${lastCount.shiftName ? `el turno ${lastCount.shiftName.toLowerCase()}` : "el último turno"}. Cámbialo si no es lo que hay.`,
                      overnight(shift) && "Lo que vendas pasada la medianoche cuenta para hoy.",
                    ]
                      .filter(Boolean)
                      .join(" ") || undefined}
                    required
                  />
                  <button type="submit" class="btn btn-primary">
                    <LockOpen size={18} stroke-width={2} />
                    Abrir turno
                  </button>
                  {/* Sin data-form-notice: el error (por ejemplo, fuera de horario) sale en el aviso flotante (toast). */}
                </form>
              ))}

            {/* Cerrado hoy: la dueña lo reabre; quien trabaja en él lo pide y la dueña acepta o rechaza en sus avisos. */}
            {t.close.status === "cerrado" && t.closeId && !currentShift &&
              (isOwner ? (
                <form
                  id={`reopen-today-${shift.id}`}
                  class="inline-form"
                  data-action="reopenShift"
                  data-confirm={`¿Reabrir el turno ${shift.name.toLowerCase()}? Se borra lo contado y se puede seguir vendiendo hasta volver a cerrarlo.`}
                  data-confirm-label="Reabrir"
                  novalidate
                >
                  <input type="hidden" name="closeId" value={t.closeId} />
                  <button type="submit" class="btn btn-secondary">
                    <RotateCcw size={18} stroke-width={1.75} />
                    Reabrir turno
                  </button>
                  <p class="notice notice-error" role="alert" data-form-notice />
                </form>
              ) : shift.id !== myShiftId ? null : reopenPending.has(t.closeId) ? (
                <p class="status chip-neutral">
                  <Hourglass size={16} stroke-width={2} />
                  <span>Pediste reabrirlo. Te avisamos cuando quien administra el negocio responda.</span>
                </p>
              ) : (
                <form
                  id={`reopen-ask-${shift.id}`}
                  class="inline-form"
                  data-action="requestReopen"
                  data-success="Listo: le avisamos a quien administra el negocio."
                  novalidate
                >
                  <input type="hidden" name="closeId" value={t.closeId} />
                  <FormInput
                    form={`reopen-ask-${shift.id}`}
                    name="reason"
                    label="¿Necesitas reabrirlo? Motivo (opcional)"
                    hint="Quien administra el negocio recibe un aviso y decide si se reabre."
                    maxlength={200}
                  />
                  <button type="submit" class="btn btn-secondary">
                    <RotateCcw size={18} stroke-width={1.75} />
                    Pedir reabrir
                  </button>
                  <p class="notice notice-error" role="alert" data-form-notice />
                </form>
              ))}

            {t.close.status === "en-curso" && t.closeId && (
              <form
                id={`close-${shift.id}`}
                class="inline-form"
                data-action="closeShift"
                data-confirm="¿Cerrar el turno? Después ya no se pueden registrar ventas ni gastos en él."
                data-confirm-label="Cerrar turno"
                novalidate
              >
                <input type="hidden" name="closeId" value={t.closeId} />
                <FormInput
                  form={`close-${shift.id}`}
                  name="counted"
                  type="number"
                  inputmode="decimal"
                  step="0.01"
                  min="0"
                  label="Dinero contado en caja (Bs)"
                  hint={`Debería haber ${formatBs(t.expected)}`}
                  required
                />
                <FormInput
                  form={`close-${shift.id}`}
                  name="note"
                  label="Nota (opcional)"
                  hint="Si no cuadra, cuenta por qué: un cambio mal dado, un gasto sin anotar…"
                  maxlength={300}
                />
                <button type="submit" class="btn btn-secondary">Cerrar turno</button>
                <p class="notice notice-error" role="alert" data-form-notice />
              </form>
            )}
          </article>
        );
      })
    }
  </section>
  {isOwner && shifts.length > 1 && (
    <p class="sr-only" id="shift-order-hint">Arrástralo o usa las flechas arriba y abajo para cambiar el orden de los turnos.</p>
  )}
  <p class="sr-only" aria-live="polite" data-order-status></p>

  <section class="days" aria-labelledby="days-title" data-region="calendar">
    <h2 class="section-title" id="days-title">Días y horario</h2>
    <p class="muted">Los días que no se trabaja, no se abre la caja ni llegan avisos para abrir el turno.</p>

    <div class="card week">
      <h3 class="label">Horario de la semana</h3>
      {
        isOwner ? (
          <form id="branch-hours" class="week-form" data-action="saveBranchHours" data-success="Horario guardado" novalidate>
            <input type="hidden" name="branchId" value={branch.id} />
            {DAYS.map((d) => {
              const h = hours.find((x) => x.dow === d.dow);
              return (
                <fieldset class="week-day">
                  <legend class="sr-only">{d.long}</legend>
                  <label class="opens">
                    <input type="checkbox" name="opens" value={d.dow} checked={!h || h.open !== null} />
                    <span>{d.long}</span>
                  </label>
                  <label class="time">
                    <span class="sr-only">{d.long}: abre a las</span>
                    <input class="input" type="time" name="open" value={h?.open ?? ""} />
                  </label>
                  <span class="muted" aria-hidden="true">a</span>
                  <label class="time">
                    <span class="sr-only">{d.long}: cierra a las</span>
                    <input class="input" type="time" name="close" value={h?.close ?? ""} />
                  </label>
                </fieldset>
              );
            })}
            <p class="field-hint">Desmarca los días que no abre. Sin horas, abre todo el día. Un turno no abre si empieza fuera de ese horario.</p>
            <p class="notice notice-error" role="alert" data-form-notice />
            <button type="submit" class="btn btn-secondary">Guardar horario</button>
          </form>
        ) : (
          <dl class="week-list">
            {DAYS.map((d) => {
              const h = hours.find((x) => x.dow === d.dow);
              return (
                <div>
                  <dt>{d.long}</dt>
                  <dd class="num">{!h ? "Todo el día" : h.open === null ? "Cerrado" : `${h.open} a ${h.close}`}</dd>
                </div>
              );
            })}
          </dl>
        )
      }
    </div>

    <ClosuresCalendar client:load branchId={branch.id} today={today} isOwner={isOwner} shifts={shifts} hours={hours} closures={closures} />
  </section>

  <section class="history" aria-labelledby="history-title">
    <h2 class="section-title" id="history-title">Historial de cierres</h2>
    <RangeFilter from={range.from} to={range.to} max={today} historyStart={ctx.business.plan === "Gratis" ? addDays(today, -60) : undefined} />
    {
      history.length === 0 ? (
        <p class="card empty-state">No hay turnos cerrados entre el {shortDate(range.from)} y el {shortDate(range.to)}.</p>
      ) : (
        <ul class="close-list" role="list">
          {history.map((c) => {
            const shift = shiftById(c.shiftId);
            const which = `turno ${shift.name.toLowerCase()}, ${c.date === today ? "hoy" : shortDate(c.date)}`;
            return (
              <li class="card close">
                <div class="close-head">
                  <ShiftChip shift={shift} />
                  <span class="close-date">{c.date === today ? "Hoy" : longDate(c.date)}</span>
                  {c.difference === 0 ? (
                    <span class="status chip-income">
                      <CircleCheck size={16} stroke-width={2} />
                      Cuadró
                    </span>
                  ) : (
                    <span class="status chip-warning">
                      <TriangleAlert size={16} stroke-width={2} />
                      <span class="num">{differenceLabel(c.difference)}</span>
                    </span>
                  )}
                </div>
                <dl class="close-facts">
                  <div>
                    <dt>Abrió</dt>
                    <dd>{c.openedBy}</dd>
                  </div>
                  <div>
                    <dt>Cerró</dt>
                    <dd>
                      {c.closedBy}
                      {c.closedAt && <span class="muted num"> · {stamp(c.closedAt)}</span>}
                    </dd>
                  </div>
                  <div>
                    <dt>Esperado</dt>
                    <dd class="num">{formatBs(c.expected)}</dd>
                  </div>
                  <div>
                    <dt>Contado</dt>
                    <dd class="num">{formatBs(c.counted)}</dd>
                  </div>
                </dl>
                {c.note && <p class="close-note">«{c.note}»</p>}
                {c.reopened && <p class="muted">Se reabrió por un error y se volvió a cerrar.</p>}
                {(canNote(c) || canReopen(c)) && (
                  <div class="close-actions">
                    {canNote(c) && (
                      <button type="button" class="btn btn-secondary" data-open-dialog={`note-${c.id}`} aria-label={`${c.note ? "Editar nota" : "Agregar nota"}: ${which}`}>
                        <MessageSquareText size={18} stroke-width={1.75} />
                        {c.note ? "Editar nota" : "Agregar nota"}
                      </button>
                    )}
                    {canReopen(c) && (
                      <form
                        id={`reopen-${c.id}`}
                        data-action="reopenShift"
                        data-confirm={`¿Reabrir el turno ${shift.name.toLowerCase()}? Se borra lo contado y se puede seguir vendiendo hasta volver a cerrarlo.`}
                        data-confirm-label="Reabrir"
                        novalidate
                      >
                        <input type="hidden" name="closeId" value={c.id} />
                        <button type="submit" class="btn btn-secondary" aria-label={`Reabrir ${which}`}>
                          <RotateCcw size={18} stroke-width={1.75} />
                          Reabrir
                        </button>
                        <p class="notice notice-error" role="alert" data-form-notice />
                      </form>
                    )}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  {
    history.filter(canNote).map((c) => (
      <Modal
        id={`note-${c.id}`}
        title="Nota del cierre"
        description={`Turno ${shiftById(c.shiftId).name.toLowerCase()}, ${longDate(c.date).toLowerCase()}.`}
        action="saveCloseNote"
        submitLabel="Guardar"
        hidden={{ closeId: c.id }}
        success="Nota guardada"
      >
        <FormInput form={`note-${c.id}-form`} name="note" label="Qué pasó" value={c.note ?? ""} maxlength={300} hint="Déjala vacía para quitarla." />
      </Modal>
    ))
  }

  {
    isOwner &&
      [undefined, ...shifts].map((shift) => {
        const id = shift ? `shift-${shift.id}` : "shift-new";
        return (
          <Modal
            id={id}
            title={shift ? `Editar turno ${shift.name}` : "Agregar turno"}
            action="saveShift"
            draft={!shift}
            submitLabel="Guardar"
            hidden={{ branchId: branch.id, id: shift?.id }}
          >
            <FormInput form={`${id}-form`} name="name" label="Nombre" value={shift?.name} required maxlength={40} />
            <div class="field-row-2">
              <FormInput form={`${id}-form`} name="start" type="time" label="Empieza" value={shift?.start ?? "07:00"} required />
              <FormInput form={`${id}-form`} name="end" type="time" label="Termina" value={shift?.end ?? "14:00"} required />
            </div>
            <fieldset class="field weekdays">
              <legend class="field-label">Días que trabaja</legend>
              <div class="weekday-row">
                {DAYS.map((d) => (
                  <label class="weekday" title={d.long}>
                    <input type="checkbox" name="weekdays" value={d.dow} form={`${id}-form`} checked={!shift?.weekdays || shift.weekdays.includes(d.dow)} aria-label={d.long} />
                    <span aria-hidden="true">{d.short}</span>
                  </label>
                ))}
              </div>
              <p class="field-hint">Desmarca los días que este turno no abre (por ejemplo, la tarde del sábado).</p>
              <p class="field-error" id={`${id}-form-weekdays-error`} />
            </fieldset>
            {shift && (
              <form
                slot="after"
                id={`${id}-delete`}
                class="delete-form"
                data-action="deleteShift"
                data-confirm={`¿Quitar el turno ${shift.name}? Las ventas pasadas lo siguen mostrando.`}
                data-confirm-label="Quitar"
                data-danger
                novalidate
              >
                <input type="hidden" name="id" value={shift.id} />
                <button type="submit" class="btn btn-secondary danger">
                  <Trash size={18} stroke-width={1.75} />
                  Quitar turno
                </button>
                <p class="notice notice-error" role="alert" data-form-notice />
              </form>
            )}
          </Modal>
        );
      })
  }
  </div>
</Layout>

<script>
  import { actions } from "astro:actions";
  import { toast } from "@/scripts/dialogs";
  import { onRegions, refreshRegions } from "@/scripts/refresh";
  import { sortable } from "@/scripts/sortable";

  // La dueña ordena los turnos arrastrando el asa de cada tarjeta; el orden se guarda al soltar.
  onRegions((root) => {
    const list = root.querySelector<HTMLElement>("[data-shift-list]");
    if (!list || list.dataset.sortable) return;
    list.dataset.sortable = "true";
    const status = document.querySelector<HTMLElement>("[data-order-status]")!;
    sortable(list, {
      item: "[data-shift-id]",
      onDrop: async (card, changed) => {
        if (!changed) return;
        const cards = [...list.querySelectorAll<HTMLElement>("[data-shift-id]")];
        const name = card.querySelector("h2")?.textContent ?? "Turno";
        status.textContent = `${name}: posición ${cards.indexOf(card) + 1} de ${cards.length}.`;
        const { error } = await actions.reorderShifts({ branchId: list.dataset.shiftList!, ids: cards.map((c) => c.dataset.shiftId!) });
        if (error) {
          toast("No se pudo guardar el orden de los turnos. Intenta de nuevo.", "error");
          await refreshRegions(["shifts"]);
        }
      },
    });
  });
</script>

<style>
  .days {
    display: grid;
    min-width: 0;
    gap: 1rem;
    margin-top: 2rem;
  }

  .days > .muted {
    margin-top: -0.5rem;
  }

  .week {
    padding: 1.25rem;
  }

