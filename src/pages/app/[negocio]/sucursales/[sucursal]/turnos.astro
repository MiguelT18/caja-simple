---
import { CircleCheck, Clock, LockOpen, Pencil, Plus, Trash, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import Layout from "@/layouts/Layout.astro";
import { branchColor, branchContext, businessHref, shiftBarData, fullName } from "@/data/queries";
import { differenceLabel, formatBs, initials, overnight, shiftHours } from "@/lib/format";
import { addDays, inShiftWindow, longDate, openFrom } from "@/lib/dates";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx) return Astro.rewrite("/404");
const { branch, currentShift, employees, role, shiftTotals, shifts, today } = ctx;
const isOwner = role === "dueño";
const tones = [
  { value: "morning", label: "Mañana" },
  { value: "afternoon", label: "Tarde" },
  { value: "night", label: "Noche" },
];
---

<Layout title={`Turnos · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader tint={branchColor(ctx.membership, branch.id)} eyebrow={longDate(today)} title="Turnos" description={`Horarios, quién está a cargo y el cuadre de caja de hoy en ${branch.name}.`}>
    {
      isOwner && (
        <button type="button" class="btn btn-primary" data-open-dialog="shift-new">
          <Plus size={18} stroke-width={2} />
          Agregar turno
        </button>
      )
    }
  </PageHeader>

  {
    shifts.length === 0 && (
      <p class="card empty-state">
        Esta sucursal todavía no tiene turnos.
        {isOwner ? " Agrega el primero con «Agregar turno» para poder abrir la caja." : " Pide a quien administra el negocio que los configure."}
      </p>
    )
  }

  <section class="shift-list">
    {
      shifts.map((shift) => {
        const t = shiftTotals(shift.id);
        const staff = employees.filter((e) => e.shiftId === shift.id);
        // Fuera de horario solo abre quien administra, y confirmándolo; la base lo exige igual (check_shift_schedule).
        const onSchedule = inShiftWindow(shift);
        const schedule = `${openFrom(shift)} a ${shift.end}`;
        return (
          <article class:list={["card shift", { live: t.close.status === "en-curso" }]} aria-labelledby={`shift-${shift.id}-title`}>
            <header class="shift-head">
              <h2 class="sr-only" id={`shift-${shift.id}-title`}>Turno {shift.name}</h2>
              <ShiftChip shift={shift} />
              <span class="hours num">
                {shiftHours(shift, true)}
              </span>
              {t.close.status === "en-curso" && (
                <span class="live-label">
                  <span class="live-dot" aria-hidden="true" />
                  {t.openedOn === today ? "En curso" : t.openedOn === addDays(today, -1) ? "En curso desde ayer" : `En curso desde el ${longDate(t.openedOn).replace(/^\S+ /, "")}`}
                </span>
              )}
              {t.close.status === "cerrado" && <span class="chip chip-neutral">Cerrado</span>}
              {t.close.status === "pendiente" && <span class="chip chip-neutral">Sin abrir hoy</span>}
              {isOwner && (
                <button type="button" class="icon-btn" data-open-dialog={`shift-${shift.id}`} aria-label={`Editar turno ${shift.name}`}>
                  <Pencil size={16} stroke-width={1.75} />
                </button>
              )}
            </header>

            <div class="shift-body">
              <div>
                <h3 class="label">A cargo</h3>
                {staff.length === 0 ? (
                  <p class="muted">
                    Nadie asignado.
                    {isOwner && (
                      <>
                        {" "}
                        <a href={`${businessHref(ctx.business)}/empleados`}>Asigna a alguien en Empleados</a>.
                      </>
                    )}
                  </p>
                ) : (
                  <ul class="staff" role="list">
                    {staff.map((e) => (
                      <li>
                        <span class="avatar-initials" aria-hidden="true">
                          {initials(e.firstName, e.lastName)}
                        </span>
                        <span>
                          {fullName(e)}
                          <span class="role">{e.status === "invitado" ? "Invitación pendiente" : e.jobTitle}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <dl class="cash">
                <div>
                  <dt>Apertura</dt>
                  <dd class="num">{t.close.status === "pendiente" ? "—" : formatBs(t.close.opening)}</dd>
                </div>
                <div>
                  <dt>Ventas</dt>
                  <dd class="num amount-income">{formatBs(t.sales, "+")}</dd>
                </div>
                <div>
                  <dt>Gastos</dt>
                  <dd class="num amount-expense">{formatBs(t.expenses, "−")}</dd>
                </div>
                <div class="strong">
                  <dt>Esperado en caja</dt>
                  <dd class="num">{formatBs(t.expected)}</dd>
                </div>
                <div>
                  <dt>Contado</dt>
                  <dd class="num">
                    {t.close.difference === undefined ? "Por contar" : formatBs(t.expected + t.close.difference)}
                  </dd>
                </div>
              </dl>
            </div>

            {t.close.difference === 0 && (
              <p class="status chip-income">
                <CircleCheck size={16} stroke-width={2} />
                La caja cuadró
              </p>
            )}
            {t.close.difference !== undefined && t.close.difference !== 0 && (
              <p class="status chip-warning">
                <TriangleAlert size={16} stroke-width={2} />
                <span class="num">{differenceLabel(t.close.difference)}</span>
              </p>
            )}

            {t.close.status === "pendiente" &&
              (currentShift ? (
                <p class="muted">Cierra el turno {currentShift.name.toLowerCase()} antes de abrir este.</p>
              ) : !onSchedule && !isOwner ? (
                <p class="status chip-neutral">
                  <Clock size={16} stroke-width={2} />
                  <span>
                    Se abre de <span class="num">{schedule}</span>. Fuera de ese horario, solo quien administra el negocio puede abrirlo.
                  </span>
                </p>
              ) : (
                <form
                  id={`open-${shift.id}`}
                  class="inline-form"
                  data-action="openShift"
                  data-confirm={
                    onSchedule
                      ? undefined
                      : `Estás fuera del horario del turno ${shift.name.toLowerCase()} (se abre de ${schedule}). Las ventas y los gastos que registres contarán en este turno. ¿Abrirlo igual?`
                  }
                  data-confirm-label="Abrir fuera de horario"
                  novalidate
                >
                  <input type="hidden" name="branchId" value={branch.id} />
                  <input type="hidden" name="shiftId" value={shift.id} />
                  <FormInput
                    form={`open-${shift.id}`}
                    name="opening"
                    type="number"
                    inputmode="decimal"
                    step="0.01"
                    min="0"
                    label="Dinero en caja al abrir (Bs)"
                    hint={overnight(shift) ? "Lo que vendas pasada la medianoche cuenta para hoy." : undefined}
                    required
                  />
                  <button type="submit" class="btn btn-primary">
                    <LockOpen size={18} stroke-width={2} />
                    Abrir turno
                  </button>
                  <p class="notice notice-error" role="alert" data-form-notice />
                </form>
              ))}

            {t.close.status === "en-curso" && t.closeId && (
              <form
                id={`close-${shift.id}`}
                class="inline-form"
                data-action="closeShift"
                data-confirm="¿Cerrar el turno? Después ya no se pueden registrar ventas ni gastos en él."
                data-confirm-label="Cerrar turno"
                novalidate
              >
                <input type="hidden" name="closeId" value={t.closeId} />
                <FormInput
                  form={`close-${shift.id}`}
                  name="counted"
                  type="number"
                  inputmode="decimal"
                  step="0.01"
                  min="0"
                  label="Dinero contado en caja (Bs)"
                  hint={`Debería haber ${formatBs(t.expected)}`}
                  required
                />
                <button type="submit" class="btn btn-secondary">Cerrar turno</button>
                <p class="notice notice-error" role="alert" data-form-notice />
              </form>
            )}
          </article>
        );
      })
    }
  </section>

  {
    isOwner &&
      [undefined, ...shifts].map((shift) => {
        const id = shift ? `shift-${shift.id}` : "shift-new";
        return (
          <Modal
            id={id}
            title={shift ? `Editar turno ${shift.name}` : "Agregar turno"}
            action="saveShift"
            submitLabel="Guardar"
            hidden={{ branchId: branch.id, id: shift?.id }}
          >
            <FormInput form={`${id}-form`} name="name" label="Nombre" value={shift?.name} required maxlength={40} />
            <div class="field-row-2">
              <FormInput form={`${id}-form`} name="start" type="time" label="Empieza" value={shift?.start ?? "07:00"} required />
              <FormInput form={`${id}-form`} name="end" type="time" label="Termina" value={shift?.end ?? "14:00"} required />
            </div>
            <FormInput
              form={`${id}-form`}
              name="tone"
              label="Momento del día"
              hint="Define el color y el ícono del turno."
              options={tones.map((t) => ({ ...t, selected: t.value === (shift?.tone ?? "morning") }))}
            />
            {shift && (
              <form
                slot="after"
                id={`${id}-delete`}
                class="delete-form"
                data-action="deleteShift"
                data-confirm={`¿Quitar el turno ${shift.name}? Las ventas pasadas lo siguen mostrando.`}
                data-confirm-label="Quitar"
                data-danger
                novalidate
              >
                <input type="hidden" name="id" value={shift.id} />
                <button type="submit" class="btn btn-secondary danger">
                  <Trash size={18} stroke-width={1.75} />
                  Quitar turno
                </button>
                <p class="notice notice-error" role="alert" data-form-notice />
              </form>
            )}
          </Modal>
        );
      })
  }
</Layout>

<style>
  .shift-list {
    display: grid;
    gap: 1rem;
  }

  .shift {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  /* El turno abierto: anillo ámbar y «En curso» con las barras (el texto siempre está). */
  .shift.live {
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  .live-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  .shift-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hours {
    margin-right: auto;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .shift-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: 1.5rem 3rem;
  }

  .label {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-medium);
  }

  .staff {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .staff li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .role {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cash {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-sm);
  }

  .cash div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .cash dt {
    color: var(--color-text-muted);
  }

  .cash dd {
    margin: 0;
  }

  .cash .strong {
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-semibold);
  }

  .cash .strong dt {
    color: var(--color-text);
  }

  .muted {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .inline-form {
    display: grid;
    grid-template-columns: minmax(0, 18rem) auto;
    align-items: end;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .inline-form .notice {
    grid-column: 1 / -1;
  }

  /* El botón queda alineado con el input aunque el campo tenga pista debajo. */
  .inline-form .btn {
    align-self: start;
    justify-self: start;
    margin-top: 1.75rem;
  }

  @media (max-width: 480px) {
    .inline-form {
      grid-template-columns: minmax(0, 1fr);
    }

    .inline-form .btn {
      margin-top: 0;
    }
  }

  .delete-form {
    display: grid;
    gap: 0.75rem;
    margin: 0 1.25rem;
    padding: 1rem 0 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .delete-form .btn {
    justify-self: start;
  }

  .danger {
    color: var(--color-expense);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  @media (max-width: 760px) {
    .shift-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
