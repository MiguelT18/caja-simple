---
import { CircleCheck, Clock, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import BarCompareChart from "@/components/app/charts/BarCompareChart";
import DonutChart from "@/components/app/charts/DonutChart";
import WeekChart from "@/components/app/charts/WeekChart";
import MovementsTable from "@/components/app/MovementsTable";
import Layout from "@/layouts/Layout.astro";
import { appPaths, branchContext, branchHref, isLowStock, sum } from "@/data/queries";
import { formatBs } from "@/lib/format";

export const getStaticPaths = () => appPaths.branch("");

const { negocio, sucursal } = Astro.params;
const ctx = branchContext(negocio!, sucursal!);
const { branch, employeeById, expenses, products, saleTotal, sales, salesByCategory, shiftById, shiftTotals, shifts, weekSummary } = ctx;

const salesTotal = sum(sales.map(saleTotal));
const expensesTotal = sum(expenses.map((g) => g.amount));
const balance = salesTotal - expensesTotal;

const movements = [
  ...sales.map((s) => ({ ...s, label: `Venta · ${s.items.length} productos`, amount: saleTotal(s), kind: "sale" as const })),
  ...expenses.map((g) => ({ ...g, label: g.concept, amount: g.amount, kind: "expense" as const })),
]
  .sort((a, b) => b.time.localeCompare(a.time))
  .map((m) => {
    const shift = shiftById(m.shiftId);
    return {
      id: m.id,
      time: m.time,
      label: m.label,
      shift: { name: shift.name, tone: shift.tone },
      by: employeeById(m.employeeId).firstName,
      amount: m.amount,
      kind: m.kind,
    };
  });

const byShift = shifts.map((shift) => {
  const t = shiftTotals(shift.id);
  return { label: shift.name, sales: t.sales, expenses: t.expenses };
});

const lowStock = products.filter(isLowStock);
---

<Layout title={`Resumen · ${branch.name}`} context={{ membership: ctx.membership, branch }}>
  <PageHeader title="Resumen" description={`Hoy en ${branch.name}`} />

  <section class="kpis" aria-label="Totales de hoy">
    <div class="card kpi">
      <p class="kpi-label">Ventas</p>
      <p class="kpi-value num amount-income">{formatBs(salesTotal, "+")}</p>
      <p class="kpi-note">{sales.length} ventas</p>
    </div>
    <div class="card kpi">
      <p class="kpi-label">Gastos</p>
      <p class="kpi-value num amount-expense">{formatBs(expensesTotal, "−")}</p>
      <p class="kpi-note">{expenses.length} gastos</p>
    </div>
    <div class="card kpi">
      <p class="kpi-label">Saldo del día</p>
      <p class:list={["kpi-value num", { "amount-expense": balance < 0 }]}>{formatBs(balance)}</p>
      <p class="kpi-note">Ventas menos gastos</p>
    </div>
  </section>

  <h2 class="section-title">Caja por turno</h2>
  <section class="shift-grid">
    {
      shifts.map((shift) => {
        const t = shiftTotals(shift.id);
        return (
          <article class="card shift-card">
            <header class="shift-card-head">
              <ShiftChip shift={shift} />
              <span class="muted num">
                {shift.start}–{shift.end}
              </span>
            </header>
            <dl class="rows">
              <div>
                <dt>Ventas</dt>
                <dd class="num amount-income">{formatBs(t.sales, "+")}</dd>
              </div>
              <div>
                <dt>Gastos</dt>
                <dd class="num amount-expense">{formatBs(t.expenses, "−")}</dd>
              </div>
              <div>
                <dt>Esperado en caja</dt>
                <dd class="num">{formatBs(t.expected)}</dd>
              </div>
            </dl>
            {t.close.status === "en-curso" ? (
              <p class="status chip-info">
                <Clock size={16} stroke-width={2} />
                Turno en curso
              </p>
            ) : t.close.difference === 0 ? (
              <p class="status chip-income">
                <CircleCheck size={16} stroke-width={2} />
                La caja cuadró
              </p>
            ) : (
              <p class="status chip-warning">
                <TriangleAlert size={16} stroke-width={2} />
                <span>Descuadre de <span class="num">{formatBs(t.close.difference!)}</span></span>
              </p>
            )}
          </article>
        );
      })
    }
  </section>

  <section class="card chart-card" aria-labelledby="week-title">
    <div class="chart-head">
      <h2 id="week-title" class="card-title">Últimos 7 días</h2>
      <p>Ventas y gastos por día</p>
    </div>
    <WeekChart client:visible days={weekSummary} />
  </section>

  <div class="chart-grid">
    <section class="card chart-card" aria-labelledby="category-title">
      <div class="chart-head">
        <h2 id="category-title" class="card-title">Ventas por categoría</h2>
        <p>Hoy</p>
      </div>
      <DonutChart client:visible items={salesByCategory()} totalLabel="vendido hoy" />
    </section>
    <section class="card chart-card" aria-labelledby="shift-title">
      <div class="chart-head">
        <h2 id="shift-title" class="card-title">Ventas y gastos por turno</h2>
        <p>Hoy</p>
      </div>
      <BarCompareChart client:visible rows={byShift} />
    </section>
  </div>

  <div class="split">
    <section>
      <h2 class="section-title">Movimientos de hoy</h2>
      <MovementsTable client:visible rows={movements} />
    </section>

    <section>
      <h2 class="section-title">Stock bajo</h2>
      <ul class="card stock-list" role="list">
        {
          lowStock.map((p) => (
            <li>
              <TriangleAlert size={16} stroke-width={2} class="warn-icon" />
              <span class="stock-name">{p.name}</span>
              <span class="num muted">
                quedan {p.stock}
              </span>
            </li>
          ))
        }
      </ul>
      <a href={branchHref(ctx.business, branch, "inventario")} class="more-link">Ver inventario</a>
    </section>
  </div>
</Layout>

<style>
  .chart-card {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
  }

  .chart-head p {
    margin: 0.125rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .chart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .kpi {
    padding: 1.25rem;
  }

  .kpi p {
    margin: 0;
  }

  .kpi p + p {
    margin-top: 0.25rem;
  }

  .kpi-label {
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
  }

  .kpi-value {
    font-size: var(--text-3xl);
    line-height: var(--text-3xl-lh);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .kpi-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .shift-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .shift-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }

  .shift-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .muted {
    color: var(--color-text-muted);
  }

  .rows {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-sm);
  }

  .rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .rows dt {
    color: var(--color-text-muted);
  }

  .rows dd {
    margin: 0;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .stock-list {
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }

  .stock-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    font-size: var(--text-sm);
  }

  .stock-list li + li {
    border-top: 1px solid var(--color-border);
  }

  .stock-name {
    flex: 1;
  }

  .stock-list :global(.warn-icon) {
    flex-shrink: 0;
    color: var(--color-warning);
  }

  .more-link {
    display: inline-block;
    margin-top: 0.75rem;
    border-radius: 0.25rem;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 1100px) {
    .chart-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .kpis,
    .shift-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
