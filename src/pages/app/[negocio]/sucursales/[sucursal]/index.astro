---
import { CircleCheck, Clock, Store, TriangleAlert } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import ShiftChip from "@/components/ShiftChip.astro";
import DonutChart from "@/components/app/charts/DonutChart";
import WeekChart from "@/components/app/charts/WeekChart";
import MovementsTable from "@/components/app/MovementsTable";
import LiveStatus from "@/components/app/LiveStatus.astro";
import Layout from "@/layouts/Layout.astro";
import { branchColor, branchContext, headerBackdrop, shiftBarData, branchHref, isLowStock, orderLabels, receiptUrls } from "@/data/queries";
import { differenceLabel, formatBs, plural, shiftHours } from "@/lib/format";
import { longDate } from "@/lib/dates";

const { negocio, sucursal } = Astro.params;
const ctx = await branchContext(Astro.locals, negocio!, sucursal!);
if (!ctx || ctx.role !== "dueño") return Astro.rewrite("/404");
const { today, branch, expenses, products, sales, salesByCategory, salesTotal, expensesTotal, shiftById, shiftTotals, shifts, weekSummary } = ctx;
const balance = salesTotal - expensesTotal;
// Única página de la sucursal con la foto del negocio de fondo: la de la sucursal va en la portada (ctx.backdrop).
const [orderNames, receipts, businessBackdrop] = await Promise.all([
  orderLabels(Astro.locals.supabase, branch.id, today, today),
  receiptUrls(Astro.locals.supabase, sales),
  headerBackdrop(Astro.locals, ctx.membership),
]);
const cover = ctx.backdrop;

const movements = [
  ...sales.map((s) => ({ ...s, ...ctx.receiptOf(s, receipts), label: `${orderNames.has(s.id) ? `Pedido «${orderNames.get(s.id)}»` : "Venta"} · ${plural(s.items, "producto", "productos")}`, amount: s.voided ?? s.total, kind: "sale" as const, payment: s.payment })),
  ...expenses.map((g) => ({ ...g, label: g.concept, amount: g.voided ?? g.amount, kind: "expense" as const, payment: undefined, receipt: undefined, missingReceipt: false, canAttach: false })),
]
  .sort((a, b) => b.time.localeCompare(a.time))
  .map((m) => {
    const shift = shiftById(m.shiftId);
    return {
      id: m.id,
      time: m.time,
      label: m.label,
      shift: { name: shift.name, tone: shift.tone },
      by: m.recordedBy.firstName,
      amount: m.amount,
      kind: m.kind,
      payment: m.payment,
      voided: m.voided !== null,
      receipt: m.receipt,
      missingReceipt: m.missingReceipt,
      canAttach: m.canAttach,
    };
  });

const lowStock = products.filter(isLowStock);
const color = branchColor(ctx.membership, branch.id);
const meta = [branch.address, plural(shifts.length, "turno", "turnos"), plural(ctx.employees.length, "persona", "personas")]
  .filter(Boolean)
  .join(" · ");
---

<Layout title={`Resumen · ${branch.name}`} context={{ membership: ctx.membership, branch, shift: shiftBarData(ctx) }}>
  <PageHeader {...businessBackdrop} tint={color} eyebrow={longDate(today)} title={branch.name} description={meta}>
    <span slot="cover" class="cover-art" style={`--branch: ${color}`}>
      <Store size={64} stroke-width={1.5} />
      {/* Mismo view-transition-name que la foto de la BranchCard: la fachada pasa de la tarjeta a la portada. */}
      {cover.image && <img src={cover.image} alt="" decoding="async" style={cover.transition && `view-transition-name: ${cover.transition}`} data-fallback />}
    </span>
  </PageHeader>

  <LiveStatus
    topic={`negocio:${ctx.business.id}`}
    names={{ [branch.id]: branch.name }}
    branch={branch.id}
    regions={["shift-bar", "kpis", "shifts", "charts", "activity"]}
  />

  <section class="kpis" aria-label="Totales de hoy" data-region="kpis">
    <div class="kpi">
      <p class="kpi-label">Ventas</p>
      <p class="kpi-value num amount-income" data-live="sales" data-amount={salesTotal} data-sign="+">{formatBs(salesTotal, "+")}</p>
      <p class="kpi-note">{plural(sales.length, "venta", "ventas")}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Gastos</p>
      <p class="kpi-value num amount-expense" data-live="expenses" data-amount={expensesTotal} data-sign="−">{formatBs(expensesTotal, "−")}</p>
      <p class="kpi-note">{plural(expenses.length, "gasto", "gastos")}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label">Saldo del día</p>
      <p class:list={["kpi-value num", { "amount-expense": balance < 0 }]} data-live="balance" data-amount={balance}>{formatBs(balance)}</p>
      <p class="kpi-note">Ventas menos gastos</p>
    </div>
  </section>

  <h2 class="section-title" id="shifts-title">Caja por turno</h2>
  <section class="shift-grid" aria-labelledby="shifts-title" data-region="shifts">
    {
      shifts.map((shift) => {
        const t = shiftTotals(shift.id);
        return (
          <article class:list={["card shift-card", { live: t.close.status === "en-curso" }]} aria-labelledby={`shift-card-${shift.id}`}>
            <header class="shift-card-head">
              <h3 class="sr-only" id={`shift-card-${shift.id}`}>Turno {shift.name}</h3>
              <ShiftChip shift={shift} />
              <span class="muted num">
                {shiftHours(shift)}
              </span>
            </header>
            <dl class="rows">
              <div>
                <dt>Ventas</dt>
                <dd class="num amount-income" data-live={`sales-${shift.id}`} data-amount={t.sales} data-sign="+">{formatBs(t.sales, "+")}</dd>
              </div>
              <div>
                <dt>Gastos</dt>
                <dd class="num amount-expense" data-live={`expenses-${shift.id}`} data-amount={t.expenses} data-sign="−">{formatBs(t.expenses, "−")}</dd>
              </div>
              <div>
                <dt>Esperado en caja</dt>
                <dd class="num" data-live={`expected-${shift.id}`} data-amount={t.expected}>{formatBs(t.expected)}</dd>
              </div>
            </dl>
            {t.close.status === "pendiente" ? (
              <p class="status chip-neutral">
                <Clock size={16} stroke-width={2} />
                Sin abrir hoy
              </p>
            ) : t.close.status === "en-curso" ? (
              <p class="status status-live">
                <span class="live-dot" aria-hidden="true" />
                Turno en curso
              </p>
            ) : t.close.difference === 0 ? (
              <p class="status chip-income">
                <CircleCheck size={16} stroke-width={2} />
                La caja cuadró
              </p>
            ) : (
              <p class="status chip-warning">
                <TriangleAlert size={16} stroke-width={2} />
                <span class="num">{differenceLabel(t.close.difference!)}</span>
              </p>
            )}
          </article>
        );
      })
    }
  </section>

  <div class="chart-grid" data-region="charts">
    <section class="card chart-card" aria-labelledby="week-title">
      <div class="chart-head">
        <h2 id="week-title" class="card-title">Últimos 7 días</h2>
        <p>Ventas y gastos por día</p>
      </div>
      <WeekChart client:visible days={weekSummary} />
    </section>
    <section class="card chart-card" aria-labelledby="category-title">
      <div class="chart-head">
        <h2 id="category-title" class="card-title">Ventas por categoría</h2>
        <p>Hoy</p>
      </div>
      <DonutChart client:visible items={salesByCategory()} totalLabel="vendido hoy" />
    </section>
  </div>

  <div class="split" data-region="activity">
    <section>
      <div class="shelf-head">
        <h2>Movimientos de hoy</h2>
        <a href={branchHref(ctx.business, branch, "ventas")} class="shelf-link">Ver ventas</a>
      </div>
      <MovementsTable client:visible rows={movements} />
    </section>

    <section>
      <div class="shelf-head">
        <h2>Stock bajo</h2>
        <a href={branchHref(ctx.business, branch, "inventario")} class="shelf-link">Ver inventario</a>
      </div>
      {lowStock.length === 0 && <p class="card empty-state">Ningún producto está por debajo de su stock mínimo.</p>}
      <ul class="card stock-list" role="list" hidden={lowStock.length === 0}>
        {
          lowStock.map((p) => (
            <li>
              <TriangleAlert size={16} stroke-width={2} class="warn-icon" />
              <span class="stock-name">{p.name}</span>
              <span class="num muted">
                Quedan {p.stock}{p.minStock ? ` · mínimo ${p.minStock}` : ""}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<style>
  .chart-card {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
  }

  .chart-head p {
    margin: 0.125rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .chart-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
  }

  .cover-art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, color-mix(in oklab, var(--branch) 55%, var(--color-surface)), color-mix(in oklab, var(--branch) 20%, var(--color-surface)));
    color: var(--color-text);
  }

  /* La foto tapa el ícono; si no carga (data-fallback), queda el ícono sobre el color de la sucursal. */
  .cover-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shift-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .shift-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }

  /* El turno abierto se marca con un anillo ámbar, además del texto «Turno en curso». */
  .shift-card.live {
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  .status-live {
    color: var(--color-primary);
    padding-left: 0;
  }

  .shift-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .muted {
    color: var(--color-text-muted);
  }

  .rows {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-sm);
  }

  .rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .rows dt {
    color: var(--color-text-muted);
  }

  .rows dd {
    margin: 0;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .stock-list {
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }

  .stock-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    font-size: var(--text-sm);
  }

  .stock-list li + li {
    border-top: 1px solid var(--color-border);
  }

  .stock-name {
    flex: 1;
  }

  .stock-list :global(.warn-icon) {
    flex-shrink: 0;
    color: var(--color-warning);
  }

  @media (max-width: 1100px) {
    .chart-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .shift-grid {
      grid-template-columns: minmax(0, 1fr);
    }

  }
</style>
