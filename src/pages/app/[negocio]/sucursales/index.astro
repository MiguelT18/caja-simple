---
import { Plus } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import BranchCard from "@/components/app/BranchCard.astro";
import BranchDialogs from "@/components/app/BranchDialogs.astro";
import Layout from "@/layouts/Layout.astro";
import { businessContext, businessHref } from "@/data/queries";
import { planLimits } from "@/data/plans";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, branchSummary } = ctx;
const maxBranches = planLimits[business.plan].branches;
const canAddBranch = maxBranches === null || branchSummary.length < maxBranches;
---

<Layout title={`Sucursales · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader title="Sucursales" description={`${branchSummary.length} ${branchSummary.length === 1 ? "sucursal" : "sucursales"} de ${business.name} · movimientos de hoy`}>
    {
      canAddBranch ? (
        <button type="button" class="btn btn-secondary" data-open-dialog="branch-new">
          <Plus size={18} stroke-width={2} />
          Agregar sucursal
        </button>
      ) : (
        <p class="notice">
          Tu plan {business.plan} incluye {maxBranches} sucursal. <a href={`${businessHref(business)}/plan`}>Ver planes →</a>
        </p>
      )
    }
  </PageHeader>

  <BranchDialogs business={business} branchSummary={branchSummary} canAddBranch={canAddBranch} />

  <section class="branch-grid" aria-label="Sucursales">
    {
      branchSummary.map((stats, i) => <BranchCard stats={stats} index={i} />)
    }
  </section>
</Layout>

<style>
  .notice a {
    color: inherit;
    font-weight: var(--font-semibold);
  }

  .branch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
</style>
