---
import PageHeader from "@/components/PageHeader.astro";
import ProductCatalog from "@/components/app/products/ProductCatalog";
import Layout from "@/layouts/Layout.astro";
import { plural } from "@/lib/format";
import { catalogLabel } from "@/data/kinds";
import { businessContext } from "@/data/queries";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, catalog, categories } = ctx;
const label = catalogLabel(business.kind);
const lowCount = catalog.filter((p) => p.soldIn.some((s) => s.low)).length;
---

<Layout title={`${label} · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader {...ctx.backdrop}
    title={label}
    live
    description={`${[plural(catalog.length, "producto", "productos"), lowCount > 0 && `${lowCount} con stock bajo en alguna sucursal`].filter(Boolean).join(" · ")}. Cada sucursal pone su precio y su stock.`}
  />

  <div data-region="catalog">
    <ProductCatalog client:load products={catalog} categories={categories} businessId={business.id} canEdit />
  </div>
</Layout>
