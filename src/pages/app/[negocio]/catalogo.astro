---
import PageHeader from "@/components/PageHeader.astro";
import ProductCatalog from "@/components/app/products/ProductCatalog";
import Layout from "@/layouts/Layout.astro";
import { appPaths, businessContext } from "@/data/queries";

export const getStaticPaths = () => appPaths.business();

const ctx = businessContext(Astro.params.negocio!);
const { business, catalog } = ctx;
const lowCount = catalog.filter((p) => p.soldIn.some((s) => s.low)).length;
---

<Layout title={`Catálogo · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader
    title="Catálogo"
    description={`${catalog.length} productos de ${business.name} · ${lowCount} con stock bajo en alguna sucursal. El precio y el stock los lleva cada sucursal.`}
  />

  <ProductCatalog client:load mode="business" products={catalog} storageKey={`caja-simple-product-categories:${business.id}`} />
</Layout>
