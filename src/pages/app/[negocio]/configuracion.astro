---
import { ArrowRight, ChevronRight, CircleCheck, CircleMinus, Gem, MapPin, Pencil, Plus, Store, Trash, TriangleAlert, Users, Clock } from "@lucide/astro";
import Avatar from "@/components/Avatar.astro";
import PageHeader from "@/components/PageHeader.astro";
import BranchDialogs from "@/components/app/BranchDialogs.astro";
import BusinessProfileFields from "@/components/app/BusinessProfileFields.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import PhotoField from "@/components/app/PhotoField.astro";
import Layout from "@/layouts/Layout.astro";
import { businessKinds, catalogLabel, kindOptions } from "@/data/kinds";
import { branchColor, businessContext, businessHref, businessImages, currentUser } from "@/data/queries";
import { planLimits } from "@/data/plans";
import { longDate } from "@/lib/dates";
import { plural } from "@/lib/format";

const ctx = await businessContext(Astro.locals, Astro.params.negocio!);
if (!ctx) return Astro.rewrite("/404");
const { business, branchSummary } = ctx;
const base = businessHref(business);
const limits = planLimits[business.plan];
const canAddBranch = limits.branches === null || branchSummary.length < limits.branches;

// Uso del plan: el texto lo dice todo; la barra solo acompaña (nada solo con color).
const branchUse = {
  label: "Sucursales",
  value: limits.branches === null ? `${branchSummary.length} · sin tope` : `${branchSummary.length} de ${limits.branches}${canAddBranch ? "" : " · al tope"}`,
  fill: limits.branches === null ? null : Math.min(100, (branchSummary.length / limits.branches) * 100),
  ok: canAddBranch,
};
const history = { label: "Historial a la vista", value: limits.historyDays === null ? "Completo" : `Últimos ${limits.historyDays} días`, ok: limits.historyDays === null };
const sections = [
  { id: "negocio", label: "Negocio", icon: Store },
  { id: "sucursales", label: "Sucursales", icon: MapPin },
  { id: "plan", label: "Plan", icon: Gem },
  { id: "eliminar", label: "Eliminar", icon: TriangleAlert },
];
const user = currentUser(Astro.locals);
const logo = (await businessImages(Astro.locals, [business])).get(business.id);
// Lo único que cambia el rubro en la app: cómo se llama el catálogo (ver docs/modelo-de-datos.md › Rubros).
const catalogLabels = JSON.stringify(Object.fromEntries(businessKinds.map((k) => [k.value, catalogLabel(k.value)])));
const lost = "sus ventas, gastos, cierres de caja, turnos, inventario y empleados asignados";
---

<Layout title={`Configuración · ${business.name}`} context={{ membership: ctx.membership }}>
  <PageHeader {...ctx.backdrop} title="Configuración" description={`Datos, sucursales y plan de ${business.name}. Lo tuyo (foto, contraseña) está en Tu cuenta.`} />

  <div class="settings-shell">
  <div class="settings">
    <aside class="index">
      <nav aria-label="Secciones de configuración">
        <p class="index-label" aria-hidden="true">En esta página</p>
        <ul role="list" class="index-list">
          {
            sections.map(({ id, label, icon: Icon }) => (
              <li>
                <a href={`#${id}`} class:list={["index-link", { danger: id === "eliminar" }]} data-index-link={id}>
                  <Icon size={18} stroke-width={1.75} />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a href="/app/cuenta" class="account">
        <Avatar src={user.avatarUrl} seed={user.id} size={2.5} />
        <span class="account-text">
          <span class="account-title">Tu cuenta</span>
          <span class="account-meta">Foto, contraseña y verificación en dos pasos</span>
        </span>
        <ChevronRight size={18} stroke-width={1.75} />
      </a>
    </aside>

    <div class="sections">
      <a href="/app/cuenta" class="account account-narrow">
        <Avatar src={user.avatarUrl} seed={user.id} size={2.5} />
        <span class="account-text">
          <span class="account-title">Tu cuenta</span>
          <span class="account-meta">Foto, contraseña y verificación en dos pasos</span>
        </span>
        <ChevronRight size={18} stroke-width={1.75} />
      </a>
      <section id="negocio" class="section" tabindex="-1" aria-labelledby="business-title">
        <header class="section-head">
          <h2 id="business-title">Negocio</h2>
          <p>Cómo se llama, a qué se dedica y su logo.</p>
        </header>
        {!business.description && (
          <p class="notice">
            Agrega una descripción de tu negocio: desde ahora es obligatoria. Sin ella no aparece en Buscar.
          </p>
        )}
        <form
          id="business-form"
          class="surface business-form"
          data-action="saveBusiness"
          data-reload
          data-track-changes
          data-success="Cambios guardados."
          data-kind-from={business.kind}
          data-catalog-labels={catalogLabels}
          enctype="multipart/form-data"
          novalidate
        >
          <input type="hidden" name="id" value={business.id} />
          <div class="business-grid">
            <div class="cover">
              <PhotoField form="business-form" label="Logo o foto" image={logo} square cover />
            </div>
            <div class="business-fields">
              <FormInput form="business-form" name="name" label="Nombre del negocio" value={business.name} required maxlength={80} />
              <FormInput form="business-form" name="kind" label="Rubro" options={kindOptions(business.kind)} hint="Solo cambia cómo se llaman algunas secciones. Tus productos, precios, stock y ventas no cambian." />
              <p class="notice kind-effect" aria-live="polite" data-kind-effect></p>
            </div>
          </div>
          <BusinessProfileFields form="business-form" description={business.description} listed={business.listed} />
          <div class="slug-row">
            <span class="slug-label">Dirección en la app</span>
            <span class="slug">{base}</span>
            <span class="field-hint">No cambia al renombrar, así tus enlaces siguen funcionando.</span>
          </div>
          <p class="notice notice-error" role="alert" data-form-notice></p>
          <div class="form-actions">
            <span class="change-status" data-change-status>Sin cambios</span>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
          </div>
        </form>
      </section>

      <section id="sucursales" class="section" tabindex="-1" aria-labelledby="branches-title">
        <header class="section-head">
          <h2 id="branches-title">Sucursales</h2>
          <p>{plural(branchSummary.length, "sucursal", "sucursales")} · cada una con su caja, sus turnos y su inventario.</p>
        </header>
        <div class="surface">
          <ul class="branches" role="list">
            {
              branchSummary.map(({ branch, image, shifts, employees, href }) => (
                <li class="branch" style={`--branch: ${branchColor(ctx.membership, branch.id)}`}>
                  <span class="art">
                    {image ? <img src={image} alt="" loading="lazy" decoding="async" data-fallback /> : null}
                    <Store size={24} stroke-width={1.75} aria-hidden="true" />
                  </span>
                  <span class="branch-text">
                    <span class="branch-name">{branch.name}</span>
                    {branch.address && (
                      <span class="branch-address">
                        <MapPin size={14} stroke-width={1.75} />
                        {branch.address}
                      </span>
                    )}
                    <span class="facts">
                      <span class="fact">
                        <Clock size={14} stroke-width={1.75} />
                        {plural(shifts.length, "turno", "turnos")}
                      </span>
                      <span class="fact">
                        <Users size={14} stroke-width={1.75} />
                        {plural(employees, "empleado", "empleados")}
                      </span>
                    </span>
                  </span>
                  <span class="branch-actions">
                    <button type="button" class="icon-btn" data-open-dialog={`branch-${branch.id}`} aria-label={`Editar ${branch.name}`} title="Editar">
                      <Pencil size={18} stroke-width={1.75} />
                    </button>
                    <a href={href} class="btn btn-secondary btn-sm">
                      Entrar<span class="sr-only"> a {branch.name}</span>
                      <ArrowRight size={16} stroke-width={2} />
                    </a>
                  </span>
                </li>
              ))
            }
            {
              canAddBranch && (
                <li>
                  <button type="button" class="branch branch-add" data-open-dialog="branch-new">
                    <span class="art art-add">
                      <Plus size={24} stroke-width={1.75} />
                    </span>
                    <span class="branch-text">
                      <span class="branch-name">Agregar sucursal</span>
                      <span class="branch-address">Con su dirección, foto y turnos</span>
                    </span>
                  </button>
                </li>
              )
            }
          </ul>
          {
            !canAddBranch && (
              <p class="notice">
                Tu plan {business.plan} incluye {plural(limits.branches!, "sucursal", "sucursales")}. <a href={`${base}/plan`}>Ver planes →</a>
              </p>
            )
          }
        </div>
      </section>

      <section id="plan" class="section" tabindex="-1" aria-labelledby="plan-title">
        <header class="section-head">
          <h2 id="plan-title">Plan</h2>
          <p>Lo que incluye el plan de {business.name} y cuánto usas.</p>
        </header>
        <div class="surface plan">
          <div class="plan-head">
            <div class="plan-name">
              <span class="plan-value">Plan {business.plan}</span>
              {business.planUntil && <span class="chip">Pagado hasta el {longDate(business.planUntil).replace(/^\S+ /, "")}</span>}
            </div>
            <a href={`${base}/plan`} class="btn btn-secondary">
              Ver planes y precios
              <ArrowRight size={18} stroke-width={2} />
            </a>
          </div>
          <dl class="usage">
            <div class:list={["use", { full: !branchUse.ok }]}>
              <dt>{branchUse.label}</dt>
              <dd>
                {branchUse.ok ? <CircleCheck size={16} stroke-width={1.75} /> : <CircleMinus size={16} stroke-width={1.75} />}
                <span class="num">{branchUse.value}</span>
              </dd>
              {branchUse.fill !== null && <span class="gauge" style={`--fill: ${branchUse.fill}%`} aria-hidden="true" />}
            </div>
            <div class="use">
              <dt>{history.label}</dt>
              <dd>
                {history.ok ? <CircleCheck size={16} stroke-width={1.75} /> : <CircleMinus size={16} stroke-width={1.75} />}
                <span class="num">{history.value}</span>
              </dd>
            </div>
          </dl>
          {limits.historyDays !== null && <p class="field-hint">Lo anterior no se borra: vuelve a aparecer cuando pasas a un plan pago.</p>}
        </div>
      </section>

      <section id="eliminar" class="section" tabindex="-1" aria-labelledby="danger-title">
        <header class="section-head">
          <h2 id="danger-title" class="danger-title">
            <TriangleAlert size={22} stroke-width={2} />
            Eliminar
          </h2>
          <p>Es definitivo: no hay papelera ni forma de recuperarlo.</p>
        </header>
        <div class="surface danger-zone">
          <ul class="rows" role="list">
            {
              branchSummary.length > 1 &&
                branchSummary.map(({ branch, image }) => (
                  <li style={`--branch: ${branchColor(ctx.membership, branch.id)}`}>
                    <span class="art art-sm">
                      {image ? <img src={image} alt="" loading="lazy" decoding="async" data-fallback /> : null}
                      <Store size={18} stroke-width={1.75} aria-hidden="true" />
                    </span>
                    <div class="row-text">
                      <p class="row-title">{branch.name}</p>
                      <p class="row-meta">Sucursal · se borran {lost}.</p>
                    </div>
                    <button type="button" class="btn btn-secondary danger-btn" data-open-dialog={`delete-branch-${branch.id}`}>
                      <Trash size={16} stroke-width={1.75} />
                      Eliminar<span class="sr-only"> {branch.name}</span>
                    </button>
                  </li>
                ))
            }
            <li>
              <span class="art art-sm art-business">
                {logo ? <img src={logo} alt="" loading="lazy" decoding="async" data-fallback /> : null}
                <Store size={18} stroke-width={1.75} aria-hidden="true" />
              </span>
              <div class="row-text">
                <p class="row-title">{business.name}</p>
                <p class="row-meta">
                  Negocio · se borran sus {plural(branchSummary.length, "sucursal", "sucursales")}, el catálogo y todo su historial. Tus empleados pierden el acceso.
                </p>
              </div>
              <button type="button" class="btn btn-secondary danger-btn" data-open-dialog="delete-business">
                <Trash size={16} stroke-width={1.75} />
                Eliminar<span class="sr-only"> {business.name}</span>
              </button>
            </li>
          </ul>
          {branchSummary.length === 1 && <p class="field-hint">Un negocio necesita al menos una sucursal: para cerrar la única, elimina el negocio.</p>}
        </div>
      </section>
    </div>
  </div>
  </div>

  <BranchDialogs business={business} branchSummary={branchSummary} canAddBranch={canAddBranch} />

  {
    branchSummary.length > 1 &&
      branchSummary.map(({ branch }) => (
        <Modal
          id={`delete-branch-${branch.id}`}
          title={`Eliminar ${branch.name}`}
          description={`Se borran ${lost}. No se puede deshacer.`}
          action="deleteBranch"
          reload
          submitLabel="Eliminar sucursal"
          danger
          hidden={{ id: branch.id }}
        >
          <FormInput form={`delete-branch-${branch.id}-form`} name="confirm" label={`Escribe «${branch.name}» para confirmar`} autocomplete="off" required />
        </Modal>
      ))
  }

  <Modal
    id="delete-business"
    title={`Eliminar ${business.name}`}
    description="Se borran todas sus sucursales, el catálogo, las ventas, los gastos y los cierres de caja. Tus empleados pierden el acceso. No se puede deshacer."
    action="deleteBusiness"
    submitLabel="Eliminar negocio"
    redirect="/app"
    danger
    hidden={{ id: business.id }}
  >
    <FormInput form="delete-business-form" name="confirm" label={`Escribe «${business.name}» para confirmar`} autocomplete="off" required />
  </Modal>
</Layout>

<script>
  // Qué pasa al cambiar el rubro: se dice antes de guardar, y solo si de verdad cambia algo.
  const form = document.querySelector<HTMLFormElement>("#business-form");
  const effect = form?.querySelector<HTMLElement>("[data-kind-effect]");
  const kind = form?.querySelector<HTMLSelectElement>("[name=kind]");
  if (form && effect && kind) {
    const from = form.dataset.kindFrom!;
    const labels: Record<string, string> = JSON.parse(form.dataset.catalogLabels!);
    const show = () => {
      const to = kind.value;
      const lines =
        to === from
          ? []
          : [
              labels[to] !== labels[from]
                ? `Al guardar, «${labels[from]}» pasa a llamarse «${labels[to]}» en el menú lateral y en su página. Tus productos, precios, stock y ventas siguen igual.`
                : "Al guardar, solo cambia el rubro del negocio: las secciones y tus datos siguen igual.",
              ...(to === "ropa" ? ["Los tipos de prenda de ejemplo solo se crean al abrir un negocio nuevo; agrégalos en el catálogo si los necesitas."] : []),
            ];
      effect.replaceChildren(...lines.map((text) => Object.assign(document.createElement("span"), { textContent: text })));
    };
    form.addEventListener("formchange", show);
    show();
  }

  // Índice: marca la sección que se está leyendo (la que ocupa la franja alta del panel).
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-index-link]")].map((a) => [a.dataset.indexLink!, a]));
  const ids = [...links.keys()];
  const last = ids[ids.length - 1];
  const mark = (id: string) => {
    links.forEach((a, key) => (key === id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
    // En el celular el índice es una fila de píldoras: la activa queda a la vista (solo scroll horizontal de la fila).
    const link = links.get(id);
    const list = link?.closest("ul");
    if (link && list && list.scrollWidth > list.clientWidth) list.scrollTo({ left: link.offsetLeft - 16, behavior: "smooth" });
  };

  // Quien hace scroll: <main> en escritorio, la página en el celular (main sin overflow).
  const first = document.getElementById(ids[0]);
  let box: HTMLElement = document.scrollingElement as HTMLElement;
  for (let p = first?.parentElement; p; p = p.parentElement) {
    if (/(auto|scroll)/.test(getComputedStyle(p).overflowY)) {
      box = p;
      break;
    }
  }
  const isPage = box === document.scrollingElement;
  const atEnd = () => box.scrollTop + box.clientHeight >= box.scrollHeight - 2;

  // Tras un clic, la marca queda en lo elegido hasta que termina el scroll.
  let pinned: string | null = null;
  let unpin = 0;
  const release = () => {
    clearTimeout(unpin);
    pinned = null;
  };
  // Respaldo para navegadores sin scrollend.
  const scrollTarget = isPage ? window : box;
  scrollTarget.addEventListener("scrollend", release);
  scrollTarget.addEventListener(
    "scroll",
    () => {
      if (pinned) {
        clearTimeout(unpin);
        unpin = window.setTimeout(release, 600);
      } else if (atEnd()) mark(last);
    },
    { passive: true },
  );

  const visible = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
      if (pinned) return;
      // Al fondo, la última sección (corta) nunca llega a la franja alta: se marca igual.
      const current = atEnd() ? last : ids.find((id) => visible.has(id));
      if (current) mark(current);
    },
    { rootMargin: "-10% 0px -60% 0px" },
  );

  links.forEach((a, id) => {
    const section = document.getElementById(id);
    if (!section) return;
    observer.observe(section);
    // Sin el salto nativo del ancla: ese desplaza también a los ancestros y corría la app entera hacia abajo.
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const offset = isPage ? 0 : box.getBoundingClientRect().top;
      const top = section.getBoundingClientRect().top - offset + box.scrollTop - parseFloat(getComputedStyle(section).scrollMarginTop);
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
      history.replaceState(null, "", `#${id}`);
      pinned = id;
      clearTimeout(unpin);
      unpin = window.setTimeout(release, 600);
      mark(id);
      section.focus({ preventScroll: true });
    });
  });

  const fromHash = decodeURIComponent(location.hash.slice(1));
  mark(links.has(fromHash) ? fromHash : ids[0]);
</script>

<style>
  /* Índice a la izquierda y secciones a la derecha; con el panel angosto, el índice pasa a una fila de píldoras. */
  /* El contenedor es el panel: el índice cambia según el ancho del panel, no de la ventana. */
  .settings-shell {
    container-type: inline-size;
  }

  .settings {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .sections {
    display: grid;
    gap: 3rem;
    min-width: 0;
    max-width: 52rem;
  }

  .section {
    display: grid;
    gap: 1rem;
    scroll-margin-top: 1.5rem;
  }

  /* Recibe el foco desde el índice (para teclado y lector), sin anillo: no es un control. */
  .section:focus {
    outline: none;
  }

  .section-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.02em;
  }

  .section-head p {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .surface {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
  }

  /* --- Índice --- */
  .index {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0 calc(-1 * var(--main-pad));
    padding: 0.5rem var(--main-pad);
    background: var(--color-surface);
  }

  .index-list {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .index-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-surface-muted);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms, color 150ms;
  }

  .index-link:hover {
    background: var(--color-surface-hover);
  }

  .index-link.danger :global(svg) {
    color: var(--color-expense);
  }

  /* Píldora activa invertida, como los filtros de Vender. */
  .index-link[aria-current] {
    background: var(--color-text);
    color: var(--color-surface);
  }

  .index-label {
    display: none;
    margin: 0 0 0.5rem;
    padding: 0 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }

  .account {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color 150ms;
  }

  .account:hover {
    background: var(--color-surface-hover);
  }

  /* Angosto: «Tu cuenta» va primera en el contenido; el índice sticky queda solo con las píldoras. */
  .index .account {
    display: none;
  }

  /* En el celular la página entera hace scroll bajo la barra fija de 4rem. */
  @media (max-width: 768px) {
    .index {
      top: 4rem;
    }

    .section {
      scroll-margin-top: 8rem;
    }
  }

  @container (min-width: 50rem) {
    /* Índice a la derecha, como «En esta página»: no compite con el Sidebar de la izquierda. */
    .settings {
      grid-template-columns: minmax(0, 52rem) 13rem;
      gap: 2.5rem;
      align-items: start;
      justify-content: center;
    }

    .index {
      grid-column: 2;
      grid-row: 1;
      top: 1.5rem;
      align-content: start;
      margin: 0;
      padding: 0 0 0 1rem;
      border-left: 1px solid var(--color-border);
      background: none;
    }

    .sections {
      grid-column: 1;
      grid-row: 1;
    }

    .index-label {
      display: block;
    }

    .index-list {
      flex-direction: column;
      gap: 0.125rem;
      overflow: visible;
    }

    /* Como los enlaces de la biblioteca del lateral: activo con fondo elevado, 700 y el ícono en ámbar. */
    .index-link {
      display: flex;
      padding: 0 0.75rem;
      border-radius: 0.375rem;
      background: none;
      color: var(--color-text-muted);
    }

    .index-link:hover {
      background: var(--color-surface-hover);
      color: var(--color-text);
    }

    .index-link[aria-current] {
      background: var(--color-surface-muted);
