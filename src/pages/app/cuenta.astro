---
import { Bell, CircleCheck, CircleMinus, Clock, Download, HandCoins, KeyRound, ShieldCheck, Trash, TriangleAlert, UserRound } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import AffiliateInvite from "@/components/app/AffiliateInvite.astro";
import FormInput from "@/components/app/FormInput.astro";
import Modal from "@/components/app/Modal.astro";
import PhotoField from "@/components/app/PhotoField.astro";
import Layout from "@/layouts/Layout.astro";
import { accountSettings, myAffiliate, myBusinesses } from "@/data/queries";
import { shiftHours } from "@/lib/format";
import { PUBLIC_VAPID_PUBLIC_KEY } from "astro:env/client";

const { user, jobs, totpFactorId, hasPassword } = await accountSettings(Astro.locals);
const vapidKey = PUBLIC_VAPID_PUBLIC_KEY ?? "";
// El programa de afiliados es de la persona, no de un negocio: va en su cuenta.
const affiliate = myAffiliate(Astro.locals);
const owned = myBusinesses(Astro.locals).filter((m) => m.role === "dueño").map((m) => m.business.name);
import CodeInput from "@/components/CodeInput.astro";

const sections = [
  { id: "perfil", label: "Perfil", icon: UserRound },
  { id: "contrasena", label: "Contraseña", icon: KeyRound },
  ...(jobs.length > 0 ? [{ id: "turnos", label: "Tus turnos", icon: Clock }] : []),
  { id: "dos-pasos", label: "Dos pasos", icon: ShieldCheck },
  { id: "notificaciones", label: "Notificaciones", icon: Bell },
  ...(affiliate ? [{ id: "afiliados", label: "Afiliados", icon: HandCoins }] : []),
  { id: "datos", label: "Tus datos", icon: Download },
  { id: "borrar", label: "Borrar la cuenta", icon: TriangleAlert },
];
---

<Layout title="Tu cuenta">
  <PageHeader title="Tu cuenta" description="Tu foto, tu nombre y cómo entras. Vale para todos los negocios donde estás." />

  <div class="settings-shell">
    <div class="settings">
      <aside class="index">
        <nav aria-label="Secciones de tu cuenta">
          <p class="index-label" aria-hidden="true">En esta página</p>
          <ul role="list" class="index-list">
            {
              sections.map(({ id, label, icon: Icon }) => (
                <li>
                  <a href={`#${id}`} class:list={["index-link", { danger: id === "borrar" }]} data-index-link={id}>
                    <Icon size={18} stroke-width={1.75} />
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="sections">
        <section id="perfil" class="section" tabindex="-1" aria-labelledby="profile-title">
          <header class="section-head">
            <h2 id="profile-title">Perfil</h2>
            <p>Tu foto y tu nombre, como te ven en todos tus equipos.</p>
          </header>
          <form id="profile-form" class="surface" data-action="saveProfile" data-reload enctype="multipart/form-data" novalidate>
            <PhotoField form="profile-form" label="Foto de perfil" image={user.avatarUrl} round />
            <div class="field-row-2">
              <FormInput form="profile-form" name="firstName" label="Nombre" value={user.firstName} autocomplete="given-name" required maxlength={60} />
              <FormInput form="profile-form" name="lastName" label="Apellido" hint="Opcional" value={user.lastName} autocomplete="family-name" maxlength={60} />
            </div>
            <p class="field-hint">Correo: <span class="strong">{user.email}</span>. Es con el que entras y no se cambia desde aquí.</p>
            <p class="notice notice-error" role="alert" data-form-notice></p>
            <button type="submit" class="btn btn-primary">Guardar perfil</button>
          </form>
        </section>

        <section id="contrasena" class="section" tabindex="-1" aria-labelledby="password-title" data-region="password">
          <header class="section-head">
            <h2 id="password-title">Contraseña</h2>
            <p>{hasPassword ? "La que usas para entrar con tu correo." : "Entras con Google. Si creas una contraseña, también podrás entrar con tu correo."}</p>
          </header>
          <form id="password-form" class="surface" data-action="changePassword" data-success={hasPassword ? "Contraseña cambiada." : "Contraseña creada."} novalidate>
            <div class="field-row-2">
              <FormInput form="password-form" name="password" type="password" label="Contraseña nueva" hint="Al menos 8 caracteres." autocomplete="new-password" required minlength={8} />
              <FormInput form="password-form" name="confirm" type="password" label="Repite la contraseña" autocomplete="new-password" required />
            </div>
            <p class="notice notice-error" role="alert" data-form-notice></p>
            <button type="submit" class="btn btn-secondary">{hasPassword ? "Cambiar contraseña" : "Crear contraseña"}</button>
          </form>
        </section>

        {
          jobs.length > 0 && (
            <section id="turnos" class="section" tabindex="-1" aria-labelledby="jobs-title">
              <header class="section-head">
                <h2 id="jobs-title">Tus turnos de trabajo</h2>
                <p>Si cambias de horario, elígelo aquí. Quien administra el negocio recibe un aviso; la sucursal y el puesto los cambia esa persona.</p>
              </header>
              <div class="surface jobs">
                {jobs.map(({ business, branch, employee, shifts }) => {
                  const form = `shift-${employee.id}`;
                  return (
                    <form id={form} class="job" data-action="changeMyShift" data-refresh="none" data-success="Turno cambiado." novalidate>
                      <input type="hidden" name="employeeId" value={employee.id} />
                      <input type="hidden" name="businessId" value={business.id} />
                      <FormInput
                        form={form}
                        name="shiftId"
                        label={`${business.name} · ${branch.name}`}
                        options={[
                          ...(employee.shiftId ? [] : [{ value: "", label: "Elige un turno", selected: true }]),
                          ...shifts.map((s) => ({ value: s.id, label: `${s.name} (${shiftHours(s)})`, selected: s.id === employee.shiftId })),
                        ]}
                        required
                      />
                      <p class="notice notice-error" role="alert" data-form-notice />
                      <button type="submit" class="btn btn-secondary">
                        Cambiar turno<span class="sr-only"> en {business.name}</span>
                      </button>
                    </form>
                  );
                })}
              </div>
            </section>
          )
        }

        <section id="dos-pasos" class="section" tabindex="-1" aria-labelledby="mfa-title">
          <header class="section-head">
            <h2 id="mfa-title">Verificación en dos pasos</h2>
            <p>Así nadie entra a tu caja aunque sepa tu contraseña.</p>
          </header>
          <div class="surface row">
            <div class="row-text">
              {
                totpFactorId ? (
                  <span class="chip chip-income"><CircleCheck size={14} stroke-width={1.75} />Activada</span>
                ) : (
                  <span class="chip chip-neutral"><CircleMinus size={14} stroke-width={1.75} />Desactivada</span>
                )
              }
              <p class="field-hint">Además de tu contraseña, al entrar te pedimos un código de 6 números de una app como Google Authenticator o Authy.</p>
            </div>
            {
              totpFactorId ? (
                <button type="button" class="btn btn-secondary" data-open-dialog="totp-disable">
                  Desactivar
                </button>
              ) : (
                <button type="button" class="btn btn-secondary" data-open-dialog="totp-enroll">
                  <ShieldCheck size={16} stroke-width={1.75} />
                  Activar
                </button>
              )
            }
          </div>
        </section>

        <section id="notificaciones" class="section" tabindex="-1" aria-labelledby="push-title">
          <header class="section-head">
            <h2 id="push-title">Notificaciones en este dispositivo</h2>
            <p>Te llegan las invitaciones, sus respuestas, la caja descuadrada y el stock bajo, aunque tengas la app cerrada. Se activa en cada dispositivo.</p>
          </header>
          <div class="surface row">
            <p class="field-hint row-text" id="push-status" aria-live="polite" data-push-status>Revisando si este navegador puede recibir avisos…</p>
            <button type="button" class="switch" role="switch" aria-checked="false" aria-labelledby="push-title" aria-describedby="push-status" disabled data-push-switch>
              <span class="switch-thumb"></span>
            </button>
          </div>
        </section>

        {
          affiliate && (
            <div id="afiliados" class="section" tabindex="-1">
              <AffiliateInvite affiliate={affiliate} />
            </div>
          )
        }

        <section id="datos" class="section" tabindex="-1" aria-labelledby="data-title">
          <header class="section-head">
            <h2 id="data-title">Tus datos</h2>
            <p>Una copia de todo lo tuyo, para guardarla o llevártela.</p>
          </header>
          <div class="surface row">
            <p class="field-hint row-text">
              Un archivo JSON con tu perfil y todo lo de tus negocios: sucursales, productos, inventario, ventas, gastos, cierres y equipo.
            </p>
            <a href="/app/cuenta/exportar" class="btn btn-secondary" download>
              <Download size={16} stroke-width={1.75} />
              Descargar tus datos
            </a>
          </div>
        </section>

        <section id="borrar" class="section" tabindex="-1" aria-labelledby="delete-title">
          <header class="section-head">
            <h2 id="delete-title" class="danger-title">
              <TriangleAlert size={22} stroke-width={2} />
              Borrar la cuenta
            </h2>
            <p>Es definitivo: no hay papelera ni forma de recuperarla.</p>
          </header>
          <div class="surface row danger-zone">
            <p class="field-hint row-text">
              {owned.length > 0
                ? `Se borran tu cuenta y ${owned.length === 1 ? "tu negocio" : `tus ${owned.length} negocios`} con todo su historial.`
                : "Se borra tu cuenta y dejas los equipos donde trabajas. Las ventas que registraste se quedan en esos negocios, sin tu nombre."}
            </p>
            <button type="button" class="btn btn-secondary danger-btn" data-open-dialog="delete-account">
              <Trash size={16} stroke-width={1.75} />
              Borrar la cuenta
            </button>
          </div>
        </section>
      </div>
    </div>
  </div>

  {
    totpFactorId ? (
      <Modal
        id="totp-disable"
        title="Desactivar la verificación en dos pasos"
        description="Escribe el código que muestra tu app ahora. Después solo te pediremos la contraseña."
        action="disableTotp"
        reload
        submitLabel="Desactivar"
        danger
        hidden={{ factorId: totpFactorId }}
      >
        <CodeInput id="totp-disable-form-code" label="Código de 6 dígitos" required />
      </Modal>
    ) : (
      <Modal
        id="totp-enroll"
        title="Activar la verificación en dos pasos"
        description="1. Escanea el código con tu app de autenticación. 2. Escribe los 6 números que te muestra."
        action="verifyTotp"
        reload
        submitLabel="Activar"
        hidden={{ factorId: "" }}
      >
        <div class="qr" data-totp-qr>
          <span class="skeleton qr-skeleton" aria-hidden="true"></span>
        </div>
        <p class="field-hint secret">¿No puedes escanear? Escribe esta clave en la app: <code data-totp-secret>…</code></p>
        <CodeInput id="totp-enroll-form-code" label="Código de 6 dígitos" required />
      </Modal>
    )
  }

  <Modal
    id="delete-account"
    title="Borrar tu cuenta"
    description="Esto no se puede deshacer. Si quieres guardar tu historial, primero descarga tus datos."
    action="deleteAccount"
    submitLabel="Borrar para siempre"
    redirect="/"
    danger
  >
    {
      owned.length > 0 && (
        <div class="notice notice-error">
          <p class="lost-title">También se borran estos negocios, con sus ventas, gastos, cierres y equipo:</p>
          <ul>
            {owned.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        </div>
      )
    }
    <FormInput form="delete-account-form" name="email" label={`Escribe tu correo (${user.email}) para confirmar`} autocomplete="off" required />
    {hasPassword && <FormInput form="delete-account-form" name="password" type="password" label="Tu contraseña" autocomplete="current-password" required />}
  </Modal>

  <div hidden data-vapid-key={vapidKey}></div>

  <script>
    import { actions } from "astro:actions";
    import { onPage } from "@/scripts/refresh";
    import { sectionIndex } from "@/scripts/section-index";

    onPage((signal) => {
      sectionIndex(signal);
      const toggle = document.querySelector<HTMLButtonElement>("[data-push-switch]");
      if (!toggle) return;

      // Activar 2FA: al abrir el diálogo se pide a Supabase un factor nuevo y se muestra su QR.
      const enroll = document.querySelector<HTMLDialogElement>("#totp-enroll");
      document.querySelector('[data-open-dialog="totp-enroll"]')?.addEventListener("click", async () => {
        if (!enroll) return;
        const notice = enroll.querySelector<HTMLElement>("[data-form-notice]")!;
        const box = enroll.querySelector<HTMLElement>("[data-totp-qr]")!;
        const skeleton = box.querySelector<HTMLElement>(".qr-skeleton")!;
        box.querySelector("img")?.remove();
        skeleton.hidden = false;
        notice.textContent = "";
        const { data, error } = await actions.enrollTotp().catch(() => ({ data: undefined, error: new Error("No hay conexión. Intenta de nuevo.") }));
        if (error || !data) {
          // Sin QR no hay nada que esperar: se quita el esqueleto y queda el mensaje.
          skeleton.hidden = true;
          notice.textContent = error?.message ?? "No se pudo preparar el código.";
          return;
        }
        enroll.querySelector<HTMLInputElement>('input[name="factorId"]')!.value = data.factorId;
        enroll.querySelector("[data-totp-secret]")!.textContent = data.secret;
        const img = Object.assign(new Image(180, 180), { src: data.qr, alt: "Código QR para tu app de autenticación" });
        box.append(img);
        skeleton.hidden = true;
      });

      // Push: el interruptor suscribe o da de baja este navegador.
      const status = document.querySelector<HTMLElement>("[data-push-status]")!;
      const vapidKey = document.querySelector<HTMLElement>("[data-vapid-key]")!.dataset.vapidKey ?? "";

      const set = (on: boolean, message: string, enabled = true) => {
        toggle.setAttribute("aria-checked", String(on));
        toggle.removeAttribute("aria-busy");
        toggle.disabled = !enabled;
        status.textContent = message;
      };

      // La clave pública VAPID viene en base64url; pushManager la quiere en bytes.
      const keyBytes = (base64: string) => {
        const raw = atob((base64 + "=".repeat((4 - (base64.length % 4)) % 4)).replace(/-/g, "+").replace(/_/g, "/"));
        return Uint8Array.from(raw, (c) => c.charCodeAt(0));
      };

      async function init() {
        const iphone = /iPhone|iPad/.test(navigator.userAgent) && !matchMedia("(display-mode: standalone)").matches;
        if (!vapidKey) return set(false, "Los avisos push todavía no están configurados en este servidor.", false);
        if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
          return set(false, iphone ? "En iPhone, primero agrega Caja Simple a tu pantalla de inicio (Compartir → Agregar a inicio) y ábrela desde ahí." : "Este navegador no puede recibir avisos push.", false);
        }
        if (Notification.permission === "denied") return set(false, "Bloqueaste los avisos para este sitio. Actívalos en los ajustes del navegador y vuelve a esta página.", false);
        const registration = await navigator.serviceWorker.register("/sw.js");
        const subscription = await registration.pushManager.getSubscription();
        set(Boolean(subscription), subscription ? "Activadas: los avisos te llegan a este dispositivo." : "Desactivadas en este dispositivo.");
      }

      toggle.addEventListener("click", async () => {
        const on = toggle.getAttribute("aria-checked") === "true";
        // aria-busy y no disabled: el interruptor conserva el foco mientras cambia.
        if (toggle.getAttribute("aria-busy") === "true") return;
        toggle.setAttribute("aria-busy", "true");
        status.textContent = on ? "Desactivando…" : "Activando…";
        try {
          const registration = await navigator.serviceWorker.ready;
          if (on) {
            const subscription = await registration.pushManager.getSubscription();
            if (subscription) {
              await actions.deletePushSubscription({ endpoint: subscription.endpoint });
              await subscription.unsubscribe();
            }
            return set(false, "Desactivadas en este dispositivo.");
          }
          if ((await Notification.requestPermission()) !== "granted") return init();
          const subscription = await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: keyBytes(vapidKey) });
          const { p256dh, auth } = subscription.toJSON().keys ?? {};
          const { error } = await actions.savePushSubscription({ endpoint: subscription.endpoint, p256dh: p256dh ?? "", auth: auth ?? "" });
          if (error) {
            await subscription.unsubscribe();
            return set(false, `No se pudo activar: ${error.message}`);
          }
          set(true, "Activadas: los avisos te llegan a este dispositivo.");
        } catch (e) {
          console.error(e);
          // «push service error»: el navegador no consiguió canal con su servicio de push (Brave con el push apagado,
          // Chromium sin servicios de Google, o una red que bloquea fcm.googleapis.com). No es algo de la app.
          const pushService = e instanceof DOMException && e.name === "AbortError" && /push service/i.test(e.message);
          set(
            on,
            pushService
              ? "Tu navegador no pudo conectarse con su servicio de avisos. En Brave, activa «Usar los servicios de Google para mensajes push» en la privacidad del navegador; si no, prueba con Chrome o Edge, o desde otra red (sin VPN ni bloqueador)."
              : "Algo falló al cambiar los avisos. Intenta de nuevo.",
          );
        }
      });

      init().catch((e) => {
        console.error(e);
        set(false, "No pudimos revisar los avisos de este navegador.", false);
      });
    });
  </script>
</Layout>

<style>
  /* Como Configuración del negocio: índice «En esta página» a la derecha y secciones a la izquierda.
     El contenedor es el panel: el índice cambia según el ancho del panel, no de la ventana. */
  .settings-shell {
    container-type: inline-size;
  }

  .settings {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .sections {
    display: grid;
    gap: 3rem;
    min-width: 0;
    max-width: 52rem;
  }

  .section {
    display: grid;
    gap: 1rem;
    scroll-margin-top: 1.5rem;
  }

  /* Recibe el foco desde el índice (para teclado y lector), sin anillo: no es un control. */
  .section:focus {
    outline: none;
  }

  /* En la grilla de la cuenta el espacio lo da el gap. */
  .section > :global(.affiliate) {
    margin-top: 0;
  }

  .section-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.02em;
  }

  .section-head p {
    max-width: 60ch;
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .surface {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: var(--radius-panel);
    background: var(--color-surface-muted);
  }

  .surface > .btn {
    justify-self: start;
  }

  /* Ajuste de una línea: lo que es a la izquierda, su control a la derecha. */
  .row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .row-text {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
  }

  .row-text .field-hint {
    margin: 0;
  }

  .row .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .chip :global(svg) {
    flex-shrink: 0;
  }

  .jobs {
    gap: 0;
  }

  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.5rem 0.75rem;
    padding: 1rem 0;
  }

  .job:first-child {
    padding-top: 0;
  }

  .job:last-child {
    padding-bottom: 0;
  }

  .job + .job {
    border-top: 1px solid var(--color-border);
  }

  .job .notice {
    grid-column: 1 / -1;
  }

  /* --- Borrar la cuenta: separado del resto, en el rojo de lo que no se deshace --- */
  .danger-title {
    color: var(--color-expense);
  }

  .danger-zone {
    background: color-mix(in oklab, var(--color-expense-soft) 45%, var(--color-surface-muted));
  }

  .danger-btn {
    color: var(--color-expense);
  }

  .danger-btn:hover:not(:disabled) {
    background: var(--color-expense-soft);
  }

  /* Angosto: los controles bajan debajo de su texto. */
  @container (max-width: 34rem) {
    /* El interruptor se queda al lado de su estado, como en los ajustes del teléfono. */
    .row:not(:has(.switch)),
    .job {
      grid-template-columns: minmax(0, 1fr);
    }

    .row .btn,
    .job .btn {
      justify-self: start;
    }
  }

  /* --- Índice: fila de píldoras sticky en angosto; columna a la derecha con el panel ancho --- */
  .index {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: 0 calc(-1 * var(--main-pad));
    padding: 0.5rem var(--main-pad);
    background: var(--color-surface);
  }

  .index-list {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .index-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-surface-muted);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms, color 150ms;
  }

  .index-link:hover {
    background: var(--color-surface-hover);
  }

  .index-link.danger :global(svg) {
    color: var(--color-expense);
  }

  .index-link[aria-current] {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .index-label {
    display: none;
    margin: 0 0 0.5rem;
    padding: 0 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }

  /* En el celular la página entera hace scroll bajo la barra fija de 4rem. */
  @media (max-width: 768px) {
    .index {
      top: 4rem;
    }

    .section {
      scroll-margin-top: 8rem;
    }
  }

  @container (min-width: 50rem) {
    .settings {
      grid-template-columns: minmax(0, 52rem) 13rem;
      gap: 2.5rem;
      align-items: start;
      justify-content: center;
    }

    .index {
      grid-column: 2;
      grid-row: 1;
      top: 1.5rem;
      margin: 0;
      padding: 0 0 0 1rem;
      border-left: 1px solid var(--color-border);
      background: none;
    }

    .sections {
      grid-column: 1;
      grid-row: 1;
    }

    .index-label {
      display: block;
    }

    .index-list {
      flex-direction: column;
      gap: 0.125rem;
      overflow: visible;
    }

