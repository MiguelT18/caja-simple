---
import { Plus, Store } from "@lucide/astro";
import PageHeader from "@/components/PageHeader.astro";
import BusinessProfileFields from "@/components/app/BusinessProfileFields.astro";
import FormInput from "@/components/app/FormInput.astro";
import MediaCard from "@/components/app/MediaCard.astro";
import Modal from "@/components/app/Modal.astro";
import Layout from "@/layouts/Layout.astro";
import { kindOptions } from "@/data/kinds";
import { businessHref, businessImages, currentUser, entryHref, myBusinesses } from "@/data/queries";
import { boliviaNow } from "@/lib/dates";
import { plural } from "@/lib/format";

const memberships = myBusinesses(Astro.locals);
const logos = await businessImages(Astro.locals, memberships.map((m) => m.business));
const hour = boliviaNow().minutes / 60;
const greeting = hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";
const firstName = currentUser(Astro.locals).firstName;
const monogram = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? "")
    .join("")
    .toUpperCase();
// Un solo negocio en Gratis por persona (lo aplica la base, migración plan_limits): con uno ya no se abre el modal.
const freeBusiness = memberships.find((m) => m.role === "dueño" && m.business.plan === "Gratis")?.business;
---

<Layout title="Tus negocios">
  {
    memberships.length === 0 ? (
      <section class="card onboarding" aria-labelledby="onboarding-title">
        <span class="onboarding-icon" aria-hidden="true">
          <Store size={24} stroke-width={1.75} />
        </span>
        <header>
          <h1 id="onboarding-title">Crea tu negocio</h1>
          <p>
            Empieza con el nombre de tu negocio y su primera sucursal. La sucursal arranca con los turnos de mañana, tarde
            y noche; los ajustas cuando quieras en Turnos.
          </p>
          <p class="hint">Si te invitaron a trabajar en un negocio, aparecerá aquí cuando entres con el correo de la invitación.</p>
        </header>
        <form id="onboarding" class="onboarding-form" data-action="createBusiness" data-redirect="/app/{slug}" novalidate>
          <FormInput form="onboarding" name="name" label="Nombre del negocio" placeholder="Ej.: Almacén López" required maxlength={80} />
          <FormInput form="onboarding" name="kind" label="Rubro" options={kindOptions()} hint="Cambia los textos y las secciones. Lo puedes cambiar después." />
          <BusinessProfileFields form="onboarding" />
          <div class="field-row-2">
            <FormInput form="onboarding" name="branchName" label="Primera sucursal" value="Principal" hint="La zona o la calle; por ejemplo: Centro o Mercado Rodríguez." required maxlength={80} />
            <FormInput form="onboarding" name="branchAddress" label="Dirección" hint="Opcional" maxlength={160} />
          </div>
          <p class="notice notice-error" role="alert" data-form-notice />
          <button type="submit" class="btn btn-primary">Crear negocio</button>
        </form>
      </section>
    ) : (
      <PageHeader title={firstName ? `${greeting}, ${firstName}` : greeting} description="Los negocios que tienes y en los que trabajas. Elige uno para entrar.">
        <button
          type="button"
          class="btn btn-secondary"
          data-open-dialog={freeBusiness ? undefined : "new-business"}
          data-upgrade-notice={freeBusiness && `Tu plan Gratis incluye 1 negocio. Para abrir otro, pasa «${freeBusiness.name}» a un plan pago.`}
          data-upgrade-href={freeBusiness && `${businessHref(freeBusiness)}/plan`}
        >
          <Plus size={18} stroke-width={2} />
          Crear negocio
        </button>
      </PageHeader>
    )
  }

  {!freeBusiness && (
  <Modal id="new-business" title="Crear negocio" description="Con su primera sucursal, que arranca con los turnos de mañana, tarde y noche." action="createBusiness" submitLabel="Crear negocio" redirect="/app/{slug}">
    <FormInput form="new-business-form" name="name" label="Nombre del negocio" required maxlength={80} />
    <FormInput form="new-business-form" name="kind" label="Rubro" options={kindOptions()} />
    <BusinessProfileFields form="new-business-form" />
    <FormInput form="new-business-form" name="branchName" label="Primera sucursal" value="Principal" hint="La zona o la calle; por ejemplo: Centro o Mercado Rodríguez." required maxlength={80} />
    <FormInput form="new-business-form" name="branchAddress" label="Dirección" hint="Opcional" maxlength={160} />
  </Modal>
  )}

  {
    memberships.length > 0 && (
      <section aria-labelledby="businesses-title">
        <h2 id="businesses-title" class="section-title">Tus negocios</h2>
        <ul class="media-grid business-grid" role="list">
          {memberships.map((m) => {
            const owner = m.role === "dueño" || !m.branches[0];
            return (
              <li>
                <MediaCard
                  href={entryHref(m)}
                  title={m.business.name}
                  monogram={monogram(m.business.name)}
                  image={logos.get(m.business.id)}
                  subtitle={
                    m.role === "dueño"
                      ? `Tu negocio · plan ${m.business.plan} · ${plural(m.branches.length, "sucursal", "sucursales")}`
                      : ["Trabajas aquí", m.employee?.jobTitle, ...m.branches.map((b) => b.name)].filter(Boolean).join(" · ")
                  }
                  transition={owner && logos.has(m.business.id) ? `biz-${m.business.id}` : undefined}
                  label={owner ? `Entrar a ${m.business.name}` : `Ir a la caja de ${m.branches[0].name}, en ${m.business.name}`}
                />
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</Layout>

<script>
  import { toast } from "@/scripts/dialogs";

  // Delegado: el contenido se reemplaza al aceptar una invitación (NotificationBell).
  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLElement>("[data-upgrade-notice]");
    if (!button) return;
    const { upgradeNotice, upgradeHref } = button.dataset;
    toast(upgradeNotice!, "info", upgradeHref ? { href: upgradeHref, label: "Ver planes →" } : undefined);
  });
</script>

<style>
  .onboarding {
    display: grid;
    gap: 1rem;
    max-width: 32rem;
    margin: 1rem auto 0;
    padding: 1.5rem;
  }

  .onboarding-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .onboarding h1 {
    margin: 0 0 0.5rem;
    font-size: var(--text-2xl);
  }

  .onboarding p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .onboarding .hint {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
  }

  .onboarding-form {
    display: grid;
    gap: 1rem;
  }

  .business-grid {
    margin: 0;
    padding: 0;
  }

  .section-title {
    margin-top: 0;
  }
</style>
