---
import AuthLayout from "../../layouts/AuthLayout.astro";
import AuthDivider from "../../components/auth/AuthDivider.astro";
import FormField from "../../components/auth/FormField.astro";
import GoogleButton from "../../components/auth/GoogleButton.astro";
import PasswordField from "../../components/auth/PasswordField.astro";

const next = Astro.url.searchParams.get("next");
const query = next ? `?next=${encodeURIComponent(next)}` : "";
---

<AuthLayout
  title="Iniciar sesión"
  heading="Inicia sesión"
  description="Bienvenido de nuevo a tu caja"
  pitch="Tu caja te espera. Entra y sigue donde la dejaste."
>
  <GoogleButton label="Continuar con Google" action={`/api/auth/google${query}`} />

  <AuthDivider />

  <form class="auth-form" method="post" action={`/api/auth/login${query}`} novalidate data-auth-form>
    <FormField
      id="email"
      label="Correo electrónico"
      type="email"
      autocomplete="email"
      autocapitalize="none"
      spellcheck="false"
      required
      data-required-message="Ingresa tu correo"
    />
    <PasswordField
      id="password"
      label="Contraseña"
      autocomplete="current-password"
      required
      data-required-message="Ingresa tu contraseña"
    />
    <button type="submit" class="btn btn-primary btn-block" data-busy-label="Entrando…">Iniciar sesión</button>
  </form>

  <Fragment slot="switch">
    ¿No tienes cuenta? <a href="/auth/crear-cuenta">Crear cuenta</a>
  </Fragment>
</AuthLayout>
