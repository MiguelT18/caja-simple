---
import AuthLayout from "../../layouts/AuthLayout.astro";
import AuthDivider from "../../components/auth/AuthDivider.astro";
import FormField from "../../components/auth/FormField.astro";
import GoogleButton from "../../components/auth/GoogleButton.astro";
import PasswordField from "../../components/auth/PasswordField.astro";
---

<AuthLayout
  title="Iniciar sesión"
  heading="Inicia sesión"
  description="Bienvenido de nuevo a tu caja"
>
  <p class="notice" role="status" data-auth-notice></p>

  <GoogleButton label="Continuar con Google" />

  <AuthDivider />

  <form class="auth-form" method="post" novalidate data-auth-form>
    <FormField
      id="email"
      label="Correo electrónico"
      type="email"
      autocomplete="email"
      autocapitalize="none"
      spellcheck="false"
      required
      data-required-message="Ingresa tu correo"
    />
    <PasswordField
      id="password"
      label="Contraseña"
      autocomplete="current-password"
      required
      data-required-message="Ingresa tu contraseña"
    />
    <button type="submit" class="btn btn-primary btn-block">Iniciar sesión</button>
  </form>

  <Fragment slot="switch">
    ¿No tienes cuenta? <a href="/auth/crear-cuenta">Crear cuenta</a>
  </Fragment>
</AuthLayout>

<script>
  import "../../scripts/auth-form.ts";
</script>

<style>
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .auth-form .btn {
    margin-top: 0.5rem;
  }
</style>
