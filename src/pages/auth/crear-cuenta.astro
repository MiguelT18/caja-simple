---
import AuthLayout from "../../layouts/AuthLayout.astro";
import AuthDivider from "../../components/auth/AuthDivider.astro";
import FormField from "../../components/auth/FormField.astro";
import GoogleButton from "../../components/auth/GoogleButton.astro";
import PasswordField from "../../components/auth/PasswordField.astro";
import { referralInvite, referralPerks } from "@/data/queries";
import { REFERRAL_COOKIE } from "@/lib/auth";

// Llegó con el enlace de un afiliado (/r/<código>): se le recuerda quién lo invitó y qué recibe.
const code = Astro.cookies.get(REFERRAL_COOKIE)?.value;
const [invite, perks] = code
  ? await Promise.all([referralInvite(Astro.locals.supabase, code).catch(() => null), referralPerks(Astro.locals.supabase).catch(() => null)])
  : [null, null];
---

<AuthLayout
  title="Crear cuenta"
  heading="Crea tu cuenta"
  description="Empieza a controlar tu negocio"
  pitch="Abre tu caja hoy. Empezar es gratis."
>
  {invite && <p class="notice" role="status">Te invitó {invite.name}: tu primer negocio prueba el plan Negocio {perks?.trialDays ?? 60} días gratis.</p>}

  <GoogleButton label="Registrarse con Google" action="/api/auth/google" />

  <AuthDivider />

  <form class="auth-form" method="post" action="/api/auth/signup" novalidate data-auth-form>
    <div class="field-row">
      <FormField
        id="firstName"
        label="Nombres"
        autocomplete="given-name"
        required
        data-required-message="Ingresa tus nombres"
      />
      <FormField
        id="lastName"
        label="Apellidos"
        autocomplete="family-name"
        required
        data-required-message="Ingresa tus apellidos"
      />
    </div>
    <FormField
      id="email"
      label="Correo electrónico"
      type="email"
      autocomplete="email"
      autocapitalize="none"
      spellcheck="false"
      required
      data-required-message="Ingresa tu correo"
    />
    <PasswordField
      id="password"
      label="Contraseña"
      autocomplete="new-password"
      required
      minlength={8}
      hint="Mínimo 8 caracteres"
      data-required-message="Ingresa una contraseña"
      data-minlength-message="La contraseña debe tener al menos 8 caracteres"
    />
    <PasswordField
      id="passwordConfirm"
      label="Repetir contraseña"
      autocomplete="new-password"
      required
      data-required-message="Repite tu contraseña"
      data-match="password"
      data-match-message="Las contraseñas no coinciden"
    />
    <button type="submit" class="btn btn-primary btn-block" data-busy-label="Creando tu cuenta…">Crear cuenta</button>
    <p class="legal-note">Al crear tu cuenta aceptas los <a href="/terminos">términos</a> y la <a href="/privacidad">política de privacidad</a>.</p>
  </form>

  <Fragment slot="switch">
    ¿Ya tienes cuenta? <a href="/auth/iniciar-sesion">Inicia sesión</a>
  </Fragment>
</AuthLayout>

<style>
  .legal-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .legal-note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .field-row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 480px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
