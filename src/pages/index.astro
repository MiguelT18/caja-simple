---
// Con la sesión en la petición, las acciones cambian: sin sesión invitan a crear cuenta; con ella, vuelven a la app.
export const prerender = false;

import { ArrowRight, Check, CircleCheck, Moon, Store, Sun, Sunset, TriangleAlert, Users } from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import DaySky from "../components/landing/DaySky.astro";
import BranchesGlance from "../components/landing/BranchesGlance.astro";
import Practical from "../components/landing/Practical.astro";
import Faq from "../components/landing/Faq.astro";

const signupHref = "/auth/crear-cuenta";
const loginHref = "/auth/iniciar-sesion";
const signedIn = Boolean(Astro.locals.userId);

// Tarjeta del hero (ejemplo): la cuenta del turno abierto, como la barra del turno de la app,
// y lo que vendió cada turno de hoy; la barra de cada uno es proporcional al que más vendió.
const now = { opening: 200, sales: 538, expenses: 30.5 };
const expected = now.opening + now.sales - now.expenses;
const daySample = [
  { name: "Mañana", icon: Sun, chip: "chip-morning", color: "--color-shift-morning", amount: 412, note: "Cuadró" },
  { name: "Tarde", icon: Sunset, chip: "chip-afternoon", color: "--color-shift-afternoon", amount: now.sales, note: "En curso" },
  { name: "Noche", icon: Moon, chip: "chip-night", color: "--color-shift-night", amount: 0, note: "Abre a las 21:00" },
];
const dayMax = Math.max(...daySample.map((shift) => shift.amount));
const bs = (n: number) => n.toLocaleString("es-BO", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Una cuenta, dos papeles (ejemplo): el rol se nombra por función, nunca «Dueña» o «Empleada».
const accountSample = [
  { name: "Panadería El Trigal", meta: "Sucursal Centro", role: "Trabajas aquí", monogram: "ET", color: "--color-branch-2" },
  { name: "Tienda Doña Rosa", meta: "3 sucursales", role: "Tu negocio", monogram: "DR", color: "--color-branch-1" },
];
---

<SiteLayout
  title="Lleva la caja de tu negocio"
  description="Registra ventas y gastos por turno, en una o varias sucursales, y sabe cada noche si la caja cuadra. Empieza gratis."
>
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">De la primera venta al cierre de caja, sin cuaderno.</h1>
        <p class="lede">
          Caja Simple lleva la caja de tu negocio: tu gente registra ventas y gastos en su turno, y tú sabes cada
          noche si la caja cuadra, en uno o en varios locales.
        </p>
        <div class="actions">
          {
            signedIn ? (
              <a href="/app" class="btn btn-primary btn-lg">Ir a tus negocios</a>
            ) : (
              <a href={signupHref} class="btn btn-primary btn-lg">Crear cuenta gratis</a>
            )
          }
          <a href="/planes" class="btn btn-secondary btn-lg">Ver planes</a>
        </div>
        <ul class="hero-facts" role="list">
          <li><Check size={16} stroke-width={2} />Gratis con una sucursal</li>
          <li><Check size={16} stroke-width={2} />Tus empleados nunca pagan</li>
          <li><Check size={16} stroke-width={2} />Sin caja registradora</li>
        </ul>
      </div>

      <figure class="demo day-card" aria-labelledby="day-card-title">
        <figcaption class="demo-head">
          <span id="day-card-title" class="demo-title">Hoy en Sucursal Centro</span>
          <span class="sample">Ejemplo</span>
        </figcaption>

        <div class="now">
          <span class="now-art" aria-hidden="true"><Sunset size={26} stroke-width={1.75} /></span>
          <span class="now-text">
            <span class="now-name">Turno tarde</span>
            <span class="now-status"><span class="live-dot" aria-hidden="true"></span>En curso<span class="num now-hours">· 14:00–21:00</span></span>
          </span>
        </div>

        <dl class="till">
          <div><dt>Apertura</dt><dd class="num">Bs {bs(now.opening)}</dd></div>
          <div><dt>Ventas</dt><dd class="num amount-income" data-count={now.sales} data-sign="+" data-delay="400">+Bs {bs(now.sales)}</dd></div>
          <div><dt>Gastos</dt><dd class="num amount-expense" data-count={now.expenses} data-sign="−" data-delay="460">−Bs {bs(now.expenses)}</dd></div>
          <div class="till-total"><dt>Esperado en caja</dt><dd class="num" data-count={expected} data-delay="520">Bs {bs(expected)}</dd></div>
        </dl>

        <p class="shifts-title">Ventas de hoy por turno</p>
        <ul class="day-shifts" role="list">
          {
            daySample.map(({ name, icon: Icon, chip, color, amount, note }, i) => (
              <li style={`--bar: var(${color}); --share: ${amount / dayMax}; --n: ${i}`}>
                <span class:list={["chip", chip]}>
                  <Icon size={14} stroke-width={2} />
                  {name}
                </span>
                <span class="shift-note">{note}</span>
                {amount > 0 ? (
                  <span class="num amount-income shift-amount" data-count={amount} data-sign="+" data-delay={250 + i * 120}>
                    +Bs {bs(amount)}
                  </span>
                ) : (
                  <span class="num shift-amount shift-empty">Bs 0,00</span>
                )}
                <span class="shift-bar" aria-hidden="true"></span>
              </li>
            ))
          }
        </ul>
      </figure>
    </section>

    <section class="day" aria-labelledby="day-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="day-title">Un día en el local</h2>
          <p>Cada turno registra lo suyo. Al final del día, los números ya están hechos.</p>
        </header>

        <div class="day-sky">
          <DaySky />
        </div>

        <ol class="timeline" role="list">
          <li class="shift" style="--shift: var(--color-shift-morning); --shift-soft: var(--color-shift-morning-soft)">
            <div class="shift-rail" aria-hidden="true"><span class="shift-dot"><Sun size={18} stroke-width={2} /></span></div>
            <div class="shift-copy">
              <p class="shift-name">Turno mañana</p>
              <h3>Abres el local y registras cada venta</h3>
              <p>Eliges los productos, ves el total y listo. Más rápido que anotarlo en papel.</p>
            </div>
            <figure class="demo mini" aria-label="Ejemplo de venta registrada">
              <figcaption class="demo-head">
                <span class="demo-title">Venta 08:42</span>
                <span class="sample">Ejemplo</span>
              </figcaption>
              <ul class="lines" role="list">
                <li><span>Pan de batalla <span class="qty num">×10</span></span><span class="num">Bs 5,00</span></li>
                <li><span>Leche 1 L <span class="qty num">×2</span></span><span class="num">Bs 14,00</span></li>
                <li><span>Mantequilla 200 g <span class="qty num">×1</span></span><span class="num">Bs 12,50</span></li>
              </ul>
              <p class="lines-total"><span>Total</span><span class="num amount-income">+Bs 31,50</span></p>
            </figure>
          </li>

          <li class="shift" style="--shift: var(--color-shift-afternoon); --shift-soft: var(--color-shift-afternoon-soft)">
            <div class="shift-rail" aria-hidden="true"><span class="shift-dot"><Sunset size={18} stroke-width={2} /></span></div>
            <div class="shift-copy">
              <p class="shift-name">Turno tarde</p>
              <h3>Anotas los gastos y cuidas el stock</h3>
              <p>Cada salida de dinero queda registrada, y te avisa cuando un producto se está acabando.</p>
            </div>
            <figure class="demo mini" aria-label="Ejemplo de gastos y aviso de stock">
              <figcaption class="demo-head">
                <span class="demo-title">Gastos del turno</span>
                <span class="sample">Ejemplo</span>
              </figcaption>
              <ul class="lines" role="list">
                <li><span>Garrafa de gas</span><span class="num amount-expense">−Bs 22,50</span></li>
                <li><span>Bolsas</span><span class="num amount-expense">−Bs 8,00</span></li>
              </ul>
              <p class="stock-alert"><TriangleAlert size={16} stroke-width={2} />Leche 1 L: quedan 3</p>
            </figure>
          </li>

          <li class="shift" style="--shift: var(--color-shift-night); --shift-soft: var(--color-shift-night-soft)">
            <div class="shift-rail" aria-hidden="true"><span class="shift-dot"><Moon size={18} stroke-width={2} /></span></div>
            <div class="shift-copy">
              <p class="shift-name">Turno noche</p>
              <h3>Cierras el turno y sabes si la caja cuadra</h3>
              <p>Cuentas el efectivo, lo comparas con lo esperado y ves la diferencia al instante.</p>
            </div>
            <figure class="demo mini" aria-label="Ejemplo de cuadre de caja">
              <figcaption class="demo-head">
                <span class="demo-title">Cuadre de caja</span>
                <span class="sample">Ejemplo</span>
              </figcaption>
              <dl class="lines">
                <div><dt>Esperado</dt><dd class="num">Bs 930,00</dd></div>
                <div><dt>Contado</dt><dd class="num">Bs 930,00</dd></div>
                <div><dt>Diferencia</dt><dd class="num">Bs 0,00</dd></div>
              </dl>
              <p class="status-ok"><CircleCheck size={18} stroke-width={2} />La caja cuadra</p>
            </figure>
          </li>
        </ol>
      </div>
    </section>

    <BranchesGlance />

    <section class="roles" aria-labelledby="roles-title">
      <div class="wrap roles-grid">
        <div class="roles-copy">
          <header class="section-head">
            <h2 id="roles-title">Una sola cuenta, sea cual sea tu papel</h2>
            <p>La cuenta es tuya, no de tu puesto. Con el mismo acceso trabajas en un negocio y administras el tuyo.</p>
          </header>
          <div class="role-cols">
            <div>
              <h3>Si trabajas en un local</h3>
              <p>Registras las ventas y los gastos de tu turno, y ves solo la sucursal donde trabajas. Entras gratis, siempre.</p>
            </div>
            <div>
              <h3>Si tienes un negocio</h3>
              <p>Ves ventas, gastos y cuadres por turno, manejas productos, empleados y turnos, y sumas sucursales cuando creces.</p>
            </div>
          </div>
        </div>

        <figure class="demo switcher" aria-labelledby="account-title">
          <figcaption class="demo-head">
            <span class="person">
              <span class="avatar" aria-hidden="true">ML</span>
              <span id="account-title" class="demo-title">María López</span>
            </span>
            <span class="sample">Ejemplo</span>
          </figcaption>
          <ul role="list">
            {
              accountSample.map((biz) => (
                <li style={`--tone: var(${biz.color})`}>
                  <span class="album" aria-hidden="true">{biz.monogram}</span>
                  <span class="biz">
                    <span class="biz-name">{biz.name}</span>
                    <span class="biz-meta">{biz.meta}</span>
                  </span>
                  <span class="chip chip-neutral">{biz.role}</span>
                </li>
              ))
            }
          </ul>
        </figure>
      </div>
    </section>

    <Practical />

    <section class="wrap bridge" aria-labelledby="bridge-title">
      <h2 id="bridge-title">Pagas por sucursal, no por persona</h2>
      <ul class="bridge-facts" role="list">
        <li><Users size={20} stroke-width={1.75} /><span>Tus empleados entran gratis, sean dos o veinte.</span></li>
        <li><Store size={20} stroke-width={1.75} /><span>Gratis con una sucursal. Cambias de plan cuando creces.</span></li>
      </ul>
      <a href="/planes" class="btn btn-secondary btn-lg">Ver planes y precios<ArrowRight size={18} stroke-width={2} /></a>
    </section>

    <Faq />

    <section class="wrap closing" aria-labelledby="closing-title">
      <div class="closing-panel">
        <span class="closing-moon" aria-hidden="true"><Moon size={28} stroke-width={1.75} /></span>
        <h2 id="closing-title">Esta noche sabes si la caja cuadra</h2>
        <p>{signedIn ? "Entra a tu negocio y registra la próxima venta." : "Crea tu cuenta, agrega tu sucursal y registra la primera venta en tu próximo turno."}</p>
        <div class="actions">
          {
            signedIn ? (
              <a href="/app" class="btn btn-primary btn-lg">Ir a tus negocios</a>
            ) : (
              <>
                <a href={signupHref} class="btn btn-primary btn-lg">Crear cuenta gratis</a>
                <a href={loginHref} class="btn btn-secondary btn-lg">Ya tengo cuenta</a>
              </>
            )
          }
        </div>
      </div>
    </section>
</SiteLayout>

<style>
  h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    font-weight: var(--font-bold);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .hero h1 {
    max-width: 17ch;
    font-size: clamp(2.25rem, 1.2rem + 4.4vw, 4rem);
    line-height: 1.02;
    font-weight: var(--font-extrabold);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-medium);
    list-style: none;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .hero-facts :global(svg) {
    color: var(--color-income);
  }

  /* Tarjeta del hero: la barra del turno de la app, en vertical. */
  .day-card {
    padding: 1.5rem;
  }

  .now {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .now-art {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.375rem;
    background: var(--color-shift-afternoon-soft);
    color: var(--color-shift-afternoon);
    box-shadow: var(--shadow-sm);
  }

  .now-text {
    display: flex;
    flex-direction: column;
  }

  .now-name {
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    font-weight: var(--font-bold);
  }

  .now-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .now-hours {
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
  }

  .till {
    display: grid;
    gap: 0.375rem;
    margin: 1.25rem 0 0;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
  }

  .till div,
  .day-shifts li,
  .lines li,
  .lines div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .till dt,
  .lines dt {
    color: var(--color-text-muted);
  }

  .till dd,
  .lines dd {
    margin: 0;
  }

  .till-total {
    margin-top: 0.375rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-border);
  }

  .till-total dt {
    color: var(--color-text);
    font-weight: var(--font-semibold);
  }

  .till-total dd {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--font-extrabold);
    letter-spacing: -0.03em;
  }

  .shifts-title {
    margin: 1.25rem 0 0.75rem;
    color: var(--color-text-muted);
    font-weight: var(--font-semibold);
  }

  .day-shifts,
  .lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .day-shifts {
    display: grid;
    gap: 0.75rem;
  }

  .day-shifts li {
    flex-wrap: wrap;
    row-gap: 0.375rem;
  }

  .shift-note {
    flex: 1;
    color: var(--color-text-muted);
  }

  .shift-empty {
    color: var(--color-text-muted);
  }

  /* Barra de lo que vendió cada turno, proporcional al que más vendió. */
  .shift-bar {
    flex-basis: 100%;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .shift-bar::before {
    content: "";
    display: block;
    width: calc(var(--share) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--bar);
  }

  .status-ok,
  .stock-alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    font-weight: var(--font-semibold);
  }

  .status-ok {
    background: var(--color-income-soft);
    color: var(--color-income);
  }

  .stock-alert {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }
  /* Un día en el local */
  .day {
    padding-block: var(--section-gap);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shift {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 26rem);
    align-items: start;
    column-gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
  }

  .shift:last-child {
    padding-bottom: 0;
  }

  .shift-rail {
    position: relative;
    align-self: stretch;
    display: flex;
    justify-content: center;
  }

  /*
   * La línea del día une los turnos y se corta en el último. Encima de la base gris, un relleno con el color
   * del turno baja hasta el siguiente cuando el turno se enciende, y se recoge cuando se apaga.
   */
  .shift:not(:last-child) .shift-rail::before,
  .shift:not(:last-child) .shift-rail::after {
    content: "";
    position: absolute;
    top: 3rem;
    bottom: calc(-1 * clamp(2.5rem, 1.5rem + 2.5vw, 4rem));
    width: 2px;
    background: var(--color-border-strong);
  }

  .shift:not(:last-child) .shift-rail::before {
    z-index: 1;
    background: var(--shift);
    transform-origin: top;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shift.is-armed:not(.is-lit) .shift-rail::before {
    transform: scaleY(0);
  }

  .shift-dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--shift);
    border-radius: 50%;
    background: var(--shift-soft);
    color: var(--shift);
    transition:
      background-color 600ms cubic-bezier(0.16, 1, 0.3, 1),
      color 600ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shift.is-armed .shift-dot {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text-subtle);
  }

  .shift.is-armed.is-lit .shift-dot {
    border-color: var(--shift);
    background: var(--shift);
    color: var(--color-surface);
    box-shadow: 0 4px 14px -4px var(--shift);
  }

  .shift-copy {
    padding-top: 0.5rem;
  }

  .shift-name {
    margin: 0 0 0.5rem;
    color: var(--shift);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
  }

  .shift-copy h3 {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .shift-copy p:last-child {
    max-width: 30rem;
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
  }

  .mini {
    padding: 1.25rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    transition: box-shadow 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Con el turno encendido, la pieza toma su color en el borde superior. */
  .shift:not(.is-armed) .mini,
  .shift.is-lit .mini {
    box-shadow:
      inset 0 3px 0 var(--shift),
      var(--shadow-md);
  }

  .lines {
    display: grid;
    gap: 0.5rem;
  }

  .qty {
    color: var(--color-text-muted);
  }

  .lines-total {
    display: flex;
    justify-content: space-between;
    margin: 1rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-semibold);
  }

  /* La franja del cielo de los turnos queda fija bajo la barra mientras pasan los turnos por debajo. */
  .day-sky {
    position: sticky;
    top: var(--header-h, 4rem);
    z-index: 2;
    isolation: isolate;
    height: 8rem;
    margin-bottom: 2rem;
    background: var(--color-surface-muted);
    /* El fondo se extiende a todo el ancho para tapar lo que pasa por debajo, también fuera de la columna. */
    box-shadow: 0 0 0 100vmax var(--color-surface-muted);
    clip-path: inset(0 -100vmax);
  }

  :global(.landing[data-header="hidden"]:not(:has(.site-header :focus-visible))) .day-sky {
    top: 0;
  }

  /* Una cuenta, dos papeles */
  .roles {
    padding-block: var(--section-gap);
  }

  .roles-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 25rem);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .role-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }

  .role-cols p {
    margin: 0.5rem 0 0;
