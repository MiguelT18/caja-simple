---
import { Check, CircleCheck, Minus, Moon, Plus, Store, Sun, Sunset, TriangleAlert, UserRound } from "@lucide/astro";
import BaseHead from "../components/BaseHead.astro";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import DaySky from "../components/landing/DaySky.astro";
import { extraBranchPrice, negocioPrice, plans } from "../data/plans";

const signupHref = "/auth/crear-cuenta";

// Ventas de ejemplo por turno en la tarjeta del hero; la barra de cada uno es proporcional al turno que más vendió.
const daySample = [
  { name: "Mañana", icon: Sun, chip: "chip-morning", color: "--color-shift-morning", amount: 412 },
  { name: "Tarde", icon: Sunset, chip: "chip-afternoon", color: "--color-shift-afternoon", amount: 538 },
  { name: "Noche", icon: Moon, chip: "chip-night", color: "--color-shift-night", amount: 290 },
];
const dayMax = Math.max(...daySample.map((shift) => shift.amount));
const loginHref = "/auth/iniciar-sesion";
---

<html lang="es">
  <head>
    <BaseHead title="Lleva la caja de tu negocio" />
    <meta
      name="description"
      content="Registra ventas y gastos por turno, en una o varias sucursales, y sabe cada noche si la caja cuadra. Empieza gratis."
    />
  </head>
  <body class="landing">
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Caja Simple, inicio">
          <Logo class="brand-logo" />
          <span class="brand-name">Caja Simple</span>
        </a>
        <nav class="header-nav" aria-label="Principal">
          <ThemeToggle class="header-theme" />
          <a href="#planes" class="nav-link nav-plans">Planes</a>
          <a href={loginHref} class="nav-link"><span class="label-long">Iniciar sesión</span><span class="label-short">Entrar</span></a>
          <a href={signupHref} class="btn btn-primary">Crear cuenta</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="wrap hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">De la primera venta al cierre de caja, sin cuaderno.</h1>
          <p class="lede">
            Caja Simple lleva la caja de tu negocio: tu gente registra ventas y gastos en su turno, y tú sabes cada
            noche si la caja cuadra, en uno o en varios locales.
          </p>
          <div class="actions">
            <a href={signupHref} class="btn btn-primary btn-lg">Crear cuenta gratis</a>
            <a href="#planes" class="btn btn-secondary btn-lg">Ver planes</a>
          </div>
          <p class="hero-note">Gratis con una sucursal. Tus empleados nunca pagan.</p>
        </div>

        <figure class="day-card" aria-labelledby="day-card-title">
          <figcaption class="mini-head">
            <span id="day-card-title" class="mini-title">Hoy en Sucursal Centro</span>
            <span class="sample">Ejemplo</span>
          </figcaption>
          <ul class="day-shifts" role="list">
            {
              daySample.map(({ name, icon: Icon, chip, color, amount }, i) => (
                <li style={`--bar: var(${color}); --share: ${amount / dayMax}; --n: ${i}`}>
                  <span class:list={["chip", chip]}>
                    <Icon size={14} stroke-width={2} />
                    {name}
                  </span>
                  <span class="num amount-income" data-count={amount} data-sign="+" data-delay={250 + i * 120}>
                    +Bs {amount},00
                  </span>
                  <span class="shift-bar" aria-hidden="true"></span>
                </li>
              ))
            }
          </ul>
          <dl class="day-totals">
            <div><dt>Ventas</dt><dd class="num amount-income" data-count="1240" data-sign="+" data-delay="500">+Bs 1.240,00</dd></div>
            <div><dt>Gastos</dt><dd class="num amount-expense" data-count="310" data-sign="−" data-delay="560">−Bs 310,00</dd></div>
            <div class="day-balance"><dt>Saldo del día</dt><dd class="num" data-count="930" data-delay="620">Bs 930,00</dd></div>
          </dl>
          <p class="status-ok day-status"><CircleCheck size={18} stroke-width={2} />La caja cuadra</p>
        </figure>
      </section>

      <section class="day" aria-labelledby="day-title">
        <div class="wrap">
          <header class="section-head">
            <h2 id="day-title">Un día en el local</h2>
            <p>Cada turno registra lo suyo. Al final del día, los números ya están hechos.</p>
          </header>

          <div class="day-sky">
            <DaySky />
          </div>

          <ol class="timeline" role="list">
            <li class="shift" style="--shift: var(--color-shift-morning); --shift-soft: var(--color-shift-morning-soft)">
              <div class="shift-rail" aria-hidden="true"><span class="shift-dot"><Sun size={18} stroke-width={2} /></span></div>
              <div class="shift-copy">
                <p class="shift-name">Turno mañana</p>
                <h3>Abres el local y registras cada venta</h3>
                <p>Eliges los productos, ves el total y listo. Más rápido que anotarlo en papel.</p>
              </div>
              <figure class="mini" aria-label="Ejemplo de venta registrada">
                <figcaption class="mini-head">
                  <span class="mini-title">Venta 08:42</span>
                  <span class="sample">Ejemplo</span>
                </figcaption>
                <ul class="lines" role="list">
                  <li><span>Pan de batalla <span class="qty num">×10</span></span><span class="num">Bs 5,00</span></li>
                  <li><span>Leche 1 L <span class="qty num">×2</span></span><span class="num">Bs 14,00</span></li>
                  <li><span>Mantequilla 200 g <span class="qty num">×1</span></span><span class="num">Bs 12,50</span></li>
                </ul>
                <p class="lines-total"><span>Total</span><span class="num amount-income">+Bs 31,50</span></p>
              </figure>
            </li>

            <li class="shift" style="--shift: var(--color-shift-afternoon); --shift-soft: var(--color-shift-afternoon-soft)">
              <div class="shift-rail" aria-hidden="true"><span class="shift-dot"><Sunset size={18} stroke-width={2} /></span></div>
              <div class="shift-copy">
                <p class="shift-name">Turno tarde</p>
                <h3>Anotas los gastos y cuidas el stock</h3>
                <p>Cada salida de dinero queda registrada, y te avisa cuando un producto se está acabando.</p>
              </div>
              <figure class="mini" aria-label="Ejemplo de gastos y aviso de stock">
                <figcaption class="mini-head">
                  <span class="mini-title">Gastos del turno</span>
                  <span class="sample">Ejemplo</span>
                </figcaption>
                <ul class="lines" role="list">
                  <li><span>Garrafa de gas</span><span class="num amount-expense">−Bs 22,50</span></li>
                  <li><span>Bolsas</span><span class="num amount-expense">−Bs 8,00</span></li>
                </ul>
                <p class="stock-alert"><TriangleAlert size={16} stroke-width={2} />Leche 1 L: quedan 3</p>
              </figure>
            </li>

            <li class="shift" style="--shift: var(--color-shift-night); --shift-soft: var(--color-shift-night-soft)">
              <div class="shift-rail" aria-hidden="true"><span class="shift-dot"><Moon size={18} stroke-width={2} /></span></div>
              <div class="shift-copy">
                <p class="shift-name">Turno noche</p>
                <h3>Cierras el turno y sabes si la caja cuadra</h3>
                <p>Cuentas el efectivo, lo comparas con lo esperado y ves la diferencia al instante.</p>
              </div>
              <figure class="mini" aria-label="Ejemplo de cuadre de caja">
                <figcaption class="mini-head">
                  <span class="mini-title">Cuadre de caja</span>
                  <span class="sample">Ejemplo</span>
                </figcaption>
                <dl class="lines">
                  <div><dt>Esperado</dt><dd class="num">Bs 930,00</dd></div>
                  <div><dt>Contado</dt><dd class="num">Bs 930,00</dd></div>
                  <div><dt>Diferencia</dt><dd class="num">Bs 0,00</dd></div>
                </dl>
                <p class="status-ok"><CircleCheck size={18} stroke-width={2} />La caja cuadra</p>
              </figure>
            </li>
          </ol>
        </div>
      </section>

      <section class="wrap roles" aria-labelledby="roles-title">
        <div class="roles-top">
          <header class="section-head">
            <h2 id="roles-title">Una sola cuenta, sea cual sea tu papel</h2>
            <p>
              La cuenta es tuya, no de tu puesto. Con el mismo acceso puedes trabajar en un negocio y administrar el
              tuyo.
            </p>
          </header>

          <figure class="account-demo" aria-labelledby="account-title">
            <figcaption class="mini-head">
              <span class="account-person">
                <span class="avatar-initials" aria-hidden="true">ML</span>
                <span id="account-title" class="mini-title">María López</span>
              </span>
              <span class="sample">Ejemplo</span>
            </figcaption>
            <ul class="account-list" role="list">
              <li>
                <span class="account-icon" aria-hidden="true"><Store size={18} stroke-width={1.75} /></span>
                <span class="account-biz">
                  <span class="account-name">Panadería El Trigal</span>
                  <span class="account-meta">Sucursal Centro</span>
                </span>
                <span class="chip chip-employee"><UserRound size={14} stroke-width={2} />Empleada</span>
              </li>
              <li>
                <span class="account-icon" aria-hidden="true"><Store size={18} stroke-width={1.75} /></span>
                <span class="account-biz">
                  <span class="account-name">Tienda Doña Rosa</span>
                  <span class="account-meta num">2 sucursales</span>
                </span>
                <span class="chip chip-owner"><Store size={14} stroke-width={2} />Dueña</span>
              </li>
            </ul>
          </figure>
        </div>
        <div class="role-grid">
          <div class="role">
            <h3><UserRound size={20} stroke-width={1.75} />Si trabajas en un local</h3>
            <ul role="list">
              <li><Check size={16} stroke-width={2} />Registras ventas y gastos de tu turno</li>
              <li><Check size={16} stroke-width={2} />Ves solo la sucursal donde trabajas</li>
              <li><Check size={16} stroke-width={2} />Entras gratis, siempre</li>
            </ul>
          </div>
          <div class="role">
            <h3><Store size={20} stroke-width={1.75} />Si tienes un negocio</h3>
            <ul role="list">
              <li><Check size={16} stroke-width={2} />Ves ventas, gastos y cuadres por turno</li>
              <li><Check size={16} stroke-width={2} />Manejas productos, empleados y turnos</li>
              <li><Check size={16} stroke-width={2} />Sumas sucursales cuando creces</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="planes" class="plans" aria-labelledby="plans-title">
        <div class="wrap">
          <header class="section-head">
            <h2 id="plans-title">Pagas por sucursal, no por persona</h2>
            <p>Tus empleados entran siempre gratis. Empieza sin pagar y cambia de plan cuando tu negocio crezca.</p>
          </header>

          <div class="plan-grid">
            {
              plans.map((plan, i) => (
                <article class="plan" aria-labelledby={`plan-${i}`}>
                  <h3 id={`plan-${i}`}>{plan.name}</h3>
                  <p class="plan-audience">{plan.audience}</p>
                  <p class="plan-price">
                    <span class="num">{plan.price}</span>
                    {plan.period && <span class="plan-period">{plan.period}</span>}
                  </p>
                  <ul role="list">
                    {plan.features.map((feature) => (
                      <li>
                        <Check size={16} stroke-width={2} />
                        {feature}
                      </li>
                    ))}
                  </ul>
                  <a href={signupHref} class:list={["btn", i === 0 ? "btn-primary" : "btn-secondary"]}>
                    {i === 0 ? "Crear cuenta gratis" : "Crear cuenta"}
                  </a>
                </article>
              ))
            }
          </div>

          <div class="calc" data-negocio={negocioPrice.join(",")} data-extra={extraBranchPrice.join(",")}>
            <div class="calc-input">
              <span id="calc-label" class="calc-label">¿Cuántos locales tienes?</span>
              <div class="stepper" role="group" aria-labelledby="calc-label">
                <button type="button" class="icon-btn" data-step="-1" aria-label="Un local menos">
                  <Minus size={18} stroke-width={2} />
                </button>
                <output class="num stepper-value" aria-live="polite">1</output>
                <button type="button" class="icon-btn" data-step="1" aria-label="Un local más">
                  <Plus size={18} stroke-width={2} />
                </button>
              </div>
            </div>
            <p class="calc-result" aria-live="polite">
              <span class="calc-price num">Bs 0</span>
              <span class="calc-detail">Plan Gratis, o Negocio por Bs {negocioPrice[0]}–{negocioPrice[1]} al mes</span>
            </p>
          </div>

          <p class="plans-note">
            Precios orientativos en Bolivianos; todavía los estamos ajustando con dueños de negocio. El plan anual trae 2
            meses gratis y se paga con QR bancario.
          </p>
        </div>
      </section>

      <section class="wrap closing" aria-labelledby="closing-title">
        <div class="closing-band">
          <div class="closing-copy">
            <p class="status-ok closing-status"><CircleCheck size={18} stroke-width={2} />La caja cuadra</p>
            <h2 id="closing-title">Empieza con tu próximo turno</h2>
            <p>Crea tu cuenta, agrega tu sucursal y registra la primera venta hoy.</p>
          </div>
          <div class="actions">
            <a href={signupHref} class="btn btn-primary btn-lg">Crear cuenta gratis</a>
            <a href={loginHref} class="btn btn-secondary btn-lg">Ya tengo cuenta</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand brand-sm"><Logo class="brand-logo" /><span class="brand-name">Caja Simple</span></a>
          <p>Tu negocio, bajo control.</p>
        </div>
        <nav class="footer-nav" aria-label="Pie de página">
          <a href="#planes">Planes</a>
          <a href={loginHref}>Iniciar sesión</a>
          <a href={signupHref}>Crear cuenta</a>
        </nav>
      </div>
    </footer>

    <script>
      import "../scripts/landing.ts";
    </script>
  </body>
</html>

<style>
  .landing {
    --wrap: 72rem;
    --section-gap: clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .landing ::selection {
    background: var(--color-primary-soft);
    color: var(--color-text);
  }

  html:has(.landing) {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html:has(.landing) {
      scroll-behavior: auto;
    }
  }

  .wrap {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding-inline: clamp(1rem, 0.5rem + 2.5vw, 2rem);
  }

  h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    font-weight: var(--font-semibold);
  }

  .btn-lg {
    min-height: 3rem;
    padding-inline: 1.5rem;
  }

  /* Encabezado */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    transition: translate 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    border-radius: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-logo {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .brand-name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
    text-decoration: none;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .nav-link:hover {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  /* Primero de la barra: en móvil queda junto a «Entrar» sin empujar la acción principal. */
  .header-nav .header-theme {
    margin-right: 0.25rem;
  }

  .header-nav .btn {
    margin-left: 0.5rem;
    white-space: nowrap;
  }

  .label-short {
    display: none;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .hero h1 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.43rem + 3.65vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lede {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-note {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  /* Piezas de UI de ejemplo */
  .day-card,
  .mini {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .day-card {
    padding: 1.5rem;
  }

  .mini-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .mini-title {
    font-weight: var(--font-semibold);
  }

  .sample {
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-medium);
  }

  .day-shifts,
  .lines,
  .role ul,
  .plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .day-shifts li,
  .lines li,
  .lines div,
  .day-totals div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .day-shifts {
    display: grid;
    gap: 0.875rem;
  }

  .day-shifts li {
    flex-wrap: wrap;
    row-gap: 0.375rem;
  }

  /* Barra de lo que vendió cada turno, proporcional al que más vendió. */
  .shift-bar {
    flex-basis: 100%;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .shift-bar::before {
    content: "";
    display: block;
    width: calc(var(--share) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--bar);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    font-weight: var(--font-semibold);
  }

  .chip-morning {
    background: var(--color-shift-morning-soft);
    color: var(--color-shift-morning);
  }

  .chip-afternoon {
    background: var(--color-shift-afternoon-soft);
    color: var(--color-shift-afternoon);
  }

  .chip-night {
    background: var(--color-shift-night-soft);
    color: var(--color-shift-night);
  }

  .day-totals {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .day-totals dt,
  .lines dt {
    color: var(--color-text-muted);
  }

  .day-totals dd,
  .lines dd {
    margin: 0;
  }

  .day-balance {
    margin-top: 0.25rem;
  }

  .day-balance dt {
    color: var(--color-text);
    font-weight: var(--font-semibold);
  }

  .day-balance dd {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .amount-income {
    color: var(--color-income);
    font-weight: var(--font-semibold);
  }

  .amount-expense {
    color: var(--color-expense);
    font-weight: var(--font-semibold);
  }

  .status-ok,
  .stock-alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-semibold);
  }

  .status-ok {
    background: var(--color-income-soft);
    color: var(--color-income);
  }

  .stock-alert {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }

  /* Secciones */
  .section-head {
    max-width: 40rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .section-head h2,
  .closing h2 {
    font-size: clamp(1.75rem, 1.29rem + 2.07vw, 2.625rem);
    line-height: 1.12;
    font-weight: var(--font-bold);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .section-head p,
  .closing p {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
  }

  /* Un día en el local */
  .day {
    padding-block: var(--section-gap);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shift {
    display: grid;
