---
// Planes y precios. Con sesión, el plan se cambia desde cada negocio (/app/[negocio]/plan).
export const prerender = false;

import { Check } from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import PlanCalculator from "../components/PlanCalculator.astro";
import { plans } from "../data/plans";

const signupHref = "/auth/crear-cuenta";
const signedIn = Boolean(Astro.locals.userId);
---

<SiteLayout
  title="Planes y precios"
  description="Pagas por sucursal, no por persona: tus empleados entran gratis. Empieza gratis y cambia de plan cuando tu negocio crezca."
  active="planes"
>
  <section class="plans" aria-labelledby="plans-title">
    <div class="wrap">
      <header class="section-head">
        <h1 id="plans-title">Pagas por sucursal, no por persona</h1>
        <p>Tus empleados entran siempre gratis. Empieza sin pagar y cambia de plan cuando tu negocio crezca.</p>
        {signedIn && <p class="plans-signed">El plan es de cada negocio: lo cambias desde la configuración del negocio.</p>}
      </header>

      <div class="plan-grid">
        {
          plans.map((plan, i) => (
            <article class="plan" aria-labelledby={`plan-${i}`}>
              <h2 id={`plan-${i}`}>{plan.name}</h2>
              <p class="plan-audience">{plan.audience}</p>
              <p class="plan-price">
                <span class="num">{plan.price}</span>
                {plan.period && <span class="plan-period">{plan.period}</span>}
              </p>
              <ul role="list">
                {plan.features.map((feature) => (
                  <li>
                    <Check size={16} stroke-width={2} />
                    {feature}
                  </li>
                ))}
              </ul>
              <a href={signedIn ? "/app" : signupHref} class:list={["btn", i === 0 ? "btn-primary" : "btn-secondary"]}>
                {signedIn ? (i === 0 ? "Ir a tus negocios" : "Elegir en tu negocio") : i === 0 ? "Crear cuenta gratis" : "Crear cuenta"}
              </a>
            </article>
          ))
        }
      </div>

      <PlanCalculator />

      <p class="plans-note">
        Precios orientativos en Bolivianos; todavía los estamos ajustando con dueños de negocio. El plan anual trae 2
        meses gratis y se paga con QR bancario.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .plan h2 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    font-weight: var(--font-semibold);
  }

  .plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan ul {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .plan li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .plan li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.3em;
    color: var(--color-income);
  }

  /* Planes */
  .plans {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .plan + .plan {
    border-left: 1px solid var(--color-border);
  }

  .plan h2 {
    font-size: var(--text-xl);
    line-height: var(--text-xl-lh);
    font-weight: var(--font-bold);
  }

  .plan-audience {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .plan-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin: 1.5rem 0 0;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl-lh);
    font-weight: var(--font-bold);
    letter-spacing: -0.01em;
  }

  .plan-period {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--font-medium);
    letter-spacing: 0;
  }

  .plan ul {
    flex: 1;
    margin-block: 1.5rem 2rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .plans-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
  }

  .plans-note {
    max-width: 44rem;
    margin: 1.5rem 0 0;
  }

  @media (max-width: 960px) {
    .plan-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan + .plan {
      border-top: 1px solid var(--color-border);
      border-left: none;
    }
  }

  /* Móvil */
  @media (max-width: 640px) {
    .plan {
      padding: 1.25rem;
    }
    .plan .btn {
      width: 100%;
    }
  }

  .section-head h1 {
    max-width: 22ch;
    margin: 0;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl-lh);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .plans-signed {
    color: var(--color-text);
    font-weight: var(--font-medium);
  }
</style>
