---
// Marco de las páginas públicas (/ y /planes). Reconoce la sesión: con ella, en lugar de «Iniciar sesión» y
// «Crear cuenta» ofrece volver a la app. Las páginas que lo usan no se prerenderizan (necesitan la petición).
import "../styles/site.css";
import { ArrowUp } from "@lucide/astro";
import BaseHead from "../components/BaseHead.astro";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description: string;
  /** Enlace del encabezado que corresponde a esta página. */
  active?: "planes";
}

const { title, description, active } = Astro.props;
const signedIn = Boolean(Astro.locals.userId);
const plansCurrent = active === "planes" ? "page" : undefined;
---

<html lang="es">
  <head>
    <BaseHead title={title} />
    <meta name="description" content={description} />
  </head>
  <body class="landing">
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Caja Simple, inicio">
          <Logo class="brand-logo" />
          <span class="brand-name">Caja Simple</span>
        </a>
        <nav class="header-nav" aria-label="Principal">
          <ThemeToggle class="header-theme" />
          {
            signedIn ? (
              <>
                <a href="/planes" class="nav-link" aria-current={plansCurrent}>Planes</a>
                <a href="/app" class="btn btn-primary">
                  <span class="label-long">Ir a tus negocios</span>
                  <span class="label-short">Tus negocios</span>
                </a>
              </>
            ) : (
              <>
                <a href="/planes" class="nav-link nav-plans" aria-current={plansCurrent}>Planes</a>
                <a href="/auth/iniciar-sesion" class="nav-link">
                  <span class="label-long">Iniciar sesión</span>
                  <span class="label-short">Entrar</span>
                </a>
                <a href="/auth/crear-cuenta" class="btn btn-primary">Crear cuenta</a>
              </>
            )
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand brand-sm"><Logo class="brand-logo" /><span class="brand-name">Caja Simple</span></a>
          <p>Tu negocio, bajo control.</p>
        </div>
        <nav class="footer-nav" aria-label="Pie de página">
          <a href="/planes" aria-current={plansCurrent}>Planes</a>
          {
            signedIn ? (
              <a href="/app">Ir a tus negocios</a>
            ) : (
              <>
                <a href="/auth/iniciar-sesion">Iniciar sesión</a>
                <a href="/auth/crear-cuenta">Crear cuenta</a>
              </>
            )
          }
        </nav>
      </div>
    </footer>

    <!-- Aparece al dejar atrás el primer bloque de la página (landing.ts); sin JS queda siempre a la vista. -->
    <a href="#top" class="to-top" aria-label="Volver arriba" data-to-top><ArrowUp size={20} stroke-width={1.75} /></a>

    <script>
      import "../scripts/landing.ts";
    </script>
  </body>
</html>
