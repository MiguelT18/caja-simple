---
import BaseHead from '../components/BaseHead.astro';
import '../styles/app.css';
import '../styles/app-surface.css';
import Sidebar from '../components/Sidebar.astro';
import PageSkeleton from '../components/app/PageSkeleton.astro';
import ShiftBar from '../components/app/ShiftBar.astro';
import type { Branch } from '../data/types';
import { currentUser, type Membership, type ShiftBarData } from '../data/queries';
import { brandStyle } from '../data/brand';

interface Props {
	title: string;
	/** Negocio (y sucursal) de la página; se omite en «Tus negocios». `shift` muestra la barra del turno. */
	context?: { membership: Membership; branch?: Branch; shift?: ShiftBarData };
}

const { title, context } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} />
	</head>
	<!-- Dentro de un negocio, su color es el acento (src/data/brand.ts); fuera, el ámbar. -->
	<body class="app-surface" style={context ? brandStyle(context.membership.business.color) : undefined}>
		<!-- Antes que las imágenes: una foto que no carga (enlace vencido, sin conexión) se oculta y queda el fondo
		     o el ícono de su contenedor, nunca el ícono de imagen rota. Inline para no perder errores tempranos. -->
		<script is:inline>
			document.addEventListener('error', (e) => { if (e.target instanceof HTMLImageElement && e.target.hasAttribute('data-fallback')) e.target.hidden = true; }, true);
		</script>
		<a class="skip-link" href="#main">Saltar al contenido</a>
		<Sidebar user={currentUser(Astro.locals)} context={context} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		{context?.shift && <ShiftBar data={context.shift} />}
		<PageSkeleton />
		<script>
			import '../scripts/action-forms.ts';
			import '../scripts/nav-skeleton.ts';
			// El service worker da los avisos push, la página sin conexión y Vender sin conexión.
			if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
			// La rueda del mouse sobre un número enfocado lo cambia sin querer (un precio de 7 pasa a 6): se suelta el foco y la página baja.
			document.addEventListener('wheel', (e) => {
				const el = e.target;
				if (el instanceof HTMLInputElement && el.type === 'number' && el === document.activeElement) el.blur();
			}, { passive: true });
		</script>
	</body>
</html>

<style is:global>
	/* Shell: el suelo con dos paneles (navegación y contenido) y, en una sucursal, la barra del turno abajo. */
	body {
		display: grid;
		grid-template-columns: 18.5rem minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr);
		height: 100dvh;
		gap: 0.5rem;
		padding: 0.5rem;
		/* clip y no hidden: hidden se puede desplazar por código (scrollIntoView del paginador) y subía toda la app sin forma de volver. */
		overflow: clip;
	}

	body:has(> .shift-bar) {
		padding-bottom: 0;
		row-gap: 0;
	}

	/* Al abrir un menú o diálogo de Radix, react-remove-scroll-bar copia los márgenes del body (0) a su padding
	   (body[data-scroll-locked]) y el shell crecía hasta los bordes. Con más especificidad, el padding queda igual.
	   Solo en escritorio: en el celular el body no tiene padding. */
	@media (min-width: 769px) {
		body.app-surface[data-scroll-locked] {
			padding: 0.5rem;
		}

		body.app-surface[data-scroll-locked]:has(> .shift-bar) {
			padding-bottom: 0;
		}
	}

	/* El panel de contenido tiene su propio scroll; los encabezados de página llegan hasta sus bordes. */
	main {
		/* Contiene lo posicionado (los .sr-only de los inputs de archivo): si no, se escapa del scroll de main, alarga
		   la página y un focus() o scrollIntoView() desplaza toda la app hacia arriba. */
		position: relative;
		min-width: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		--main-pad: clamp(1rem, 2.5vw, 2rem);
		padding: 0 var(--main-pad) 3rem;
		border-radius: var(--radius-panel);
		background: var(--color-surface);
		scrollbar-width: thin;
	}

	/* Escala un poco más compacta en escritorio (1rem = 15px) y controles más bajos con mouse;
	   en móvil y con pantalla táctil queda todo en 16px y 44px. */
	@media (min-width: 769px) {
		html {
			font-size: 93.75%;
		}
	}

	@media (min-width: 769px) and (pointer: fine) {
		.btn,
		.input {
			min-height: 2.5rem;
		}
	}

	/* Lo que se escribe nunca baja de 16px, aunque la raíz sea de 15px o un componente pida text-sm.
	   :is() toma la especificidad de input:not(…), así gana sobre .input. */
	:is(input:not([type='checkbox'], [type='radio']), select, textarea) {
		font-size: max(16px, var(--text-base));
	}

	@media (max-width: 768px) {
		body {
			display: flex;
			flex-direction: column;
			height: auto;
			min-height: 100dvh;
			padding: 0;
			gap: 0;
			overflow: visible;
			background: var(--color-surface);
		}

		main {
			overflow: visible;
			--main-pad: 1rem;
			padding: 0 var(--main-pad) 2rem;
			border-radius: 0;
		}

		/* Deja lugar para el mini-reproductor fijo. */
		body:has(> .shift-bar) main {
			padding-bottom: 6.5rem;
		}
	}
</style>
