---
import BaseHead from '../components/BaseHead.astro';
import '../styles/app.css';
import Sidebar from '../components/Sidebar.astro';
import type { Branch } from '../data/mock';
import { currentUser, type Membership } from '../data/queries';

interface Props {
	title: string;
	/** Negocio (y sucursal) de la página; se omite en «Tus negocios». */
	context?: { membership: Membership; branch?: Branch };
}

const { title, context } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} />
	</head>
	<body>
		<Sidebar user={currentUser()} context={context} />
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	body {
		display: flex;
		min-height: 100dvh;
	}

	main {
		flex: 1;
		min-width: 0;
		/* El lateral flotante ya deja margen a su derecha. */
		padding: 2rem 2rem 2rem 1.25rem;
	}

	@media (max-width: 768px) {
		body {
			flex-direction: column;
		}

		main {
			padding: 1rem;
		}
	}
</style>
