SUPABASE_URL=
SUPABASE_KEY=
# Solo para la CLI de Supabase (migraciones y tipos). Nunca en el código.
SUPABASE_DB_PASSWORD=
# Opcional: enlace del botón «Mejorar plan» (p. ej. https://wa.me/591…). Sin él, la página de plan solo explica el proceso.
PUBLIC_UPGRADE_URL=
# Notificaciones push (claves con `pnpm dlx web-push generate-vapid-keys`). La pública va al navegador;
# VAPID_PRIVATE_KEY y PUSH_WEBHOOK_SECRET solo se usan para `supabase secrets set` (ver AGENTS.md).
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
