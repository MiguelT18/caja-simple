# Producción (Vercel usa sus propias variables). `astro dev` no arranca con estas: desarrollar va contra la base local.
SUPABASE_URL=
SUPABASE_KEY=
# Solo para la CLI de Supabase (db push a producción). Nunca en el código.
SUPABASE_DB_PASSWORD=
#
# Base local: en .env.development.local (lo lee solo `astro dev` y gana sobre este archivo), con lo que da `pnpm db:status`:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_KEY=<Publishable key (o anon key)>
# Sin Upstash en local: la caché se apaga sola.
# Upstash Redis (Vercel › Marketplace › Upstash): caché y límite de intentos. Opcional en dev, obligatorio en producción.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: enlace del botón «Mejorar plan» (p. ej. https://wa.me/591…). Sin él, la página de plan solo explica el proceso.
PUBLIC_UPGRADE_URL=
# Notificaciones push (claves con `pnpm dlx web-push generate-vapid-keys`). La pública va al navegador;
# VAPID_PRIVATE_KEY y PUSH_WEBHOOK_SECRET solo se usan para `supabase secrets set` (ver AGENTS.md).
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
# Contacto para los servicios de push (p. ej. mailto:hola@tudominio.com); solo para `supabase secrets set`.
VAPID_SUBJECT=
# Opcional: correo por cada mensaje de /app/ayuda (clave de https://resend.com y a qué correo llega).
# Sin ellas, los mensajes solo quedan en la tabla feedback.
RESEND_API_KEY=
FEEDBACK_EMAIL=
